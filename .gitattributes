# Normalize text files for consistent cross-platform diffs.
* text=auto

# Source and config files should use LF in-repo.
*.cs text eol=lf
*.shader text eol=lf
*.cginc text eol=lf
*.hlsl text eol=lf
*.compute text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.uss text eol=lf
*.uxml text eol=lf
*.asmdef text eol=lf
*.asmref text eol=lf
*.meta text eol=lf

# Unity serialized assets are YAML text.
# Uses UnityYAMLMerge (Smart Merge) for semantic conflict resolution.
*.unity text eol=lf merge=unityyamlmerge
*.prefab text eol=lf merge=unityyamlmerge
*.asset text eol=lf merge=unityyamlmerge
*.mat text eol=lf merge=unityyamlmerge
*.anim text eol=lf merge=unityyamlmerge
*.controller text eol=lf merge=unityyamlmerge
*.playable text eol=lf merge=unityyamlmerge
*.overrideController text eol=lf merge=unityyamlmerge

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.bmp binary
*.tga binary
*.psd binary
*.tif binary
*.tiff binary
*.exr binary
*.mp3 binary
*.wav binary
*.ogg binary
*.mp4 binary
*.mov binary
*.avi binary
*.fbx binary
*.blend binary
*.obj binary
*.glb binary
*.gltf text eol=lf
*.stl binary
*.dae text eol=lf
*.ttf binary
*.otf binary
*.dll binary
