{
  "general": {
    "enablePromptCompletion": true
  },
  "mcpServers": {
    "sequential-thinking": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"]
    },
    "memory-graph": {
      "command": "npx",
      "args": ["-y", "mcp-knowledge-graph", "--memory-path", "C:/Users/Conner/.claude/memory"]
    },
    "vb-blender": {
      "command": "uv",
      "args": ["--directory", "C:/Users/Conner/OneDrive/Documents/veilbreakers-gamedev-toolkit/Tools/mcp-toolkit", "run", "vb-blender-mcp"],
      "env": {
        "BLENDER_PORT": "9876",
        "BLENDER_HOST": "localhost"
      }
    },
    "vb-unity": {
      "command": "uv",
      "args": ["--directory", "C:/Users/Conner/OneDrive/Documents/veilbreakers-gamedev-toolkit/Tools/mcp-toolkit", "run", "vb-unity-mcp"],
      "env": {
        "UNITY_PROJECT_PATH": "C:/Users/Conner/OneDrive/Documents/VeilBreakers3DCurrent"
      }
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      }
    }
  },
  "_notes": {
    "profile": "Core profile: lean defaults for high reasoning signal and low token/tool overhead.",
    "full_profile_file": "Tools/mcp/gemini.settings.full.example.json",
    "setup": "Copy this file to .gemini/settings.json for machine-local Gemini CLI MCP setup."
  }
}
