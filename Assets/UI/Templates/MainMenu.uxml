<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Styles/VeilBreakers.uss?fileID=7433441132597879392&amp;guid=f14e48b4bc52a9f4586f9c621c434598&amp;type=3" />
    <Style src="project://database/Assets/UI/Styles/VeilBreakersTheme.uss?fileID=7433441132597879392&amp;guid=0c75776285827f74db8942ace412c502&amp;type=3" />

    <ui:VisualElement name="menu-root" class="vb-root" style="flex-grow: 1;">

        <!-- Background -->
        <ui:VisualElement name="background" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgb(8, 6, 12);" />

        <!-- VEILBREAKERS LOGO - Large at very top -->
        <ui:VisualElement name="logo-container" picking-mode="Ignore" style="position: absolute; left: 0; right: 0; top: -40px; height: 380px; justify-content: flex-start; align-items: center;">
            <ui:VisualElement name="logo-image" style="width: 100%; height: 360px; max-width: 2600px; background-image: url('project://database/Assets/Art/UI/MainMenu/logo_veilbreakers.png?fileID=2800000&amp;guid=068214e22c8853d4c8fe90c83ab65bbc&amp;type=3'); -unity-background-scale-mode: scale-to-fit;" />
        </ui:VisualElement>

        <!-- Demon Figure - Smaller, anchored to bottom center -->
        <ui:VisualElement name="monster-image" picking-mode="Ignore" style="position: absolute; left: 10%; right: 10%; top: 20%; bottom: 0; background-image: url('project://database/Assets/Art/UI/MainMenu/demon_figure.png?fileID=2800000&amp;guid=37ac0bd864327ca4ab90b841b55d87bc&amp;type=3'); -unity-background-scale-mode: scale-to-fit; background-position-x: center; background-position-y: bottom;" />

        <!-- Menu Buttons - Molten orange theme via USS -->
        <ui:VisualElement name="button-container" style="position: absolute; left: 0; right: 0; bottom: 20px; flex-direction: row; justify-content: center; align-items: center; padding: 20px 20px; background-color: rgba(8, 6, 12, 0.80);">

            <ui:Button text="NEW GAME" name="btn-new-game" class="vb-menu-btn-primary" style="width: 180px; height: 55px; margin: 0 12px; border-width: 2px; border-radius: 6px; font-size: 18px; letter-spacing: 3px; -unity-font-style: bold;" />

            <ui:Button text="CONTINUE" name="btn-continue" class="vb-menu-btn-primary" style="display: none; width: 180px; height: 55px; margin: 0 12px; border-width: 2px; border-radius: 6px; font-size: 18px; letter-spacing: 3px; -unity-font-style: bold;" />

            <ui:Button text="SETTINGS" name="btn-settings" class="vb-menu-btn-secondary" style="width: 150px; height: 50px; margin: 0 12px; border-width: 2px; border-radius: 6px; font-size: 16px; letter-spacing: 3px; -unity-font-style: bold;" />

            <ui:Button text="CREDITS" name="btn-credits" class="vb-menu-btn-secondary" style="width: 150px; height: 50px; margin: 0 12px; border-width: 2px; border-radius: 6px; font-size: 16px; letter-spacing: 3px; -unity-font-style: bold;" />

            <ui:Button text="EXIT" name="btn-exit" class="vb-menu-btn-secondary" style="width: 120px; height: 50px; margin: 0 12px; border-width: 2px; border-radius: 6px; font-size: 16px; letter-spacing: 3px; -unity-font-style: bold;" />

        </ui:VisualElement>

        <!-- Footer -->
        <ui:VisualElement name="footer" style="position: absolute; left: 0; right: 0; bottom: 0; height: 50px; flex-direction: row; justify-content: space-between; align-items: center; padding: 0 50px; background-color: transparent;">
            <ui:Label text="© 2026 VeilBreakers" style="font-size: 14px; color: rgb(80, 70, 65); letter-spacing: 2px;" />
            <ui:Label text="v2.84 Alpha" name="version-label" style="font-size: 14px; color: rgb(80, 70, 65); letter-spacing: 2px;" />
        </ui:VisualElement>

        <!-- Loading Overlay -->
        <ui:VisualElement name="loading-overlay" style="display: none; position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(8, 6, 12, 0.95); justify-content: center; align-items: center;">
            <ui:VisualElement style="width: 60px; height: 60px; border-width: 4px; border-color: rgba(180, 40, 60, 0.3); border-top-color: rgb(180, 40, 60); border-radius: 30px; margin-bottom: 25px;" />
            <ui:Label text="ENTERING THE VEIL..." style="font-size: 18px; letter-spacing: 5px; color: rgb(180, 40, 60);" />
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
