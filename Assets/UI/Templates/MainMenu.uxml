<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Styles/VeilBreakers.uss?fileID=7433441132597879392&amp;guid=f14e48b4bc52a9f4586f9c621c434598&amp;type=3" />
    <Style src="project://database/Assets/UI/Styles/VeilBreakersTheme.uss?fileID=7433441132597879392&amp;guid=0c75776285827f74db8942ace412c502&amp;type=3" />

    <ui:VisualElement name="menu-root" class="vb-root" style="flex-grow: 1;">

        <!-- Background -->
        <ui:VisualElement name="background" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgb(8, 6, 12);" />

        <!-- Veil pulse circles (animated via C#) -->
        <ui:VisualElement name="veil-pulse-layer" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; overflow: hidden;">
            <ui:VisualElement name="veil-pulse-1" style="position: absolute; left: 15%; top: 25%; width: 400px; height: 400px; border-radius: 200px; background-color: rgba(180, 40, 60, 0.10);" />
            <ui:VisualElement name="veil-pulse-2" style="position: absolute; right: 10%; top: 15%; width: 300px; height: 300px; border-radius: 150px; background-color: rgba(140, 30, 50, 0.08);" />
            <ui:VisualElement name="veil-pulse-3" style="position: absolute; left: 5%; bottom: 15%; width: 350px; height: 350px; border-radius: 175px; background-color: rgba(120, 30, 45, 0.07);" />
        </ui:VisualElement>

        <!-- Particle containers (populated by C#) - v2.63: overflow VISIBLE to prevent clipping -->
        <ui:VisualElement name="particle-container" picking-mode="Ignore" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; overflow: visible;" />
        <ui:VisualElement name="ember-container" picking-mode="Ignore" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; overflow: visible;" />
        <ui:VisualElement name="spark-container" picking-mode="Ignore" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; overflow: visible;" />

        <!-- Main Content - Centered Layout -->
        <ui:VisualElement name="content" style="flex-grow: 1; justify-content: center; align-items: center;">

            <!-- Title Section -->
            <ui:VisualElement name="title-section" style="align-items: center; margin-bottom: 60px;">

                <!-- Decorative line above -->
                <ui:VisualElement style="flex-direction: row; align-items: center; margin-bottom: 24px;">
                    <ui:VisualElement style="width: 60px; height: 1px; background-color: rgba(180, 40, 60, 0.4);" />
                    <ui:VisualElement style="width: 8px; height: 8px; border-radius: 4px; background-color: rgb(180, 40, 60); margin: 0 16px;" />
                    <ui:VisualElement style="width: 60px; height: 1px; background-color: rgba(180, 40, 60, 0.4);" />
                </ui:VisualElement>

                <!-- Main Title -->
            <ui:Label text="VEILBREAKERS" name="game-title" style="font-size: 72px; letter-spacing: 12px; color: rgb(235, 225, 215); -unity-font-style: bold; -unity-text-align: middle-center; margin-bottom: 16px;" />

                <!-- Tagline -->
                <ui:Label text="Break the Veil. Bind the Fallen." name="tagline" style="font-size: 16px; letter-spacing: 4px; color: rgb(130, 120, 110); -unity-text-align: middle-center; -unity-font-style: italic;" />

                <!-- Decorative dots below -->
                <ui:VisualElement style="flex-direction: row; margin-top: 24px;">
                    <ui:VisualElement style="width: 4px; height: 4px; border-radius: 2px; background-color: rgba(180, 40, 60, 0.6); margin: 0 6px;" />
                    <ui:VisualElement style="width: 4px; height: 4px; border-radius: 2px; background-color: rgba(180, 40, 60, 0.6); margin: 0 6px;" />
                    <ui:VisualElement style="width: 4px; height: 4px; border-radius: 2px; background-color: rgba(180, 40, 60, 0.6); margin: 0 6px;" />
                </ui:VisualElement>

            </ui:VisualElement>

            <!-- Menu Buttons Container -->
            <ui:VisualElement name="button-container" style="width: 320px; padding: 32px; background-color: rgba(12, 9, 18, 0.9); border-width: 1px; border-color: rgba(180, 40, 60, 0.3); border-radius: 12px; box-shadow: 0 18px 42px rgba(0,0,0,0.55);">

                <!-- NEW GAME Button -->
                <ui:Button text="NEW GAME" name="btn-new-game" class="menu-button-main" style="width: 100%; margin-bottom: 12px; -unity-text-align: middle-center;" />

                <!-- CONTINUE Button -->
                <ui:Button text="CONTINUE" name="btn-continue" class="menu-button-main" style="display: none; width: 100%; margin-bottom: 12px; -unity-text-align: middle-center;" />

                <!-- Divider -->
                <ui:VisualElement style="flex-direction: row; align-items: center; margin: 16px 0;">
                    <ui:VisualElement style="flex-grow: 1; height: 1px; background-color: rgba(180, 40, 60, 0.3);" />
                    <ui:VisualElement style="width: 6px; height: 6px; border-radius: 3px; background-color: rgba(180, 40, 60, 0.5); margin: 0 12px;" />
                    <ui:VisualElement style="flex-grow: 1; height: 1px; background-color: rgba(180, 40, 60, 0.3);" />
                </ui:VisualElement>

                <!-- SETTINGS Button -->
                <ui:Button text="SETTINGS" name="btn-settings" class="menu-button-secondary" style="width: 100%; margin-bottom: 8px; -unity-text-align: middle-center;" />

                <!-- CREDITS Button -->
                <ui:Button text="CREDITS" name="btn-credits" class="menu-button-secondary" style="width: 100%; margin-bottom: 8px; -unity-text-align: middle-center;" />

                <!-- EXIT Button -->
                <ui:Button text="EXIT" name="btn-exit" class="menu-button-secondary menu-button-exit" style="width: 100%; -unity-text-align: middle-center;" />

            </ui:VisualElement>

        </ui:VisualElement>

        <!-- Footer - positioned below the centered content, not overlapping -->
        <ui:VisualElement name="footer" style="position: absolute; left: 0; right: 0; bottom: 0; height: 40px; flex-direction: row; justify-content: space-between; align-items: center; padding: 0 40px; background-color: transparent;">
            <ui:Label text="© 2026 VeilBreakers" style="font-size: 11px; color: rgb(80, 70, 65); letter-spacing: 1px;" />
            <ui:Label text="v2.84 Alpha" name="version-label" style="font-size: 11px; color: rgb(80, 70, 65); letter-spacing: 1px;" />
        </ui:VisualElement>

        <!-- Centered decorative element - positioned absolutely to be perfectly centered -->
        <ui:VisualElement name="footer-decoration" style="position: absolute; left: 50%; bottom: 16px; translate: -50% 0; flex-direction: row; align-items: center;">
            <ui:VisualElement style="width: 20px; height: 1px; background-color: rgba(180, 40, 60, 0.3);" />
            <ui:VisualElement style="width: 4px; height: 4px; border-radius: 2px; background-color: rgba(180, 40, 60, 0.5); margin: 0 8px;" />
            <ui:VisualElement style="width: 20px; height: 1px; background-color: rgba(180, 40, 60, 0.3);" />
        </ui:VisualElement>

        <!-- Loading Overlay -->
        <ui:VisualElement name="loading-overlay" style="display: none; position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(8, 6, 12, 0.95); justify-content: center; align-items: center;">
            <ui:VisualElement style="width: 48px; height: 48px; border-width: 3px; border-color: rgba(180, 40, 60, 0.3); border-top-color: rgb(180, 40, 60); border-radius: 24px; margin-bottom: 20px;" />
            <ui:Label text="ENTERING THE VEIL..." style="font-size: 14px; letter-spacing: 4px; color: rgb(180, 40, 60);" />
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
