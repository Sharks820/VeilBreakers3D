<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Styles/VeilBreakers.uss?fileID=7433441132597879392&amp;guid=f14e48b4bc52a9f4586f9c621c434598&amp;type=3" />
    <Style src="project://database/Assets/UI/Styles/VeilBreakersTheme.uss?fileID=7433441132597879392&amp;guid=0c75776285827f74db8942ace412c502&amp;type=3" />

    <ui:VisualElement name="menu-root" class="vb-root" style="flex-grow: 1;">

        <!-- Background -->
        <ui:VisualElement name="background" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgb(8, 6, 12);" />

        <!-- VFX handled by MenuPulseController + MainMenuVFXSetup (Canvas/SpriteRenderer) -->

        <!-- Title Monster Art - Uses demon_figure.png -->
        <ui:VisualElement name="title-monster" picking-mode="Ignore" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; justify-content: flex-end; align-items: center; overflow: hidden;">
            <ui:VisualElement name="monster-image" style="width: 100%; height: 95%; background-image: url('project://database/Assets/Art/UI/MainMenu/demon_figure.png?fileID=2800000&amp;guid=37ac0bd864327ca4ab90b841b55d87bc&amp;type=3'); -unity-background-scale-mode: scale-to-fit; translate: 0 12%;" />
        </ui:VisualElement>

        <!-- Logo - VEILBREAKERS text -->
        <ui:VisualElement name="logo-container" picking-mode="Ignore" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; justify-content: flex-start; align-items: center; padding-top: 60px;">
            <ui:VisualElement name="logo-image" style="width: 600px; height: 150px; background-image: url('project://database/Assets/Art/UI/MainMenu/logo_veilbreakers.png?fileID=2800000&amp;guid=068214e22c8853d4c8fe90c83ab65bbc&amp;type=3'); -unity-background-scale-mode: scale-to-fit;" />
        </ui:VisualElement>

        <!-- Old particle/ember containers removed - VFX now uses ParticleSystem -->

        <!-- Menu Buttons - Horizontal row at bottom -->
        <ui:VisualElement name="button-container" style="position: absolute; left: 0; right: 0; bottom: 50px; flex-direction: row; justify-content: center; align-items: center; padding: 16px 20px; background-color: rgba(8, 6, 12, 0.75);">

            <!-- NEW GAME Button - Primary (Crimson) -->
            <ui:Button text="NEW GAME" name="btn-new-game" class="vb-menu-btn-primary" style="width: 170px; height: 50px; margin: 0 10px; background-color: rgb(130, 30, 45); border-width: 2px; border-color: rgb(180, 50, 70); border-radius: 4px; color: rgb(255, 245, 235); font-size: 16px; letter-spacing: 3px; -unity-font-style: bold; -unity-text-align: middle-center;" />

            <!-- CONTINUE Button (hidden by default) -->
            <ui:Button text="CONTINUE" name="btn-continue" class="vb-menu-btn-primary" style="display: none; width: 170px; height: 50px; margin: 0 10px; background-color: rgb(130, 30, 45); border-width: 2px; border-color: rgb(180, 50, 70); border-radius: 4px; color: rgb(255, 245, 235); font-size: 16px; letter-spacing: 3px; -unity-font-style: bold; -unity-text-align: middle-center;" />

            <!-- SETTINGS Button - Secondary -->
            <ui:Button text="SETTINGS" name="btn-settings" class="vb-menu-btn-secondary" style="width: 140px; height: 50px; margin: 0 10px; background-color: rgba(20, 18, 28, 0.95); border-width: 1px; border-color: rgb(70, 60, 80); border-radius: 4px; color: rgb(170, 165, 160); font-size: 15px; letter-spacing: 3px; -unity-text-align: middle-center;" />

            <!-- CREDITS Button - Secondary -->
            <ui:Button text="CREDITS" name="btn-credits" class="vb-menu-btn-secondary" style="width: 140px; height: 50px; margin: 0 10px; background-color: rgba(20, 18, 28, 0.95); border-width: 1px; border-color: rgb(70, 60, 80); border-radius: 4px; color: rgb(170, 165, 160); font-size: 15px; letter-spacing: 3px; -unity-text-align: middle-center;" />

            <!-- EXIT Button - Secondary -->
            <ui:Button text="EXIT" name="btn-exit" class="vb-menu-btn-secondary" style="width: 110px; height: 50px; margin: 0 10px; background-color: rgba(20, 18, 28, 0.95); border-width: 1px; border-color: rgb(70, 60, 80); border-radius: 4px; color: rgb(170, 165, 160); font-size: 15px; letter-spacing: 3px; -unity-text-align: middle-center;" />

        </ui:VisualElement>

        <!-- Footer - positioned below the centered content, not overlapping -->
        <ui:VisualElement name="footer" style="position: absolute; left: 0; right: 0; bottom: 0; height: 40px; flex-direction: row; justify-content: space-between; align-items: center; padding: 0 40px; background-color: transparent;">
            <ui:Label text="© 2026 VeilBreakers" style="font-size: 11px; color: rgb(80, 70, 65); letter-spacing: 1px;" />
            <ui:Label text="v2.84 Alpha" name="version-label" style="font-size: 11px; color: rgb(80, 70, 65); letter-spacing: 1px;" />
        </ui:VisualElement>

        <!-- Centered decorative element - positioned absolutely to be perfectly centered -->
        <ui:VisualElement name="footer-decoration" style="position: absolute; left: 50%; bottom: 16px; translate: -50% 0; flex-direction: row; align-items: center;">
            <ui:VisualElement style="width: 20px; height: 1px; background-color: rgba(180, 40, 60, 0.3);" />
            <ui:VisualElement style="width: 4px; height: 4px; border-radius: 2px; background-color: rgba(180, 40, 60, 0.5); margin: 0 8px;" />
            <ui:VisualElement style="width: 20px; height: 1px; background-color: rgba(180, 40, 60, 0.3);" />
        </ui:VisualElement>

        <!-- Loading Overlay -->
        <ui:VisualElement name="loading-overlay" style="display: none; position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(8, 6, 12, 0.95); justify-content: center; align-items: center;">
            <ui:VisualElement style="width: 48px; height: 48px; border-width: 3px; border-color: rgba(180, 40, 60, 0.3); border-top-color: rgb(180, 40, 60); border-radius: 24px; margin-bottom: 20px;" />
            <ui:Label text="ENTERING THE VEIL..." style="font-size: 14px; letter-spacing: 4px; color: rgb(180, 40, 60);" />
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
