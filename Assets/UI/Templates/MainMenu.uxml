<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Styles/VeilBreakers.uss?fileID=7433441132597879392&amp;guid=f14e48b4bc52a9f4586f9c621c434598&amp;type=3" />
    <Style src="project://database/Assets/UI/Styles/VeilBreakersTheme.uss?fileID=7433441132597879392&amp;guid=0c75776285827f74db8942ace412c502&amp;type=3" />

    <ui:VisualElement name="menu-root" class="vb-root" style="flex-grow: 1;">

        <!-- ====================================================================
             BACKGROUND LAYERS - Deep Atmospheric Depth
             ==================================================================== -->

        <!-- Layer 0: Void Black -->
        <ui:VisualElement name="bg-void" class="bg-void" />

        <!-- Layer 1: Deep Purple Ambient -->
        <ui:VisualElement name="bg-ambient" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0;">
            <ui:VisualElement style="position: absolute; left: 0; top: 0; right: 0; height: 60%; background-color: rgba(80, 40, 120, 0.06);" />
            <ui:VisualElement style="position: absolute; left: 0; bottom: 0; right: 0; height: 50%; background-color: rgba(40, 0, 80, 0.08);" />
        </ui:VisualElement>

        <!-- Layer 2: Veil Energy Pulse (animated via C#) -->
        <ui:VisualElement name="veil-pulse-layer" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; overflow: hidden;">
            <ui:VisualElement name="veil-pulse-1" style="position: absolute; left: 20%; top: 30%; width: 400px; height: 400px; border-radius: 50%; background-color: rgba(130, 70, 180, 0.04);" />
            <ui:VisualElement name="veil-pulse-2" style="position: absolute; right: 15%; top: 20%; width: 300px; height: 300px; border-radius: 50%; background-color: rgba(100, 50, 150, 0.05);" />
            <ui:VisualElement name="veil-pulse-3" style="position: absolute; left: 10%; bottom: 20%; width: 350px; height: 350px; border-radius: 50%; background-color: rgba(80, 40, 140, 0.03);" />
        </ui:VisualElement>

        <!-- Layer 3: Floating Particle Container (populated by C#) -->
        <ui:VisualElement name="particle-container" class="particle-layer" />

        <!-- Layer 4: Ember Particles (populated by C#) -->
        <ui:VisualElement name="ember-container" class="particle-layer" />

        <!-- Layer 5: Vignette Overlay -->
        <ui:VisualElement name="vignette" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0;">
            <ui:VisualElement class="bg-vignette-top" />
            <ui:VisualElement class="bg-vignette-bottom" />
            <ui:VisualElement class="bg-vignette-left" />
            <ui:VisualElement class="bg-vignette-right" />
            <!-- Center gradient for depth -->
            <ui:VisualElement style="position: absolute; left: 30%; top: 20%; right: 30%; bottom: 40%; background-color: rgba(130, 70, 180, 0.02); border-radius: 50%;" />
        </ui:VisualElement>

        <!-- ====================================================================
             MAIN CONTENT
             ==================================================================== -->

        <ui:VisualElement name="content-container" style="flex-grow: 1; flex-direction: row; padding: 60px 80px;">

            <!-- ================================================================
                 LEFT SIDE - Title & Branding (60%)
                 ================================================================ -->

            <ui:VisualElement name="left-panel" style="flex-grow: 1; justify-content: center; max-width: 60%;">

                <!-- Logo / Title Section -->
                <ui:VisualElement name="title-section" style="margin-bottom: 40px;">

                    <!-- Decorative Line Above Title -->
                    <ui:VisualElement style="flex-direction: row; align-items: center; margin-bottom: 20px;">
                        <ui:VisualElement style="width: 80px; height: 1px; background-color: rgba(130, 70, 180, 0.5);" />
                        <ui:VisualElement style="width: 10px; height: 10px; border-radius: 50%; background-color: rgb(130, 70, 180); margin: 0 12px;" />
                        <ui:VisualElement style="width: 40px; height: 1px; background-color: rgba(130, 70, 180, 0.3);" />
                    </ui:VisualElement>

                    <!-- Main Title - VEILBREAKERS -->
                    <ui:VisualElement name="logo-container" style="margin-bottom: 20px;">
                        <ui:Label text="VEILBREAKERS" name="game-title" class="title-hero" style="font-size: 68px; -unity-text-align: middle-left; letter-spacing: 6px;" />
                    </ui:VisualElement>

                    <!-- Tagline with Accent Line -->
                    <ui:VisualElement name="tagline-container" style="flex-direction: row; align-items: center;">
                        <ui:VisualElement style="width: 50px; height: 2px; background-color: rgb(180, 50, 70); margin-right: 16px;" />
                        <ui:Label text="Break the Veil. Bind the Fallen." name="tagline" class="title-tagline" />
                    </ui:VisualElement>

                    <!-- Decorative Accent Below -->
                    <ui:VisualElement style="flex-direction: row; margin-top: 24px; opacity: 0.6;">
                        <ui:VisualElement style="width: 4px; height: 4px; border-radius: 50%; background-color: rgb(130, 70, 180); margin-right: 8px;" />
                        <ui:VisualElement style="width: 4px; height: 4px; border-radius: 50%; background-color: rgb(130, 70, 180); margin-right: 8px;" />
                        <ui:VisualElement style="width: 4px; height: 4px; border-radius: 50%; background-color: rgb(130, 70, 180);" />
                    </ui:VisualElement>

                </ui:VisualElement>

                <!-- News/Update Section (Optional) -->
                <ui:VisualElement name="news-section" style="margin-top: 60px; max-width: 450px; display: none;">
                    <ui:VisualElement style="padding: 16px 20px; background-color: rgba(18, 14, 26, 0.8); border-width: 1px; border-color: rgba(130, 70, 180, 0.3); border-radius: 8px;">
                        <ui:Label text="LATEST UPDATE" style="font-size: 11px; color: rgb(130, 70, 180); letter-spacing: 2px; margin-bottom: 8px;" />
                        <ui:Label text="Version 1.0 - The Veil Awakens" style="font-size: 14px; color: rgb(165, 155, 145);" />
                    </ui:VisualElement>
                </ui:VisualElement>

            </ui:VisualElement>

            <!-- ================================================================
                 RIGHT SIDE - Menu Buttons (40%)
                 ================================================================ -->

            <ui:VisualElement name="right-panel" style="width: 360px; justify-content: center; align-items: flex-end;">

                <!-- Menu Button Container -->
                <ui:VisualElement name="button-container" style="width: 300px; padding: 32px; background-color: rgba(12, 9, 18, 0.85); border-width: 1px; border-color: rgba(130, 70, 180, 0.25); border-radius: 12px;">

                    <!-- CONTINUE Button (if save exists) -->
                    <ui:Button text="CONTINUE" name="btn-continue" class="btn-primary" style="display: none; margin-bottom: 16px; width: 100%;">
                        <ui:VisualElement name="continue-glow" style="position: absolute; left: -4px; top: -4px; right: -4px; bottom: -4px; border-radius: 10px; border-width: 2px; border-color: rgba(130, 70, 180, 0.4); opacity: 0;" />
                    </ui:Button>

                    <!-- NEW GAME Button -->
                    <ui:Button text="NEW GAME" name="btn-new-game" class="btn-primary" style="margin-bottom: 16px; width: 100%;">
                        <ui:VisualElement name="newgame-glow" style="position: absolute; left: -4px; top: -4px; right: -4px; bottom: -4px; border-radius: 10px; border-width: 2px; border-color: rgba(130, 70, 180, 0.4); opacity: 0;" />
                    </ui:Button>

                    <!-- Divider -->
                    <ui:VisualElement class="divider-decorated" style="margin: 12px 0 20px 0;">
                        <ui:VisualElement class="divider-line" />
                        <ui:VisualElement class="divider-dot" style="width: 6px; height: 6px; margin: 0 12px;" />
                        <ui:VisualElement class="divider-line" />
                    </ui:VisualElement>

                    <!-- SETTINGS Button -->
                    <ui:Button text="SETTINGS" name="btn-settings" class="btn-secondary" style="margin-bottom: 10px; width: 100%;" />

                    <!-- CREDITS Button -->
                    <ui:Button text="CREDITS" name="btn-credits" class="btn-secondary" style="margin-bottom: 10px; width: 100%;" />

                    <!-- EXIT Button -->
                    <ui:Button text="EXIT" name="btn-exit" class="btn-tertiary" style="width: 100%;" />

                </ui:VisualElement>

                <!-- Social Links (Optional) -->
                <ui:VisualElement name="social-container" style="flex-direction: row; margin-top: 24px; opacity: 0.6;">
                    <!-- Icons populated by C# -->
                </ui:VisualElement>

            </ui:VisualElement>

        </ui:VisualElement>

        <!-- ====================================================================
             FOOTER
             ==================================================================== -->

        <ui:VisualElement name="footer" class="footer">

            <!-- Copyright -->
            <ui:Label text="© 2026 VeilBreakers" class="footer-text" />

            <!-- Center Decoration -->
            <ui:VisualElement style="flex-direction: row; align-items: center;">
                <ui:VisualElement style="width: 30px; height: 1px; background-color: rgba(130, 70, 180, 0.3);" />
                <ui:VisualElement style="width: 6px; height: 6px; border-radius: 50%; background-color: rgba(130, 70, 180, 0.5); margin: 0 10px;" />
                <ui:VisualElement style="width: 30px; height: 1px; background-color: rgba(130, 70, 180, 0.3);" />
            </ui:VisualElement>

            <!-- Version -->
            <ui:Label text="v0.1.0 Alpha" name="version-label" class="footer-text" />

        </ui:VisualElement>

        <!-- ====================================================================
             LOADING OVERLAY
             ==================================================================== -->

        <ui:VisualElement name="loading-overlay" class="loading-overlay" style="display: none;">
            <ui:VisualElement class="loading-spinner" />
            <ui:Label text="ENTERING THE VEIL..." class="loading-text" />
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
