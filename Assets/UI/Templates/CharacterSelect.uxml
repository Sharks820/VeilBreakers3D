<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Styles/VeilBreakers.uss?fileID=7433441132597879392&amp;guid=f14e48b4bc52a9f4586f9c621c434598&amp;type=3" />
    <Style src="project://database/Assets/UI/Styles/VeilBreakersTheme.uss?fileID=7433441132597879392&amp;guid=0c75776285827f74db8942ace412c502&amp;type=3" />

    <ui:VisualElement name="charselect-root" class="vb-root" style="flex-grow: 1;">

        <!-- ====================================================================
             BACKGROUND
             ==================================================================== -->

        <ui:VisualElement name="background" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgb(8, 6, 12);" />

        <!-- Veil ambient effect -->
        <ui:VisualElement name="veil-effect" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(120, 60, 160, 0.03);" />

        <!-- ====================================================================
             HEADER
             ==================================================================== -->

        <ui:VisualElement name="header" style="position: absolute; left: 0; top: 0; right: 0; height: 80px; flex-direction: row; justify-content: space-between; align-items: center; padding: 0 40px; background-color: rgba(0, 0, 0, 0.5);">

            <!-- Back button -->
            <ui:Button text="BACK" name="btn-back" class="vb-button" style="width: 120px;" />

            <!-- Title -->
            <ui:Label text="CHOOSE YOUR HERO" class="vb-title" style="font-size: 28px; letter-spacing: 4px; color: rgb(235, 225, 215);" />

            <!-- Placeholder for balance -->
            <ui:VisualElement style="width: 120px;" />

        </ui:VisualElement>

        <!-- ====================================================================
             MAIN CONTENT AREA
             ==================================================================== -->

        <ui:VisualElement name="content" style="flex-grow: 1; flex-direction: row; margin-top: 80px; margin-bottom: 100px;">

            <!-- ================================================================
                 LEFT PANEL - Hero List
                 ================================================================ -->

            <ui:VisualElement name="hero-list-panel" style="width: 280px; padding: 24px; background-color: rgba(15, 12, 22, 0.8); border-right-width: 1px; border-right-color: rgba(60, 50, 75, 0.5);">

                <ui:Label text="HEROES" class="vb-text" style="font-size: 14px; letter-spacing: 2px; color: rgb(120, 60, 160); margin-bottom: 16px;" />

                <ui:ScrollView name="hero-scroll" class="vb-scrollview" style="flex-grow: 1;">

                    <!-- Hero cards will be populated dynamically -->
                    <ui:VisualElement name="hero-list" class="vb-column" style="padding-right: 8px;">

                        <!-- Example hero card template structure -->
                        <ui:VisualElement name="hero-card-template" class="hero-card" style="display: none; margin-bottom: 8px;">
                            <ui:VisualElement class="hero-card-portrait" style="width: 60px; height: 60px; background-color: rgb(25, 20, 35); border-radius: 4px; margin-right: 12px;" />
                            <ui:VisualElement class="hero-card-info" style="flex-grow: 1;">
                                <ui:Label class="hero-card-name" text="Hero Name" style="color: rgb(235, 225, 215); font-size: 16px; -unity-font-style: bold;" />
                                <ui:VisualElement class="hero-card-brands" style="flex-direction: row; margin-top: 4px;">
                                    <ui:VisualElement class="brand-indicator" style="width: 12px; height: 12px; border-radius: 6px; margin-right: 4px;" />
                                    <ui:VisualElement class="brand-indicator" style="width: 12px; height: 12px; border-radius: 6px; margin-right: 4px;" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>

                    </ui:VisualElement>

                </ui:ScrollView>

            </ui:VisualElement>

            <!-- ================================================================
                 CENTER - 3D Preview Area
                 ================================================================ -->

            <ui:VisualElement name="preview-area" style="flex-grow: 1; justify-content: center; align-items: center;">

                <!-- 3D model will render here via RenderTexture -->
                <ui:VisualElement name="model-viewport" style="width: 400px; height: 500px; background-color: rgba(15, 12, 22, 0.5); border-radius: 8px; border-width: 1px; border-color: rgba(60, 50, 75, 0.3);">

                    <!-- Placeholder for when no hero selected -->
                    <ui:VisualElement name="placeholder" style="flex-grow: 1; justify-content: center; align-items: center;">
                        <ui:Label text="Select a Hero" style="color: rgb(75, 68, 65); font-size: 20px; letter-spacing: 2px;" />
                    </ui:VisualElement>

                    <!-- Model display (background-image will be set to RenderTexture) -->
                    <ui:VisualElement name="model-display" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; display: none;" />

                </ui:VisualElement>

                <!-- Rotate hint -->
                <ui:Label text="Drag to rotate" style="color: rgb(75, 68, 65); font-size: 12px; margin-top: 12px;" />

            </ui:VisualElement>

            <!-- ================================================================
                 RIGHT PANEL - Hero Details
                 ================================================================ -->

            <ui:VisualElement name="details-panel" style="width: 350px; padding: 24px; background-color: rgba(15, 12, 22, 0.8); border-left-width: 1px; border-left-color: rgba(60, 50, 75, 0.5);">

                <!-- Hero Name Section -->
                <ui:VisualElement name="hero-header" style="margin-bottom: 24px;">
                    <ui:Label name="hero-name" text="Select a Hero" class="vb-title" style="font-size: 28px; -unity-text-align: middle-left; margin-bottom: 8px;" />
                    <ui:Label name="hero-title" text="" style="color: rgb(120, 60, 160); font-size: 14px; letter-spacing: 1px; -unity-font-style: italic;" />
                </ui:VisualElement>

                <ui:VisualElement class="vb-divider-horizontal" style="margin-bottom: 20px;" />

                <!-- Brand Affinity Section -->
                <ui:VisualElement name="brand-section" style="margin-bottom: 24px;">
                    <ui:Label text="BRAND AFFINITY" style="color: rgb(165, 155, 145); font-size: 12px; letter-spacing: 2px; margin-bottom: 12px;" />

                    <ui:VisualElement name="brand-display" class="vb-row" style="flex-wrap: wrap;">
                        <!-- Brand indicators populated dynamically -->
                        <ui:VisualElement name="primary-brand" class="brand-badge" style="margin-right: 8px; margin-bottom: 8px;">
                            <ui:VisualElement class="brand-icon" style="width: 24px; height: 24px; border-radius: 4px; margin-right: 8px;" />
                            <ui:Label class="brand-name" text="Primary" style="color: rgb(235, 225, 215); font-size: 14px;" />
                        </ui:VisualElement>
                        <ui:VisualElement name="secondary-brand" class="brand-badge" style="margin-bottom: 8px;">
                            <ui:VisualElement class="brand-icon" style="width: 24px; height: 24px; border-radius: 4px; margin-right: 8px;" />
                            <ui:Label class="brand-name" text="Secondary" style="color: rgb(235, 225, 215); font-size: 14px;" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Stats Section -->
                <ui:VisualElement name="stats-section" style="margin-bottom: 24px;">
                    <ui:Label text="BASE STATS" style="color: rgb(165, 155, 145); font-size: 12px; letter-spacing: 2px; margin-bottom: 12px;" />

                    <ui:VisualElement name="stats-container" class="vb-column">
                        <!-- Health -->
                        <ui:VisualElement class="stat-row vb-row" style="margin-bottom: 8px;">
                            <ui:Label text="Health" style="color: rgb(165, 155, 145); width: 80px; font-size: 14px;" />
                            <ui:VisualElement class="stat-bar-bg" style="flex-grow: 1; height: 8px; background-color: rgb(25, 20, 35); border-radius: 4px; overflow: hidden;">
                                <ui:VisualElement name="stat-health-fill" class="stat-bar-fill" style="width: 60%; height: 100%; background-color: rgb(180, 50, 50); border-radius: 4px;" />
                            </ui:VisualElement>
                            <ui:Label name="stat-health-value" text="100" style="color: rgb(235, 225, 215); width: 40px; -unity-text-align: middle-right; font-size: 14px;" />
                        </ui:VisualElement>

                        <!-- Attack -->
                        <ui:VisualElement class="stat-row vb-row" style="margin-bottom: 8px;">
                            <ui:Label text="Attack" style="color: rgb(165, 155, 145); width: 80px; font-size: 14px;" />
                            <ui:VisualElement class="stat-bar-bg" style="flex-grow: 1; height: 8px; background-color: rgb(25, 20, 35); border-radius: 4px; overflow: hidden;">
                                <ui:VisualElement name="stat-attack-fill" class="stat-bar-fill" style="width: 50%; height: 100%; background-color: rgb(220, 120, 40); border-radius: 4px;" />
                            </ui:VisualElement>
                            <ui:Label name="stat-attack-value" text="50" style="color: rgb(235, 225, 215); width: 40px; -unity-text-align: middle-right; font-size: 14px;" />
                        </ui:VisualElement>

                        <!-- Defense -->
                        <ui:VisualElement class="stat-row vb-row" style="margin-bottom: 8px;">
                            <ui:Label text="Defense" style="color: rgb(165, 155, 145); width: 80px; font-size: 14px;" />
                            <ui:VisualElement class="stat-bar-bg" style="flex-grow: 1; height: 8px; background-color: rgb(25, 20, 35); border-radius: 4px; overflow: hidden;">
                                <ui:VisualElement name="stat-defense-fill" class="stat-bar-fill" style="width: 45%; height: 100%; background-color: rgb(140, 150, 165); border-radius: 4px;" />
                            </ui:VisualElement>
                            <ui:Label name="stat-defense-value" text="45" style="color: rgb(235, 225, 215); width: 40px; -unity-text-align: middle-right; font-size: 14px;" />
                        </ui:VisualElement>

                        <!-- Speed -->
                        <ui:VisualElement class="stat-row vb-row" style="margin-bottom: 8px;">
                            <ui:Label text="Speed" style="color: rgb(165, 155, 145); width: 80px; font-size: 14px;" />
                            <ui:VisualElement class="stat-bar-bg" style="flex-grow: 1; height: 8px; background-color: rgb(25, 20, 35); border-radius: 4px; overflow: hidden;">
                                <ui:VisualElement name="stat-speed-fill" class="stat-bar-fill" style="width: 70%; height: 100%; background-color: rgb(60, 140, 220); border-radius: 4px;" />
                            </ui:VisualElement>
                            <ui:Label name="stat-speed-value" text="70" style="color: rgb(235, 225, 215); width: 40px; -unity-text-align: middle-right; font-size: 14px;" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Abilities Preview -->
                <ui:VisualElement name="abilities-section" style="flex-grow: 1;">
                    <ui:Label text="STARTING ABILITIES" style="color: rgb(165, 155, 145); font-size: 12px; letter-spacing: 2px; margin-bottom: 12px;" />

                    <ui:VisualElement name="abilities-list" class="vb-column">
                        <!-- Ability 1 -->
                        <ui:VisualElement name="ability-1" class="ability-card vb-card" style="margin-bottom: 8px;">
                            <ui:VisualElement class="ability-icon" style="width: 40px; height: 40px; background-color: rgb(40, 32, 50); border-radius: 4px; margin-right: 12px;" />
                            <ui:VisualElement style="flex-grow: 1;">
                                <ui:Label class="ability-name" text="Ability Name" style="color: rgb(235, 225, 215); font-size: 14px; -unity-font-style: bold; margin-bottom: 2px;" />
                                <ui:Label class="ability-desc" text="Description goes here" style="color: rgb(165, 155, 145); font-size: 12px;" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <!-- Ability 2 -->
                        <ui:VisualElement name="ability-2" class="ability-card vb-card" style="margin-bottom: 8px;">
                            <ui:VisualElement class="ability-icon" style="width: 40px; height: 40px; background-color: rgb(40, 32, 50); border-radius: 4px; margin-right: 12px;" />
                            <ui:VisualElement style="flex-grow: 1;">
                                <ui:Label class="ability-name" text="Ability Name" style="color: rgb(235, 225, 215); font-size: 14px; -unity-font-style: bold; margin-bottom: 2px;" />
                                <ui:Label class="ability-desc" text="Description goes here" style="color: rgb(165, 155, 145); font-size: 12px;" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <!-- Ability 3 -->
                        <ui:VisualElement name="ability-3" class="ability-card vb-card">
                            <ui:VisualElement class="ability-icon" style="width: 40px; height: 40px; background-color: rgb(40, 32, 50); border-radius: 4px; margin-right: 12px;" />
                            <ui:VisualElement style="flex-grow: 1;">
                                <ui:Label class="ability-name" text="Ability Name" style="color: rgb(235, 225, 215); font-size: 14px; -unity-font-style: bold; margin-bottom: 2px;" />
                                <ui:Label class="ability-desc" text="Description goes here" style="color: rgb(165, 155, 145); font-size: 12px;" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

            </ui:VisualElement>

        </ui:VisualElement>

        <!-- ====================================================================
             FOOTER - Action Buttons
             ==================================================================== -->

        <ui:VisualElement name="footer" style="position: absolute; left: 0; right: 0; bottom: 0; height: 100px; flex-direction: row; justify-content: center; align-items: center; padding: 0 40px; background-color: rgba(0, 0, 0, 0.6);">

            <ui:Button text="SELECT HERO" name="btn-select" class="vb-button vb-button-primary vb-button-large" style="min-width: 250px;" />

        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
