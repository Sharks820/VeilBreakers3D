<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Styles/VeilBreakers.uss?fileID=7433441132597879392&amp;guid=f14e48b4bc52a9f4586f9c621c434598&amp;type=3" />
    <Style src="project://database/Assets/UI/Styles/VeilBreakersTheme.uss?fileID=7433441132597879392&amp;guid=0c75776285827f74db8942ace412c502&amp;type=3" />

    <ui:VisualElement name="charset-root" class="vb-root" style="flex-grow: 1;">

        <!-- ====================================================================
             BACKGROUND LAYERS
             ==================================================================== -->

        <ui:VisualElement name="bg-void" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgb(3, 2, 5);" />

        <!-- Veil ambient glow -->
        <ui:VisualElement name="bg-ambient" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0;">
            <ui:VisualElement style="position: absolute; left: 0; top: 0; right: 0; height: 50%; background-color: rgba(80, 40, 120, 0.04);" />
            <ui:VisualElement style="position: absolute; left: 0; bottom: 0; right: 0; height: 60%; background-color: rgba(40, 0, 80, 0.06);" />
        </ui:VisualElement>

        <!-- Particle container -->
        <ui:VisualElement name="particle-container" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; overflow: hidden;" />

        <!-- ====================================================================
             HEADER
             ==================================================================== -->

        <ui:VisualElement name="header" style="position: absolute; left: 0; top: 0; right: 0; height: 80px; flex-direction: row; justify-content: space-between; align-items: center; padding: 0 40px; background-color: rgba(0, 0, 0, 0.6); border-bottom-width: 1px; border-bottom-color: rgba(130, 70, 180, 0.2);">

            <!-- Back Button -->
            <ui:Button text="BACK" name="btn-back" class="btn-tertiary" style="width: 120px; min-height: 40px;" />

            <!-- Title -->
            <ui:VisualElement style="flex-direction: row; align-items: center;">
                <ui:VisualElement style="width: 40px; height: 1px; background-color: rgba(130, 70, 180, 0.4); margin-right: 16px;" />
                <ui:Label text="CHOOSE YOUR HERO" class="title-section" style="font-size: 24px;" />
                <ui:VisualElement style="width: 40px; height: 1px; background-color: rgba(130, 70, 180, 0.4); margin-left: 16px;" />
            </ui:VisualElement>

            <!-- Placeholder for symmetry -->
            <ui:VisualElement style="width: 120px;" />

        </ui:VisualElement>

        <!-- ====================================================================
             MAIN CONTENT AREA
             ==================================================================== -->

        <ui:VisualElement name="content" style="flex-grow: 1; flex-direction: row; margin-top: 80px; margin-bottom: 100px; padding: 20px;">

            <!-- ================================================================
                 LEFT PANEL - Hero List
                 ================================================================ -->

            <ui:VisualElement name="hero-list-panel" style="width: 260px; padding: 20px; background-color: rgba(12, 9, 18, 0.9); border-width: 1px; border-color: rgba(75, 60, 100, 0.4); border-radius: 12px; margin-right: 20px;">

                <!-- Section Header -->
                <ui:VisualElement style="flex-direction: row; align-items: center; margin-bottom: 16px;">
                    <ui:VisualElement style="width: 4px; height: 16px; background-color: rgb(130, 70, 180); border-radius: 2px; margin-right: 10px;" />
                    <ui:Label text="HEROES" style="font-size: 13px; letter-spacing: 2px; color: rgb(130, 70, 180); -unity-font-style: bold;" />
                </ui:VisualElement>

                <!-- Hero List Scroll -->
                <ui:ScrollView name="hero-scroll" class="scrollview" style="flex-grow: 1;">
                    <ui:VisualElement name="hero-list" style="padding-right: 8px;">
                        <!-- Hero cards populated dynamically -->
                    </ui:VisualElement>
                </ui:ScrollView>

            </ui:VisualElement>

            <!-- ================================================================
                 CENTER - Hero Preview & 3D Model
                 ================================================================ -->

            <ui:VisualElement name="center-panel" style="flex-grow: 1; align-items: center; justify-content: center; margin: 0 20px;">

                <!-- 3D Model Viewport -->
                <ui:VisualElement name="model-viewport" style="width: 380px; height: 480px; background-color: rgba(12, 9, 18, 0.8); border-width: 2px; border-color: rgba(130, 70, 180, 0.3); border-radius: 16px; align-items: center; justify-content: center; overflow: hidden;">

                    <!-- Decorative corner accents -->
                    <ui:VisualElement style="position: absolute; left: -1px; top: -1px; width: 30px; height: 30px; border-top-width: 2px; border-left-width: 2px; border-color: rgb(130, 70, 180); border-top-left-radius: 16px;" />
                    <ui:VisualElement style="position: absolute; right: -1px; top: -1px; width: 30px; height: 30px; border-top-width: 2px; border-right-width: 2px; border-color: rgb(130, 70, 180); border-top-right-radius: 16px;" />
                    <ui:VisualElement style="position: absolute; left: -1px; bottom: -1px; width: 30px; height: 30px; border-bottom-width: 2px; border-left-width: 2px; border-color: rgb(130, 70, 180); border-bottom-left-radius: 16px;" />
                    <ui:VisualElement style="position: absolute; right: -1px; bottom: -1px; width: 30px; height: 30px; border-bottom-width: 2px; border-right-width: 2px; border-color: rgb(130, 70, 180); border-bottom-right-radius: 16px;" />

                    <!-- Placeholder when no hero selected -->
                    <ui:VisualElement name="placeholder" style="align-items: center; justify-content: center;">
                        <ui:VisualElement style="width: 80px; height: 80px; border-radius: 50%; border-width: 2px; border-color: rgba(130, 70, 180, 0.3); margin-bottom: 16px; align-items: center; justify-content: center;">
                            <ui:Label text="?" style="font-size: 36px; color: rgba(130, 70, 180, 0.5);" />
                        </ui:VisualElement>
                        <ui:Label text="Select a Hero" style="font-size: 18px; color: rgb(95, 85, 80); letter-spacing: 2px;" />
                    </ui:VisualElement>

                    <!-- Model display (RenderTexture target) -->
                    <ui:VisualElement name="model-display" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; display: none;" />

                </ui:VisualElement>

                <!-- Rotate Hint -->
                <ui:Label text="Drag to rotate" style="margin-top: 12px; font-size: 12px; color: rgb(75, 68, 65); letter-spacing: 1px;" />

            </ui:VisualElement>

            <!-- ================================================================
                 RIGHT PANEL - Hero Details & Signature Monster
                 ================================================================ -->

            <ui:VisualElement name="details-panel" style="width: 340px; padding: 20px; background-color: rgba(12, 9, 18, 0.9); border-width: 1px; border-color: rgba(75, 60, 100, 0.4); border-radius: 12px;">

                <ui:ScrollView class="scrollview" style="flex-grow: 1;">

                    <!-- Hero Name & Title -->
                    <ui:VisualElement name="hero-header" style="margin-bottom: 20px;">
                        <ui:Label name="hero-name" text="Select a Hero" style="font-size: 26px; color: rgb(240, 235, 225); -unity-font-style: bold; letter-spacing: 1px; margin-bottom: 6px;" />
                        <ui:Label name="hero-title" text="" style="font-size: 13px; color: rgb(130, 70, 180); letter-spacing: 1px; -unity-font-style: italic;" />
                    </ui:VisualElement>

                    <!-- Divider -->
                    <ui:VisualElement style="height: 1px; background-color: rgba(75, 60, 100, 0.5); margin-bottom: 20px;" />

                    <!-- Path Badge -->
                    <ui:VisualElement name="path-section" style="margin-bottom: 20px;">
                        <ui:Label text="PATH" style="font-size: 11px; letter-spacing: 2px; color: rgb(95, 85, 80); margin-bottom: 10px;" />
                        <ui:VisualElement name="path-badge" class="path-badge path-badge-voidtouched" style="align-self: flex-start;">
                            <ui:VisualElement name="path-icon" class="path-icon" style="background-color: rgb(130, 70, 180);" />
                            <ui:Label name="path-name" text="VOIDTOUCHED" class="path-name" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- Brand Affinity -->
                    <ui:VisualElement name="brand-section" style="margin-bottom: 20px;">
                        <ui:Label text="BRAND AFFINITY" style="font-size: 11px; letter-spacing: 2px; color: rgb(95, 85, 80); margin-bottom: 10px;" />
                        <ui:VisualElement name="brand-display" style="flex-direction: row; flex-wrap: wrap;">
                            <ui:VisualElement name="primary-brand" class="brand-badge">
                                <ui:VisualElement class="brand-dot" style="background-color: rgb(130, 70, 180);" />
                                <ui:Label class="brand-name" text="DREAD" />
                            </ui:VisualElement>
                            <ui:VisualElement name="secondary-brand" class="brand-badge">
                                <ui:VisualElement class="brand-dot" style="background-color: rgb(60, 20, 80);" />
                                <ui:Label class="brand-name" text="VOID" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- Stats Section -->
                    <ui:VisualElement name="stats-section" style="margin-bottom: 24px;">
                        <ui:Label text="BASE STATS" style="font-size: 11px; letter-spacing: 2px; color: rgb(95, 85, 80); margin-bottom: 12px;" />

                        <ui:VisualElement name="stats-container">
                            <!-- Health -->
                            <ui:VisualElement style="flex-direction: row; align-items: center; margin-bottom: 10px;">
                                <ui:Label text="Health" style="width: 65px; font-size: 13px; color: rgb(145, 135, 125);" />
                                <ui:VisualElement class="bar-container" style="flex-grow: 1; margin: 0 12px;">
                                    <ui:VisualElement name="stat-health-fill" class="bar-fill bar-health" style="width: 60%;" />
                                </ui:VisualElement>
                                <ui:Label name="stat-health-value" text="100" style="width: 35px; font-size: 13px; color: rgb(215, 205, 195); -unity-text-align: middle-right;" />
                            </ui:VisualElement>

                            <!-- Attack -->
                            <ui:VisualElement style="flex-direction: row; align-items: center; margin-bottom: 10px;">
                                <ui:Label text="Attack" style="width: 65px; font-size: 13px; color: rgb(145, 135, 125);" />
                                <ui:VisualElement class="bar-container" style="flex-grow: 1; margin: 0 12px;">
                                    <ui:VisualElement name="stat-attack-fill" class="bar-fill bar-attack" style="width: 50%;" />
                                </ui:VisualElement>
                                <ui:Label name="stat-attack-value" text="50" style="width: 35px; font-size: 13px; color: rgb(215, 205, 195); -unity-text-align: middle-right;" />
                            </ui:VisualElement>

                            <!-- Defense -->
                            <ui:VisualElement style="flex-direction: row; align-items: center; margin-bottom: 10px;">
                                <ui:Label text="Defense" style="width: 65px; font-size: 13px; color: rgb(145, 135, 125);" />
                                <ui:VisualElement class="bar-container" style="flex-grow: 1; margin: 0 12px;">
                                    <ui:VisualElement name="stat-defense-fill" class="bar-fill bar-defense" style="width: 45%;" />
                                </ui:VisualElement>
                                <ui:Label name="stat-defense-value" text="45" style="width: 35px; font-size: 13px; color: rgb(215, 205, 195); -unity-text-align: middle-right;" />
                            </ui:VisualElement>

                            <!-- Speed -->
                            <ui:VisualElement style="flex-direction: row; align-items: center;">
                                <ui:Label text="Speed" style="width: 65px; font-size: 13px; color: rgb(145, 135, 125);" />
                                <ui:VisualElement class="bar-container" style="flex-grow: 1; margin: 0 12px;">
                                    <ui:VisualElement name="stat-speed-fill" class="bar-fill bar-speed" style="width: 70%;" />
                                </ui:VisualElement>
                                <ui:Label name="stat-speed-value" text="70" style="width: 35px; font-size: 13px; color: rgb(215, 205, 195); -unity-text-align: middle-right;" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- Divider -->
                    <ui:VisualElement style="height: 1px; background-color: rgba(75, 60, 100, 0.5); margin-bottom: 20px;" />

                    <!-- ============================================================
                         SIGNATURE MONSTER SECTION - NEW!
                         ============================================================ -->

                    <ui:VisualElement name="signature-monster-section" style="margin-bottom: 24px;">
                        <ui:VisualElement style="flex-direction: row; align-items: center; margin-bottom: 14px;">
                            <ui:VisualElement style="width: 4px; height: 16px; background-color: rgb(60, 180, 160); border-radius: 2px; margin-right: 10px;" />
                            <ui:Label text="SIGNATURE MONSTER" style="font-size: 11px; letter-spacing: 2px; color: rgb(60, 180, 160); -unity-font-style: bold;" />
                        </ui:VisualElement>

                        <!-- Monster Card -->
                        <ui:VisualElement name="signature-monster-card" class="monster-card" style="width: 100%; flex-direction: row; padding: 14px;">

                            <!-- Monster Portrait -->
                            <ui:VisualElement name="monster-portrait" class="monster-portrait" style="width: 70px; height: 70px; margin-right: 14px; flex-shrink: 0;" />

                            <!-- Monster Info -->
                            <ui:VisualElement style="flex-grow: 1;">
                                <ui:Label name="monster-name" text="Shadow Hound" style="font-size: 15px; color: rgb(240, 235, 225); -unity-font-style: bold; margin-bottom: 4px;" />
                                <ui:Label name="monster-type" text="Beast - Stalker" style="font-size: 12px; color: rgb(145, 135, 125); margin-bottom: 8px;" />

                                <!-- Monster Brands -->
                                <ui:VisualElement style="flex-direction: row; margin-bottom: 8px;">
                                    <ui:VisualElement name="monster-brand-1" class="brand-dot" style="background-color: rgb(120, 60, 160); width: 12px; height: 12px; margin-right: 6px;" />
                                    <ui:VisualElement name="monster-brand-2" class="brand-dot" style="background-color: rgb(60, 20, 80); width: 12px; height: 12px;" />
                                </ui:VisualElement>

                                <!-- Synergy Indicator -->
                                <ui:VisualElement name="synergy-indicator" class="synergy-indicator" style="align-self: flex-start; padding: 4px 10px;">
                                    <ui:VisualElement class="synergy-icon" style="width: 12px; height: 12px; margin-right: 6px;" />
                                    <ui:Label text="PATH SYNERGY" class="synergy-text" style="font-size: 10px;" />
                                </ui:VisualElement>
                            </ui:VisualElement>

                        </ui:VisualElement>

                        <!-- Monster Ability Preview -->
                        <ui:VisualElement name="monster-ability" style="margin-top: 12px; padding: 10px 12px; background-color: rgba(25, 20, 35, 0.8); border-radius: 6px; border-width: 1px; border-color: rgba(60, 50, 75, 0.5);">
                            <ui:Label text="SIGNATURE ABILITY" style="font-size: 10px; letter-spacing: 1px; color: rgb(95, 85, 80); margin-bottom: 6px;" />
                            <ui:Label name="monster-ability-name" text="Shadow Stalk" style="font-size: 14px; color: rgb(215, 205, 195); -unity-font-style: bold; margin-bottom: 4px;" />
                            <ui:Label name="monster-ability-desc" text="Vanish into shadows, then strike from behind dealing bonus damage." style="font-size: 12px; color: rgb(145, 135, 125); white-space: normal;" />
                        </ui:VisualElement>

                    </ui:VisualElement>

                    <!-- Divider -->
                    <ui:VisualElement style="height: 1px; background-color: rgba(75, 60, 100, 0.5); margin-bottom: 20px;" />

                    <!-- Innate Ability -->
                    <ui:VisualElement name="innate-ability-section">
                        <ui:Label text="HERO INNATE ABILITY" style="font-size: 11px; letter-spacing: 2px; color: rgb(95, 85, 80); margin-bottom: 12px;" />

                        <ui:VisualElement name="innate-ability" class="ability-card">
                            <ui:VisualElement class="ability-icon" style="background-color: rgb(45, 36, 62);" />
                            <ui:VisualElement style="flex-grow: 1;">
                                <ui:Label name="innate-ability-name" class="ability-name" text="Void Sight" />
                                <ui:Label name="innate-ability-desc" class="ability-desc" text="See hidden enemies and weak points." style="white-space: normal;" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>

                </ui:ScrollView>

            </ui:VisualElement>

        </ui:VisualElement>

        <!-- ====================================================================
             FOOTER - Action Buttons
             ==================================================================== -->

        <ui:VisualElement name="footer" style="position: absolute; left: 0; right: 0; bottom: 0; height: 100px; flex-direction: row; justify-content: center; align-items: center; background-color: rgba(0, 0, 0, 0.7); border-top-width: 1px; border-top-color: rgba(130, 70, 180, 0.2);">

            <!-- Hero Summary (when selected) -->
            <ui:VisualElement name="hero-summary" style="flex-direction: row; align-items: center; margin-right: 40px; display: none;">
                <ui:VisualElement name="summary-portrait" style="width: 50px; height: 50px; background-color: rgba(45, 36, 62, 0.8); border-radius: 8px; border-width: 2px; border-color: rgba(130, 70, 180, 0.5); margin-right: 16px;" />
                <ui:VisualElement>
                    <ui:Label name="summary-name" text="Hero Name" style="font-size: 16px; color: rgb(240, 235, 225); -unity-font-style: bold;" />
                    <ui:Label name="summary-path" text="VOIDTOUCHED" style="font-size: 11px; color: rgb(130, 70, 180); letter-spacing: 1px;" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Select Button -->
            <ui:Button text="BEGIN ADVENTURE" name="btn-select" class="btn-primary" style="min-width: 280px; min-height: 56px; font-size: 18px;" />

        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
