<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Styles/VeilBreakers.uss?fileID=7433441132597879392&amp;guid=f14e48b4bc52a9f4586f9c621c434598&amp;type=3" />
    <Style src="project://database/Assets/UI/Styles/VeilBreakersTheme.uss?fileID=7433441132597879392&amp;guid=0c75776285827f74db8942ace412c502&amp;type=3" />

    <ui:VisualElement name="charset-root" class="vb-root" style="flex-grow: 1;">

        <!-- Background -->
        <ui:VisualElement name="bg" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgb(8, 6, 12);" />

        <!-- Header Bar -->
        <ui:VisualElement name="header" style="position: absolute; left: 0; top: 0; right: 0; height: 70px; flex-direction: row; justify-content: space-between; align-items: center; padding: 0 30px; background-color: rgba(0, 0, 0, 0.7); border-bottom-width: 1px; border-bottom-color: rgba(130, 70, 180, 0.3);">
            <ui:Button text="BACK" name="btn-back" style="width: 100px; height: 36px; font-size: 12px; letter-spacing: 1px; -unity-text-align: middle-center; background-color: transparent; border-color: rgba(130, 70, 180, 0.4); border-width: 1px; border-radius: 4px; color: rgb(140, 130, 120);" />
            <ui:Label text="CHOOSE YOUR HERO" style="font-size: 20px; letter-spacing: 4px; color: rgb(200, 190, 180); -unity-font-style: bold;" />
            <ui:VisualElement style="width: 100px;" />
        </ui:VisualElement>

        <!-- Main Content -->
        <ui:VisualElement name="content" style="flex-grow: 1; flex-direction: row; margin-top: 70px; margin-bottom: 90px; padding: 20px;">

            <!-- Left Panel - Hero List -->
            <ui:VisualElement name="hero-list-panel" style="width: 240px; padding: 16px; background-color: rgba(12, 9, 18, 0.9); border-width: 1px; border-color: rgba(80, 60, 100, 0.4); border-radius: 10px; margin-right: 16px;">
                <ui:Label text="HEROES" style="font-size: 12px; letter-spacing: 2px; color: rgb(130, 70, 180); margin-bottom: 14px; -unity-font-style: bold;" />
                <ui:ScrollView name="hero-scroll" style="flex-grow: 1;">
                    <ui:VisualElement name="hero-list" />
                </ui:ScrollView>
            </ui:VisualElement>

            <!-- Center - Hero Preview -->
            <ui:VisualElement name="center-panel" style="flex-grow: 1; align-items: center; justify-content: center;">
                <ui:VisualElement name="model-viewport" style="width: 360px; height: 450px; background-color: rgba(12, 9, 18, 0.85); border-width: 2px; border-color: rgba(130, 70, 180, 0.4); border-radius: 12px; align-items: center; justify-content: center;">
                    <ui:VisualElement style="width: 70px; height: 70px; border-radius: 35px; border-width: 2px; border-color: rgba(130, 70, 180, 0.3); align-items: center; justify-content: center; margin-bottom: 12px;">
                        <ui:Label text="?" style="font-size: 32px; color: rgba(130, 70, 180, 0.5);" />
                    </ui:VisualElement>
                    <ui:Label text="Select a Hero" style="font-size: 16px; color: rgb(90, 80, 75); letter-spacing: 2px;" />
                </ui:VisualElement>
                <ui:Label text="Drag to rotate" style="margin-top: 10px; font-size: 11px; color: rgb(70, 65, 60);" />
            </ui:VisualElement>

            <!-- Right Panel - Hero Details -->
            <ui:VisualElement name="details-panel" style="width: 320px; padding: 16px; background-color: rgba(12, 9, 18, 0.9); border-width: 1px; border-color: rgba(80, 60, 100, 0.4); border-radius: 10px; margin-left: 16px; overflow: hidden;">
                <ui:ScrollView style="flex-grow: 1;" mode="Vertical" vertical-scroller-visibility="AlwaysVisible" mouse-wheel-scroll-size="80">
                    <ui:VisualElement name="details-content" style="flex-direction: column; width: 100%; padding-right: 8px;">

                    <!-- Hero Name -->
                    <ui:Label name="hero-name" text="Select a Hero" style="font-size: 24px; color: rgb(235, 225, 215); -unity-font-style: bold; margin-bottom: 4px; flex-shrink: 0;" />
                    <ui:Label name="hero-title" text="" style="font-size: 12px; color: rgb(130, 70, 180); letter-spacing: 1px; margin-bottom: 16px; flex-shrink: 0;" />

                    <ui:VisualElement style="height: 1px; background-color: rgba(80, 60, 100, 0.4); margin-bottom: 16px;" />

                    <!-- Path Section -->
                    <ui:Label text="PATH" style="font-size: 10px; letter-spacing: 2px; color: rgb(90, 80, 75); margin-bottom: 8px; flex-shrink: 0;" />
                    <ui:VisualElement name="path-badge" style="flex-direction: row; align-items: center; align-self: flex-start; padding: 6px 12px; background-color: rgba(100, 60, 160, 0.2); border-width: 1px; border-color: rgba(130, 70, 180, 0.5); border-radius: 4px; margin-bottom: 16px; flex-shrink: 0;">
                        <ui:VisualElement style="width: 8px; height: 8px; border-radius: 4px; background-color: rgb(130, 70, 180); margin-right: 8px;" />
                        <ui:Label name="path-name" text="VOIDTOUCHED" style="font-size: 11px; letter-spacing: 1px; color: rgb(180, 140, 200);" />
                    </ui:VisualElement>

                    <!-- Brand Affinity -->
                    <ui:Label text="BRAND AFFINITY" style="font-size: 10px; letter-spacing: 2px; color: rgb(90, 80, 75); margin-bottom: 8px; flex-shrink: 0;" />
                    <ui:VisualElement name="brand-display" style="flex-direction: row; margin-bottom: 16px; flex-shrink: 0;">
                        <ui:VisualElement style="flex-direction: row; align-items: center; padding: 4px 10px; background-color: rgba(40, 32, 55, 0.6); border-radius: 4px; margin-right: 8px;">
                            <ui:VisualElement style="width: 10px; height: 10px; border-radius: 5px; background-color: rgb(130, 70, 180); margin-right: 6px;" />
                            <ui:Label text="DREAD" style="font-size: 11px; color: rgb(165, 155, 145);" />
                        </ui:VisualElement>
                        <ui:VisualElement style="flex-direction: row; align-items: center; padding: 4px 10px; background-color: rgba(40, 32, 55, 0.6); border-radius: 4px;">
                            <ui:VisualElement style="width: 10px; height: 10px; border-radius: 5px; background-color: rgb(60, 30, 80); margin-right: 6px;" />
                            <ui:Label text="VOID" style="font-size: 11px; color: rgb(165, 155, 145);" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- Stats -->
                    <ui:Label text="BASE STATS" style="font-size: 10px; letter-spacing: 2px; color: rgb(90, 80, 75); margin-bottom: 10px; flex-shrink: 0;" />
                    <ui:VisualElement name="stats-container" style="margin-bottom: 16px; flex-shrink: 0;">
                        <!-- Health -->
                        <ui:VisualElement style="flex-direction: row; align-items: center; margin-bottom: 8px;">
                            <ui:Label text="Health" style="width: 60px; font-size: 12px; color: rgb(140, 130, 120);" />
                            <ui:VisualElement style="flex-grow: 1; height: 6px; background-color: rgba(30, 25, 40, 0.8); border-radius: 3px; margin: 0 10px; overflow: hidden;">
                                <ui:VisualElement name="stat-health-fill" style="width: 60%; height: 100%; background-color: rgb(180, 60, 80); border-radius: 3px;" />
                            </ui:VisualElement>
                            <ui:Label name="stat-health-value" text="100" style="width: 30px; font-size: 12px; color: rgb(200, 190, 180); -unity-text-align: middle-right;" />
                        </ui:VisualElement>
                        <!-- Attack -->
                        <ui:VisualElement style="flex-direction: row; align-items: center; margin-bottom: 8px;">
                            <ui:Label text="Attack" style="width: 60px; font-size: 12px; color: rgb(140, 130, 120);" />
                            <ui:VisualElement style="flex-grow: 1; height: 6px; background-color: rgba(30, 25, 40, 0.8); border-radius: 3px; margin: 0 10px; overflow: hidden;">
                                <ui:VisualElement name="stat-attack-fill" style="width: 50%; height: 100%; background-color: rgb(200, 120, 60); border-radius: 3px;" />
                            </ui:VisualElement>
                            <ui:Label name="stat-attack-value" text="50" style="width: 30px; font-size: 12px; color: rgb(200, 190, 180); -unity-text-align: middle-right;" />
                        </ui:VisualElement>
                        <!-- Defense -->
                        <ui:VisualElement style="flex-direction: row; align-items: center; margin-bottom: 8px;">
                            <ui:Label text="Defense" style="width: 60px; font-size: 12px; color: rgb(140, 130, 120);" />
                            <ui:VisualElement style="flex-grow: 1; height: 6px; background-color: rgba(30, 25, 40, 0.8); border-radius: 3px; margin: 0 10px; overflow: hidden;">
                                <ui:VisualElement name="stat-defense-fill" style="width: 45%; height: 100%; background-color: rgb(80, 140, 180); border-radius: 3px;" />
                            </ui:VisualElement>
                            <ui:Label name="stat-defense-value" text="45" style="width: 30px; font-size: 12px; color: rgb(200, 190, 180); -unity-text-align: middle-right;" />
                        </ui:VisualElement>
                        <!-- Speed -->
                        <ui:VisualElement style="flex-direction: row; align-items: center;">
                            <ui:Label text="Speed" style="width: 60px; font-size: 12px; color: rgb(140, 130, 120);" />
                            <ui:VisualElement style="flex-grow: 1; height: 6px; background-color: rgba(30, 25, 40, 0.8); border-radius: 3px; margin: 0 10px; overflow: hidden;">
                                <ui:VisualElement name="stat-speed-fill" style="width: 70%; height: 100%; background-color: rgb(100, 180, 120); border-radius: 3px;" />
                            </ui:VisualElement>
                            <ui:Label name="stat-speed-value" text="70" style="width: 30px; font-size: 12px; color: rgb(200, 190, 180); -unity-text-align: middle-right;" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement style="height: 1px; background-color: rgba(80, 60, 100, 0.4); margin-bottom: 16px;" />

                    <!-- Signature Monster Section -->
                    <ui:VisualElement style="flex-direction: row; align-items: center; margin-bottom: 12px;">
                        <ui:VisualElement style="width: 4px; height: 14px; background-color: rgb(60, 180, 160); border-radius: 2px; margin-right: 8px;" />
                        <ui:Label text="SIGNATURE MONSTER" style="font-size: 10px; letter-spacing: 2px; color: rgb(60, 180, 160); -unity-font-style: bold;" />
                    </ui:VisualElement>

                    <ui:VisualElement name="signature-monster-card" style="flex-direction: row; padding: 12px; background-color: rgba(25, 20, 35, 0.8); border-width: 1px; border-color: rgba(60, 180, 160, 0.3); border-radius: 8px; margin-bottom: 12px; flex-shrink: 0;">
                        <!-- Monster Portrait -->
                        <ui:VisualElement name="monster-portrait" style="width: 60px; height: 60px; background-color: rgba(40, 35, 55, 0.8); border-radius: 6px; margin-right: 12px; align-items: center; justify-content: center; flex-shrink: 0;">
                            <ui:Label text="M" style="font-size: 24px; color: rgba(130, 70, 180, 0.5);" />
                        </ui:VisualElement>
                        <!-- Monster Info -->
                        <ui:VisualElement style="flex-grow: 1;">
                            <ui:Label name="monster-name" text="Shadow Hound" style="font-size: 14px; color: rgb(230, 220, 210); -unity-font-style: bold; margin-bottom: 2px;" />
                            <ui:Label name="monster-type" text="Beast - Stalker" style="font-size: 11px; color: rgb(130, 120, 110); margin-bottom: 6px;" />
                            <ui:VisualElement style="flex-direction: row; margin-bottom: 6px;">
                                <ui:VisualElement style="width: 10px; height: 10px; border-radius: 5px; background-color: rgb(120, 60, 160); margin-right: 4px;" />
                                <ui:VisualElement style="width: 10px; height: 10px; border-radius: 5px; background-color: rgb(60, 20, 80);" />
                            </ui:VisualElement>
                            <ui:VisualElement style="flex-direction: row; align-items: center; padding: 3px 8px; background-color: rgba(60, 180, 160, 0.15); border-radius: 3px; align-self: flex-start;">
                                <ui:Label text="PATH SYNERGY" style="font-size: 9px; letter-spacing: 1px; color: rgb(80, 200, 180);" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- Monster Ability -->
                    <ui:VisualElement name="monster-ability" style="padding: 10px; background-color: rgba(30, 25, 40, 0.7); border-radius: 6px; margin-bottom: 16px; flex-shrink: 0;">
                        <ui:Label text="SIGNATURE ABILITY" style="font-size: 9px; letter-spacing: 1px; color: rgb(90, 80, 75); margin-bottom: 4px;" />
                        <ui:Label name="monster-ability-name" text="Shadow Stalk" style="font-size: 13px; color: rgb(200, 190, 180); -unity-font-style: bold; margin-bottom: 3px;" />
                        <ui:Label name="monster-ability-desc" text="Vanish into shadows, then strike from behind dealing bonus damage." style="font-size: 11px; color: rgb(130, 120, 110); white-space: normal;" />
                    </ui:VisualElement>

                    <ui:VisualElement style="height: 1px; background-color: rgba(80, 60, 100, 0.4); margin-bottom: 16px;" />

                    <!-- Hero Innate Ability -->
                    <ui:Label text="HERO INNATE ABILITY" style="font-size: 10px; letter-spacing: 2px; color: rgb(90, 80, 75); margin-bottom: 10px;" />
                    <ui:VisualElement name="innate-ability" style="flex-direction: row; padding: 10px; background-color: rgba(30, 25, 40, 0.7); border-radius: 6px; flex-shrink: 0;">
                        <ui:VisualElement style="width: 36px; height: 36px; background-color: rgba(45, 36, 62, 0.8); border-radius: 6px; margin-right: 10px; flex-shrink: 0;" />
                        <ui:VisualElement style="flex-grow: 1;">
                            <ui:Label name="innate-ability-name" text="Void Sight" style="font-size: 13px; color: rgb(200, 190, 180); -unity-font-style: bold; margin-bottom: 2px;" />
                            <ui:Label name="innate-ability-desc" text="See hidden enemies and weak points." style="font-size: 11px; color: rgb(130, 120, 110); white-space: normal;" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    </ui:VisualElement>
                </ui:ScrollView>
            </ui:VisualElement>

        </ui:VisualElement>

        <!-- Footer - Centered Button -->
        <ui:VisualElement name="footer" style="position: absolute; left: 276px; right: 356px; bottom: 0; height: 90px; justify-content: center; align-items: center; background-color: rgba(0, 0, 0, 0.7); border-top-width: 1px; border-top-color: rgba(130, 70, 180, 0.3);">
            <ui:Button text="BEGIN ADVENTURE" name="btn-select" class="menu-button-main" style="width: 280px; -unity-text-align: middle-center;" />
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
