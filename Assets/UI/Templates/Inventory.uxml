<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Styles/VeilBreakers.uss?fileID=7433441132597879392&amp;guid=f14e48b4bc52a9f4586f9c621c434598&amp;type=3" />
    <Style src="project://database/Assets/UI/Styles/VeilBreakersTheme.uss?fileID=7433441132597879392&amp;guid=0c75776285827f74db8942ace412c502&amp;type=3" />

    <ui:VisualElement name="inventory-root" class="vb-root" style="flex-grow: 1;">

        <!-- ====================================================================
             BACKGROUND
             ==================================================================== -->

        <ui:VisualElement name="background" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgb(8, 6, 12);" />

        <!-- Veil ambient effect -->
        <ui:VisualElement name="veil-effect" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(180, 40, 60, 0.03);" />

        <!-- ====================================================================
             HEADER
             ==================================================================== -->

        <ui:VisualElement name="header" style="position: absolute; left: 0; top: 0; right: 0; height: 70px; flex-direction: row; justify-content: space-between; align-items: center; padding: 0 30px; background-color: rgba(0, 0, 0, 0.6); border-bottom-width: 1px; border-bottom-color: rgba(80, 45, 55, 0.5);">

            <!-- Back button -->
            <ui:Button text="BACK" name="btn-back" class="vb-button" style="width: 100px;" />

            <!-- Title -->
            <ui:Label text="INVENTORY" class="vb-title" style="font-size: 24px; letter-spacing: 4px; color: rgb(235, 225, 215);" />

            <!-- Currency display -->
            <ui:VisualElement name="currency-display" class="vb-row" style="align-items: center;">
                <ui:VisualElement name="currency-icon" style="width: 24px; height: 24px; background-color: rgb(220, 180, 50); border-radius: 12px; margin-right: 8px;" />
                <ui:Label name="currency-amount" text="0" style="color: rgb(220, 180, 50); font-size: 18px; -unity-font-style: bold;" />
            </ui:VisualElement>

        </ui:VisualElement>

        <!-- ====================================================================
             MAIN CONTENT AREA
             ==================================================================== -->

        <ui:VisualElement name="content" style="flex-grow: 1; flex-direction: row; margin-top: 70px; padding: 20px;">

            <!-- ================================================================
                 LEFT PANEL - Category Tabs + Item Grid
                 ================================================================ -->

            <ui:VisualElement name="items-panel" style="flex-grow: 1; margin-right: 20px;">

                <!-- Category Tabs -->
                <ui:VisualElement name="category-tabs" class="vb-row" style="margin-bottom: 16px; background-color: rgba(15, 12, 22, 0.8); border-radius: 8px; padding: 4px;">

                    <ui:Button text="ALL" name="tab-all" class="inventory-tab inventory-tab-active" />
                    <ui:Button text="CONSUMABLES" name="tab-consumables" class="inventory-tab" />
                    <ui:Button text="EQUIPMENT" name="tab-equipment" class="inventory-tab" />
                    <ui:Button text="KEY ITEMS" name="tab-key-items" class="inventory-tab" />
                    <ui:Button text="MATERIALS" name="tab-materials" class="inventory-tab" />

                </ui:VisualElement>

                <!-- Sort/Filter Row -->
                <ui:VisualElement name="filter-row" class="vb-row" style="margin-bottom: 12px; justify-content: space-between; align-items: center;">

                    <!-- Sort dropdown -->
                    <ui:VisualElement class="vb-row" style="align-items: center;">
                        <ui:Label text="Sort:" style="color: rgb(165, 155, 145); font-size: 12px; margin-right: 8px;" />
                        <ui:DropdownField name="sort-dropdown" class="vb-dropdown" style="min-width: 150px;" />
                    </ui:VisualElement>

                    <!-- Item count -->
                    <ui:Label name="item-count" text="0 / 100 items" style="color: rgb(165, 155, 145); font-size: 12px;" />

                </ui:VisualElement>

                <!-- Item Grid Container -->
                <ui:VisualElement name="grid-container" style="flex-grow: 1; background-color: rgba(15, 12, 22, 0.6); border-radius: 8px; border-width: 1px; border-color: rgba(80, 45, 55, 0.3); padding: 12px;">

                    <ui:ScrollView name="item-scroll" class="vb-scrollview" style="flex-grow: 1;">

                        <ui:VisualElement name="item-grid" style="flex-direction: row; flex-wrap: wrap; padding: 4px;">
                            <!-- Item slots will be populated dynamically -->
                        </ui:VisualElement>

                    </ui:ScrollView>

                    <!-- Empty state -->
                    <ui:VisualElement name="empty-state" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; justify-content: center; align-items: center; display: none;">
                        <ui:Label text="No items in this category" style="color: rgb(75, 68, 65); font-size: 16px; letter-spacing: 1px;" />
                    </ui:VisualElement>

                </ui:VisualElement>

            </ui:VisualElement>

            <!-- ================================================================
                 RIGHT PANEL - Item Details
                 ================================================================ -->

            <ui:VisualElement name="details-panel" style="width: 320px; background-color: rgba(15, 12, 22, 0.8); border-radius: 8px; border-width: 1px; border-color: rgba(80, 45, 55, 0.3); padding: 20px;">

                <!-- Item Icon & Name -->
                <ui:VisualElement name="item-header" class="vb-column" style="align-items: center; margin-bottom: 20px;">

                    <!-- Item icon with rarity border -->
                    <ui:VisualElement name="item-icon-frame" class="item-icon-frame rarity-common" style="width: 80px; height: 80px; margin-bottom: 12px; justify-content: center; align-items: center;">
                        <ui:VisualElement name="item-icon" style="width: 64px; height: 64px; background-color: rgb(40, 32, 50);" />
                    </ui:VisualElement>

                    <ui:Label name="item-name" text="Select an Item" class="vb-title" style="font-size: 20px; -unity-text-align: middle-center;" />
                    <ui:Label name="item-category-label" text="" style="color: rgb(165, 155, 145); font-size: 12px; letter-spacing: 1px; margin-top: 4px;" />

                </ui:VisualElement>

                <ui:VisualElement class="vb-divider-horizontal" style="margin-bottom: 16px;" />

                <!-- Item Description -->
                <ui:VisualElement name="description-section" style="margin-bottom: 16px;">
                    <ui:Label name="item-description" text="Choose an item from your inventory to view its details." style="color: rgb(165, 155, 145); font-size: 14px; white-space: normal; -unity-text-align: upper-left;" />
                </ui:VisualElement>

                <!-- Stats Section (for equipment) -->
                <ui:VisualElement name="stats-section" style="margin-bottom: 16px; display: none;">
                    <ui:Label text="STATS" style="color: rgb(180, 40, 60); font-size: 12px; letter-spacing: 2px; margin-bottom: 8px;" />

                    <ui:VisualElement name="stats-list" class="vb-column">
                        <!-- Stats populated dynamically -->
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Effects Section (for consumables) -->
                <ui:VisualElement name="effects-section" style="margin-bottom: 16px; display: none;">
                    <ui:Label text="EFFECTS" style="color: rgb(180, 40, 60); font-size: 12px; letter-spacing: 2px; margin-bottom: 8px;" />

                    <ui:VisualElement name="effects-list" class="vb-column">
                        <!-- Effects populated dynamically -->
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Brand Affinity -->
                <ui:VisualElement name="brand-section" style="margin-bottom: 16px; display: none;">
                    <ui:Label text="BRAND AFFINITY" style="color: rgb(180, 40, 60); font-size: 12px; letter-spacing: 2px; margin-bottom: 8px;" />

                    <ui:VisualElement name="brand-display" class="brand-badge">
                        <ui:VisualElement class="brand-icon" style="width: 20px; height: 20px; border-radius: 4px; margin-right: 8px;" />
                        <ui:Label class="brand-name" text="None" style="color: rgb(235, 225, 215); font-size: 14px;" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Quantity & Value -->
                <ui:VisualElement name="quantity-section" class="vb-row" style="justify-content: space-between; margin-bottom: 20px;">
                    <ui:VisualElement class="vb-column">
                        <ui:Label text="QUANTITY" style="color: rgb(165, 155, 145); font-size: 10px; letter-spacing: 1px;" />
                        <ui:Label name="item-quantity" text="x0" style="color: rgb(235, 225, 215); font-size: 18px; -unity-font-style: bold;" />
                    </ui:VisualElement>
                    <ui:VisualElement class="vb-column" style="align-items: flex-end;">
                        <ui:Label text="SELL VALUE" style="color: rgb(165, 155, 145); font-size: 10px; letter-spacing: 1px;" />
                        <ui:Label name="item-value" text="0" style="color: rgb(220, 180, 50); font-size: 18px; -unity-font-style: bold;" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Spacer -->
                <ui:VisualElement style="flex-grow: 1;" />

                <!-- Action Buttons -->
                <ui:VisualElement name="action-buttons" class="vb-column" style="margin-top: auto;">
                    <ui:Button text="USE" name="btn-use" class="vb-button vb-button-primary" style="margin-bottom: 8px;" />
                    <ui:Button text="DROP" name="btn-drop" class="vb-button vb-button-danger" />
                </ui:VisualElement>

            </ui:VisualElement>

        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
