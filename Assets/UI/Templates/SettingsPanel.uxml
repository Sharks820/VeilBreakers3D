<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Styles/VeilBreakers.uss?fileID=7433441132597879392&amp;guid=f14e48b4bc52a9f4586f9c621c434598&amp;type=3" />
    <Style src="project://database/Assets/UI/Styles/VeilBreakersTheme.uss?fileID=7433441132597879392&amp;guid=0c75776285827f74db8942ace412c502&amp;type=3" />

    <ui:VisualElement name="settings-root" class="vb-root" style="flex-grow: 1; justify-content: center; align-items: center;">

        <!-- Background -->
        <ui:VisualElement style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgb(8, 6, 12);" />

        <!-- Darkened overlay -->
        <ui:VisualElement style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(0, 0, 0, 0.6);" />

        <!-- Settings Panel -->
        <ui:VisualElement name="settings-panel" style="width: 650px; max-height: 85%; background-color: rgba(12, 9, 18, 0.95); border-width: 2px; border-color: rgba(130, 70, 180, 0.4); border-radius: 14px; padding: 28px;">

            <!-- Header -->
            <ui:VisualElement name="header" style="flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 20px; padding-bottom: 16px; border-bottom-width: 1px; border-bottom-color: rgba(130, 70, 180, 0.3);">
                <ui:VisualElement style="flex-direction: row; align-items: center;">
                    <ui:VisualElement style="width: 4px; height: 24px; background-color: rgb(130, 70, 180); border-radius: 2px; margin-right: 14px;" />
                    <ui:Label text="SETTINGS" style="font-size: 26px; letter-spacing: 5px; color: rgb(235, 225, 215); -unity-font-style: bold;" />
                </ui:VisualElement>
                <ui:Button text="X" name="btn-close" style="width: 40px; height: 40px; font-size: 18px; background-color: transparent; border-width: 1px; border-color: rgba(180, 50, 70, 0.4); border-radius: 20px; color: rgb(180, 80, 90); -unity-text-align: middle-center; padding: 0;" />
            </ui:VisualElement>

            <!-- Tab Bar -->
            <ui:VisualElement name="tab-container" style="flex-direction: row; margin-bottom: 20px; background-color: rgba(20, 16, 28, 0.6); border-radius: 6px; padding: 4px;">
                <ui:Button text="AUDIO" name="tab-audio" style="flex-grow: 1; height: 40px; font-size: 12px; letter-spacing: 2px; background-color: rgb(120, 60, 160); border-width: 0; border-radius: 4px; color: rgb(235, 225, 215); margin-right: 4px;" />
                <ui:Button text="GRAPHICS" name="tab-graphics" style="flex-grow: 1; height: 40px; font-size: 12px; letter-spacing: 2px; background-color: transparent; border-width: 0; border-radius: 4px; color: rgb(120, 110, 100); margin-right: 4px;" />
                <ui:Button text="CONTROLS" name="tab-controls" style="flex-grow: 1; height: 40px; font-size: 12px; letter-spacing: 2px; background-color: transparent; border-width: 0; border-radius: 4px; color: rgb(120, 110, 100); margin-right: 4px;" />
                <ui:Button text="GAMEPLAY" name="tab-gameplay" style="flex-grow: 1; height: 40px; font-size: 12px; letter-spacing: 2px; background-color: transparent; border-width: 0; border-radius: 4px; color: rgb(120, 110, 100);" />
            </ui:VisualElement>

            <!-- Content ScrollView -->
            <ui:ScrollView name="settings-content" style="flex-grow: 1; min-height: 320px; max-height: 420px;">

                <!-- AUDIO TAB -->
                <ui:VisualElement name="audio-settings" style="padding: 4px 0;">

                    <!-- Master Volume -->
                    <ui:VisualElement style="flex-direction: row; align-items: center; padding: 10px 0; border-bottom-width: 1px; border-bottom-color: rgba(60, 50, 75, 0.2);">
                        <ui:Label text="Master Volume" style="width: 160px; font-size: 14px; color: rgb(165, 155, 145);" />
                        <ui:Slider name="slider-master" class="vb-slider" low-value="0" high-value="100" value="80" style="flex-grow: 1; margin: 0 16px;" />
                        <ui:Label name="label-master-value" text="80%" style="width: 50px; font-size: 14px; color: rgb(130, 70, 180); -unity-text-align: middle-right; -unity-font-style: bold;" />
                    </ui:VisualElement>

                    <!-- Music -->
                    <ui:VisualElement style="flex-direction: row; align-items: center; padding: 10px 0; border-bottom-width: 1px; border-bottom-color: rgba(60, 50, 75, 0.2);">
                        <ui:Label text="Music" style="width: 160px; font-size: 14px; color: rgb(165, 155, 145);" />
                        <ui:Slider name="slider-music" class="vb-slider" low-value="0" high-value="100" value="70" style="flex-grow: 1; margin: 0 16px;" />
                        <ui:Label name="label-music-value" text="70%" style="width: 50px; font-size: 14px; color: rgb(130, 70, 180); -unity-text-align: middle-right; -unity-font-style: bold;" />
                    </ui:VisualElement>

                    <!-- Sound Effects -->
                    <ui:VisualElement style="flex-direction: row; align-items: center; padding: 10px 0; border-bottom-width: 1px; border-bottom-color: rgba(60, 50, 75, 0.2);">
                        <ui:Label text="Sound Effects" style="width: 160px; font-size: 14px; color: rgb(165, 155, 145);" />
                        <ui:Slider name="slider-sfx" class="vb-slider" low-value="0" high-value="100" value="80" style="flex-grow: 1; margin: 0 16px;" />
                        <ui:Label name="label-sfx-value" text="80%" style="width: 50px; font-size: 14px; color: rgb(130, 70, 180); -unity-text-align: middle-right; -unity-font-style: bold;" />
                    </ui:VisualElement>

                    <!-- Voice -->
                    <ui:VisualElement style="flex-direction: row; align-items: center; padding: 10px 0; border-bottom-width: 1px; border-bottom-color: rgba(60, 50, 75, 0.2);">
                        <ui:Label text="Voice / Dialogue" style="width: 160px; font-size: 14px; color: rgb(165, 155, 145);" />
                        <ui:Slider name="slider-voice" class="vb-slider" low-value="0" high-value="100" value="100" style="flex-grow: 1; margin: 0 16px;" />
                        <ui:Label name="label-voice-value" text="100%" style="width: 50px; font-size: 14px; color: rgb(130, 70, 180); -unity-text-align: middle-right; -unity-font-style: bold;" />
                    </ui:VisualElement>

                    <!-- Mute Toggle -->
                    <ui:VisualElement style="flex-direction: row; align-items: center; padding: 14px 0; margin-top: 8px;">
                        <ui:Label text="Mute All Audio" style="width: 160px; font-size: 14px; color: rgb(165, 155, 145);" />
                        <ui:Toggle name="toggle-mute" class="vb-toggle" />
                    </ui:VisualElement>

                    <!-- Subtitles Toggle -->
                    <ui:VisualElement style="flex-direction: row; align-items: center; padding: 14px 0;">
                        <ui:Label text="Subtitles" style="width: 160px; font-size: 14px; color: rgb(165, 155, 145);" />
                        <ui:Toggle name="toggle-subtitles" class="vb-toggle" value="true" />
                    </ui:VisualElement>

                </ui:VisualElement>

                <!-- GRAPHICS TAB (hidden) -->
                <ui:VisualElement name="graphics-settings" style="padding: 4px 0; display: none;">

                    <ui:Label text="DISPLAY" style="font-size: 11px; letter-spacing: 2px; color: rgb(130, 70, 180); margin-bottom: 12px; padding-bottom: 8px; border-bottom-width: 1px; border-bottom-color: rgba(130, 70, 180, 0.3);" />

                    <!-- Resolution -->
                    <ui:VisualElement style="flex-direction: row; align-items: center; padding: 10px 0; border-bottom-width: 1px; border-bottom-color: rgba(60, 50, 75, 0.2);">
                        <ui:Label text="Resolution" style="width: 160px; font-size: 14px; color: rgb(165, 155, 145);" />
                        <ui:DropdownField name="dropdown-resolution" class="vb-dropdown" style="flex-grow: 1; margin-left: 16px; height: 36px;" />
                    </ui:VisualElement>

                    <!-- Display Mode -->
                    <ui:VisualElement style="flex-direction: row; align-items: center; padding: 10px 0; border-bottom-width: 1px; border-bottom-color: rgba(60, 50, 75, 0.2);">
                        <ui:Label text="Display Mode" style="width: 160px; font-size: 14px; color: rgb(165, 155, 145);" />
                        <ui:DropdownField name="dropdown-fullscreen" class="vb-dropdown" choices="Fullscreen,Windowed,Borderless" index="0" style="flex-grow: 1; margin-left: 16px; height: 36px;" />
                    </ui:VisualElement>

                    <!-- VSync -->
                    <ui:VisualElement style="flex-direction: row; align-items: center; padding: 14px 0;">
                        <ui:Label text="VSync" style="width: 160px; font-size: 14px; color: rgb(165, 155, 145);" />
                        <ui:Toggle name="toggle-vsync" class="vb-toggle" value="true" />
                    </ui:VisualElement>

                    <ui:Label text="QUALITY" style="font-size: 11px; letter-spacing: 2px; color: rgb(130, 70, 180); margin-top: 16px; margin-bottom: 12px; padding-bottom: 8px; border-bottom-width: 1px; border-bottom-color: rgba(130, 70, 180, 0.3);" />

                    <!-- Quality -->
                    <ui:VisualElement style="flex-direction: row; align-items: center; padding: 10px 0; border-bottom-width: 1px; border-bottom-color: rgba(60, 50, 75, 0.2);">
                        <ui:Label text="Quality Preset" style="width: 160px; font-size: 14px; color: rgb(165, 155, 145);" />
                        <ui:DropdownField name="dropdown-quality" class="vb-dropdown" choices="Low,Medium,High,Ultra" index="2" style="flex-grow: 1; margin-left: 16px; height: 36px;" />
                    </ui:VisualElement>

                    <!-- Show FPS -->
                    <ui:VisualElement style="flex-direction: row; align-items: center; padding: 14px 0;">
                        <ui:Label text="Show FPS Counter" style="width: 160px; font-size: 14px; color: rgb(165, 155, 145);" />
                        <ui:Toggle name="toggle-fps" class="vb-toggle" />
                    </ui:VisualElement>

                </ui:VisualElement>

                <!-- CONTROLS TAB (hidden) -->
                <ui:VisualElement name="controls-settings" style="padding: 4px 0; display: none;">

                    <ui:Label text="MOUSE" style="font-size: 11px; letter-spacing: 2px; color: rgb(130, 70, 180); margin-bottom: 12px; padding-bottom: 8px; border-bottom-width: 1px; border-bottom-color: rgba(130, 70, 180, 0.3);" />

                    <!-- Mouse Sensitivity -->
                    <ui:VisualElement style="flex-direction: row; align-items: center; padding: 10px 0; border-bottom-width: 1px; border-bottom-color: rgba(60, 50, 75, 0.2);">
                        <ui:Label text="Mouse Sensitivity" style="width: 160px; font-size: 14px; color: rgb(165, 155, 145);" />
                        <ui:Slider name="slider-sensitivity" class="vb-slider" low-value="1" high-value="100" value="50" style="flex-grow: 1; margin: 0 16px;" />
                        <ui:Label name="label-sensitivity-value" text="50" style="width: 50px; font-size: 14px; color: rgb(130, 70, 180); -unity-text-align: middle-right; -unity-font-style: bold;" />
                    </ui:VisualElement>

                    <!-- Invert Y -->
                    <ui:VisualElement style="flex-direction: row; align-items: center; padding: 14px 0;">
                        <ui:Label text="Invert Y-Axis" style="width: 160px; font-size: 14px; color: rgb(165, 155, 145);" />
                        <ui:Toggle name="toggle-invert-y" class="vb-toggle" />
                    </ui:VisualElement>

                    <ui:Label text="KEYBINDINGS" style="font-size: 11px; letter-spacing: 2px; color: rgb(130, 70, 180); margin-top: 16px; margin-bottom: 12px; padding-bottom: 8px; border-bottom-width: 1px; border-bottom-color: rgba(130, 70, 180, 0.3);" />

                    <ui:Label text="Click a key to rebind (coming soon)" style="font-size: 12px; color: rgb(100, 90, 85); margin-bottom: 12px; -unity-font-style: italic;" />

                    <!-- Key bindings -->
                    <ui:VisualElement style="flex-direction: row; justify-content: space-between; padding: 8px 12px; background-color: rgba(25, 20, 35, 0.6); border-radius: 4px; margin-bottom: 4px;">
                        <ui:Label text="Move Forward" style="font-size: 13px; color: rgb(165, 155, 145);" />
                        <ui:Label text="W" style="font-size: 13px; color: rgb(130, 70, 180); -unity-font-style: bold; padding: 2px 10px; background-color: rgba(130, 70, 180, 0.2); border-radius: 3px;" />
                    </ui:VisualElement>
                    <ui:VisualElement style="flex-direction: row; justify-content: space-between; padding: 8px 12px; background-color: rgba(25, 20, 35, 0.6); border-radius: 4px; margin-bottom: 4px;">
                        <ui:Label text="Move Back" style="font-size: 13px; color: rgb(165, 155, 145);" />
                        <ui:Label text="S" style="font-size: 13px; color: rgb(130, 70, 180); -unity-font-style: bold; padding: 2px 10px; background-color: rgba(130, 70, 180, 0.2); border-radius: 3px;" />
                    </ui:VisualElement>
                    <ui:VisualElement style="flex-direction: row; justify-content: space-between; padding: 8px 12px; background-color: rgba(25, 20, 35, 0.6); border-radius: 4px; margin-bottom: 4px;">
                        <ui:Label text="Move Left" style="font-size: 13px; color: rgb(165, 155, 145);" />
                        <ui:Label text="A" style="font-size: 13px; color: rgb(130, 70, 180); -unity-font-style: bold; padding: 2px 10px; background-color: rgba(130, 70, 180, 0.2); border-radius: 3px;" />
                    </ui:VisualElement>
                    <ui:VisualElement style="flex-direction: row; justify-content: space-between; padding: 8px 12px; background-color: rgba(25, 20, 35, 0.6); border-radius: 4px; margin-bottom: 4px;">
                        <ui:Label text="Move Right" style="font-size: 13px; color: rgb(165, 155, 145);" />
                        <ui:Label text="D" style="font-size: 13px; color: rgb(130, 70, 180); -unity-font-style: bold; padding: 2px 10px; background-color: rgba(130, 70, 180, 0.2); border-radius: 3px;" />
                    </ui:VisualElement>
                    <ui:VisualElement style="flex-direction: row; justify-content: space-between; padding: 8px 12px; background-color: rgba(25, 20, 35, 0.6); border-radius: 4px; margin-bottom: 4px;">
                        <ui:Label text="Interact" style="font-size: 13px; color: rgb(165, 155, 145);" />
                        <ui:Label text="E" style="font-size: 13px; color: rgb(130, 70, 180); -unity-font-style: bold; padding: 2px 10px; background-color: rgba(130, 70, 180, 0.2); border-radius: 3px;" />
                    </ui:VisualElement>

                </ui:VisualElement>

                <!-- GAMEPLAY TAB (hidden) -->
                <ui:VisualElement name="gameplay-settings" style="padding: 4px 0; display: none;">

                    <ui:Label text="DIFFICULTY" style="font-size: 11px; letter-spacing: 2px; color: rgb(130, 70, 180); margin-bottom: 12px; padding-bottom: 8px; border-bottom-width: 1px; border-bottom-color: rgba(130, 70, 180, 0.3);" />

                    <!-- Difficulty -->
                    <ui:VisualElement style="flex-direction: row; align-items: center; padding: 10px 0; border-bottom-width: 1px; border-bottom-color: rgba(60, 50, 75, 0.2);">
                        <ui:Label text="Difficulty" style="width: 160px; font-size: 14px; color: rgb(165, 155, 145);" />
                        <ui:DropdownField name="dropdown-difficulty" class="vb-dropdown" choices="Story,Normal,Hard,Nightmare" index="1" style="flex-grow: 1; margin-left: 16px; height: 36px;" />
                    </ui:VisualElement>

                    <ui:Label text="INTERFACE" style="font-size: 11px; letter-spacing: 2px; color: rgb(130, 70, 180); margin-top: 16px; margin-bottom: 12px; padding-bottom: 8px; border-bottom-width: 1px; border-bottom-color: rgba(130, 70, 180, 0.3);" />

                    <!-- Damage Numbers -->
                    <ui:VisualElement style="flex-direction: row; align-items: center; padding: 14px 0;">
                        <ui:Label text="Damage Numbers" style="width: 160px; font-size: 14px; color: rgb(165, 155, 145);" />
                        <ui:Toggle name="toggle-damage-numbers" class="vb-toggle" value="true" />
                    </ui:VisualElement>

                    <!-- Health Bars -->
                    <ui:VisualElement style="flex-direction: row; align-items: center; padding: 14px 0;">
                        <ui:Label text="Health Bars" style="width: 160px; font-size: 14px; color: rgb(165, 155, 145);" />
                        <ui:Toggle name="toggle-health-bars" class="vb-toggle" value="true" />
                    </ui:VisualElement>

                    <!-- Tutorial Tips -->
                    <ui:VisualElement style="flex-direction: row; align-items: center; padding: 14px 0;">
                        <ui:Label text="Tutorial Tips" style="width: 160px; font-size: 14px; color: rgb(165, 155, 145);" />
                        <ui:Toggle name="toggle-tutorials" class="vb-toggle" value="true" />
                    </ui:VisualElement>

                </ui:VisualElement>

            </ui:ScrollView>

            <!-- Bottom Buttons -->
            <ui:VisualElement style="flex-direction: row; justify-content: flex-end; margin-top: 20px; padding-top: 16px; border-top-width: 1px; border-top-color: rgba(130, 70, 180, 0.2);">
                <ui:Button text="RESET DEFAULTS" name="btn-reset" style="height: 40px; padding: 0 20px; font-size: 12px; letter-spacing: 1px; background-color: transparent; border-width: 1px; border-color: rgba(130, 70, 180, 0.3); border-radius: 4px; color: rgb(120, 110, 100); margin-right: 12px;" />
                <ui:Button text="APPLY" name="btn-apply" style="height: 40px; padding: 0 32px; font-size: 14px; letter-spacing: 2px; -unity-font-style: bold; background-color: rgb(120, 60, 160); border-color: rgb(160, 100, 200); border-width: 2px; border-radius: 6px; color: rgb(235, 225, 215);" />
            </ui:VisualElement>

        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
