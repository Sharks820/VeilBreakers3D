<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Styles/VeilBreakers.uss?fileID=7433441132597879392&amp;guid=f14e48b4bc52a9f4586f9c621c434598&amp;type=3" />
    <Style src="project://database/Assets/UI/Styles/VeilBreakersTheme.uss?fileID=7433441132597879392&amp;guid=0c75776285827f74db8942ace412c502&amp;type=3" />

    <ui:VisualElement name="settings-root" class="vb-root" style="flex-grow: 1; justify-content: center; align-items: center;">

        <!-- Background layers for depth -->
        <ui:VisualElement name="bg-void" class="bg-void" />

        <!-- Vignette overlay -->
        <ui:VisualElement name="vignette" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0;">
            <ui:VisualElement class="bg-vignette-top" />
            <ui:VisualElement class="bg-vignette-bottom" />
        </ui:VisualElement>

        <!-- Darkened overlay for modal effect -->
        <ui:VisualElement name="modal-overlay" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(0, 0, 0, 0.6);" />

        <!-- Settings Panel Container -->
        <ui:VisualElement name="settings-panel" class="settings-panel-container">

            <!-- Header with decorative elements -->
            <ui:VisualElement name="header" class="settings-header">
                <ui:VisualElement style="flex-direction: row; align-items: center;">
                    <ui:VisualElement style="width: 4px; height: 28px; background-color: rgb(130, 70, 180); margin-right: 16px; border-radius: 2px;" />
                    <ui:Label text="SETTINGS" name="title" class="settings-title" />
                </ui:VisualElement>
                <ui:Button text="X" name="btn-close" class="settings-close-btn" />
            </ui:VisualElement>

            <!-- Tab Bar -->
            <ui:VisualElement name="tab-container" class="settings-tab-bar">
                <ui:Button text="AUDIO" name="tab-audio" class="settings-tab settings-tab-active" />
                <ui:Button text="GRAPHICS" name="tab-graphics" class="settings-tab" />
                <ui:Button text="CONTROLS" name="tab-controls" class="settings-tab" />
                <ui:Button text="GAMEPLAY" name="tab-gameplay" class="settings-tab" />
            </ui:VisualElement>

            <!-- Content area with scroll -->
            <ui:ScrollView name="settings-content" class="vb-scrollview" style="flex-grow: 1; min-height: 350px; max-height: 450px;">

                <!-- ================================================================
                     AUDIO TAB
                     ================================================================ -->
                <ui:VisualElement name="audio-settings" style="padding: 8px 0;">

                    <!-- Master Volume -->
                    <ui:VisualElement class="settings-row">
                        <ui:Label text="Master Volume" class="settings-label" />
                        <ui:Slider name="slider-master" class="aaa-slider settings-control" low-value="0" high-value="100" value="80" />
                        <ui:Label name="label-master-value" text="80%" class="settings-value" />
                    </ui:VisualElement>

                    <!-- Music Volume -->
                    <ui:VisualElement class="settings-row">
                        <ui:Label text="Music" class="settings-label" />
                        <ui:Slider name="slider-music" class="aaa-slider settings-control" low-value="0" high-value="100" value="70" />
                        <ui:Label name="label-music-value" text="70%" class="settings-value" />
                    </ui:VisualElement>

                    <!-- SFX Volume -->
                    <ui:VisualElement class="settings-row">
                        <ui:Label text="Sound Effects" class="settings-label" />
                        <ui:Slider name="slider-sfx" class="aaa-slider settings-control" low-value="0" high-value="100" value="80" />
                        <ui:Label name="label-sfx-value" text="80%" class="settings-value" />
                    </ui:VisualElement>

                    <!-- Voice Volume -->
                    <ui:VisualElement class="settings-row">
                        <ui:Label text="Voice / Dialogue" class="settings-label" />
                        <ui:Slider name="slider-voice" class="aaa-slider settings-control" low-value="0" high-value="100" value="100" />
                        <ui:Label name="label-voice-value" text="100%" class="settings-value" />
                    </ui:VisualElement>

                    <!-- Ambient Volume -->
                    <ui:VisualElement class="settings-row">
                        <ui:Label text="Ambient" class="settings-label" />
                        <ui:Slider name="slider-ambient" class="aaa-slider settings-control" low-value="0" high-value="100" value="60" />
                        <ui:Label name="label-ambient-value" text="60%" class="settings-value" />
                    </ui:VisualElement>

                    <!-- Divider -->
                    <ui:VisualElement class="divider-decorated" style="margin: 20px 0;">
                        <ui:VisualElement class="divider-line" />
                        <ui:VisualElement class="divider-dot" style="margin: 0 12px;" />
                        <ui:VisualElement class="divider-line" />
                    </ui:VisualElement>

                    <!-- Audio Options -->
                    <ui:VisualElement class="settings-row">
                        <ui:Label text="Mute All" class="settings-label" />
                        <ui:Toggle name="toggle-mute" class="aaa-toggle settings-control" />
                    </ui:VisualElement>

                    <ui:VisualElement class="settings-row">
                        <ui:Label text="Subtitles" class="settings-label" />
                        <ui:Toggle name="toggle-subtitles" class="aaa-toggle settings-control" value="true" />
                    </ui:VisualElement>

                </ui:VisualElement>

                <!-- ================================================================
                     GRAPHICS TAB (hidden by default)
                     ================================================================ -->
                <ui:VisualElement name="graphics-settings" style="padding: 8px 0; display: none;">

                    <ui:Label text="DISPLAY" class="settings-section-header" />

                    <!-- Resolution -->
                    <ui:VisualElement class="settings-row">
                        <ui:Label text="Resolution" class="settings-label" />
                        <ui:DropdownField name="dropdown-resolution" class="vb-dropdown settings-control" style="min-width: 200px;" />
                    </ui:VisualElement>

                    <!-- Display Mode -->
                    <ui:VisualElement class="settings-row">
                        <ui:Label text="Display Mode" class="settings-label" />
                        <ui:DropdownField name="dropdown-fullscreen" class="vb-dropdown settings-control" choices="Fullscreen,Windowed,Borderless" index="0" style="min-width: 200px;" />
                    </ui:VisualElement>

                    <!-- VSync -->
                    <ui:VisualElement class="settings-row">
                        <ui:Label text="VSync" class="settings-label" />
                        <ui:Toggle name="toggle-vsync" class="aaa-toggle settings-control" value="true" />
                    </ui:VisualElement>

                    <!-- Frame Rate Cap -->
                    <ui:VisualElement class="settings-row">
                        <ui:Label text="Frame Rate Cap" class="settings-label" />
                        <ui:DropdownField name="dropdown-framerate" class="vb-dropdown settings-control" choices="Unlimited,30,60,120,144" index="2" style="min-width: 200px;" />
                    </ui:VisualElement>

                    <ui:Label text="QUALITY" class="settings-section-header" />

                    <!-- Quality Preset -->
                    <ui:VisualElement class="settings-row">
                        <ui:Label text="Quality Preset" class="settings-label" />
                        <ui:DropdownField name="dropdown-quality" class="vb-dropdown settings-control" choices="Low,Medium,High,Ultra,Custom" index="2" style="min-width: 200px;" />
                    </ui:VisualElement>

                    <!-- Shadow Quality -->
                    <ui:VisualElement class="settings-row">
                        <ui:Label text="Shadows" class="settings-label" />
                        <ui:DropdownField name="dropdown-shadows" class="vb-dropdown settings-control" choices="Off,Low,Medium,High" index="2" style="min-width: 200px;" />
                    </ui:VisualElement>

                    <!-- Post Processing -->
                    <ui:VisualElement class="settings-row">
                        <ui:Label text="Post Processing" class="settings-label" />
                        <ui:Toggle name="toggle-postfx" class="aaa-toggle settings-control" value="true" />
                    </ui:VisualElement>

                    <!-- Show FPS -->
                    <ui:VisualElement class="settings-row">
                        <ui:Label text="Show FPS Counter" class="settings-label" />
                        <ui:Toggle name="toggle-fps" class="aaa-toggle settings-control" />
                    </ui:VisualElement>

                </ui:VisualElement>

                <!-- ================================================================
                     CONTROLS TAB (hidden by default)
                     ================================================================ -->
                <ui:VisualElement name="controls-settings" style="padding: 8px 0; display: none;">

                    <ui:Label text="MOUSE" class="settings-section-header" />

                    <!-- Mouse Sensitivity -->
                    <ui:VisualElement class="settings-row">
                        <ui:Label text="Mouse Sensitivity" class="settings-label" />
                        <ui:Slider name="slider-sensitivity" class="aaa-slider settings-control" low-value="1" high-value="100" value="50" />
                        <ui:Label name="label-sensitivity-value" text="50" class="settings-value" />
                    </ui:VisualElement>

                    <!-- Invert Y -->
                    <ui:VisualElement class="settings-row">
                        <ui:Label text="Invert Y-Axis" class="settings-label" />
                        <ui:Toggle name="toggle-invert-y" class="aaa-toggle settings-control" />
                    </ui:VisualElement>

                    <ui:Label text="KEYBINDINGS" class="settings-section-header" />

                    <ui:Label text="Click a binding to rebind (coming soon)" style="font-size: 12px; color: rgb(100, 90, 85); margin-bottom: 16px; font-style: italic;" />

                    <!-- Key bindings list -->
                    <ui:VisualElement name="keybind-move-forward" class="settings-row" style="background-color: rgba(25, 20, 35, 0.5); border-radius: 6px; padding: 8px 12px; margin-bottom: 4px;">
                        <ui:Label text="Move Forward" class="settings-label" />
                        <ui:Label text="W" style="font-size: 14px; color: rgb(130, 70, 180); -unity-font-style: bold; padding: 4px 12px; background-color: rgba(130, 70, 180, 0.2); border-radius: 4px;" />
                    </ui:VisualElement>

                    <ui:VisualElement name="keybind-move-back" class="settings-row" style="background-color: rgba(25, 20, 35, 0.5); border-radius: 6px; padding: 8px 12px; margin-bottom: 4px;">
                        <ui:Label text="Move Back" class="settings-label" />
                        <ui:Label text="S" style="font-size: 14px; color: rgb(130, 70, 180); -unity-font-style: bold; padding: 4px 12px; background-color: rgba(130, 70, 180, 0.2); border-radius: 4px;" />
                    </ui:VisualElement>

                    <ui:VisualElement name="keybind-move-left" class="settings-row" style="background-color: rgba(25, 20, 35, 0.5); border-radius: 6px; padding: 8px 12px; margin-bottom: 4px;">
                        <ui:Label text="Move Left" class="settings-label" />
                        <ui:Label text="A" style="font-size: 14px; color: rgb(130, 70, 180); -unity-font-style: bold; padding: 4px 12px; background-color: rgba(130, 70, 180, 0.2); border-radius: 4px;" />
                    </ui:VisualElement>

                    <ui:VisualElement name="keybind-move-right" class="settings-row" style="background-color: rgba(25, 20, 35, 0.5); border-radius: 6px; padding: 8px 12px; margin-bottom: 4px;">
                        <ui:Label text="Move Right" class="settings-label" />
                        <ui:Label text="D" style="font-size: 14px; color: rgb(130, 70, 180); -unity-font-style: bold; padding: 4px 12px; background-color: rgba(130, 70, 180, 0.2); border-radius: 4px;" />
                    </ui:VisualElement>

                    <ui:VisualElement name="keybind-interact" class="settings-row" style="background-color: rgba(25, 20, 35, 0.5); border-radius: 6px; padding: 8px 12px; margin-bottom: 4px;">
                        <ui:Label text="Interact" class="settings-label" />
                        <ui:Label text="E" style="font-size: 14px; color: rgb(130, 70, 180); -unity-font-style: bold; padding: 4px 12px; background-color: rgba(130, 70, 180, 0.2); border-radius: 4px;" />
                    </ui:VisualElement>

                    <ui:VisualElement name="keybind-cycle-target" class="settings-row" style="background-color: rgba(25, 20, 35, 0.5); border-radius: 6px; padding: 8px 12px; margin-bottom: 4px;">
                        <ui:Label text="Cycle Target" class="settings-label" />
                        <ui:Label text="TAB" style="font-size: 14px; color: rgb(130, 70, 180); -unity-font-style: bold; padding: 4px 12px; background-color: rgba(130, 70, 180, 0.2); border-radius: 4px;" />
                    </ui:VisualElement>

                    <ui:VisualElement name="keybind-pause" class="settings-row" style="background-color: rgba(25, 20, 35, 0.5); border-radius: 6px; padding: 8px 12px; margin-bottom: 4px;">
                        <ui:Label text="Pause Menu" class="settings-label" />
                        <ui:Label text="ESC" style="font-size: 14px; color: rgb(130, 70, 180); -unity-font-style: bold; padding: 4px 12px; background-color: rgba(130, 70, 180, 0.2); border-radius: 4px;" />
                    </ui:VisualElement>

                </ui:VisualElement>

                <!-- ================================================================
                     GAMEPLAY TAB (hidden by default)
                     ================================================================ -->
                <ui:VisualElement name="gameplay-settings" style="padding: 8px 0; display: none;">

                    <ui:Label text="DIFFICULTY" class="settings-section-header" />

                    <!-- Difficulty -->
                    <ui:VisualElement class="settings-row">
                        <ui:Label text="Difficulty" class="settings-label" />
                        <ui:DropdownField name="dropdown-difficulty" class="vb-dropdown settings-control" choices="Story,Normal,Hard,Nightmare" index="1" style="min-width: 200px;" />
                    </ui:VisualElement>

                    <ui:Label text="INTERFACE" class="settings-section-header" />

                    <!-- Combat Damage Numbers -->
                    <ui:VisualElement class="settings-row">
                        <ui:Label text="Damage Numbers" class="settings-label" />
                        <ui:Toggle name="toggle-damage-numbers" class="aaa-toggle settings-control" value="true" />
                    </ui:VisualElement>

                    <!-- Floating Health Bars -->
                    <ui:VisualElement class="settings-row">
                        <ui:Label text="Health Bars" class="settings-label" />
                        <ui:Toggle name="toggle-health-bars" class="aaa-toggle settings-control" value="true" />
                    </ui:VisualElement>

                    <!-- Tutorial Tips -->
                    <ui:VisualElement class="settings-row">
                        <ui:Label text="Tutorial Tips" class="settings-label" />
                        <ui:Toggle name="toggle-tutorials" class="aaa-toggle settings-control" value="true" />
                    </ui:VisualElement>

                    <ui:Label text="ACCESSIBILITY" class="settings-section-header" />

                    <!-- Colorblind Mode -->
                    <ui:VisualElement class="settings-row">
                        <ui:Label text="Colorblind Mode" class="settings-label" />
                        <ui:DropdownField name="dropdown-colorblind" class="vb-dropdown settings-control" choices="Off,Protanopia,Deuteranopia,Tritanopia" index="0" style="min-width: 200px;" />
                    </ui:VisualElement>

                    <!-- Screen Shake -->
                    <ui:VisualElement class="settings-row">
                        <ui:Label text="Screen Shake" class="settings-label" />
                        <ui:Slider name="slider-screenshake" class="aaa-slider settings-control" low-value="0" high-value="100" value="100" />
                        <ui:Label name="label-screenshake-value" text="100%" class="settings-value" />
                    </ui:VisualElement>

                </ui:VisualElement>

            </ui:ScrollView>

            <!-- Bottom button row -->
            <ui:VisualElement name="button-container" class="settings-button-row">
                <ui:Button text="RESET DEFAULTS" name="btn-reset" class="btn-tertiary" style="margin-right: 16px;" />
                <ui:Button text="APPLY" name="btn-apply" class="btn-primary" style="min-width: 120px;" />
            </ui:VisualElement>

        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
