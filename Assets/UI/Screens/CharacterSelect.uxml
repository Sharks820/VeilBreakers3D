<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements"
          editor-extension-mode="False">

    <Style src="project://database/Assets/UI/Styles/CharacterSelect.uss" />

    <!-- ROOT: Full-screen container -->
    <ui:VisualElement name="character-select-root" class="character-select-root theme-vex">

        <!-- PARALLAX BACKGROUND SYSTEM (all layers non-interactive) -->
        <ui:VisualElement name="parallax-bg" class="parallax-bg" picking-mode="Ignore">
            <!-- Layer 1: Deepest Void -->
            <ui:VisualElement name="parallax-deep" class="parallax-bg parallax-deep" picking-mode="Ignore">
                <ui:VisualElement name="void-stars" class="void-stars" picking-mode="Ignore" />
            </ui:VisualElement>

            <!-- Layer 2: Atmospheric Fog -->
            <ui:VisualElement name="parallax-fog" class="parallax-bg parallax-fog" picking-mode="Ignore">
                <ui:VisualElement name="fog-particles" class="fog-particles" picking-mode="Ignore" />
            </ui:VisualElement>

            <!-- Layer 5: Vignette & Lighting -->
            <ui:VisualElement name="background-vignette" class="background-vignette" picking-mode="Ignore" />
        </ui:VisualElement>

        <!-- LEFT HALF: 3D HERO STAGE (55% width, full height) -->
        <ui:VisualElement name="hero-stage" class="hero-stage">
            <!-- Hero Aura Glow (non-interactive) -->
            <ui:VisualElement name="hero-aura-container" class="hero-aura-container" picking-mode="Ignore">
                <ui:VisualElement name="aura-base" class="aura-base" picking-mode="Ignore" />
                <ui:VisualElement name="aura-ring" class="aura-ring" picking-mode="Ignore" />
            </ui:VisualElement>

            <!-- The Render Texture Surface -->
            <ui:VisualElement name="hero-render-target" class="hero-render-target" />

            <!-- Hero Name Plate (bottom of stage) -->
            <ui:VisualElement name="hero-name-plate" class="hero-name-plate" picking-mode="Ignore">
                <ui:Label name="stage-hero-name" class="stage-hero-name" text="NYX" />
                <ui:Label name="stage-hero-title" class="stage-hero-title" text="THE SHADOW THAT SPEAKS" />
            </ui:VisualElement>

            <ui:Label name="drag-hint" class="drag-hint" text="DRAG TO ROTATE" picking-mode="Ignore" />
        </ui:VisualElement>

        <!-- RIGHT HALF: TABBED INFO PANEL -->
        <ui:VisualElement name="info-panel-container" class="veil-panel info-panel-container">
            <!-- Tab Header Strip -->
            <ui:VisualElement name="tab-header-strip" class="tab-header-strip">
                <ui:Button name="tab-btn-overview" class="tab-btn tab-btn-active" text="OVERVIEW" />
                <ui:Button name="tab-btn-abilities" class="tab-btn" text="ABILITIES" />
                <ui:Button name="tab-btn-lore" class="tab-btn" text="LORE" />
            </ui:VisualElement>

            <!-- Tab Content Area -->
            <ui:VisualElement name="tab-content" class="tab-content">

                <!-- TAB 1: OVERVIEW (default active) -->
                <ui:VisualElement name="tab-overview-content" class="tab-content-section tab-active">
                    <ui:Label name="hero-name" class="hero-name" text="VEX" />
                    <ui:Label name="hero-title" class="hero-title" text="THE WARDEN" />
                    <ui:Label name="hero-quote" class="hero-quote" text="&quot;I hold the line.&quot;" />

                    <ui:VisualElement class="ornamental-divider">
                        <ui:VisualElement class="divider-line" />
                        <ui:Label class="divider-diamond" text="&#x25C6;" />
                    </ui:VisualElement>

                    <ui:VisualElement name="hero-class-info" class="hero-class-info">
                        <ui:VisualElement name="path-row" class="info-row">
                            <ui:Label class="info-label" text="PATH" />
                            <ui:Label name="hero-path" class="info-value" text="IRONBOUND" />
                        </ui:VisualElement>
                        <ui:VisualElement name="role-row" class="info-row">
                            <ui:Label class="info-label" text="ROLE" />
                            <ui:Label name="hero-role" class="info-value" text="TANK" />
                        </ui:VisualElement>
                        <ui:VisualElement name="synergy-row" class="info-row">
                            <ui:Label class="info-label" text="SYNERGY" />
                            <ui:Label name="hero-synergy" class="info-value" text="IRON / DREAD" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- Starter Stats Grid -->
                    <ui:VisualElement name="starter-stats-grid" class="starter-stats-grid">
                        <ui:VisualElement class="stat-chip stat-chip-hp">
                            <ui:VisualElement class="stat-chip-header">
                                <ui:Label class="stat-chip-label" text="HP" />
                                <ui:Label name="stat-hp" class="stat-chip-value" text="68" />
                            </ui:VisualElement>
                            <ui:VisualElement class="stat-bar-track">
                                <ui:VisualElement name="stat-hp-fill" class="stat-bar-fill" style="width: 85%;" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="stat-chip stat-chip-stamina">
                            <ui:VisualElement class="stat-chip-header">
                                <ui:Label class="stat-chip-label" text="STAMINA" />
                                <ui:Label name="stat-stamina" class="stat-chip-value" text="45" />
                            </ui:VisualElement>
                            <ui:VisualElement class="stat-bar-track">
                                <ui:VisualElement name="stat-stamina-fill" class="stat-bar-fill" style="width: 56%;" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="stat-chip stat-chip-atk">
                            <ui:VisualElement class="stat-chip-header">
                                <ui:Label class="stat-chip-label" text="ATK" />
                                <ui:Label name="stat-atk" class="stat-chip-value" text="10" />
                            </ui:VisualElement>
                            <ui:VisualElement class="stat-bar-track">
                                <ui:VisualElement name="stat-atk-fill" class="stat-bar-fill" style="width: 25%;" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="stat-chip stat-chip-def">
                            <ui:VisualElement class="stat-chip-header">
                                <ui:Label class="stat-chip-label" text="DEF" />
                                <ui:Label name="stat-def" class="stat-chip-value" text="20" />
                            </ui:VisualElement>
                            <ui:VisualElement class="stat-bar-track">
                                <ui:VisualElement name="stat-def-fill" class="stat-bar-fill" style="width: 50%;" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement class="ornamental-divider">
                        <ui:VisualElement class="divider-line" />
                        <ui:Label class="divider-diamond" text="&#x25C6;" />
                    </ui:VisualElement>

                    <!-- Champion Monster Info — 50/50 split -->
                    <ui:VisualElement name="champion-section" class="champion-section-v2">
                        <!-- Left: 3D Model Render Target -->
                        <ui:VisualElement name="champion-model-viewer" class="champion-model-viewer" />
                        <!-- Right: Info -->
                        <ui:VisualElement name="champion-info-panel" class="champion-info-panel">
                            <ui:Label name="champion-name" class="champion-name-v2" text="SKITTER-TEETH" />
                            <ui:Label name="champion-brand-label" class="champion-brand-label" text="&#x2B25; IRON BRAND" />
                            <ui:VisualElement class="champion-tags">
                                <ui:Label name="champion-brand" class="tag tag-brand" text="IRON" />
                                <ui:Label name="champion-role" class="tag" text="TANK" />
                            </ui:VisualElement>
                            <ui:Label name="champion-desc" class="champion-desc" text="Your starting companion." />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement class="ornamental-divider">
                        <ui:VisualElement class="divider-line" />
                        <ui:Label class="divider-diamond" text="&#x25C6;" />
                    </ui:VisualElement>

                    <!-- D&D Attributes (number grid, no bars) -->
                    <ui:VisualElement name="attribute-bars-section" class="attribute-section">
                        <ui:Label name="attribute-bars-header" class="section-header" text="ATTRIBUTES" />
                        <ui:VisualElement name="attribute-grid" class="attribute-grid">
                            <ui:VisualElement class="attr-chip">
                                <ui:Label class="attr-chip-label" text="STR" />
                                <ui:Label name="bar-str-value" class="attr-chip-value" text="14" />
                            </ui:VisualElement>
                            <ui:VisualElement class="attr-chip">
                                <ui:Label class="attr-chip-label" text="DEX" />
                                <ui:Label name="bar-dex-value" class="attr-chip-value" text="10" />
                            </ui:VisualElement>
                            <ui:VisualElement class="attr-chip">
                                <ui:Label class="attr-chip-label" text="CON" />
                                <ui:Label name="bar-con-value" class="attr-chip-value" text="14" />
                            </ui:VisualElement>
                            <ui:VisualElement class="attr-chip">
                                <ui:Label class="attr-chip-label" text="INT" />
                                <ui:Label name="bar-int-value" class="attr-chip-value" text="10" />
                            </ui:VisualElement>
                            <ui:VisualElement class="attr-chip">
                                <ui:Label class="attr-chip-label" text="WIS" />
                                <ui:Label name="bar-wis-value" class="attr-chip-value" text="12" />
                            </ui:VisualElement>
                            <ui:VisualElement class="attr-chip">
                                <ui:Label class="attr-chip-label" text="CHA" />
                                <ui:Label name="bar-cha-value" class="attr-chip-value" text="10" />
                            </ui:VisualElement>
                            <ui:VisualElement class="attr-chip">
                                <ui:Label class="attr-chip-label" text="SPD" />
                                <ui:Label name="bar-spd-value" class="attr-chip-value" text="5" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- TAB 2: ABILITIES -->
                <ui:VisualElement name="tab-abilities-content" class="tab-content-section">
                    <ui:Label name="abilities-header" class="section-header" text="ABILITIES" />
                    <ui:VisualElement name="abilities-list" class="abilities-list">
                        <ui:Label name="ability-0" class="ability-slot" text="Shield Wall" />
                        <ui:Label name="ability-1" class="ability-slot" text="Iron Guard" />
                        <ui:Label name="ability-2" class="ability-slot" text="Veil Strike" />
                        <ui:Label name="ability-3" class="ability-slot" text="Fortify" />
                        <ui:Label name="ability-4" class="ability-slot" text="Last Stand" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- TAB 3: LORE -->
                <ui:VisualElement name="tab-lore-content" class="tab-content-section">
                    <ui:Label name="lore-header" class="section-header" text="LORE" />
                    <ui:VisualElement name="hero-lore-section" class="hero-lore-section">
                        <ui:Label name="hero-backstory" class="hero-backstory" text="" />
                    </ui:VisualElement>
                    <ui:VisualElement name="synergy-detail-section" class="synergy-detail-section">
                        <ui:Label name="synergy-detail-header" class="section-header" text="SYNERGY" />
                        <ui:Label name="hero-synergy-detail" class="hero-synergy-detail" text="" />
                    </ui:VisualElement>
                    <ui:VisualElement name="brands-section" class="brands-section">
                        <ui:Label name="brands-header" class="section-header" text="BRANDS" />
                        <ui:Label name="hero-brands-detail" class="hero-brands-detail" text="" />
                    </ui:VisualElement>
                </ui:VisualElement>

            </ui:VisualElement>
        </ui:VisualElement>

        <!-- TOP BAR: Navigation -->
        <ui:Button name="btn-back" class="btn-back" text="&#x25C0; BACK" />

        <!-- HERO INDEX: Absolute-positioned at top-center -->
        <ui:Label name="hero-index" class="hero-index" text="HERO 1 / 4" picking-mode="Ignore" />

        <!-- BOTTOM LAYER: Unified bar — Carousel + Embark in same row -->
        <ui:VisualElement name="bottom-layer" class="bottom-layer">
            <ui:Button name="btn-prev" class="nav-arrow nav-arrow-left" text="&#x25C0;" />
            <ui:VisualElement name="carousel-container" class="carousel-container" style="flex-grow: 1;">
                <ui:VisualElement name="carousel-strip" class="carousel-strip">
                    <!-- Carousel cards generated dynamically -->
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Button name="btn-next" class="nav-arrow nav-arrow-right" text="&#x25B6;" />

            <!-- EMBARK AREA: Sits to the right of carousel in same row -->
            <ui:VisualElement name="embark-area" class="embark-area">
                <ui:Button name="btn-embark" class="btn-embark">
                    <ui:VisualElement name="embark-hex-bg" class="embark-hex-bg" />
                    <ui:VisualElement name="embark-glow" class="embark-glow" />
                    <ui:Label name="embark-text" class="embark-text" text="EMBARK AS VEX" />
                    <ui:Label name="embark-subtitle" class="embark-subtitle" text="HOLD TO EMBARK" />
                </ui:Button>
                <ui:VisualElement name="embark-progress-ring" class="embark-progress-ring" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- CINEMATIC OVERLAY SYSTEM (Highest Z-Index, all non-interactive) -->
        <ui:VisualElement name="cinematic-overlays" class="cinematic-overlays" picking-mode="Ignore">
            <ui:VisualElement name="scanlines" class="overlay-scanlines" picking-mode="Ignore" />
            <ui:VisualElement name="vignette-outer" class="overlay-vignette" picking-mode="Ignore" />
            <ui:VisualElement name="veil-glow" class="overlay-veil-glow" picking-mode="Ignore" />
        </ui:VisualElement>

        <!-- TOAST NOTIFICATION (hidden by default) -->
        <ui:VisualElement name="toast-container" class="toast-container toast-hidden">
            <ui:VisualElement name="toast-content" class="toast-content">
                <ui:VisualElement name="toast-icon" class="toast-icon" />
                <ui:Label name="toast-message" class="toast-message" text="" />
            </ui:VisualElement>
            <ui:VisualElement name="toast-actions" class="toast-actions">
                <ui:Button name="btn-toast-retry" class="toast-btn" text="RETRY" />
                <ui:Button name="btn-toast-back" class="toast-btn" text="BACK TO MENU" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- SKELETON LOADING OVERLAY (hidden by default) -->
        <ui:VisualElement name="skeleton-overlay" class="skeleton-overlay hidden" />

    </ui:VisualElement>
</ui:UXML>
