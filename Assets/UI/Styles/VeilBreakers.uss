/* =============================================================================
   VEILBREAKERS - MAIN STYLESHEET
   Dark Fantasy Horror Theme
   ============================================================================= */

/* =============================================================================
   GLOBAL FONT - Required for text rendering in UI Toolkit
   ============================================================================= */

* {
    -unity-font-definition: url('project://database/Assets/UI/Fonts/Cinzel-Variable.ttf?fileID=12800000&guid=c7b3e9f2a4d816543e8c1a0b5f927d4e&type=3');
}

/* UIDocument wraps UXML content in a TemplateContainer — it must grow to
   fill the viewport, otherwise all content collapses to zero height. */
TemplateContainer {
    flex-grow: 1;
}

/* =============================================================================
   CSS VARIABLES (Custom Properties)
   ============================================================================= */

:root {
    /* Primary Colors - Dark Fantasy Palette */
   --color-background-dark: rgb(15, 12, 20);
   --color-background-medium: rgb(28, 20, 25);
   --color-background-light: rgb(45, 30, 38);

   /* Accent Colors - Corruption/Brand themed */
   --color-accent-red: rgb(180, 80, 20);
   --color-accent-red-glow: rgb(255, 140, 50);
   --color-accent-crimson: rgb(180, 80, 20);
   --color-accent-crimson-glow: rgb(255, 140, 50);
   --color-accent-gold: rgb(200, 160, 80);
   --color-accent-cyan: rgb(60, 180, 200);

    /* Text Colors */
    --color-text-primary: rgb(230, 220, 210);
    --color-text-secondary: rgb(160, 150, 140);
    --color-text-disabled: rgb(100, 90, 80);
    --color-text-highlight: rgb(255, 240, 200);

    /* UI Element Colors */
    --color-border: rgb(70, 45, 55);
    --color-border-highlight: rgb(120, 60, 80);
    --color-panel: rgba(25, 15, 20, 0.9);
    --color-panel-hover: rgba(45, 28, 35, 0.95);

    /* Health/Resource Colors */
    --color-health: rgb(180, 50, 50);
    --color-health-low: rgb(220, 40, 40);
    --color-mana: rgb(60, 100, 180);
    --color-stamina: rgb(60, 160, 80);
    --color-guard: rgb(80, 140, 200);
    --color-fury: rgb(200, 80, 40);
    --color-damage-ghost: rgba(200, 60, 60, 0.5);
    --color-heal-ghost: rgba(60, 200, 80, 0.5);

    /* AAA Transition Timings */
    --transition-fast: 0.1s;
    --transition-normal: 0.2s;
    --transition-slow: 0.35s;
    --transition-emphasis: 0.5s;

    /* Corruption State Colors */
    --color-corruption-ascended: rgb(255, 215, 0);
    --color-corruption-purified: rgb(180, 220, 255);
    --color-corruption-unstable: rgb(180, 180, 180);
    --color-corruption-corrupted: rgb(160, 50, 80);
    --color-corruption-abyssal: rgb(80, 10, 40);

    /* Spacing */
    --spacing-xs: 4px;
    --spacing-sm: 8px;
    --spacing-md: 16px;
    --spacing-lg: 24px;
    --spacing-xl: 32px;

    /* Border Radius */
    --radius-sm: 4px;
    --radius-md: 8px;
    --radius-lg: 12px;

    /* Font Sizes */
    --font-size-xs: 12px;
    --font-size-sm: 14px;
    --font-size-md: 16px;
    --font-size-lg: 20px;
    --font-size-xl: 24px;
    --font-size-title: 32px;
    --font-size-header: 48px;
}

/* =============================================================================
   BASE ELEMENTS
   ============================================================================= */

.vb-root {
    flex-grow: 1;
    /* Transparent to allow 3D VFX to show through */
    background-color: transparent;
}

/* =============================================================================
   TYPOGRAPHY
   ============================================================================= */

.vb-text {
    color: var(--color-text-primary);
    font-size: var(--font-size-md);
    -unity-font-style: normal;
}

.vb-text-secondary {
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
}

.vb-text-highlight {
    color: var(--color-text-highlight);
    -unity-font-style: bold;
}

.vb-title {
    color: var(--color-text-primary);
    font-size: var(--font-size-title);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 2px;
}

.vb-header {
    color: var(--color-accent-gold);
    font-size: var(--font-size-header);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 4px;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.8);
}

/* =============================================================================
   PANELS & CONTAINERS
   ============================================================================= */

.vb-panel {
    background-color: var(--color-panel);
    border-color: var(--color-border);
    border-width: 2px;
    border-radius: var(--radius-md);
    padding: var(--spacing-md);
}

.vb-panel-dark {
    background-color: rgba(10, 8, 15, 0.95);
    border-color: var(--color-border);
    border-width: 2px;
    border-radius: var(--radius-md);
    padding: var(--spacing-md);
}

.vb-panel-glow {
    background-color: var(--color-panel);
    border-color: var(--color-accent-crimson);
    border-width: 2px;
    border-radius: var(--radius-md);
    padding: var(--spacing-md);
}

.vb-card {
    background-color: var(--color-background-medium);
    border-color: var(--color-border);
    border-width: 1px;
    border-radius: var(--radius-sm);
    padding: var(--spacing-sm);
    margin: var(--spacing-xs);
}

.vb-card:hover {
    background-color: var(--color-panel-hover);
    border-color: var(--color-border-highlight);
}

/* =============================================================================
   BUTTONS
   ============================================================================= */

.vb-button {
    background-color: var(--color-background-light);
    border-color: var(--color-border);
    border-width: 2px;
    border-radius: var(--radius-sm);
    padding: var(--spacing-sm) var(--spacing-md);
    color: var(--color-text-primary);
    font-size: var(--font-size-md);
    -unity-font-style: bold;
    cursor: link;

    /* AAA Transition System - Multi-property with staggered timing */
    transition-property: scale, background-color, border-color, translate, opacity;
    transition-duration: 0.12s, 0.18s, 0.18s, 0.08s, 0.15s;
    transition-timing-function: ease-out-cubic;

    /* Base state */
    scale: 1 1;
    translate: 0 0;
    opacity: 1;
}

.vb-button:hover {
    background-color: var(--color-background-medium);
    border-color: var(--color-accent-crimson);
    color: var(--color-text-highlight);
    scale: 1.03 1.03;
    translate: 0 -2px;
}

.vb-button:active {
    background-color: var(--color-accent-crimson);
    scale: 0.97 0.97;
    translate: 0 2px;
    transition-property: scale, translate;
    transition-duration: 0.08s;
    transition-timing-function: ease-out;
}

.vb-button:disabled {
    background-color: var(--color-background-dark);
    border-color: var(--color-border);
    color: var(--color-text-disabled);
    cursor: arrow;
}

.vb-button-primary {
    background-color: var(--color-accent-red);
    border-color: var(--color-accent-red-glow);
    color: white;
}

.vb-button-primary:hover {
    background-color: var(--color-accent-red-glow);
    border-color: rgb(255, 100, 120);
}

.vb-button-secondary {
    background-color: var(--color-accent-crimson);
    border-color: var(--color-accent-crimson-glow);
    color: white;
}

.vb-button-large {
    font-size: var(--font-size-lg);
    padding: var(--spacing-md) var(--spacing-xl);
    min-width: 200px;
    min-height: 50px;
}

/* =============================================================================
   INPUT FIELDS
   ============================================================================= */

.vb-textfield {
    background-color: var(--color-background-dark);
    border-color: var(--color-border);
    border-width: 2px;
    border-radius: var(--radius-sm);
    padding: var(--spacing-sm);
    color: var(--color-text-primary);
    font-size: var(--font-size-md);
}

.vb-textfield:focus {
    border-color: var(--color-accent-crimson);
}

.vb-textfield > .unity-text-field__input {
    background-color: transparent;
    border-width: 0;
    color: var(--color-text-primary);
}

/* =============================================================================
   SLIDERS
   ============================================================================= */

.vb-slider {
    min-height: 30px;
}

.vb-slider .unity-base-slider__dragger {
    background-color: rgb(180, 80, 20);
    border-radius: 50%;
    width: 20px;
    height: 20px;
    margin-top: -8px;
}

.vb-slider .unity-base-slider__tracker {
    background-color: var(--color-background-light);
    border-radius: var(--radius-sm);
    height: 6px;
}

.vb-slider .unity-base-slider__drag-container {
    background-color: rgb(200, 100, 30);
    border-radius: var(--radius-sm);
}

/* =============================================================================
   TOGGLE / CHECKBOX
   ============================================================================= */

.vb-toggle {
    flex-direction: row;
    align-items: center;
}

.vb-toggle .unity-toggle__checkmark {
    background-color: var(--color-background-dark);
    border-color: var(--color-border);
    border-width: 2px;
    border-radius: var(--radius-sm);
    width: 24px;
    height: 24px;
}

.vb-toggle:checked .unity-toggle__checkmark {
    background-color: rgb(180, 80, 20);
    border-color: rgb(255, 140, 50);
}

.vb-toggle .unity-toggle__text {
    color: var(--color-text-primary);
    font-size: var(--font-size-md);
    margin-left: var(--spacing-sm);
}

/* =============================================================================
   DROPDOWN
   ============================================================================= */

.vb-dropdown {
    background-color: rgb(28, 20, 25);
    border-color: rgb(70, 45, 55);
    border-width: 2px;
    border-radius: 4px;
    padding: 8px 12px;
    min-height: 36px;
    flex-direction: row;
    align-items: center;
}

.vb-dropdown:hover {
    border-color: rgb(180, 80, 20);
    background-color: rgb(40, 30, 38);
}

.vb-dropdown:focus {
    border-color: rgb(255, 140, 50);
}

.vb-dropdown__display {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    height: 100%;
    flex-grow: 1;
}

.vb-dropdown__text {
    color: rgb(200, 190, 180);
    font-size: 14px;
    -unity-text-align: middle-left;
    flex-grow: 1;
}

.vb-dropdown__arrow {
    color: rgb(165, 155, 145);
    font-size: 12px;
    margin-left: 8px;
}

.vb-dropdown--open {
    border-color: rgb(255, 140, 50);
}

.vb-dropdown-popup {
    background-color: rgb(18, 14, 18);
    border-color: rgb(180, 80, 20);
    border-width: 2px;
    border-radius: 8px;
    padding: 6px;
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.55);
}

.vb-dropdown-popup__scroll {
    max-height: 280px;
}

.vb-dropdown-item {
    background-color: transparent;
    border-width: 0;
    padding: 10px 14px;
    margin: 2px 0;
    border-radius: 6px;
    color: rgb(200, 190, 180);
    font-size: 14px;
    -unity-text-align: middle-left;
    transition-duration: 0.15s;
    cursor: link;
}

.vb-dropdown-item:hover {
    background-color: rgba(180, 80, 20, 0.3);
    color: rgb(235, 225, 215);
}

.vb-dropdown-item--selected {
    background-color: rgb(180, 80, 20);
    color: rgb(255, 255, 255);
}

/* CRITICAL: Force popup layer to be transparent - prevents purple overlay bug */
#vb-dropdown-popup-layer {
    background-color: rgba(0, 0, 0, 0) !important;
}

/* Dropdown container styling - DO NOT override position/z-index (breaks Unity's placement) */
.unity-base-dropdown__container-outer {
    background-color: rgb(18, 14, 18);
    border-color: rgb(180, 80, 20);
    border-width: 2px;
    border-radius: 8px;
    padding: 8px;
    margin-top: 2px;
    min-width: 200px;
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.55);
    max-height: 280px;
    overflow-y: auto;
}

.unity-base-dropdown__container-inner {
    background-color: rgb(18, 14, 18);
    padding: 4px;
}

.unity-base-dropdown__item {
    background-color: transparent;
    padding: 10px 16px;
    margin: 2px 0;
    border-radius: 6px;
    transition-duration: 0.15s;
}

.unity-base-dropdown__item:hover {
    background-color: rgba(180, 80, 20, 0.3);
}

.unity-base-dropdown__item:checked {
    background-color: rgb(180, 80, 20);
}

/* Dropdown scroll view fix */
.unity-base-dropdown .unity-scroll-view {
    max-height: 300px;
}

/* Dropdown Scrollbar - Thin crimson styled */
.unity-base-dropdown .unity-scroller--vertical {
    width: 8px;
    margin-right: 2px;
}

.unity-base-dropdown .unity-scroller--vertical .unity-base-slider__tracker {
    background-color: rgba(50, 35, 42, 0.5);
    border-radius: 4px;
    margin: 0;
}

.unity-base-dropdown .unity-scroller--vertical .unity-base-slider__dragger {
    background-color: rgba(180, 80, 20, 0.8);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(255, 140, 50, 0.4);
}

.unity-base-dropdown .unity-scroller--vertical .unity-base-slider__dragger:hover {
    background-color: rgb(210, 100, 30);
    border-color: rgba(255, 160, 70, 0.6);
}

.unity-base-dropdown .unity-scroller--vertical .unity-base-slider__dragger:active {
    background-color: rgb(255, 140, 50);
}

.unity-base-dropdown__label {
    color: rgb(200, 190, 180);
    font-size: 14px;
}

.unity-base-dropdown__item:hover .unity-base-dropdown__label {
    color: rgb(235, 225, 215);
}

.unity-base-dropdown__item:checked .unity-base-dropdown__label {
    color: rgb(255, 255, 255);
}

.unity-base-dropdown__checkmark {
    -unity-background-image-tint-color: rgb(120, 200, 150);
}

/* =============================================================================
   SCROLLVIEW
   ============================================================================= */

.vb-scrollview {
    background-color: transparent;
}

.vb-scrollview .unity-scroller--vertical {
    width: 14px;
    margin-left: 6px;
}

.vb-scrollview .unity-scroller--vertical .unity-base-slider__dragger {
    background-color: var(--color-accent-crimson);
    border-radius: 6px;
    width: 10px;
    margin-left: 2px;
    min-height: 40px;
    transition-duration: 0.15s;
    cursor: link;
}

.vb-scrollview .unity-scroller--vertical .unity-base-slider__dragger:hover {
    background-color: var(--color-accent-crimson-glow);
    width: 12px;
    margin-left: 1px;
}

.vb-scrollview .unity-scroller--vertical .unity-base-slider__tracker {
    background-color: rgba(40, 32, 50, 0.8);
    border-radius: 7px;
    border-width: 1px;
    border-color: rgba(100, 50, 65, 0.3);
    cursor: link;
}

/* =============================================================================
   PROGRESS BARS
   ============================================================================= */

.vb-progressbar {
    height: 20px;
    background-color: var(--color-background-dark);
    border-color: var(--color-border);
    border-width: 1px;
    border-radius: var(--radius-sm);
    overflow: hidden;
}

.vb-progressbar-fill {
    background-color: var(--color-accent-crimson);
    height: 100%;
    transition-duration: 0.3s;
}

.vb-healthbar-fill {
    background-color: var(--color-health);
}

.vb-healthbar-low .vb-healthbar-fill {
    background-color: var(--color-health-low);
}

.vb-manabar-fill {
    background-color: var(--color-mana);
}

/* =============================================================================
   LISTS & GRIDS
   ============================================================================= */

.vb-list-item {
    background-color: transparent;
    border-color: transparent;
    border-width: 1px;
    border-radius: var(--radius-sm);
    padding: var(--spacing-sm);
    margin: var(--spacing-xs) 0;
}

.vb-list-item:hover {
    background-color: var(--color-panel-hover);
    border-color: var(--color-border-highlight);
}

.vb-list-item:selected {
    background-color: var(--color-accent-crimson);
    border-color: var(--color-accent-crimson-glow);
}

.vb-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-start;
    align-items: flex-start;
}

.vb-grid-item {
    width: 100px;
    height: 100px;
    margin: var(--spacing-xs);
    background-color: var(--color-background-medium);
    border-color: var(--color-border);
    border-width: 1px;
    border-radius: var(--radius-sm);
}

/* =============================================================================
   TOOLTIPS
   ============================================================================= */

.vb-tooltip {
    background-color: rgba(10, 8, 15, 0.98);
    border-color: var(--color-accent-crimson);
    border-width: 1px;
    border-radius: var(--radius-sm);
    padding: var(--spacing-sm) var(--spacing-md);
    max-width: 300px;
}

.vb-tooltip-title {
    color: var(--color-text-highlight);
    font-size: var(--font-size-md);
    -unity-font-style: bold;
    margin-bottom: var(--spacing-xs);
}

.vb-tooltip-text {
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
}

/* =============================================================================
   ICONS & IMAGES
   ============================================================================= */

.vb-icon {
    width: 32px;
    height: 32px;
    -unity-background-scale-mode: scale-to-fit;
}

.vb-icon-small {
    width: 24px;
    height: 24px;
}

.vb-icon-large {
    width: 48px;
    height: 48px;
}

.vb-portrait {
    width: 64px;
    height: 64px;
    border-color: var(--color-border);
    border-width: 2px;
    border-radius: var(--radius-sm);
    -unity-background-scale-mode: scale-to-fit;
}

/* =============================================================================
   DIVIDERS & SEPARATORS
   ============================================================================= */

.vb-divider-horizontal {
    height: 2px;
    background-color: var(--color-border);
    margin: var(--spacing-md) 0;
}

.vb-divider-vertical {
    width: 2px;
    background-color: var(--color-border);
    margin: 0 var(--spacing-md);
}

/* =============================================================================
   LAYOUT UTILITIES
   ============================================================================= */

.vb-row {
    flex-direction: row;
    align-items: center;
}

.vb-column {
    flex-direction: column;
}

.vb-center {
    justify-content: center;
    align-items: center;
}

.vb-space-between {
    justify-content: space-between;
}

.vb-flex-grow {
    flex-grow: 1;
}

.vb-margin-sm { margin: var(--spacing-sm); }
.vb-margin-md { margin: var(--spacing-md); }
.vb-margin-lg { margin: var(--spacing-lg); }

.vb-padding-sm { padding: var(--spacing-sm); }
.vb-padding-md { padding: var(--spacing-md); }
.vb-padding-lg { padding: var(--spacing-lg); }

/* =============================================================================
   ANIMATIONS
   ============================================================================= */

.vb-fade-in {
    opacity: 1;
    transition-property: opacity;
    transition-duration: 0.3s;
}

.vb-fade-out {
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.3s;
}

.vb-pulse {
    transition-property: scale;
    transition-duration: 0.5s;
}

.vb-pulse:hover {
    scale: 1.05;
}

/* =============================================================================
   MAIN MENU SPECIFIC STYLES
   ============================================================================= */

/* Main menu buttons - larger, more prominent - CRIMSON THEME */
.menu-button-main {
    min-width: 100%;
    min-height: 54px;
    font-size: 18px;
    letter-spacing: 2px;
    background-color: rgb(180, 80, 20);
    border-color: rgb(255, 140, 50);
    border-width: 2px;
    border-radius: 4px;
    color: rgb(235, 225, 215);
    -unity-font-style: bold;
    transition-duration: 0.2s;
    transition-property: background-color, border-color, scale, translate;
}

.menu-button-main:hover {
    background-color: rgb(200, 60, 80);
    border-color: rgb(255, 100, 120);
    scale: 1.02;
    translate: -2px 0;
}

.menu-button-main:active {
    background-color: rgb(140, 30, 50);
    scale: 0.98;
}

/* Secondary menu buttons - smaller, less prominent */
.menu-button-secondary {
    min-width: 100%;
    min-height: 44px;
    font-size: 14px;
    letter-spacing: 1px;
    background-color: rgba(26, 20, 28, 0.85);
    border-color: rgb(70, 45, 55);
    border-width: 1px;
    border-radius: 4px;
    color: rgb(185, 210, 200);
    -unity-font-style: normal;
    transition-duration: 0.15s;
    transition-property: background-color, border-color, color, translate;
}

.menu-button-secondary:hover {
    background-color: rgba(80, 40, 50, 0.9);
    border-color: rgb(180, 50, 70);
    color: rgb(235, 225, 215);
    translate: -2px 0;
}

.menu-button-secondary:active {
    background-color: rgb(22, 44, 36);
}

/* Exit button - special styling with hover animation */
.menu-button-exit {
    background-color: rgba(30, 25, 40, 0.6);
    border-color: rgba(180, 50, 70, 0.3);
    color: rgb(120, 100, 95);
}

.menu-button-exit:hover {
    background-color: rgba(100, 30, 40, 0.9);
    border-color: rgb(200, 60, 80);
    color: rgb(255, 200, 200);
    translate: -3px 0;
    scale: 1.02;
}

.menu-button-exit:active {
    background-color: rgb(120, 40, 50);
    scale: 0.98;
}

/* Button glow effect element (inner child for animation) */
.button-glow {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    border-radius: 4px;
    opacity: 0;
    transition-duration: 0.3s;
}

.menu-button-main:hover .button-glow {
    opacity: 1;
}

/* Menu background layer styles */
.menu-bg-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* =============================================================================
   CHARACTER SELECT SPECIFIC STYLES
   ============================================================================= */

/* Hero card in the list */
.hero-card {
    flex-direction: row;
    align-items: center;
    padding: 12px;
    margin-bottom: 8px;
    background-color: rgb(28, 20, 25);
    border-color: rgb(70, 45, 55);
    border-width: 1px;
    border-radius: 4px;
    transition-duration: 0.15s;
    transition-property: background-color, border-color, scale;
    cursor: link;
}

.hero-card:hover {
    background-color: rgb(40, 25, 32);
    border-color: rgb(120, 50, 70);
}

.hero-card.selected {
    background-color: rgb(50, 25, 35);
    border-color: rgb(180, 80, 20);
}

/* Hero-specific colors - Applied per character */
.hero-card.hero-mirage {
    border-color: var(--hero-mirage);
}

.hero-card.hero-mirage:hover,
.hero-card.hero-mirage.selected {
    border-color: var(--hero-mirage-glow);
    box-shadow: 0 0 16px rgba(40, 200, 80, 0.4);
}

.hero-card.hero-bastion {
    border-color: var(--hero-bastion);
}

.hero-card.hero-bastion:hover,
.hero-card.hero-bastion.selected {
    border-color: var(--hero-bastion-glow);
    box-shadow: 0 0 16px rgba(60, 140, 220, 0.4);
}

.hero-card.hero-marrow {
    border-color: var(--hero-marrow);
}

.hero-card.hero-marrow:hover,
.hero-card.hero-marrow.selected {
    border-color: var(--hero-marrow-glow);
    box-shadow: 0 0 16px rgba(160, 80, 200, 0.4);
}

.hero-card.hero-rend {
    border-color: var(--hero-rend);
}

.hero-card.hero-rend:hover,
.hero-card.hero-rend.selected {
    border-color: var(--hero-rend-glow);
    box-shadow: 0 0 16px rgba(140, 30, 30, 0.4);
}

/* NEW HEROES v2.0 */
.hero-card.hero-vex {
    border-color: var(--hero-vex);
}

.hero-card.hero-vex:hover,
.hero-card.hero-vex.selected {
    border-color: var(--hero-vex-glow);
    box-shadow: 0 0 16px rgba(140, 128, 115, 0.4);
}

.hero-card.hero-seraphina {
    border-color: var(--hero-seraphina);
}

.hero-card.hero-seraphina:hover,
.hero-card.hero-seraphina.selected {
    border-color: var(--hero-seraphina-glow);
    box-shadow: 0 0 16px rgba(165, 50, 90, 0.4);
}

.hero-card.hero-orion {
    border-color: var(--hero-orion);
}

.hero-card.hero-orion:hover,
.hero-card.hero-orion.selected {
    border-color: var(--hero-orion-glow);
    box-shadow: 0 0 16px rgba(40, 165, 240, 0.4);
}

.hero-card.hero-nyx {
    border-color: var(--hero-nyx);
}

.hero-card.hero-nyx:hover,
.hero-card.hero-nyx.selected {
    border-color: var(--hero-nyx-glow);
    box-shadow: 0 0 16px rgba(100, 40, 120, 0.4);
}

.hero-card-portrait {
    width: 50px;
    height: 50px;
    background-color: rgb(28, 20, 25);
    border-radius: 4px;
    margin-right: 12px;
    -unity-background-scale-mode: scale-to-fit;
}

.hero-card-name {
    color: rgb(235, 225, 215);
    font-size: 16px;
    -unity-font-style: bold;
}

/* Brand badge display */
.brand-badge {
    flex-direction: row;
    align-items: center;
    background-color: rgba(40, 32, 50, 0.8);
    border-radius: 4px;
    padding: 6px 10px;
}

.brand-icon {
    width: 20px;
    height: 20px;
    border-radius: 4px;
    margin-right: 8px;
}

.brand-name {
    color: rgb(235, 225, 215);
    font-size: 14px;
}

/* Stat bars */
.stat-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.stat-bar-bg {
    flex-grow: 1;
    height: 8px;
    background-color: rgb(28, 20, 25);
    border-radius: 4px;
    overflow: hidden;
}

.stat-bar-fill {
    height: 100%;
    border-radius: 4px;
    transition-duration: 0.3s;
    transition-property: width;
}

/* Ability cards */
.ability-card {
    flex-direction: row;
    align-items: center;
    padding: 10px;
    background-color: rgb(28, 20, 25);
    border-color: rgb(50, 35, 42);
    border-width: 1px;
    border-radius: 4px;
}

.ability-card:hover {
    background-color: rgb(40, 30, 38);
    border-color: rgb(70, 45, 55);
}

.ability-icon {
    width: 40px;
    height: 40px;
    background-color: rgb(45, 30, 38);
    border-radius: 4px;
    margin-right: 12px;
    -unity-background-scale-mode: scale-to-fit;
}

.ability-name {
    color: rgb(235, 225, 215);
    font-size: 14px;
    -unity-font-style: bold;
    margin-bottom: 2px;
}

.ability-desc {
    color: rgb(165, 155, 145);
    font-size: 12px;
}

/* =============================================================================
   INVENTORY UI
   ============================================================================= */

/* Category Tabs */
.inventory-tab {
    flex-grow: 1;
    height: 36px;
    background-color: transparent;
    border-width: 0;
    border-radius: 6px;
    color: rgb(165, 155, 145);
    font-size: 12px;
    letter-spacing: 1px;
    margin: 2px;
    transition-duration: 0.15s;
}

.inventory-tab:hover {
    background-color: rgba(180, 80, 20, 0.2);
    color: rgb(200, 190, 180);
}

.inventory-tab-active {
    background-color: rgb(180, 80, 20);
    color: rgb(235, 225, 215);
}

.inventory-tab-active:hover {
    background-color: rgb(160, 50, 80);
}

/* Item Grid Slots */
.item-slot {
    width: 72px;
    height: 72px;
    margin: 4px;
    background-color: rgb(28, 20, 25);
    border-width: 2px;
    border-color: rgb(50, 35, 42);
    border-radius: 6px;
    justify-content: center;
    align-items: center;
    transition-duration: 0.15s;
}

.item-slot:hover {
    border-color: rgb(180, 80, 20);
    background-color: rgb(40, 30, 38);
}

.item-slot-selected {
    border-color: rgb(255, 140, 50);
    background-color: rgb(50, 32, 42);
}

.item-slot-empty {
    background-color: rgb(18, 14, 25);
    border-style: dashed;
    border-color: rgb(35, 30, 45);
}

/* Item icon within slot */
.item-slot-icon {
    width: 48px;
    height: 48px;
    -unity-background-scale-mode: scale-to-fit;
}

/* Item quantity badge */
.item-quantity-badge {
    position: absolute;
    right: 2px;
    bottom: 2px;
    background-color: rgba(0, 0, 0, 0.8);
    padding: 2px 6px;
    border-radius: 4px;
}

.item-quantity-text {
    color: rgb(235, 225, 215);
    font-size: 11px;
    -unity-font-style: bold;
}

/* Rarity borders */
.rarity-common {
    border-color: rgb(120, 120, 120);
}

.rarity-uncommon {
    border-color: rgb(60, 180, 80);
}

.rarity-rare {
    border-color: rgb(60, 120, 220);
}

.rarity-epic {
    border-color: rgb(180, 50, 80);
}

.rarity-legendary {
    border-color: rgb(220, 160, 40);
}

.rarity-mythic {
    border-color: rgb(255, 80, 80);
    border-width: 3px;
}

/* Item icon frame (for detail panel) */
.item-icon-frame {
    background-color: rgb(28, 20, 25);
    border-width: 3px;
    border-radius: 8px;
    padding: 8px;
}

/* Stat display rows */
.item-stat-row {
    flex-direction: row;
    justify-content: space-between;
    padding: 6px 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(60, 50, 75, 0.3);
}

.item-stat-name {
    color: rgb(165, 155, 145);
    font-size: 13px;
}

.item-stat-value {
    font-size: 13px;
    -unity-font-style: bold;
}

.item-stat-positive {
    color: rgb(80, 200, 120);
}

.item-stat-negative {
    color: rgb(220, 80, 80);
}

/* Effect display */
.item-effect {
    padding: 8px;
    margin-bottom: 6px;
    background-color: rgba(180, 80, 20, 0.1);
    border-radius: 4px;
    border-left-width: 3px;
    border-left-color: rgb(180, 80, 20);
}

.item-effect-text {
    color: rgb(200, 190, 180);
    font-size: 13px;
}

/* Dropdown styling - see main dropdown section above */

/* Danger button for drop/discard */
.vb-button-danger {
    background-color: rgb(120, 40, 40);
    border-color: rgb(160, 60, 60);
}

.vb-button-danger:hover {
    background-color: rgb(150, 50, 50);
    border-color: rgb(180, 80, 80);
}

.vb-button-danger:active {
    background-color: rgb(100, 30, 30);
}

/* =============================================================================
   MONSTER COLLECTION UI
   ============================================================================= */

/* Monster card in grid */
.monster-card {
    width: 100px;
    height: 120px;
    margin: 6px;
    background-color: rgb(28, 20, 25);
    border-width: 2px;
    border-color: rgb(50, 35, 42);
    border-radius: 8px;
    padding: 8px;
    flex-direction: column;
    align-items: center;
    transition-duration: 0.15s;
}

.monster-card:hover {
    border-color: rgb(180, 80, 20);
    background-color: rgb(40, 30, 38);
    scale: 1.02;
}

.monster-card-selected {
    border-color: rgb(255, 140, 50);
    background-color: rgb(50, 32, 42);
}

/* Monster portrait in card */
.monster-card-portrait {
    width: 64px;
    height: 64px;
    background-color: rgb(40, 30, 38);
    border-radius: 4px;
    margin-bottom: 6px;
    -unity-background-scale-mode: scale-to-fit;
}

.monster-card-name {
    color: rgb(200, 190, 180);
    font-size: 11px;
    -unity-text-align: middle-center;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 84px;
}

.monster-card-level {
    color: rgb(165, 155, 145);
    font-size: 10px;
}

/* Corruption glow effects */
.corruption-low {
    border-color: rgb(60, 120, 80);
}

.corruption-medium {
    border-color: rgb(180, 150, 60);
}

.corruption-high {
    border-color: rgb(180, 80, 80);
}

.corruption-critical {
    border-color: rgb(180, 80, 20);
    border-width: 3px;
}

/* Corruption bar */
.corruption-bar-bg {
    height: 12px;
    background-color: rgb(28, 20, 25);
    border-radius: 6px;
    overflow: hidden;
}

/* Monster stat item */
.monster-stat-item {
    flex-direction: column;
    align-items: flex-start;
    padding: 4px;
}

/* Skill display in list */
.monster-skill {
    flex-direction: row;
    align-items: center;
    padding: 8px;
    margin-bottom: 4px;
    background-color: rgb(30, 24, 40);
    border-radius: 4px;
    border-left-width: 3px;
    border-left-color: rgb(180, 80, 20);
}

.monster-skill:hover {
    background-color: rgb(45, 30, 38);
}

.monster-skill-icon {
    width: 24px;
    height: 24px;
    background-color: rgb(50, 35, 42);
    border-radius: 4px;
    margin-right: 10px;
}

.monster-skill-name {
    color: rgb(200, 190, 180);
    font-size: 13px;
    flex-grow: 1;
}

.monster-skill-brand {
    width: 16px;
    height: 16px;
    border-radius: 8px;
}

/* Text field styling */
.vb-text-field {
    background-color: rgb(28, 20, 25);
    border-color: rgb(70, 45, 55);
    border-width: 1px;
    border-radius: 4px;
    padding: 6px 12px;
    color: rgb(200, 190, 180);
    font-size: 13px;
}

.vb-text-field:hover {
    border-color: rgb(120, 50, 70);
}

.vb-text-field:focus {
    border-color: rgb(180, 80, 20);
}

.vb-text-field > .unity-text-field__input {
    background-color: transparent;
    border-width: 0;
    color: rgb(200, 190, 180);
}

/* =============================================================================
   VERA DIALOGUE UI
   ============================================================================= */

/* Main dialogue box */
.dialogue-box {
    background-color: rgba(12, 10, 18, 0.95);
    border-width: 2px;
    border-color: rgb(70, 45, 55);
    border-radius: 12px;
    overflow: hidden;
}

.dialogue-box-glitched {
    border-color: rgb(180, 80, 20);
}

/* Glitch overlay effect */
.dialogue-glitch-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(160, 60, 120, 0.1);
    border-radius: 12px;
}

/* VERA Portrait */
.vera-portrait-frame {
    width: 100px;
    height: 100px;
    background-color: rgb(20, 16, 28);
    border-radius: 50px;
    border-width: 3px;
    border-color: rgb(180, 80, 20);
    justify-content: center;
    align-items: center;
    overflow: hidden;
}

.vera-portrait-frame-glitched {
    border-color: rgb(180, 80, 20);
}

.vera-portrait-glow {
    position: absolute;
    left: -4px;
    top: -4px;
    right: -4px;
    bottom: -4px;
    border-radius: 54px;
    border-width: 2px;
    border-color: rgba(120, 200, 150, 0.5);
}

.vera-portrait-glow-corrupted {
    border-color: rgba(160, 60, 120, 0.7);
}

.vera-portrait {
    width: 80px;
    height: 80px;
    border-radius: 40px;
    background-color: rgb(70, 45, 55);
    -unity-background-scale-mode: scale-to-fit;
}

.vera-scanlines {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(160, 60, 120, 0.3);
    border-radius: 50px;
}

.vera-name {
    color: rgb(120, 200, 150);
    font-size: 14px;
    letter-spacing: 3px;
    -unity-font-style: bold;
}

.vera-name-glitched {
    color: rgb(180, 80, 20);
}

/* Integrity pip indicator */
.integrity-pip {
    width: 12px;
    height: 12px;
    border-radius: 6px;
    background-color: rgb(120, 200, 150);
}

.integrity-pip-warning {
    background-color: rgb(220, 180, 60);
}

.integrity-pip-critical {
    background-color: rgb(200, 60, 80);
}

.integrity-pip-corrupted {
    background-color: rgb(180, 80, 20);
}

/* Dialogue text */
.dialogue-text {
    color: rgb(220, 215, 210);
    font-size: 16px;
    white-space: normal;
    line-height: 1.5;
}

.dialogue-text-glitched {
    color: rgb(200, 140, 170);
}

/* Continue indicator */
.continue-hint {
    color: rgb(100, 90, 85);
    font-size: 11px;
    letter-spacing: 1px;
}

.continue-arrow {
    width: 0;
    height: 0;
    margin-left: 8px;
    border-left-width: 6px;
    border-right-width: 6px;
    border-top-width: 8px;
    border-left-color: transparent;
    border-right-color: transparent;
    border-top-color: rgb(100, 90, 85);
}

/* Choices container */
.dialogue-choices {
    background-color: rgba(8, 6, 12, 0.5);
}

/* Choice button */
.dialogue-choice {
    padding: 12px 20px;
    margin-bottom: 8px;
    background-color: rgb(28, 20, 25);
    border-width: 1px;
    border-color: rgb(70, 45, 55);
    border-radius: 6px;
    transition-duration: 0.15s;
}

.dialogue-choice:hover {
    background-color: rgb(45, 30, 38);
    border-color: rgb(180, 80, 20);
}

.dialogue-choice:active {
    background-color: rgb(55, 35, 45);
}

.dialogue-choice-text {
    color: rgb(200, 190, 180);
    font-size: 14px;
}

.dialogue-choice:hover .dialogue-choice-text {
    color: rgb(235, 225, 215);
}

/* Choice with consequence indicator */
.dialogue-choice-consequence {
    border-left-width: 3px;
    border-left-color: rgb(220, 180, 60);
}

.dialogue-choice-dangerous {
    border-left-color: rgb(200, 60, 80);
}

/* Veil Integrity bar */
.integrity-bar-bg {
    background-color: rgb(28, 20, 25);
    border-radius: 4px;
    overflow: hidden;
}

.integrity-bar-fill {
    height: 100%;
    background-color: rgb(120, 200, 150);
    border-radius: 4px;
    transition-duration: 0.3s;
    transition-property: width, background-color;
}

.integrity-bar-fill-warning {
    background-color: rgb(220, 180, 60);
}

.integrity-bar-fill-critical {
    background-color: rgb(200, 60, 80);
}

.integrity-bar-fill-corrupted {
    background-color: rgb(180, 80, 20);
}

/* =============================================================================
   AAA MENU BUTTON STYLES
   ============================================================================= */

/* Primary button with glow effect - MOLTEN ORANGE THEME */
.btn-primary {
    min-height: 54px;
    font-size: 16px;
    letter-spacing: 3px;
    -unity-font-style: bold;
    background-color: rgb(180, 80, 20);
    border-width: 2px;
    border-color: rgb(255, 140, 50);
    border-radius: 8px;
    color: rgb(255, 245, 220);
    padding: 14px 24px;
    transition-duration: 0.2s;
    transition-property: background-color, border-color, scale, translate;
}

.btn-primary:hover {
    background-color: rgb(210, 100, 30);
    border-color: rgb(255, 180, 80);
    scale: 1.02;
    translate: -2px 0;
}

.btn-primary:active {
    background-color: rgb(140, 60, 15);
    scale: 0.98;
}

.btn-secondary {
    min-height: 44px;
    font-size: 14px;
    letter-spacing: 2px;
    background-color: rgba(25, 18, 12, 0.95);
    border-width: 1px;
    border-color: rgb(120, 70, 30);
    border-radius: 6px;
    color: rgb(200, 160, 100);
    padding: 10px 20px;
    transition-duration: 0.15s;
    transition-property: background-color, border-color, color, translate;
}

.btn-secondary:hover {
    background-color: rgba(55, 35, 20, 0.98);
    border-color: rgb(180, 110, 50);
    color: rgb(255, 200, 130);
    translate: -2px 0;
}

.btn-secondary:active {
    background-color: rgba(15, 10, 5, 0.98);
}

.btn-tertiary {
    min-height: 40px;
    font-size: 12px;
    letter-spacing: 1px;
    background-color: transparent;
    border-width: 1px;
    border-color: rgba(100, 50, 65, 0.4);
    border-radius: 4px;
    color: rgb(120, 110, 100);
    padding: 8px 16px;
    transition-duration: 0.15s;
}

.btn-tertiary:hover {
    background-color: rgba(180, 50, 70, 0.2);
    border-color: rgba(180, 50, 70, 0.5);
    color: rgb(180, 50, 70);
}

/* =============================================================================
   AAA TITLE STYLES
   ============================================================================= */

.title-hero {
    font-size: 68px;
    letter-spacing: 8px;
    -unity-font-style: bold;
    color: rgb(235, 225, 215);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(180, 80, 20, 0.5);
}

.title-tagline {
    font-size: 14px;
    letter-spacing: 3px;
    color: rgb(165, 155, 145);
    -unity-font-style: italic;
}

/* =============================================================================
   AAA BACKGROUND & VIGNETTE STYLES
   ============================================================================= */

.bg-void {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(8, 6, 12);
}

.bg-vignette-top {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    height: 35%;
    background-color: rgba(0, 0, 0, 0.4);
}

.bg-vignette-bottom {
    position: absolute;
    left: 0;
    bottom: 0;
    right: 0;
    height: 35%;
    background-color: rgba(0, 0, 0, 0.5);
}

.bg-vignette-left {
    position: absolute;
    left: 0;
    top: 0;
    width: 25%;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.3);
}

.bg-vignette-right {
    position: absolute;
    right: 0;
    top: 0;
    width: 25%;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.3);
}

/* =============================================================================
   AAA DECORATED ELEMENTS
   ============================================================================= */

.divider-decorated {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.divider-line {
    flex-grow: 1;
    height: 1px;
    background-color: rgba(180, 80, 20, 0.3);
}

.divider-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: rgba(180, 80, 20, 0.5);
}

/* =============================================================================
   AAA FOOTER STYLES
   ============================================================================= */

.footer {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 16px 40px;
    background-color: rgba(8, 6, 12, 0.8);
    border-top-width: 1px;
    border-top-color: rgba(180, 80, 20, 0.2);
}

.footer-text {
    font-size: 11px;
    letter-spacing: 1px;
    color: rgb(80, 70, 65);
}

/* =============================================================================
   AAA LOADING OVERLAY
   ============================================================================= */

.loading-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(8, 6, 12, 0.95);
    justify-content: center;
    align-items: center;
}

.loading-spinner {
    width: 48px;
    height: 48px;
    border-width: 3px;
    border-color: rgba(180, 80, 20, 0.3);
    border-top-color: rgb(180, 80, 20);
    border-radius: 50%;
    margin-bottom: 20px;
}

.loading-text {
    font-size: 14px;
    letter-spacing: 4px;
    color: rgb(180, 80, 20);
}

/* =============================================================================
   AAA PARTICLE LAYERS
   ============================================================================= */

/* v2.63 FIX: overflow VISIBLE to prevent particle clipping */
.particle-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    overflow: visible;
}

/* =============================================================================
   AAA SETTINGS PANEL STYLES
   ============================================================================= */

.settings-panel-container {
    background-color: rgba(12, 9, 18, 0.95);
    border-width: 2px;
    border-color: rgba(180, 80, 20, 0.4);
    border-radius: 16px;
    padding: 32px;
    overflow: visible !important; /* CRITICAL: Allow dropdown popups to render outside panel */
}

/* Settings Close Button - Perfectly centered X */
.settings-panel-container #btn-close {
    transition: all 0.2s ease;
}

.settings-panel-container #btn-close:hover {
    border-color: rgb(255, 140, 50);
    color: rgb(255, 180, 100);
    scale: 1.05;
}

.settings-panel-container #btn-close:active {
    background-color: rgba(180, 80, 20, 0.2);
    scale: 0.95;
}

.settings-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
    padding-bottom: 16px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(180, 80, 20, 0.3);
}

.settings-title {
    font-size: 28px;
    letter-spacing: 6px;
    -unity-font-style: bold;
    color: rgb(235, 225, 215);
}

.settings-close-btn {
    width: 44px;
    height: 44px;
    font-size: 24px;
    background-color: transparent;
    border-width: 1px;
    border-color: rgba(180, 100, 30, 0.3);
    border-radius: 50%;
    color: rgb(200, 140, 80);
    transition-duration: 0.15s;
}

.settings-close-btn:hover {
    background-color: rgba(180, 80, 20, 0.2);
    border-color: rgb(255, 140, 50);
}

/* Settings Tab Bar */
.settings-tab-bar {
    flex-direction: row;
    margin-bottom: 24px;
    background-color: rgba(20, 16, 28, 0.5);
    border-radius: 8px;
    padding: 4px;
}

.settings-tab {
    flex-grow: 1;
    min-height: 44px;
    font-size: 13px;
    letter-spacing: 2px;
    background-color: transparent;
    border-width: 0;
    border-radius: 6px;
    color: rgb(120, 110, 100);
    margin: 0 2px;
    transition-duration: 0.15s;
}

.settings-tab:hover {
    background-color: rgba(180, 80, 20, 0.15);
    color: rgb(200, 160, 100);
}

.settings-tab-active {
    background-color: rgb(180, 80, 20);
    color: rgb(255, 245, 220);
}

.settings-tab-active:hover {
    background-color: rgb(210, 100, 30);
}

.settings-tab-inactive {
    background-color: transparent;
    color: rgb(165, 155, 145); /* Lighter gray for better visibility */
}

/* Settings Row */
.settings-row {
    flex-direction: row;
    align-items: center;
    padding: 12px 0;
    margin-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(60, 50, 75, 0.2);
}

.settings-label {
    width: 180px;
    min-width: 180px;
    flex-shrink: 0;
    font-size: 14px;
    color: rgb(165, 155, 145);
    letter-spacing: 1px;
}

.settings-control {
    flex-grow: 1;
    margin: 0 16px;
}

.settings-value {
    width: 60px;
    min-width: 60px;
    flex-shrink: 0;
    font-size: 14px;
    color: rgb(200, 120, 40);
    -unity-text-align: middle-right;
    -unity-font-style: bold;
}

/* Settings Section Header */
.settings-section-header {
    font-size: 12px;
    letter-spacing: 3px;
    color: rgb(200, 120, 40);
    margin-top: 24px;
    margin-bottom: 16px;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(180, 80, 20, 0.3);
}

/* Settings Button Row */
.settings-button-row {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 24px;
    padding-top: 16px;
    border-top-width: 1px;
    border-top-color: rgba(180, 80, 20, 0.2);
}

.settings-scroll {
    overflow: visible;
}

.settings-scroll .unity-scroll-view__content-container {
    overflow: visible;
}

.settings-scroll .unity-scroll-view__content-viewport {
    overflow: visible;
    -unity-overflow-clip-box: content-box;
}

/* AAA Slider Style */
.aaa-slider {
    min-height: 24px;
}

.aaa-slider .unity-base-slider__tracker {
    background-color: rgba(40, 32, 55, 0.8);
    border-radius: 6px;
    height: 8px;
}

.aaa-slider .unity-base-slider__dragger {
    background-color: rgb(180, 80, 20);
    border-width: 2px;
    border-color: rgb(255, 140, 50);
    border-radius: 50%;
    width: 22px;
    height: 22px;
    margin-top: -7px;
    transition-duration: 0.1s;
}

.aaa-slider:hover .unity-base-slider__dragger {
    background-color: rgb(210, 100, 30);
    scale: 1.1;
}

.aaa-slider .unity-base-slider__drag-container {
    background-color: rgb(180, 80, 20);
    border-radius: 6px;
}

/* AAA Toggle Style */
.aaa-toggle {
    flex-direction: row;
    align-items: center;
}

.aaa-toggle .unity-toggle__input {
    background-color: rgba(40, 32, 55, 0.8);
    border-color: rgba(120, 70, 30, 0.5);
    border-width: 2px;
    border-radius: 14px;
    width: 52px;
    height: 28px;
    padding: 2px;
    transition-duration: 0.2s;
}

.aaa-toggle:checked .unity-toggle__input {
    background-color: rgba(180, 80, 20, 0.5);
    border-color: rgb(180, 80, 20);
}

.aaa-toggle .unity-toggle__checkmark {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background-color: rgb(100, 90, 80);
    transition-duration: 0.2s;
    translate: 0 0;
}

.aaa-toggle:checked .unity-toggle__checkmark {
    background-color: rgb(180, 80, 20);
    translate: 24px 0;
}

.aaa-toggle .unity-toggle__text {
    color: rgb(165, 155, 145);
    font-size: 14px;
    margin-left: 12px;
}

/* =============================================================================
   PATH BADGE STYLES
   ============================================================================= */

.path-badge {
    padding: 6px 14px;
    border-radius: 4px;
    border-width: 1px;
}

.path-ironbound {
    background-color: rgba(140, 120, 100, 0.2);
    border-color: rgba(140, 120, 100, 0.5);
    color: rgb(200, 180, 160);
}

.path-fangborn {
    background-color: rgba(160, 80, 80, 0.2);
    border-color: rgba(160, 80, 80, 0.5);
    color: rgb(200, 120, 120);
}

.path-voidtouched {
    background-color: rgba(140, 40, 80, 0.2);
    border-color: rgba(140, 40, 80, 0.5);
    color: rgb(180, 60, 80);
}

.path-unchained {
    background-color: rgba(60, 140, 160, 0.2);
    border-color: rgba(60, 140, 160, 0.5);
    color: rgb(100, 180, 200);
}

/* =============================================================================
   BRAND COLOR INDICATORS
   ============================================================================= */

.brand-indicator {
    width: 24px;
    height: 24px;
    border-radius: 6px;
    border-width: 2px;
}

.brand-iron { background-color: rgb(140, 130, 120); border-color: rgb(180, 170, 160); }
.brand-savage { background-color: rgb(180, 60, 60); border-color: rgb(220, 100, 100); }
.brand-surge { background-color: rgb(60, 140, 200); border-color: rgb(100, 180, 240); }
.brand-venom { background-color: rgb(80, 160, 80); border-color: rgb(120, 200, 120); }
.brand-dread { background-color: rgb(140, 40, 80); border-color: rgb(180, 60, 100); }
.brand-leech { background-color: rgb(160, 60, 120); border-color: rgb(200, 100, 160); }
.brand-grace { background-color: rgb(200, 180, 120); border-color: rgb(240, 220, 160); }
.brand-mend { background-color: rgb(100, 200, 180); border-color: rgb(140, 240, 220); }
.brand-ruin { background-color: rgb(220, 120, 40); border-color: rgb(255, 160, 80); }
.brand-void { background-color: rgb(50, 20, 35); border-color: rgb(100, 40, 60); }

/* =============================================================================
   SYNERGY DISPLAY
   ============================================================================= */

.synergy-badge {
    padding: 8px 16px;
    border-radius: 6px;
    border-width: 2px;
}

.synergy-full {
    background-color: rgba(80, 200, 120, 0.15);
    border-color: rgb(80, 200, 120);
}

.synergy-partial {
    background-color: rgba(200, 180, 80, 0.15);
    border-color: rgb(200, 180, 80);
}

.synergy-neutral {
    background-color: rgba(120, 120, 120, 0.15);
    border-color: rgb(120, 120, 120);
}

.synergy-anti {
    background-color: rgba(200, 80, 80, 0.15);
    border-color: rgb(200, 80, 80);
}

/* =============================================================================
   MONSTER CARD AAA STYLES
   ============================================================================= */

.monster-card-aaa {
    background-color: rgba(25, 20, 35, 0.9);
    border-width: 2px;
    border-color: rgba(100, 50, 65, 0.5);
    border-radius: 12px;
    padding: 16px;
    transition-duration: 0.2s;
}

.monster-card-aaa:hover {
    background-color: rgba(35, 28, 50, 0.95);
    border-color: rgba(180, 80, 20, 0.7);
    translate: 0 -2px;
}

.monster-portrait-frame {
    width: 120px;
    height: 120px;
    background-color: rgba(20, 16, 28, 0.8);
    border-width: 3px;
    border-color: rgba(180, 80, 20, 0.4);
    border-radius: 8px;
    justify-content: center;
    align-items: center;
    overflow: hidden;
}

.monster-portrait-placeholder {
    width: 100%;
    height: 100%;
    background-color: rgba(100, 50, 65, 0.3);
    justify-content: center;
    align-items: center;
}

.monster-portrait-placeholder-text {
    font-size: 48px;
    color: rgba(180, 80, 20, 0.5);
}

/* =============================================================================
   HERO SUMMARY CARD
   ============================================================================= */

.hero-summary-card {
    flex-direction: row;
    align-items: center;
    background-color: rgba(18, 14, 26, 0.9);
    border-width: 1px;
    border-color: rgba(180, 80, 20, 0.3);
    border-radius: 8px;
    padding: 16px 24px;
}

.hero-summary-portrait {
    width: 64px;
    height: 64px;
    background-color: rgba(40, 32, 55, 0.8);
    border-radius: 8px;
    margin-right: 16px;
}

.hero-summary-info {
    flex-grow: 1;
}

.hero-summary-name {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(235, 225, 215);
    margin-bottom: 4px;
}

.hero-summary-path {
    font-size: 12px;
    letter-spacing: 2px;
    color: rgb(180, 80, 20);
}

/* =============================================================================
   MAIN MENU BUTTONS - MOLTEN ORANGE THEME
   Using #menu-root context for maximum specificity
   Overrides Unity's built-in Button styling
   ============================================================================= */

/* Override Unity's default Button pseudo-states within main menu */
/* Primary buttons (NEW GAME, CONTINUE) - Bright molten orange */
#button-container #btn-new-game,
#button-container #btn-continue {
    background-color: rgb(180, 80, 20);
    border-color: rgb(255, 140, 50);
    color: rgb(255, 245, 220);
}

#button-container #btn-new-game:hover,
#button-container #btn-continue:hover {
    background-color: rgb(210, 100, 30);
    border-color: rgb(255, 180, 80);
    color: rgb(255, 255, 240);
}

#button-container #btn-new-game:active,
#button-container #btn-continue:active {
    background-color: rgb(140, 60, 15);
    border-color: rgb(200, 100, 40);
}

/* Secondary buttons (SETTINGS, CREDITS, EXIT) - Subdued amber */
#button-container #btn-settings,
#button-container #btn-credits,
#button-container #btn-exit {
    background-color: rgba(25, 18, 12, 0.95);
    border-color: rgb(120, 70, 30);
    color: rgb(200, 160, 100);
}

#button-container #btn-settings:hover,
#button-container #btn-credits:hover,
#button-container #btn-exit:hover {
    background-color: rgba(55, 35, 20, 0.98);
    border-color: rgb(180, 110, 50);
    color: rgb(255, 200, 130);
}

#button-container #btn-settings:active,
#button-container #btn-credits:active,
#button-container #btn-exit:active {
    background-color: rgba(15, 10, 5, 0.98);
    border-color: rgb(100, 60, 25);
}

/* =========================================================================
   MAIN MENU BUTTONS — Unified dark base, orange on hover (AAA V5)
   ========================================================================= */

#menu-root .vb-menu-btn,
#menu-root #btn-new-game,
#menu-root #btn-continue,
#menu-root #btn-settings,
#menu-root #btn-credits,
#menu-root #btn-exit {
    -unity-font-definition: url('project://database/Assets/UI/Fonts/Cinzel-Variable.ttf?fileID=12800000&guid=c7b3e9f2a4d816543e8c1a0b5f927d4e&type=3');
    -unity-text-align: middle-center;
    width: 300px;
    height: 56px;
    flex-grow: 0;
    flex-shrink: 0;
    font-size: 18px;
    -unity-font-style: bold;
    letter-spacing: 5px;
    /* background-color: initial — C# gradient texture is the visual base */
    border-width: 1px;
    border-radius: 3px;
    border-color: rgba(160, 115, 55, 0.45);
    border-top-color: rgba(200, 155, 80, 0.35);
    color: rgba(210, 180, 130, 0.85);
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.7);
    transition-property: scale, border-color, border-width, color, translate;
    transition-duration: 0.15s, 0.25s, 0.15s, 0.25s, 0.15s;
    transition-timing-function: ease-out;
}

#menu-root .vb-menu-btn:hover,
#menu-root #btn-new-game:hover,
#menu-root #btn-continue:hover,
#menu-root #btn-settings:hover,
#menu-root #btn-credits:hover,
#menu-root #btn-exit:hover {
    /* background-color removed — C# ApplyButtonGradients owns gradient swap on hover */
    border-width: 2px;
    border-color: rgba(255, 180, 80, 0.7);
    border-top-color: rgba(255, 220, 140, 0.65);
    color: #fffae8;
    text-shadow: 0 0 12px rgba(255, 200, 100, 0.5);
    scale: 1.04 1.04;
    translate: 0 -2px;
}

#menu-root .vb-menu-btn:active,
#menu-root #btn-new-game:active,
#menu-root #btn-continue:active,
#menu-root #btn-settings:active,
#menu-root #btn-credits:active,
#menu-root #btn-exit:active {
    /* background-color removed — C# handles active state gradient */
    scale: 0.97 0.97;
    translate: 0 0;
    transition-duration: 0.08s;
}

/* Prevent right-click / focus from causing stuck highlight */
#menu-root .vb-menu-btn:focus,
#menu-root #btn-new-game:focus,
#menu-root #btn-continue:focus,
#menu-root #btn-settings:focus,
#menu-root #btn-credits:focus,
#menu-root #btn-exit:focus {
    border-width: 1px;
    border-color: rgba(160, 115, 55, 0.45);
    border-top-color: rgba(200, 155, 80, 0.35);
    color: rgba(210, 180, 130, 0.85);
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.7);
    scale: 1 1;
    translate: 0 0;
}

/* =============================================================================
   MAIN MENU - ART BUTTON SHEET OVERRIDES
   When the button sheet skins are applied, disable all "bouncy" UI motion and
   rely on the art + a simple hover outline from MoltenButtonVFX.
   ============================================================================= */

#menu-root .vb-btn-sheet,
#menu-root .vb-btn-sheet:hover,
#menu-root .vb-btn-sheet:active {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    text-shadow: none;
    scale: 1 1;
    transition: none;
}

#button-container #btn-new-game.vb-btn-sheet,
#button-container #btn-new-game.vb-btn-sheet:hover,
#button-container #btn-new-game.vb-btn-sheet:active,
#button-container #btn-continue.vb-btn-sheet,
#button-container #btn-continue.vb-btn-sheet:hover,
#button-container #btn-continue.vb-btn-sheet:active,
#button-container #btn-settings.vb-btn-sheet,
#button-container #btn-settings.vb-btn-sheet:hover,
#button-container #btn-settings.vb-btn-sheet:active,
#button-container #btn-credits.vb-btn-sheet,
#button-container #btn-credits.vb-btn-sheet:hover,
#button-container #btn-credits.vb-btn-sheet:active,
#button-container #btn-exit.vb-btn-sheet,
#button-container #btn-exit.vb-btn-sheet:hover,
#button-container #btn-exit.vb-btn-sheet:active {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    text-shadow: none;
    scale: 1 1;
    transition: none;
}

/* =============================================================================
   ANIMATED BAR - AAA Health/Resource Bars with Ghost Effect
   Unity 6.3 Optimized Transitions
   ============================================================================= */

.animated-bar {
    height: 16px;
    min-width: 100px;
    background-color: rgba(0, 0, 0, 0.7);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
    overflow: hidden;
    flex-direction: row;
    position: relative;
}

.animated-bar__background {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(20, 15, 25, 0.8);
}

.animated-bar__fill {
    position: absolute;
    height: 100%;
    border-radius: 7px;
    /* Smooth fill animation */
    transition-property: width, background-color;
    transition-duration: 0.25s, 0.3s;
    transition-timing-function: ease-out-cubic;
}

.animated-bar__ghost {
    position: absolute;
    height: 100%;
    border-radius: 7px;
    /* Ghost follows with delay for damage, leads for heal */
    transition-property: width;
    transition-duration: 0.4s;
    transition-timing-function: ease-in-cubic;
}

/* Health Bar Type */
.animated-bar--health .animated-bar__fill {
    background-color: var(--color-health);
}

.animated-bar--health .animated-bar__ghost {
    background-color: var(--color-damage-ghost);
}

/* Mana Bar Type */
.animated-bar--mana .animated-bar__fill {
    background-color: var(--color-mana);
}

.animated-bar--mana .animated-bar__ghost {
    background-color: rgba(60, 100, 180, 0.4);
}

/* Guard Bar Type (Bastion) */
.animated-bar--guard .animated-bar__fill {
    background-color: var(--color-guard);
}

.animated-bar--guard .animated-bar__ghost {
    background-color: rgba(80, 140, 200, 0.4);
}

/* Fury Bar Type (Rend) */
.animated-bar--fury .animated-bar__fill {
    background-color: var(--color-fury);
}

.animated-bar--fury .animated-bar__ghost {
    background-color: rgba(200, 80, 40, 0.4);
}

/* Corruption Bar Type */
.animated-bar--corruption .animated-bar__fill {
    background-color: var(--color-corruption-corrupted);
}

.animated-bar--corruption .animated-bar__ghost {
    background-color: rgba(160, 50, 80, 0.4);
}

/* Flash effect for critical state */
.animated-bar--flash .animated-bar__fill {
    background-color: rgb(255, 100, 100);
}

/* Low health pulsing effect */
.animated-bar--critical {
    animation: bar-pulse 0.8s infinite alternate;
}

/* =============================================================================
   MENU ITEM TRANSITIONS - AAA Slide Effects
   ============================================================================= */

.menu-item {
    transition-property: translate, opacity, background-color, border-color;
    transition-duration: 0.18s, 0.15s, 0.2s, 0.2s;
    transition-timing-function: ease-out-back, ease-out, ease-out, ease-out;
    translate: 0 0;
    opacity: 1;
}

.menu-item:hover {
    translate: 8px 0;
    background-color: rgba(80, 60, 100, 0.25);
}

.menu-item--entering {
    translate: -40px 0;
    opacity: 0;
}

.menu-item--exiting {
    translate: 40px 0;
    opacity: 0;
}

/* =============================================================================
   FOCUS STATES - Gamepad Navigation
   ============================================================================= */

.vb-button:focus {
    border-color: var(--color-accent-gold);
    border-width: 3px;
    scale: 1.02 1.02;
}

.menu-item:focus {
    background-color: rgba(100, 80, 140, 0.3);
    border-left-width: 4px;
    border-left-color: var(--color-accent-gold);
}

/* =============================================================================
   GLASSMORPHISM PANEL - Unity 6.3 Blur Effect Ready
   ============================================================================= */

.blur-panel {
    background-color: rgba(20, 15, 30, 0.75);
    border-radius: 12px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    /* Subtle inner glow effect */
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.02);
}

.blur-panel--dark {
    background-color: rgba(10, 8, 15, 0.85);
}

.blur-panel--accent {
    border-color: rgba(160, 80, 200, 0.3);
}

/* =============================================================================
   SCREEN TRANSITIONS
   ============================================================================= */

.screen-transition-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgb(5, 3, 8);
    transition-property: opacity;
    transition-duration: 0.35s;
    transition-timing-function: ease-in-out;
}

/* =============================================================================
   PARALLAX BACKGROUND LAYERS
   ============================================================================= */

/* Base parallax layer - apply to any element that should move */
.parallax-layer {
    transition-property: translate;
    transition-duration: 0.1s;
    transition-timing-function: ease-out;
}

/* Depth layers - furthest to closest */
.parallax-layer-1 {
    /* Subtle movement - far background elements */
    transition-property: translate;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
    opacity: 0.4;
}

.parallax-layer-2 {
    /* Medium-far elements */
    transition-property: translate;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
    opacity: 0.6;
}

.parallax-layer-3 {
    /* Medium-close elements */
    transition-property: translate;
    transition-duration: 0.1s;
    transition-timing-function: ease-out;
    opacity: 0.8;
}

.parallax-layer-4 {
    /* Closest/foreground elements - most movement */
    transition-property: translate;
    transition-duration: 0.08s;
    transition-timing-function: ease-out;
}

/* =============================================================================
   AMBIENT VFX CONTAINERS
   ============================================================================= */

.vfx-container {
    position: absolute;
    width: 100%;
    height: 100%;
    overflow: hidden;
    pointer-events: none;
}

.vfx-particle-layer {
    position: absolute;
    width: 100%;
    height: 100%;
}

/* Corruption particle styling - MOLTEN ORANGE THEME */
.corruption-particle {
    position: absolute;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background-color: rgba(255, 120, 40, 0.7);
    opacity: 0;
}

/* Veil energy wisps - MOLTEN AMBER/RED */
.veil-wisp {
    position: absolute;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: rgba(255, 80, 30, 0.5);
    opacity: 0;
}

/* =============================================================================
   MENU BACKGROUND ENHANCEMENTS
   ============================================================================= */

.menu-background {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgb(10, 8, 15);
}

.menu-background__gradient {
    position: absolute;
    width: 100%;
    height: 100%;
    background-image: linear-gradient(180deg, rgba(20, 15, 30, 0.9) 0%, rgba(10, 8, 15, 1) 100%);
}

.menu-background__vignette {
    position: absolute;
    width: 100%;
    height: 100%;
    background-image: radial-gradient(ellipse at center, transparent 40%, rgba(0, 0, 0, 0.7) 100%);
}

/* Animated glow pulse for accent elements */
.glow-pulse {
    transition-property: opacity, scale;
    transition-duration: 1.5s;
    transition-timing-function: ease-in-out;
}

.glow-pulse--active {
    opacity: 1;
    scale: 1.02 1.02;
}

/* =============================================================================
   LOADING STATES
   ============================================================================= */

.loading-spinner {
    width: 48px;
    height: 48px;
    border-width: 4px;
    border-color: rgba(160, 80, 200, 0.2);
    border-top-color: rgb(160, 80, 200);
    border-radius: 50%;
}

.loading-text {
    color: rgb(160, 150, 140);
    font-size: 14px;
    -unity-font-style: italic;
}

/* =============================================================================
   TOOLTIP ENHANCEMENTS
   ============================================================================= */

.tooltip--aaa {
    background-color: rgba(20, 15, 25, 0.95);
    border-width: 1px;
    border-color: rgba(160, 80, 200, 0.4);
    border-radius: 6px;
    padding: 12px 16px;
    transition-property: opacity, translate;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
    translate: 0 -4px;
    opacity: 0;
}

.tooltip--aaa.tooltip--visible {
    translate: 0 0;
    opacity: 1;
}

.tooltip__arrow {
    position: absolute;
    width: 8px;
    height: 8px;
    background-color: rgba(20, 15, 25, 0.95);
    border-width: 0 1px 1px 0;
    border-color: rgba(160, 80, 200, 0.4);
    rotate: 45deg;
    bottom: -5px;
    left: 50%;
    translate: -50% 0;
}

/* =============================================================================
   BUTTON VFX
   ============================================================================= */

.button-ripple {
    transition-property: width, height, translate, opacity;
    transition-duration: 0.35s;
    transition-timing-function: ease-out;
}



.button-glow {
    transition-property: opacity;
    transition-duration: 0.2s;
    transition-timing-function: ease-out;
}

.button--pressed {
    scale: 0.97 0.97;
    translate: 0 2px;
    transition-property: scale, translate;
    transition-duration: 0.08s;
    transition-timing-function: ease-out;
}

.button--clicked {
    /* Brief flash effect */
}

/* Hover glow overlay applied by MainMenuController */
.vb-button-hover-glow {
    transition-property: border-color, background-color;
    transition-duration: 0.25s;
    transition-timing-function: ease-out;
}

/* Primary button VFX (important actions) */
.vb-button--primary .button-glow {
    background-color: rgba(200, 120, 40, 0.15);
}

/* Danger button VFX */
.vb-button--danger .button-glow {
    background-color: rgba(200, 60, 60, 0.15);
}

/* Success button VFX */
.vb-button--success .button-glow {
    background-color: rgba(60, 180, 80, 0.15);
}

/* =============================================================================
   NOTIFICATION BADGES
   ============================================================================= */

.notification-badge {
    position: absolute;
    top: -4px;
    right: -4px;
    min-width: 18px;
    height: 18px;
    padding: 0 5px;
    background-color: rgb(200, 60, 60);
    border-radius: 9px;
    color: rgb(255, 255, 255);
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.notification-badge--pulse {
    transition-property: scale;
    transition-duration: 0.3s;
    transition-timing-function: ease-in-out;
}

/* =============================================================================
   MODAL OVERLAYS
   ============================================================================= */

.modal-backdrop {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.7);
    transition-property: opacity;
    transition-duration: 0.25s;
    opacity: 0;
}

.modal-backdrop--visible {
    opacity: 1;
}

.modal-container {
    position: absolute;
    transition-property: scale, opacity, translate;
    transition-duration: 0.25s;
    transition-timing-function: ease-out-back;
    scale: 0.9 0.9;
    opacity: 0;
    translate: 0 20px;
}

.modal-container--visible {
    scale: 1 1;
    opacity: 1;
    translate: 0 0;
}

/* =============================================================================
   TITLE SCREEN EMBER/ASH VFX
   ============================================================================= */

.title-vfx-container {
    position: absolute;
    width: 100%;
    height: 100%;
    overflow: hidden;
    pointer-events: none;
}

/* Ember glow effect */
.ember-glow {
    border-radius: 50%;
    transition-property: opacity;
    transition-duration: 0.1s;
}

/* Ash particle styling */
.ash-particle {
    transition-property: opacity, rotate;
    transition-duration: 0.15s;
}

/* Spark flash effect */
.spark-particle {
    border-radius: 50%;
    transition-property: opacity;
    transition-duration: 0.05s;
}

/* Heat distortion overlay (for future shader support) */
.heat-distortion {
    position: absolute;
    width: 100%;
    height: 30%;
    bottom: 0;
    background-image: linear-gradient(0deg, rgba(255, 100, 50, 0.03) 0%, transparent 100%);
    pointer-events: none;
}

/* Vignette enhancement for title screen */
.title-vignette {
    position: absolute;
    width: 100%;
    height: 100%;
    background-image: radial-gradient(ellipse at center, transparent 30%, rgba(0, 0, 0, 0.6) 100%);
    pointer-events: none;
}

/* Subtle red ambient glow at bottom */
.title-ambient-glow {
    position: absolute;
    width: 100%;
    height: 40%;
    bottom: 0;
    background-image: radial-gradient(ellipse at bottom center, rgba(180, 60, 30, 0.15) 0%, transparent 70%);
    pointer-events: none;
}

/* Logo protection mask - embers avoid this area */
.logo-safe-zone {
    position: absolute;
    pointer-events: none;
}

/* Demon focal point glow */
.demon-glow {
    position: absolute;
    border-radius: 50%;
    background-image: radial-gradient(circle, rgba(200, 80, 40, 0.2) 0%, transparent 70%);
    pointer-events: none;
}

/* =============================================================================
   SAVE BROWSER OVERLAY — AAA dark fantasy save slot picker
   ============================================================================= */

.save-browser-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(4, 2, 8, 0.88);
    justify-content: center;
    align-items: center;
    z-index: 100;
}

.save-browser-panel {
    width: 680px;
    max-height: 85%;
    background-color: rgba(12, 8, 18, 0.97);
    border-width: 1px;
    border-color: rgba(80, 65, 100, 0.25);
    border-top-width: 2px;
    border-top-color: rgba(200, 160, 60, 0.5);
    border-radius: 8px;
    padding: 24px 28px 20px 28px;
    flex-direction: column;
}

.save-browser-header {
    flex-direction: column;
    align-items: center;
    margin-bottom: 16px;
}

.save-browser-title {
    font-size: 18px;
    letter-spacing: 6px;
    -unity-font-style: bold;
    color: rgba(240, 235, 250, 0.95);
    -unity-text-align: middle-center;
    text-shadow: 0 0 12px rgba(200, 160, 60, 0.25);
    margin-bottom: 6px;
}

.save-browser-subtitle {
    font-size: 11px;
    color: rgba(160, 150, 175, 0.5);
    -unity-text-align: middle-center;
    letter-spacing: 1px;
    -unity-font-style: italic;
}

.save-browser-divider {
    width: 60%;
    height: 1px;
    background-color: rgba(200, 160, 60, 0.15);
    margin-top: 12px;
    align-self: center;
}

/* Save slots container — scrollable if needed */
.save-slots-container {
    flex-direction: column;
    flex-grow: 1;
    overflow: scroll;
    margin-bottom: 16px;
}

.save-browser-empty {
    font-size: 13px;
    color: rgba(160, 150, 175, 0.4);
    -unity-text-align: middle-center;
    -unity-font-style: italic;
    padding: 40px 0;
}

/* Individual save slot card */
.save-slot-card {
    flex-direction: row;
    align-items: stretch;
    padding: 14px 16px;
    margin-bottom: 8px;
    background-color: rgba(8, 6, 14, 0.7);
    border-width: 1px;
    border-color: rgba(80, 65, 100, 0.12);
    border-radius: 6px;
    translate: 0 0;
    transition-property: translate, background-color, border-color;
    transition-duration: 0.2s, 0.2s, 0.2s;
    transition-timing-function: ease-out, ease-out, ease-out;
}

.save-slot-card:hover {
    background-color: rgba(14, 10, 24, 0.85);
    border-color: rgba(200, 160, 60, 0.2);
    translate: 2px 0;
}

.save-slot-corrupted {
    border-color: rgba(180, 50, 50, 0.25);
    opacity: 0.6;
}

/* Left edge indicator bar */
.save-slot-indicator {
    width: 4px;
    border-radius: 2px;
    background-color: rgba(200, 160, 60, 0.5);
    margin-right: 14px;
    flex-shrink: 0;
    min-height: 48px;
}

.save-slot-indicator-auto {
    background-color: rgba(70, 190, 210, 0.5);
}

/* Middle info section */
.save-slot-info {
    flex: 1;
    flex-direction: column;
    justify-content: center;
}

.save-slot-top-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
}

.save-slot-hero-name {
    font-size: 15px;
    -unity-font-style: bold;
    color: rgba(240, 235, 250, 0.95);
    letter-spacing: 2px;
}

.save-slot-tag {
    font-size: 8px;
    letter-spacing: 2px;
    -unity-font-style: bold;
    color: rgba(200, 160, 60, 0.8);
    background-color: rgba(200, 160, 60, 0.08);
    border-radius: 8px;
    padding: 2px 8px;
    border-width: 1px;
    border-color: rgba(200, 160, 60, 0.15);
}

.save-slot-tag-auto {
    color: rgba(70, 190, 210, 0.8);
    background-color: rgba(70, 190, 210, 0.08);
    border-color: rgba(70, 190, 210, 0.15);
}

.save-slot-mid-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.save-slot-detail {
    font-size: 10px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    color: rgba(180, 170, 200, 0.65);
    margin-right: 12px;
}

.save-slot-level {
    color: rgba(255, 180, 100, 0.85);
}

.save-slot-path {
    color: rgba(150, 130, 180, 0.7);
    letter-spacing: 2px;
}

.save-slot-location {
    color: rgba(160, 150, 175, 0.55);
    -unity-font-style: italic;
}

.save-slot-bottom-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.save-slot-playtime {
    font-size: 10px;
    color: rgba(140, 130, 160, 0.5);
    letter-spacing: 1px;
}

.save-slot-date {
    font-size: 9px;
    color: rgba(140, 130, 160, 0.4);
}

/* Right: action buttons */
.save-slot-actions {
    flex-direction: column;
    justify-content: center;
    align-items: flex-end;
    margin-left: 14px;
}

.save-slot-load-btn {
    font-size: 10px;
    letter-spacing: 3px;
    -unity-font-style: bold;
    color: rgba(15, 10, 5, 0.9);
    background-color: rgba(200, 160, 60, 0.85);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(255, 215, 90, 0.4);
    padding: 6px 18px;
    margin-bottom: 6px;
    min-width: 80px;
    -unity-text-align: middle-center;
    transition-property: background-color, border-color;
    transition-duration: 0.15s, 0.15s;
}

.save-slot-load-btn:hover {
    background-color: rgba(220, 180, 70, 0.95);
    border-color: rgba(255, 230, 120, 0.6);
}

.save-slot-delete-btn {
    font-size: 8px;
    letter-spacing: 2px;
    color: rgba(180, 50, 50, 0.6);
    background-color: transparent;
    border-width: 1px;
    border-color: rgba(180, 50, 50, 0.15);
    border-radius: 3px;
    padding: 3px 12px;
    min-width: 80px;
    -unity-text-align: middle-center;
    transition-property: color, border-color, background-color;
    transition-duration: 0.15s, 0.15s, 0.15s;
}

.save-slot-delete-btn:hover {
    color: rgba(220, 60, 60, 0.9);
    border-color: rgba(220, 60, 60, 0.35);
    background-color: rgba(180, 50, 50, 0.06);
}

.save-slot-corrupt-label {
    font-size: 9px;
    letter-spacing: 2px;
    -unity-font-style: bold;
    color: rgba(180, 50, 50, 0.7);
    margin-bottom: 6px;
}

/* Footer */
.save-browser-footer {
    flex-direction: row;
    justify-content: center;
    padding-top: 8px;
    border-top-width: 1px;
    border-top-color: rgba(80, 65, 100, 0.12);
}

.save-browser-back-btn {
    font-size: 11px;
    letter-spacing: 4px;
    -unity-font-style: bold;
    color: rgba(180, 170, 200, 0.6);
    background-color: transparent;
    border-width: 1px;
    border-color: rgba(80, 65, 100, 0.2);
    border-radius: 4px;
    padding: 8px 32px;
    transition-property: color, border-color, background-color;
    transition-duration: 0.15s, 0.15s, 0.15s;
}

.save-browser-back-btn:hover {
    color: rgba(240, 235, 250, 0.9);
    border-color: rgba(200, 160, 60, 0.35);
    background-color: rgba(255, 255, 255, 0.02);
}
