/* =============================================================================
   VEILBREAKERS - MAIN STYLESHEET
   Dark Fantasy Horror Theme
   ============================================================================= */

/* =============================================================================
   GLOBAL FONT - Required for text rendering in UI Toolkit
   ============================================================================= */

* {
    -unity-font-definition: url('project://database/Assets/UI/Fonts/Arial.ttf?fileID=12800000&guid=a1b82bd02ca673443b4c4c64ac746061&type=3');
}

/* =============================================================================
   CSS VARIABLES (Custom Properties)
   ============================================================================= */

:root {
    /* Primary Colors - Dark Fantasy Palette */
   --color-background-dark: rgb(15, 12, 20);
   --color-background-medium: rgb(28, 20, 25);
   --color-background-light: rgb(45, 30, 38);

   /* Accent Colors - Corruption/Brand themed */
   --color-accent-red: rgb(180, 40, 60);
   --color-accent-red-glow: rgb(220, 60, 80);
   --color-accent-crimson: rgb(180, 40, 60);
   --color-accent-crimson-glow: rgb(220, 60, 80);
   --color-accent-gold: rgb(200, 160, 80);
   --color-accent-cyan: rgb(60, 180, 200);

    /* Text Colors */
    --color-text-primary: rgb(230, 220, 210);
    --color-text-secondary: rgb(160, 150, 140);
    --color-text-disabled: rgb(100, 90, 80);
    --color-text-highlight: rgb(255, 240, 200);

    /* UI Element Colors */
    --color-border: rgb(70, 45, 55);
    --color-border-highlight: rgb(120, 60, 80);
    --color-panel: rgba(25, 15, 20, 0.9);
    --color-panel-hover: rgba(45, 28, 35, 0.95);

    /* Health/Resource Colors */
    --color-health: rgb(180, 50, 50);
    --color-health-low: rgb(220, 40, 40);
    --color-mana: rgb(60, 100, 180);
    --color-stamina: rgb(60, 160, 80);

    /* Corruption State Colors */
    --color-corruption-ascended: rgb(255, 215, 0);
    --color-corruption-purified: rgb(180, 220, 255);
    --color-corruption-unstable: rgb(180, 180, 180);
    --color-corruption-corrupted: rgb(160, 50, 80);
    --color-corruption-abyssal: rgb(80, 10, 40);

    /* Spacing */
    --spacing-xs: 4px;
    --spacing-sm: 8px;
    --spacing-md: 16px;
    --spacing-lg: 24px;
    --spacing-xl: 32px;

    /* Border Radius */
    --radius-sm: 4px;
    --radius-md: 8px;
    --radius-lg: 12px;

    /* Font Sizes */
    --font-size-xs: 12px;
    --font-size-sm: 14px;
    --font-size-md: 16px;
    --font-size-lg: 20px;
    --font-size-xl: 24px;
    --font-size-title: 32px;
    --font-size-header: 48px;
}

/* =============================================================================
   BASE ELEMENTS
   ============================================================================= */

.vb-root {
    flex-grow: 1;
    background-color: var(--color-background-dark);
}

/* =============================================================================
   TYPOGRAPHY
   ============================================================================= */

.vb-text {
    color: var(--color-text-primary);
    font-size: var(--font-size-md);
    -unity-font-style: normal;
}

.vb-text-secondary {
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
}

.vb-text-highlight {
    color: var(--color-text-highlight);
    -unity-font-style: bold;
}

.vb-title {
    color: var(--color-text-primary);
    font-size: var(--font-size-title);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 2px;
}

.vb-header {
    color: var(--color-accent-gold);
    font-size: var(--font-size-header);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 4px;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.8);
}

/* =============================================================================
   PANELS & CONTAINERS
   ============================================================================= */

.vb-panel {
    background-color: var(--color-panel);
    border-color: var(--color-border);
    border-width: 2px;
    border-radius: var(--radius-md);
    padding: var(--spacing-md);
}

.vb-panel-dark {
    background-color: rgba(10, 8, 15, 0.95);
    border-color: var(--color-border);
    border-width: 2px;
    border-radius: var(--radius-md);
    padding: var(--spacing-md);
}

.vb-panel-glow {
    background-color: var(--color-panel);
    border-color: var(--color-accent-crimson);
    border-width: 2px;
    border-radius: var(--radius-md);
    padding: var(--spacing-md);
}

.vb-card {
    background-color: var(--color-background-medium);
    border-color: var(--color-border);
    border-width: 1px;
    border-radius: var(--radius-sm);
    padding: var(--spacing-sm);
    margin: var(--spacing-xs);
}

.vb-card:hover {
    background-color: var(--color-panel-hover);
    border-color: var(--color-border-highlight);
}

/* =============================================================================
   BUTTONS
   ============================================================================= */

.vb-button {
    background-color: var(--color-background-light);
    border-color: var(--color-border);
    border-width: 2px;
    border-radius: var(--radius-sm);
    padding: var(--spacing-sm) var(--spacing-md);
    color: var(--color-text-primary);
    font-size: var(--font-size-md);
    -unity-font-style: bold;
    transition-duration: 0.15s;
    cursor: link;
}

.vb-button:hover {
    background-color: var(--color-background-medium);
    border-color: var(--color-accent-crimson);
    color: var(--color-text-highlight);
    scale: 1.02;
}

.vb-button:active {
    background-color: var(--color-accent-crimson);
    scale: 0.98;
}

.vb-button:disabled {
    background-color: var(--color-background-dark);
    border-color: var(--color-border);
    color: var(--color-text-disabled);
    cursor: arrow;
}

.vb-button-primary {
    background-color: var(--color-accent-red);
    border-color: var(--color-accent-red-glow);
    color: white;
}

.vb-button-primary:hover {
    background-color: var(--color-accent-red-glow);
    border-color: rgb(255, 100, 120);
}

.vb-button-secondary {
    background-color: var(--color-accent-crimson);
    border-color: var(--color-accent-crimson-glow);
    color: white;
}

.vb-button-large {
    font-size: var(--font-size-lg);
    padding: var(--spacing-md) var(--spacing-xl);
    min-width: 200px;
    min-height: 50px;
}

/* =============================================================================
   INPUT FIELDS
   ============================================================================= */

.vb-textfield {
    background-color: var(--color-background-dark);
    border-color: var(--color-border);
    border-width: 2px;
    border-radius: var(--radius-sm);
    padding: var(--spacing-sm);
    color: var(--color-text-primary);
    font-size: var(--font-size-md);
}

.vb-textfield:focus {
    border-color: var(--color-accent-crimson);
}

.vb-textfield > .unity-text-field__input {
    background-color: transparent;
    border-width: 0;
    color: var(--color-text-primary);
}

/* =============================================================================
   SLIDERS
   ============================================================================= */

.vb-slider {
    min-height: 30px;
}

.vb-slider .unity-base-slider__dragger {
    background-color: var(--color-accent-crimson);
    border-radius: 50%;
    width: 20px;
    height: 20px;
    margin-top: -8px;
}

.vb-slider .unity-base-slider__tracker {
    background-color: var(--color-background-light);
    border-radius: var(--radius-sm);
    height: 6px;
}

.vb-slider .unity-base-slider__drag-container {
    background-color: var(--color-accent-crimson-glow);
    border-radius: var(--radius-sm);
}

/* =============================================================================
   TOGGLE / CHECKBOX
   ============================================================================= */

.vb-toggle {
    flex-direction: row;
    align-items: center;
}

.vb-toggle .unity-toggle__checkmark {
    background-color: var(--color-background-dark);
    border-color: var(--color-border);
    border-width: 2px;
    border-radius: var(--radius-sm);
    width: 24px;
    height: 24px;
}

.vb-toggle:checked .unity-toggle__checkmark {
    background-color: var(--color-accent-crimson);
    border-color: var(--color-accent-crimson-glow);
}

.vb-toggle .unity-toggle__text {
    color: var(--color-text-primary);
    font-size: var(--font-size-md);
    margin-left: var(--spacing-sm);
}

/* =============================================================================
   DROPDOWN
   ============================================================================= */

.vb-dropdown {
    background-color: rgb(28, 20, 25);
    border-color: rgb(70, 45, 55);
    border-width: 2px;
    border-radius: 4px;
    padding: 8px 12px;
    min-height: 36px;
}

.vb-dropdown:hover {
    border-color: rgb(180, 40, 60);
    background-color: rgb(40, 30, 38);
}

.vb-dropdown:focus {
    border-color: rgb(220, 60, 80);
}

.vb-dropdown .unity-base-popup-field__text {
    color: rgb(200, 190, 180);
    font-size: 14px;
    -unity-text-align: middle-left;
}

.vb-dropdown .unity-base-popup-field__arrow {
    -unity-background-image-tint-color: rgb(165, 155, 145);
    width: 12px;
    height: 12px;
}

.vb-dropdown .unity-base-popup-field__input {
    background-color: transparent;
    border-width: 0;
    padding: 0;
}

/* Dropdown container styling - DO NOT override position/z-index (breaks Unity's placement) */
.unity-base-dropdown__container-outer {
    background-color: rgb(18, 14, 18);
    border-color: rgb(180, 40, 60);
    border-width: 2px;
    border-radius: 8px;
    padding: 8px;
    margin-top: 2px;
    min-width: 200px;
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.55);
    max-height: 280px;
    overflow-y: auto;
}

.unity-base-dropdown__container-inner {
    background-color: rgb(18, 14, 18);
    padding: 4px;
}

.unity-base-dropdown__item {
    background-color: transparent;
    padding: 10px 16px;
    margin: 2px 0;
    border-radius: 6px;
    transition-duration: 0.15s;
}

.unity-base-dropdown__item:hover {
    background-color: rgba(180, 40, 60, 0.3);
}

.unity-base-dropdown__item:checked {
    background-color: rgb(180, 40, 60);
}

/* Dropdown scroll view fix */
.unity-base-dropdown .unity-scroll-view {
    max-height: 300px;
}

/* Dropdown Scrollbar - Thin crimson styled */
.unity-base-dropdown .unity-scroller--vertical {
    width: 8px;
    margin-right: 2px;
}

.unity-base-dropdown .unity-scroller--vertical .unity-base-slider__tracker {
    background-color: rgba(50, 35, 42, 0.5);
    border-radius: 4px;
    margin: 0;
}

.unity-base-dropdown .unity-scroller--vertical .unity-base-slider__dragger {
    background-color: rgba(180, 40, 60, 0.8);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(220, 60, 80, 0.4);
}

.unity-base-dropdown .unity-scroller--vertical .unity-base-slider__dragger:hover {
    background-color: rgb(200, 50, 70);
    border-color: rgba(255, 80, 100, 0.6);
}

.unity-base-dropdown .unity-scroller--vertical .unity-base-slider__dragger:active {
    background-color: rgb(220, 60, 80);
}

.unity-base-dropdown__label {
    color: rgb(200, 190, 180);
    font-size: 14px;
}

.unity-base-dropdown__item:hover .unity-base-dropdown__label {
    color: rgb(235, 225, 215);
}

.unity-base-dropdown__item:checked .unity-base-dropdown__label {
    color: rgb(255, 255, 255);
}

.unity-base-dropdown__checkmark {
    -unity-background-image-tint-color: rgb(120, 200, 150);
}

/* =============================================================================
   SCROLLVIEW
   ============================================================================= */

.vb-scrollview {
    background-color: transparent;
}

.vb-scrollview .unity-scroller--vertical {
    width: 14px;
    margin-left: 6px;
}

.vb-scrollview .unity-scroller--vertical .unity-base-slider__dragger {
    background-color: var(--color-accent-crimson);
    border-radius: 6px;
    width: 10px;
    margin-left: 2px;
    min-height: 40px;
    transition-duration: 0.15s;
    cursor: link;
}

.vb-scrollview .unity-scroller--vertical .unity-base-slider__dragger:hover {
    background-color: var(--color-accent-crimson-glow);
    width: 12px;
    margin-left: 1px;
}

.vb-scrollview .unity-scroller--vertical .unity-base-slider__tracker {
    background-color: rgba(40, 32, 50, 0.8);
    border-radius: 7px;
    border-width: 1px;
    border-color: rgba(100, 50, 65, 0.3);
    cursor: link;
}

/* =============================================================================
   PROGRESS BARS
   ============================================================================= */

.vb-progressbar {
    height: 20px;
    background-color: var(--color-background-dark);
    border-color: var(--color-border);
    border-width: 1px;
    border-radius: var(--radius-sm);
    overflow: hidden;
}

.vb-progressbar-fill {
    background-color: var(--color-accent-crimson);
    height: 100%;
    transition-duration: 0.3s;
}

.vb-healthbar-fill {
    background-color: var(--color-health);
}

.vb-healthbar-low .vb-healthbar-fill {
    background-color: var(--color-health-low);
}

.vb-manabar-fill {
    background-color: var(--color-mana);
}

/* =============================================================================
   LISTS & GRIDS
   ============================================================================= */

.vb-list-item {
    background-color: transparent;
    border-color: transparent;
    border-width: 1px;
    border-radius: var(--radius-sm);
    padding: var(--spacing-sm);
    margin: var(--spacing-xs) 0;
}

.vb-list-item:hover {
    background-color: var(--color-panel-hover);
    border-color: var(--color-border-highlight);
}

.vb-list-item:selected {
    background-color: var(--color-accent-crimson);
    border-color: var(--color-accent-crimson-glow);
}

.vb-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-start;
    align-items: flex-start;
}

.vb-grid-item {
    width: 100px;
    height: 100px;
    margin: var(--spacing-xs);
    background-color: var(--color-background-medium);
    border-color: var(--color-border);
    border-width: 1px;
    border-radius: var(--radius-sm);
}

/* =============================================================================
   TOOLTIPS
   ============================================================================= */

.vb-tooltip {
    background-color: rgba(10, 8, 15, 0.98);
    border-color: var(--color-accent-crimson);
    border-width: 1px;
    border-radius: var(--radius-sm);
    padding: var(--spacing-sm) var(--spacing-md);
    max-width: 300px;
}

.vb-tooltip-title {
    color: var(--color-text-highlight);
    font-size: var(--font-size-md);
    -unity-font-style: bold;
    margin-bottom: var(--spacing-xs);
}

.vb-tooltip-text {
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
}

/* =============================================================================
   ICONS & IMAGES
   ============================================================================= */

.vb-icon {
    width: 32px;
    height: 32px;
    -unity-background-scale-mode: scale-to-fit;
}

.vb-icon-small {
    width: 24px;
    height: 24px;
}

.vb-icon-large {
    width: 48px;
    height: 48px;
}

.vb-portrait {
    width: 64px;
    height: 64px;
    border-color: var(--color-border);
    border-width: 2px;
    border-radius: var(--radius-sm);
    -unity-background-scale-mode: scale-to-fit;
}

/* =============================================================================
   DIVIDERS & SEPARATORS
   ============================================================================= */

.vb-divider-horizontal {
    height: 2px;
    background-color: var(--color-border);
    margin: var(--spacing-md) 0;
}

.vb-divider-vertical {
    width: 2px;
    background-color: var(--color-border);
    margin: 0 var(--spacing-md);
}

/* =============================================================================
   LAYOUT UTILITIES
   ============================================================================= */

.vb-row {
    flex-direction: row;
    align-items: center;
}

.vb-column {
    flex-direction: column;
}

.vb-center {
    justify-content: center;
    align-items: center;
}

.vb-space-between {
    justify-content: space-between;
}

.vb-flex-grow {
    flex-grow: 1;
}

.vb-margin-sm { margin: var(--spacing-sm); }
.vb-margin-md { margin: var(--spacing-md); }
.vb-margin-lg { margin: var(--spacing-lg); }

.vb-padding-sm { padding: var(--spacing-sm); }
.vb-padding-md { padding: var(--spacing-md); }
.vb-padding-lg { padding: var(--spacing-lg); }

/* =============================================================================
   ANIMATIONS
   ============================================================================= */

.vb-fade-in {
    opacity: 1;
    transition-property: opacity;
    transition-duration: 0.3s;
}

.vb-fade-out {
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.3s;
}

.vb-pulse {
    transition-property: scale;
    transition-duration: 0.5s;
}

.vb-pulse:hover {
    scale: 1.05;
}

/* =============================================================================
   MAIN MENU SPECIFIC STYLES
   ============================================================================= */

/* Main menu buttons - larger, more prominent - CRIMSON THEME */
.menu-button-main {
    min-width: 100%;
    min-height: 54px;
    font-size: 18px;
    letter-spacing: 2px;
    background-color: rgb(180, 40, 60);
    border-color: rgb(220, 60, 80);
    border-width: 2px;
    border-radius: 4px;
    color: rgb(235, 225, 215);
    -unity-font-style: bold;
    transition-duration: 0.2s;
    transition-property: background-color, border-color, scale, translate;
}

.menu-button-main:hover {
    background-color: rgb(200, 60, 80);
    border-color: rgb(255, 100, 120);
    scale: 1.02;
    translate: -2px 0;
}

.menu-button-main:active {
    background-color: rgb(140, 30, 50);
    scale: 0.98;
}

/* Secondary menu buttons - smaller, less prominent */
.menu-button-secondary {
    min-width: 100%;
    min-height: 44px;
    font-size: 14px;
    letter-spacing: 1px;
    background-color: rgba(26, 20, 28, 0.85);
    border-color: rgb(70, 45, 55);
    border-width: 1px;
    border-radius: 4px;
    color: rgb(185, 210, 200);
    -unity-font-style: normal;
    transition-duration: 0.15s;
    transition-property: background-color, border-color, color, translate;
}

.menu-button-secondary:hover {
    background-color: rgba(80, 40, 50, 0.9);
    border-color: rgb(180, 50, 70);
    color: rgb(235, 225, 215);
    translate: -2px 0;
}

.menu-button-secondary:active {
    background-color: rgb(22, 44, 36);
}

/* Exit button - special styling with hover animation */
.menu-button-exit {
    background-color: rgba(30, 25, 40, 0.6);
    border-color: rgba(180, 50, 70, 0.3);
    color: rgb(120, 100, 95);
}

.menu-button-exit:hover {
    background-color: rgba(100, 30, 40, 0.9);
    border-color: rgb(200, 60, 80);
    color: rgb(255, 200, 200);
    translate: -3px 0;
    scale: 1.02;
}

.menu-button-exit:active {
    background-color: rgb(120, 40, 50);
    scale: 0.98;
}

/* Button glow effect element (inner child for animation) */
.button-glow {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    border-radius: 4px;
    opacity: 0;
    transition-duration: 0.3s;
}

.menu-button-main:hover .button-glow {
    opacity: 1;
}

/* Menu background layer styles */
.menu-bg-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* =============================================================================
   CHARACTER SELECT SPECIFIC STYLES
   ============================================================================= */

/* Hero card in the list */
.hero-card {
    flex-direction: row;
    align-items: center;
    padding: 12px;
    margin-bottom: 8px;
    background-color: rgb(28, 20, 25);
    border-color: rgb(70, 45, 55);
    border-width: 1px;
    border-radius: 4px;
    transition-duration: 0.15s;
    transition-property: background-color, border-color, scale;
    cursor: link;
}

.hero-card:hover {
    background-color: rgb(40, 25, 32);
    border-color: rgb(120, 50, 70);
}

.hero-card.selected {
    background-color: rgb(50, 25, 35);
    border-color: rgb(180, 40, 60);
}

/* Hero-specific colors - Applied per character */
.hero-card.hero-mirage {
    border-color: var(--hero-mirage);
}

.hero-card.hero-mirage:hover,
.hero-card.hero-mirage.selected {
    border-color: var(--hero-mirage-glow);
    box-shadow: 0 0 16px rgba(40, 200, 80, 0.4);
}

.hero-card.hero-bastion {
    border-color: var(--hero-bastion);
}

.hero-card.hero-bastion:hover,
.hero-card.hero-bastion.selected {
    border-color: var(--hero-bastion-glow);
    box-shadow: 0 0 16px rgba(60, 140, 220, 0.4);
}

.hero-card.hero-marrow {
    border-color: var(--hero-marrow);
}

.hero-card.hero-marrow:hover,
.hero-card.hero-marrow.selected {
    border-color: var(--hero-marrow-glow);
    box-shadow: 0 0 16px rgba(160, 80, 200, 0.4);
}

.hero-card.hero-rend {
    border-color: var(--hero-rend);
}

.hero-card.hero-rend:hover,
.hero-card.hero-rend.selected {
    border-color: var(--hero-rend-glow);
    box-shadow: 0 0 16px rgba(140, 30, 30, 0.4);
}

.hero-card-portrait {
    width: 50px;
    height: 50px;
    background-color: rgb(28, 20, 25);
    border-radius: 4px;
    margin-right: 12px;
    -unity-background-scale-mode: scale-to-fit;
}

.hero-card-name {
    color: rgb(235, 225, 215);
    font-size: 16px;
    -unity-font-style: bold;
}

/* Brand badge display */
.brand-badge {
    flex-direction: row;
    align-items: center;
    background-color: rgba(40, 32, 50, 0.8);
    border-radius: 4px;
    padding: 6px 10px;
}

.brand-icon {
    width: 20px;
    height: 20px;
    border-radius: 4px;
    margin-right: 8px;
}

.brand-name {
    color: rgb(235, 225, 215);
    font-size: 14px;
}

/* Stat bars */
.stat-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.stat-bar-bg {
    flex-grow: 1;
    height: 8px;
    background-color: rgb(28, 20, 25);
    border-radius: 4px;
    overflow: hidden;
}

.stat-bar-fill {
    height: 100%;
    border-radius: 4px;
    transition-duration: 0.3s;
    transition-property: width;
}

/* Ability cards */
.ability-card {
    flex-direction: row;
    align-items: center;
    padding: 10px;
    background-color: rgb(28, 20, 25);
    border-color: rgb(50, 35, 42);
    border-width: 1px;
    border-radius: 4px;
}

.ability-card:hover {
    background-color: rgb(40, 30, 38);
    border-color: rgb(70, 45, 55);
}

.ability-icon {
    width: 40px;
    height: 40px;
    background-color: rgb(45, 30, 38);
    border-radius: 4px;
    margin-right: 12px;
    -unity-background-scale-mode: scale-to-fit;
}

.ability-name {
    color: rgb(235, 225, 215);
    font-size: 14px;
    -unity-font-style: bold;
    margin-bottom: 2px;
}

.ability-desc {
    color: rgb(165, 155, 145);
    font-size: 12px;
}

/* =============================================================================
   INVENTORY UI
   ============================================================================= */

/* Category Tabs */
.inventory-tab {
    flex-grow: 1;
    height: 36px;
    background-color: transparent;
    border-width: 0;
    border-radius: 6px;
    color: rgb(165, 155, 145);
    font-size: 12px;
    letter-spacing: 1px;
    margin: 2px;
    transition-duration: 0.15s;
}

.inventory-tab:hover {
    background-color: rgba(180, 40, 60, 0.2);
    color: rgb(200, 190, 180);
}

.inventory-tab-active {
    background-color: rgb(180, 40, 60);
    color: rgb(235, 225, 215);
}

.inventory-tab-active:hover {
    background-color: rgb(160, 50, 80);
}

/* Item Grid Slots */
.item-slot {
    width: 72px;
    height: 72px;
    margin: 4px;
    background-color: rgb(28, 20, 25);
    border-width: 2px;
    border-color: rgb(50, 35, 42);
    border-radius: 6px;
    justify-content: center;
    align-items: center;
    transition-duration: 0.15s;
}

.item-slot:hover {
    border-color: rgb(180, 40, 60);
    background-color: rgb(40, 30, 38);
}

.item-slot-selected {
    border-color: rgb(220, 60, 80);
    background-color: rgb(50, 32, 42);
}

.item-slot-empty {
    background-color: rgb(18, 14, 25);
    border-style: dashed;
    border-color: rgb(35, 30, 45);
}

/* Item icon within slot */
.item-slot-icon {
    width: 48px;
    height: 48px;
    -unity-background-scale-mode: scale-to-fit;
}

/* Item quantity badge */
.item-quantity-badge {
    position: absolute;
    right: 2px;
    bottom: 2px;
    background-color: rgba(0, 0, 0, 0.8);
    padding: 2px 6px;
    border-radius: 4px;
}

.item-quantity-text {
    color: rgb(235, 225, 215);
    font-size: 11px;
    -unity-font-style: bold;
}

/* Rarity borders */
.rarity-common {
    border-color: rgb(120, 120, 120);
}

.rarity-uncommon {
    border-color: rgb(60, 180, 80);
}

.rarity-rare {
    border-color: rgb(60, 120, 220);
}

.rarity-epic {
    border-color: rgb(180, 50, 80);
}

.rarity-legendary {
    border-color: rgb(220, 160, 40);
}

.rarity-mythic {
    border-color: rgb(255, 80, 80);
    border-width: 3px;
}

/* Item icon frame (for detail panel) */
.item-icon-frame {
    background-color: rgb(28, 20, 25);
    border-width: 3px;
    border-radius: 8px;
    padding: 8px;
}

/* Stat display rows */
.item-stat-row {
    flex-direction: row;
    justify-content: space-between;
    padding: 6px 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(60, 50, 75, 0.3);
}

.item-stat-name {
    color: rgb(165, 155, 145);
    font-size: 13px;
}

.item-stat-value {
    font-size: 13px;
    -unity-font-style: bold;
}

.item-stat-positive {
    color: rgb(80, 200, 120);
}

.item-stat-negative {
    color: rgb(220, 80, 80);
}

/* Effect display */
.item-effect {
    padding: 8px;
    margin-bottom: 6px;
    background-color: rgba(180, 40, 60, 0.1);
    border-radius: 4px;
    border-left-width: 3px;
    border-left-color: rgb(180, 40, 60);
}

.item-effect-text {
    color: rgb(200, 190, 180);
    font-size: 13px;
}

/* Dropdown styling - see main dropdown section above */

/* Danger button for drop/discard */
.vb-button-danger {
    background-color: rgb(120, 40, 40);
    border-color: rgb(160, 60, 60);
}

.vb-button-danger:hover {
    background-color: rgb(150, 50, 50);
    border-color: rgb(180, 80, 80);
}

.vb-button-danger:active {
    background-color: rgb(100, 30, 30);
}

/* =============================================================================
   MONSTER COLLECTION UI
   ============================================================================= */

/* Monster card in grid */
.monster-card {
    width: 100px;
    height: 120px;
    margin: 6px;
    background-color: rgb(28, 20, 25);
    border-width: 2px;
    border-color: rgb(50, 35, 42);
    border-radius: 8px;
    padding: 8px;
    flex-direction: column;
    align-items: center;
    transition-duration: 0.15s;
}

.monster-card:hover {
    border-color: rgb(180, 40, 60);
    background-color: rgb(40, 30, 38);
    scale: 1.02;
}

.monster-card-selected {
    border-color: rgb(220, 60, 80);
    background-color: rgb(50, 32, 42);
}

/* Monster portrait in card */
.monster-card-portrait {
    width: 64px;
    height: 64px;
    background-color: rgb(40, 30, 38);
    border-radius: 4px;
    margin-bottom: 6px;
    -unity-background-scale-mode: scale-to-fit;
}

.monster-card-name {
    color: rgb(200, 190, 180);
    font-size: 11px;
    -unity-text-align: middle-center;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 84px;
}

.monster-card-level {
    color: rgb(165, 155, 145);
    font-size: 10px;
}

/* Corruption glow effects */
.corruption-low {
    border-color: rgb(60, 120, 80);
}

.corruption-medium {
    border-color: rgb(180, 150, 60);
}

.corruption-high {
    border-color: rgb(180, 80, 80);
}

.corruption-critical {
    border-color: rgb(180, 40, 60);
    border-width: 3px;
}

/* Corruption bar */
.corruption-bar-bg {
    height: 12px;
    background-color: rgb(28, 20, 25);
    border-radius: 6px;
    overflow: hidden;
}

/* Monster stat item */
.monster-stat-item {
    flex-direction: column;
    align-items: flex-start;
    padding: 4px;
}

/* Skill display in list */
.monster-skill {
    flex-direction: row;
    align-items: center;
    padding: 8px;
    margin-bottom: 4px;
    background-color: rgb(30, 24, 40);
    border-radius: 4px;
    border-left-width: 3px;
    border-left-color: rgb(180, 40, 60);
}

.monster-skill:hover {
    background-color: rgb(45, 30, 38);
}

.monster-skill-icon {
    width: 24px;
    height: 24px;
    background-color: rgb(50, 35, 42);
    border-radius: 4px;
    margin-right: 10px;
}

.monster-skill-name {
    color: rgb(200, 190, 180);
    font-size: 13px;
    flex-grow: 1;
}

.monster-skill-brand {
    width: 16px;
    height: 16px;
    border-radius: 8px;
}

/* Text field styling */
.vb-text-field {
    background-color: rgb(28, 20, 25);
    border-color: rgb(70, 45, 55);
    border-width: 1px;
    border-radius: 4px;
    padding: 6px 12px;
    color: rgb(200, 190, 180);
    font-size: 13px;
}

.vb-text-field:hover {
    border-color: rgb(120, 50, 70);
}

.vb-text-field:focus {
    border-color: rgb(180, 40, 60);
}

.vb-text-field > .unity-text-field__input {
    background-color: transparent;
    border-width: 0;
    color: rgb(200, 190, 180);
}

/* =============================================================================
   VERA DIALOGUE UI
   ============================================================================= */

/* Main dialogue box */
.dialogue-box {
    background-color: rgba(12, 10, 18, 0.95);
    border-width: 2px;
    border-color: rgb(70, 45, 55);
    border-radius: 12px;
    overflow: hidden;
}

.dialogue-box-glitched {
    border-color: rgb(180, 40, 60);
}

/* Glitch overlay effect */
.dialogue-glitch-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(160, 60, 120, 0.1);
    border-radius: 12px;
}

/* VERA Portrait */
.vera-portrait-frame {
    width: 100px;
    height: 100px;
    background-color: rgb(20, 16, 28);
    border-radius: 50px;
    border-width: 3px;
    border-color: rgb(180, 40, 60);
    justify-content: center;
    align-items: center;
    overflow: hidden;
}

.vera-portrait-frame-glitched {
    border-color: rgb(180, 40, 60);
}

.vera-portrait-glow {
    position: absolute;
    left: -4px;
    top: -4px;
    right: -4px;
    bottom: -4px;
    border-radius: 54px;
    border-width: 2px;
    border-color: rgba(120, 200, 150, 0.5);
}

.vera-portrait-glow-corrupted {
    border-color: rgba(160, 60, 120, 0.7);
}

.vera-portrait {
    width: 80px;
    height: 80px;
    border-radius: 40px;
    background-color: rgb(70, 45, 55);
    -unity-background-scale-mode: scale-to-fit;
}

.vera-scanlines {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(160, 60, 120, 0.3);
    border-radius: 50px;
}

.vera-name {
    color: rgb(120, 200, 150);
    font-size: 14px;
    letter-spacing: 3px;
    -unity-font-style: bold;
}

.vera-name-glitched {
    color: rgb(180, 40, 60);
}

/* Integrity pip indicator */
.integrity-pip {
    width: 12px;
    height: 12px;
    border-radius: 6px;
    background-color: rgb(120, 200, 150);
}

.integrity-pip-warning {
    background-color: rgb(220, 180, 60);
}

.integrity-pip-critical {
    background-color: rgb(200, 60, 80);
}

.integrity-pip-corrupted {
    background-color: rgb(180, 40, 60);
}

/* Dialogue text */
.dialogue-text {
    color: rgb(220, 215, 210);
    font-size: 16px;
    white-space: normal;
    line-height: 1.5;
}

.dialogue-text-glitched {
    color: rgb(200, 140, 170);
}

/* Continue indicator */
.continue-hint {
    color: rgb(100, 90, 85);
    font-size: 11px;
    letter-spacing: 1px;
}

.continue-arrow {
    width: 0;
    height: 0;
    margin-left: 8px;
    border-left-width: 6px;
    border-right-width: 6px;
    border-top-width: 8px;
    border-left-color: transparent;
    border-right-color: transparent;
    border-top-color: rgb(100, 90, 85);
}

/* Choices container */
.dialogue-choices {
    background-color: rgba(8, 6, 12, 0.5);
}

/* Choice button */
.dialogue-choice {
    padding: 12px 20px;
    margin-bottom: 8px;
    background-color: rgb(28, 20, 25);
    border-width: 1px;
    border-color: rgb(70, 45, 55);
    border-radius: 6px;
    transition-duration: 0.15s;
}

.dialogue-choice:hover {
    background-color: rgb(45, 30, 38);
    border-color: rgb(180, 40, 60);
}

.dialogue-choice:active {
    background-color: rgb(55, 35, 45);
}

.dialogue-choice-text {
    color: rgb(200, 190, 180);
    font-size: 14px;
}

.dialogue-choice:hover .dialogue-choice-text {
    color: rgb(235, 225, 215);
}

/* Choice with consequence indicator */
.dialogue-choice-consequence {
    border-left-width: 3px;
    border-left-color: rgb(220, 180, 60);
}

.dialogue-choice-dangerous {
    border-left-color: rgb(200, 60, 80);
}

/* Veil Integrity bar */
.integrity-bar-bg {
    background-color: rgb(28, 20, 25);
    border-radius: 4px;
    overflow: hidden;
}

.integrity-bar-fill {
    height: 100%;
    background-color: rgb(120, 200, 150);
    border-radius: 4px;
    transition-duration: 0.3s;
    transition-property: width, background-color;
}

.integrity-bar-fill-warning {
    background-color: rgb(220, 180, 60);
}

.integrity-bar-fill-critical {
    background-color: rgb(200, 60, 80);
}

.integrity-bar-fill-corrupted {
    background-color: rgb(180, 40, 60);
}

/* =============================================================================
   AAA MENU BUTTON STYLES
   ============================================================================= */

/* Primary button with glow effect */
.btn-primary {
    min-height: 54px;
    font-size: 16px;
    letter-spacing: 3px;
    -unity-font-style: bold;
    background-color: rgba(180, 40, 60, 0.9);
    border-width: 2px;
    border-color: rgb(220, 60, 80);
    border-radius: 8px;
    color: rgb(235, 225, 215);
    padding: 14px 24px;
    transition-duration: 0.2s;
    transition-property: background-color, border-color, scale, translate;
}

.btn-primary:hover {
    background-color: rgb(160, 50, 80);
    border-color: rgb(220, 60, 80);
    scale: 1.02;
    translate: -2px 0;
}

.btn-primary:active {
    background-color: rgb(120, 30, 50);
    scale: 0.98;
}

.btn-secondary {
    min-height: 44px;
    font-size: 14px;
    letter-spacing: 2px;
    background-color: rgba(40, 25, 30, 0.85);
    border-width: 1px;
    border-color: rgba(130, 60, 70, 0.6);
    border-radius: 6px;
    color: rgb(165, 155, 145);
    padding: 10px 20px;
    transition-duration: 0.15s;
    transition-property: background-color, border-color, color, translate;
}

.btn-secondary:hover {
    background-color: rgba(60, 50, 80, 0.9);
    border-color: rgba(180, 40, 60, 0.8);
    color: rgb(200, 190, 180);
    translate: -2px 0;
}

.btn-secondary:active {
    background-color: rgb(55, 35, 45);
}

.btn-tertiary {
    min-height: 40px;
    font-size: 12px;
    letter-spacing: 1px;
    background-color: transparent;
    border-width: 1px;
    border-color: rgba(100, 50, 65, 0.4);
    border-radius: 4px;
    color: rgb(120, 110, 100);
    padding: 8px 16px;
    transition-duration: 0.15s;
}

.btn-tertiary:hover {
    background-color: rgba(180, 50, 70, 0.2);
    border-color: rgba(180, 50, 70, 0.5);
    color: rgb(180, 50, 70);
}

/* =============================================================================
   AAA TITLE STYLES
   ============================================================================= */

.title-hero {
    font-size: 68px;
    letter-spacing: 8px;
    -unity-font-style: bold;
    color: rgb(235, 225, 215);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(180, 40, 60, 0.5);
}

.title-tagline {
    font-size: 14px;
    letter-spacing: 3px;
    color: rgb(165, 155, 145);
    -unity-font-style: italic;
}

/* =============================================================================
   AAA BACKGROUND & VIGNETTE STYLES
   ============================================================================= */

.bg-void {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(8, 6, 12);
}

.bg-vignette-top {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    height: 35%;
    background-color: rgba(0, 0, 0, 0.4);
}

.bg-vignette-bottom {
    position: absolute;
    left: 0;
    bottom: 0;
    right: 0;
    height: 35%;
    background-color: rgba(0, 0, 0, 0.5);
}

.bg-vignette-left {
    position: absolute;
    left: 0;
    top: 0;
    width: 25%;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.3);
}

.bg-vignette-right {
    position: absolute;
    right: 0;
    top: 0;
    width: 25%;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.3);
}

/* =============================================================================
   AAA DECORATED ELEMENTS
   ============================================================================= */

.divider-decorated {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.divider-line {
    flex-grow: 1;
    height: 1px;
    background-color: rgba(180, 40, 60, 0.3);
}

.divider-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: rgba(180, 40, 60, 0.5);
}

/* =============================================================================
   AAA FOOTER STYLES
   ============================================================================= */

.footer {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 16px 40px;
    background-color: rgba(8, 6, 12, 0.8);
    border-top-width: 1px;
    border-top-color: rgba(180, 40, 60, 0.2);
}

.footer-text {
    font-size: 11px;
    letter-spacing: 1px;
    color: rgb(80, 70, 65);
}

/* =============================================================================
   AAA LOADING OVERLAY
   ============================================================================= */

.loading-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(8, 6, 12, 0.95);
    justify-content: center;
    align-items: center;
}

.loading-spinner {
    width: 48px;
    height: 48px;
    border-width: 3px;
    border-color: rgba(180, 40, 60, 0.3);
    border-top-color: rgb(180, 40, 60);
    border-radius: 50%;
    margin-bottom: 20px;
}

.loading-text {
    font-size: 14px;
    letter-spacing: 4px;
    color: rgb(180, 40, 60);
}

/* =============================================================================
   AAA PARTICLE LAYERS
   ============================================================================= */

.particle-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    overflow: hidden;
}

/* =============================================================================
   AAA SETTINGS PANEL STYLES
   ============================================================================= */

.settings-panel-container {
    background-color: rgba(12, 9, 18, 0.95);
    border-width: 2px;
    border-color: rgba(180, 40, 60, 0.4);
    border-radius: 16px;
    padding: 32px;
    overflow: visible !important; /* CRITICAL: Allow dropdown popups to render outside panel */
}

/* Settings Close Button - Perfectly centered X */
.settings-panel-container #btn-close {
    transition: all 0.2s ease;
}

.settings-panel-container #btn-close:hover {
    border-color: rgb(220, 60, 80);
    color: rgb(220, 80, 100);
    scale: 1.05;
}

.settings-panel-container #btn-close:active {
    background-color: rgba(180, 40, 60, 0.2);
    scale: 0.95;
}

.settings-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
    padding-bottom: 16px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(180, 40, 60, 0.3);
}

.settings-title {
    font-size: 28px;
    letter-spacing: 6px;
    -unity-font-style: bold;
    color: rgb(235, 225, 215);
}

.settings-close-btn {
    width: 44px;
    height: 44px;
    font-size: 24px;
    background-color: transparent;
    border-width: 1px;
    border-color: rgba(180, 50, 70, 0.3);
    border-radius: 50%;
    color: rgb(180, 50, 70);
    transition-duration: 0.15s;
}

.settings-close-btn:hover {
    background-color: rgba(180, 50, 70, 0.2);
    border-color: rgb(180, 50, 70);
}

/* Settings Tab Bar */
.settings-tab-bar {
    flex-direction: row;
    margin-bottom: 24px;
    background-color: rgba(20, 16, 28, 0.5);
    border-radius: 8px;
    padding: 4px;
}

.settings-tab {
    flex-grow: 1;
    min-height: 44px;
    font-size: 13px;
    letter-spacing: 2px;
    background-color: transparent;
    border-width: 0;
    border-radius: 6px;
    color: rgb(120, 110, 100);
    margin: 0 2px;
    transition-duration: 0.15s;
}

.settings-tab:hover {
    background-color: rgba(180, 40, 60, 0.15);
    color: rgb(165, 155, 145);
}

.settings-tab-active {
    background-color: rgb(180, 40, 60);
    color: rgb(235, 225, 215);
}

.settings-tab-active:hover {
    background-color: rgb(160, 50, 80);
}

.settings-tab-inactive {
    background-color: transparent;
    color: rgb(165, 155, 145); /* Lighter gray for better visibility */
}

/* Settings Row */
.settings-row {
    flex-direction: row;
    align-items: center;
    padding: 12px 0;
    margin-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(60, 50, 75, 0.2);
}

.settings-label {
    width: 180px;
    min-width: 180px;
    flex-shrink: 0;
    font-size: 14px;
    color: rgb(165, 155, 145);
    letter-spacing: 1px;
}

.settings-control {
    flex-grow: 1;
    margin: 0 16px;
}

.settings-value {
    width: 60px;
    min-width: 60px;
    flex-shrink: 0;
    font-size: 14px;
    color: rgb(180, 40, 60);
    -unity-text-align: middle-right;
    -unity-font-style: bold;
}

/* Settings Section Header */
.settings-section-header {
    font-size: 12px;
    letter-spacing: 3px;
    color: rgb(180, 40, 60);
    margin-top: 24px;
    margin-bottom: 16px;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(180, 40, 60, 0.3);
}

/* Settings Button Row */
.settings-button-row {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 24px;
    padding-top: 16px;
    border-top-width: 1px;
    border-top-color: rgba(180, 40, 60, 0.2);
}

.settings-scroll {
    overflow: visible;
}

.settings-scroll .unity-scroll-view__content-container {
    overflow: visible;
}

.settings-scroll .unity-scroll-view__content-viewport {
    overflow: visible;
    -unity-overflow-clip-box: content-box;
}

/* AAA Slider Style */
.aaa-slider {
    min-height: 24px;
}

.aaa-slider .unity-base-slider__tracker {
    background-color: rgba(40, 32, 55, 0.8);
    border-radius: 6px;
    height: 8px;
}

.aaa-slider .unity-base-slider__dragger {
    background-color: rgb(180, 40, 60);
    border-width: 2px;
    border-color: rgb(220, 60, 80);
    border-radius: 50%;
    width: 22px;
    height: 22px;
    margin-top: -7px;
    transition-duration: 0.1s;
}

.aaa-slider:hover .unity-base-slider__dragger {
    background-color: rgb(170, 50, 80);
    scale: 1.1;
}

.aaa-slider .unity-base-slider__drag-container {
    background-color: rgb(180, 40, 60);
    border-radius: 6px;
}

/* AAA Toggle Style */
.aaa-toggle {
    flex-direction: row;
    align-items: center;
}

.aaa-toggle .unity-toggle__input {
    background-color: rgba(40, 32, 55, 0.8);
    border-color: rgba(100, 50, 65, 0.5);
    border-width: 2px;
    border-radius: 14px;
    width: 52px;
    height: 28px;
    padding: 2px;
    transition-duration: 0.2s;
}

.aaa-toggle:checked .unity-toggle__input {
    background-color: rgba(180, 40, 60, 0.5);
    border-color: rgb(180, 40, 60);
}

.aaa-toggle .unity-toggle__checkmark {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background-color: rgb(100, 90, 80);
    transition-duration: 0.2s;
    translate: 0 0;
}

.aaa-toggle:checked .unity-toggle__checkmark {
    background-color: rgb(180, 40, 60);
    translate: 24px 0;
}

.aaa-toggle .unity-toggle__text {
    color: rgb(165, 155, 145);
    font-size: 14px;
    margin-left: 12px;
}

/* =============================================================================
   PATH BADGE STYLES
   ============================================================================= */

.path-badge {
    padding: 6px 14px;
    border-radius: 4px;
    border-width: 1px;
}

.path-ironbound {
    background-color: rgba(140, 120, 100, 0.2);
    border-color: rgba(140, 120, 100, 0.5);
    color: rgb(200, 180, 160);
}

.path-fangborn {
    background-color: rgba(160, 80, 80, 0.2);
    border-color: rgba(160, 80, 80, 0.5);
    color: rgb(200, 120, 120);
}

.path-voidtouched {
    background-color: rgba(140, 40, 80, 0.2);
    border-color: rgba(140, 40, 80, 0.5);
    color: rgb(180, 60, 80);
}

.path-unchained {
    background-color: rgba(60, 140, 160, 0.2);
    border-color: rgba(60, 140, 160, 0.5);
    color: rgb(100, 180, 200);
}

/* =============================================================================
   BRAND COLOR INDICATORS
   ============================================================================= */

.brand-indicator {
    width: 24px;
    height: 24px;
    border-radius: 6px;
    border-width: 2px;
}

.brand-iron { background-color: rgb(140, 130, 120); border-color: rgb(180, 170, 160); }
.brand-savage { background-color: rgb(180, 60, 60); border-color: rgb(220, 100, 100); }
.brand-surge { background-color: rgb(60, 140, 200); border-color: rgb(100, 180, 240); }
.brand-venom { background-color: rgb(80, 160, 80); border-color: rgb(120, 200, 120); }
.brand-dread { background-color: rgb(140, 40, 80); border-color: rgb(180, 60, 100); }
.brand-leech { background-color: rgb(160, 60, 120); border-color: rgb(200, 100, 160); }
.brand-grace { background-color: rgb(200, 180, 120); border-color: rgb(240, 220, 160); }
.brand-mend { background-color: rgb(100, 200, 180); border-color: rgb(140, 240, 220); }
.brand-ruin { background-color: rgb(220, 120, 40); border-color: rgb(255, 160, 80); }
.brand-void { background-color: rgb(50, 20, 35); border-color: rgb(100, 40, 60); }

/* =============================================================================
   SYNERGY DISPLAY
   ============================================================================= */

.synergy-badge {
    padding: 8px 16px;
    border-radius: 6px;
    border-width: 2px;
}

.synergy-full {
    background-color: rgba(80, 200, 120, 0.15);
    border-color: rgb(80, 200, 120);
}

.synergy-partial {
    background-color: rgba(200, 180, 80, 0.15);
    border-color: rgb(200, 180, 80);
}

.synergy-neutral {
    background-color: rgba(120, 120, 120, 0.15);
    border-color: rgb(120, 120, 120);
}

.synergy-anti {
    background-color: rgba(200, 80, 80, 0.15);
    border-color: rgb(200, 80, 80);
}

/* =============================================================================
   MONSTER CARD AAA STYLES
   ============================================================================= */

.monster-card-aaa {
    background-color: rgba(25, 20, 35, 0.9);
    border-width: 2px;
    border-color: rgba(100, 50, 65, 0.5);
    border-radius: 12px;
    padding: 16px;
    transition-duration: 0.2s;
}

.monster-card-aaa:hover {
    background-color: rgba(35, 28, 50, 0.95);
    border-color: rgba(180, 40, 60, 0.7);
    translate: 0 -2px;
}

.monster-portrait-frame {
    width: 120px;
    height: 120px;
    background-color: rgba(20, 16, 28, 0.8);
    border-width: 3px;
    border-color: rgba(180, 40, 60, 0.4);
    border-radius: 8px;
    justify-content: center;
    align-items: center;
    overflow: hidden;
}

.monster-portrait-placeholder {
    width: 100%;
    height: 100%;
    background-color: rgba(100, 50, 65, 0.3);
    justify-content: center;
    align-items: center;
}

.monster-portrait-placeholder-text {
    font-size: 48px;
    color: rgba(180, 40, 60, 0.5);
}

/* =============================================================================
   HERO SUMMARY CARD
   ============================================================================= */

.hero-summary-card {
    flex-direction: row;
    align-items: center;
    background-color: rgba(18, 14, 26, 0.9);
    border-width: 1px;
    border-color: rgba(180, 40, 60, 0.3);
    border-radius: 8px;
    padding: 16px 24px;
}

.hero-summary-portrait {
    width: 64px;
    height: 64px;
    background-color: rgba(40, 32, 55, 0.8);
    border-radius: 8px;
    margin-right: 16px;
}

.hero-summary-info {
    flex-grow: 1;
}

.hero-summary-name {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(235, 225, 215);
    margin-bottom: 4px;
}

.hero-summary-path {
    font-size: 12px;
    letter-spacing: 2px;
    color: rgb(180, 40, 60);
}
