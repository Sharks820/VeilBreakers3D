/* ═════════════════════════════════════════════════════════════════════════════
   VEILBREAKERS 3D - AAA CHARACTER SELECT SCREEN
   Cinematic, atmospheric, immersive hero selection experience
   ═════════════════════════════════════════════════════════════════════════════ */

/* Import theme variables */
@import url("VeilBreakersTheme.uss");

/* ═════════════════════════════════════════════════════════════════════════════
   CORE VARIABLES - Character Select Specific
   ═════════════════════════════════════════════════════════════════════════════ */

:root {
    /* Transition Timing */
    --transition-fast: 0.2s;
    --transition-normal: 0.4s;
    --transition-slow: 0.8s;
    --transition-hero-switch: 1.2s;
    
    /* Easing Functions */
    --ease-out-expo: cubic-bezier(0.16, 1, 0.3, 1);
    --ease-out-back: cubic-bezier(0.34, 1.56, 0.64, 1);
    --ease-in-out-quint: cubic-bezier(0.86, 0, 0.07, 1);
    
    /* Spacing */
    --panel-margin: 40px;
    --card-gap: 20px;
    
    /* Glass Effect */
    --glass-bg: rgba(15, 12, 20, 0.75);
    --glass-border: rgba(255, 255, 255, 0.1);
    --glass-blur: 12px;
    
    /* Glow Effects */
    --glow-primary: 0 0 20px var(--hero-color-primary);
    --glow-secondary: 0 0 40px var(--hero-color-secondary);
    --glow-text: 0 0 20px rgba(235, 225, 215, 0.8);
}

/* ═════════════════════════════════════════════════════════════════════════════
   HIDDEN STATE
   ═════════════════════════════════════════════════════════════════════════════ */

.hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
}

/* ═════════════════════════════════════════════════════════════════════════════
   BACKGROUND LAYERS - Parallax System
   ═════════════════════════════════════════════════════════════════════════════ */

.parallax-bg {
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
}

/* Layer 1: Deepest Void */
.parallax-deep {
    background-color: rgb(5, 3, 8);
    z-index: 0;
}

.void-stars {
    position: absolute;
    width: 100%;
    height: 100%;
    /* Procedural starfield using radial gradients */
    background-color: transparent;
    opacity: 0.6;
}

.veil-cracks {
    position: absolute;
    width: 100%;
    height: 100%;
    /* Procedural crack effect using subtle gradient */
    background: linear-gradient(135deg,
        transparent 0%,
        rgba(60, 20, 40, 0.1) 25%,
        transparent 50%,
        rgba(40, 15, 30, 0.08) 75%,
        transparent 100%);
    opacity: 0.3;
}

/* Layer 2: Fog Particles */
.parallax-fog {
    z-index: 1;
    pointer-events: none;
}

.fog-particles {
    position: absolute;
    width: 100%;
    height: 100%;
    /* Procedural fog using layered gradients */
    background: radial-gradient(ellipse 80% 50% at 20% 60%,
            rgba(40, 30, 50, 0.4) 0%,
            transparent 70%),
        radial-gradient(ellipse 60% 40% at 80% 40%,
            rgba(30, 20, 40, 0.3) 0%,
            transparent 60%),
        radial-gradient(ellipse 100% 80% at 50% 80%,
            rgba(20, 15, 30, 0.5) 0%,
            transparent 50%);
    opacity: 0.6;
}

@keyframes fog-drift {
    0% { background-position: 0% 50%; }
    100% { background-position: 200% 50%; }
}

/* Layer 3: Midground Environment */
.parallax-mid {
    z-index: 2;
}

.hero-environment {
    position: absolute;
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
    opacity: 0.6;
    transition: opacity var(--transition-slow) var(--ease-out-expo);
}

/* Layer 4: Near Atmosphere */
.parallax-near {
    z-index: 3;
    pointer-events: none;
}

.ambient-glow {
    position: absolute;
    width: 100%;
    height: 100%;
    background: radial-gradient(ellipse at 50% 70%, 
        var(--hero-color-primary) 0%,
        transparent 60%);
    opacity: 0.15;
    transition: background var(--transition-slow) var(--ease-out-expo);
}

/* Layer 5: Vignette Overlay */
.vignette-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    z-index: 4;
    pointer-events: none;
    background: radial-gradient(ellipse at 50% 50%,
        transparent 0%,
        transparent 50%,
        rgba(0, 0, 0, 0.4) 80%,
        rgba(0, 0, 0, 0.7) 100%);
}

/* Transition Overlay */
.transition-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    z-index: 100;
    background-color: rgb(0, 0, 0);
    opacity: 0;
    transition: opacity var(--transition-normal) var(--ease-in-out-quint);
}

.transition-overlay.hidden {
    opacity: 0;
}

.transition-overlay.active {
    opacity: 1;
}

/* ═════════════════════════════════════════════════════════════════════════════
   MAIN STAGE - Hero Display
   ═════════════════════════════════════════════════════════════════════════════ */

.main-stage {
    position: absolute;
    width: 60%;
    height: 70%;
    top: 10%;
    left: 5%;
    z-index: 10;
}

/* Hero Aura Container */
.hero-aura-container {
    position: absolute;
    width: 100%;
    height: 100%;
    z-index: 1;
}

.aura-base {
    position: absolute;
    width: 80%;
    height: 80%;
    top: 10%;
    left: 10%;
    /* Procedural aura glow */
    background: radial-gradient(ellipse 50% 60% at 50% 50%,
        rgba(140, 150, 165, 0.3) 0%,
        rgba(140, 150, 165, 0.1) 40%,
        transparent 70%);
    border-radius: 50%;
    opacity: 0.6;
    animation: aura-pulse 4s var(--ease-in-out-quint) infinite;
}

@keyframes aura-pulse {
    0%, 100% { 
        opacity: 0.5; 
        scale: 1;
        rotate: 0deg;
    }
    50% { 
        opacity: 0.8; 
        scale: 1.05;
        rotate: 5deg;
    }
}

.aura-particles {
    position: absolute;
    width: 100%;
    height: 100%;
    /* Procedural particle effect using multiple gradients */
    background: radial-gradient(circle 3px at 20% 30%, rgba(200, 200, 220, 0.6) 0%, transparent 100%),
        radial-gradient(circle 2px at 60% 20%, rgba(180, 190, 200, 0.5) 0%, transparent 100%),
        radial-gradient(circle 4px at 80% 60%, rgba(160, 170, 180, 0.4) 0%, transparent 100%),
        radial-gradient(circle 2px at 40% 80%, rgba(200, 210, 220, 0.5) 0%, transparent 100%),
        radial-gradient(circle 3px at 70% 40%, rgba(170, 180, 190, 0.4) 0%, transparent 100%);
    opacity: 0.6;
    animation: particle-float 8s linear infinite;
}

@keyframes particle-float {
    0% { background-position: 0% 0%; }
    100% { background-position: 100% 100%; }
}

.ground-glow {
    position: absolute;
    width: 60%;
    height: 30%;
    bottom: 5%;
    left: 20%;
    background: radial-gradient(ellipse at 50% 100%,
        var(--hero-color-primary) 0%,
        transparent 70%);
    opacity: 0.3;
}

/* Hero Display */
.hero-display {
    position: absolute;
    width: 100%;
    height: 100%;
    z-index: 2;
}

.hero-silhouette {
    position: absolute;
    width: 100%;
    height: 100%;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center bottom;
    transition: all var(--transition-hero-switch) var(--ease-out-expo);
}

.hero-rim-light {
    position: absolute;
    width: 100%;
    height: 100%;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center bottom;
    mix-blend-mode: screen;
    opacity: 0.6;
}

.hero-eyes {
    position: absolute;
    width: 100%;
    height: 100%;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center bottom;
    mix-blend-mode: screen;
    opacity: 0.9;
    transition: opacity var(--transition-normal) var(--ease-out-expo);
}

.hero-eyes.hidden {
    opacity: 0;
}

/* Monster Orbit System */
.monster-orbit {
    position: absolute;
    width: 200px;
    height: 200px;
    top: 20%;
    right: 10%;
    z-index: 3;
}

.synergy-tether {
    position: absolute;
    width: 100%;
    height: 2px;
    top: 50%;
    background: linear-gradient(90deg, 
        transparent 0%,
        var(--hero-color-primary) 50%,
        transparent 100%);
    opacity: 0.6;
    animation: tether-pulse 2s var(--ease-in-out-quint) infinite;
}

@keyframes tether-pulse {
    0%, 100% { opacity: 0.4; }
    50% { opacity: 0.8; }
}

.monster-container {
    position: absolute;
    width: 80px;
    height: 80px;
    top: 30%;
    left: 50%;
    translate: -50% -50%;
    animation: orbit 12s linear infinite;
}

@keyframes orbit {
    0% { 
        transform: translateX(-60px) translateY(0px);
        scale: 1;
    }
    25% { 
        transform: translateX(0px) translateY(-40px);
        scale: 0.9;
    }
    50% { 
        transform: translateX(60px) translateY(0px);
        scale: 1;
    }
    75% { 
        transform: translateX(0px) translateY(40px);
        scale: 1.1;
    }
    100% { 
        transform: translateX(-60px) translateY(0px);
        scale: 1;
    }
}

.monster-model {
    width: 100%;
    height: 100%;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
}

.monster-aura {
    position: absolute;
    width: 120%;
    height: 120%;
    top: -10%;
    left: -10%;
    border-radius: 50%;
    background: radial-gradient(circle at 50% 50%,
        var(--hero-color-primary) 0%,
        transparent 70%);
    opacity: 0.3;
}

/* Environmental Effects */
.env-effects {
    position: absolute;
    width: 100%;
    height: 100%;
    z-index: 4;
    pointer-events: none;
}

/* ═════════════════════════════════════════════════════════════════════════════
   RIGHT PANEL - Stats & Abilities
   ═════════════════════════════════════════════════════════════════════════════ */

.right-panel {
    position: absolute;
    width: 280px;
    height: auto;
    top: var(--panel-margin);
    right: var(--panel-margin);
    padding: 24px;
    z-index: 20;
    
    background-color: var(--glass-bg);
    backdrop-filter: blur(var(--glass-blur));
    -unity-backdrop-filter: blur(var(--glass-blur));
    border-width: 1px;
    border-color: var(--glass-border);
    border-radius: 8px;
}

/* Path Badge */
.path-badge {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
    padding: 8px 16px;
    background-color: rgba(0, 0, 0, 0.25);
    border-radius: 4px;
    border-width: 1px;
    border-color: var(--hero-color-primary);
}

.path-icon {
    width: 24px;
    height: 24px;
    margin-right: 8px;
    /* Procedural path icon - diamond shape */
    background-color: transparent;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.4);
    border-radius: 4px;
    rotate: 45deg;
    scale: 0.7;
}

.path-name {
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--hero-color-primary);
    letter-spacing: 3px;
}

/* Synergy Indicator */
.synergy-indicator {
    align-items: center;
    margin-bottom: 24px;
}

.synergy-label {
    font-size: 10px;
    color: var(--text-secondary);
    letter-spacing: 4px;
    margin-bottom: 8px;
}

.synergy-stars {
    flex-direction: row;
    justify-content: center;
}

.synergy-star {
    width: 14px;
    height: 14px;
    margin: 0 3px;
    /* Procedural star - diamond/rhombus shape */
    background-color: rgba(60, 50, 70, 0.6);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.2);
    border-radius: 2px;
    rotate: 45deg;
    opacity: 0.5;
    transition: all var(--transition-fast) var(--ease-out-expo);
}

.synergy-star.filled {
    background-color: rgba(255, 200, 60, 0.9);
    border-color: rgba(255, 220, 100, 0.8);
    opacity: 1;
    box-shadow: 0 0 8px rgba(255, 200, 60, 0.6);
}

/* Stat Pillars */
.stat-pillars {
    flex-direction: row;
    justify-content: space-between;
    height: 200px;
    margin-bottom: 24px;
}

.stat-pillar {
    align-items: center;
    width: 30px;
    height: 100%;
}

.stat-value {
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--text-primary);
    margin-bottom: 4px;
}

.stat-bar-container {
    width: 8px;
    flex-grow: 1;
    background-color: rgba(255, 255, 255, 0.05);
    border-radius: 4px;
    overflow: hidden;
    margin-bottom: 4px;
}

.stat-fill {
    width: 100%;
    background: linear-gradient(180deg,
        var(--hero-color-secondary) 0%,
        var(--hero-color-primary) 100%);
    border-radius: 4px;
    transition: height 0.8s var(--ease-out-back);
}

.stat-pillar.highest .stat-fill {
    background: linear-gradient(180deg,
        var(--hero-color-secondary) 0%,
        var(--hero-color-primary) 100%);
    box-shadow: 0 0 10px var(--hero-color-primary);
}

.stat-label {
    font-size: 10px;
    color: var(--text-secondary);
    letter-spacing: 1px;
}

/* Ability Section */
.ability-section {
    margin-bottom: 24px;
}

.section-title {
    font-size: 10px;
    color: var(--text-secondary);
    letter-spacing: 4px;
    margin-bottom: 12px;
}

.ability-cards {
    gap: 8px;
}

.ability-card {
    flex-direction: row;
    align-items: center;
    padding: 8px 12px;
    background-color: rgba(255, 255, 255, 0.03);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.05);
    transition: all var(--transition-fast) var(--ease-out-expo);
}

.ability-card:hover {
    background-color: rgba(0, 0, 0, 0.25);
    border-color: var(--hero-color-primary);
    translate: 4px 0;
}

.ability-icon {
    width: 32px;
    height: 32px;
    margin-right: 12px;
    background-color: rgba(0, 0, 0, 0.3);
    border-radius: 4px;
    background-size: contain;
}

.ability-info {
    flex-grow: 1;
}

.ability-name {
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--text-primary);
    margin-bottom: 2px;
}

.ability-desc {
    font-size: 10px;
    color: var(--text-secondary);
}

.ability-desc.ultimate {
    color: rgba(200, 180, 120, 1);
}

/* Monster Section */
.monster-section {
    padding-top: 16px;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.05);
}

.monster-info-card {
    flex-direction: row;
    align-items: center;
    padding: 12px;
    background-color: rgba(255, 255, 255, 0.03);
    border-radius: 4px;
}

.monster-thumbnail {
    width: 48px;
    height: 48px;
    margin-right: 12px;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    border-radius: 4px;
}

.monster-name {
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--text-primary);
}

.monster-type {
    font-size: 10px;
    color: var(--text-secondary);
}

/* ═════════════════════════════════════════════════════════════════════════════
   HERO INFO DISPLAY (Bottom Center)
   ═════════════════════════════════════════════════════════════════════════════ */

.hero-info-container {
    position: absolute;
    width: 600px;
    height: auto;
    bottom: 220px;
    left: 50%;
    translate: -50% 0;
    z-index: 20;
    align-items: center;
}

.hero-name-display {
    font-size: 64px;
    -unity-font-style: bold;
    color: var(--hero-color-primary);
    text-shadow: var(--glow-primary),
                 0 0 60px var(--hero-color-primary);
    letter-spacing: 12px;
    margin-bottom: 8px;
    transition: all var(--transition-slow) var(--ease-out-expo);
}

.hero-title-display {
    font-size: 18px;
    color: var(--text-secondary);
    letter-spacing: 8px;
    text-transform: uppercase;
    margin-bottom: 16px;
}

.hero-quote {
    font-size: 14px;
    font-style: italic;
    color: rgba(200, 190, 180, 0.8);
    text-align: center;
    max-width: 400px;
    opacity: 0;
    transition: opacity var(--transition-slow) var(--ease-out-expo);
}

.hero-quote.visible {
    opacity: 1;
}

/* ═════════════════════════════════════════════════════════════════════════════
   HERO CAROUSEL
   ═════════════════════════════════════════════════════════════════════════════ */

.hero-carousel {
    position: absolute;
    width: 100%;
    height: 180px;
    bottom: 40px;
    z-index: 30;
    justify-content: center;
    align-items: center;
}

.carousel-track {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    gap: var(--card-gap);
}

/* Hero Cards */
.hero-card {
    width: 140px;
    height: 180px;
    background-color: rgba(15, 12, 20, 0.8);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
    overflow: hidden;
    cursor: pointer;
    transition: all var(--transition-normal) var(--ease-out-back);
    position: relative;
}

.hero-card:hover {
    border-color: rgba(255, 255, 255, 0.35);
    scale: 1.08;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
}

.hero-card.selected {
    scale: 1.15;
    border-color: var(--hero-color-secondary);
    border-width: 2px;
    box-shadow: 0 0 30px var(--hero-color-primary),
                0 0 60px var(--hero-color-primary),
                inset 0 0 15px rgba(255, 255, 255, 0.08);
}

.hero-portrait {
    position: absolute;
    width: 100%;
    height: 70%;
    top: 0;
    background-size: cover;
    background-position: center top;
    /* Unity UI Toolkit uses -unity-mask-image, not mask-image */
    -unity-mask-image: linear-gradient(180deg,
        rgba(0,0,0,1) 60%,
        rgba(0,0,0,0) 100%);
    opacity: 0.7;
    transition: opacity var(--transition-normal) var(--ease-out-expo);
}

.hero-card.selected .hero-portrait {
    opacity: 1;
}

.hero-frame {
    position: absolute;
    width: 100%;
    height: 100%;
    border-color: rgba(255, 255, 255, 0.1);
    border-width: 1px;
    border-radius: 8px;
}

.hero-glow {
    position: absolute;
    width: 100%;
    height: 100%;
    background: none;
    transition: all var(--transition-normal) var(--ease-out-expo);
}

.hero-glow.active {
    background: radial-gradient(ellipse at 50% 30%,
        var(--hero-color-primary) 0%,
        transparent 70%);
    opacity: 0.35;
}

.hero-card-name {
    position: absolute;
    width: 100%;
    bottom: 12px;
    text-align: center;
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--text-secondary);
    letter-spacing: 2px;
    transition: color var(--transition-normal) var(--ease-out-expo);
}

.hero-card.selected .hero-card-name {
    color: var(--text-primary);
}

.hero-path-icon {
    position: absolute;
    width: 16px;
    height: 16px;
    top: 8px;
    right: 8px;
    background-size: contain;
    opacity: 0.6;
}

/* Carousel Arrows */
.carousel-arrow {
    position: absolute;
    width: 48px;
    height: 48px;
    background-color: rgba(15, 12, 20, 0.8);
    border-radius: 50%;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.2);
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all var(--transition-fast) var(--ease-out-expo);
}

.carousel-arrow:hover {
    background-color: rgba(0, 0, 0, 0.35);
    border-color: var(--hero-color-primary);
    scale: 1.1;
}

.carousel-prev {
    left: calc(50% - 320px);
}

.carousel-next {
    right: calc(50% - 320px);
}

.arrow-icon {
    width: 12px;
    height: 12px;
    /* CSS arrow using borders */
    background-color: transparent;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 0;
    border-left-width: 0;
    border-color: rgba(255, 255, 255, 0.7);
    rotate: 45deg;
}

.arrow-icon.left {
    rotate: -135deg;
}

.arrow-icon.right {
    rotate: 45deg;
}

.carousel-arrow:hover .arrow-icon {
    border-color: var(--hero-color-secondary);
}

/* ═════════════════════════════════════════════════════════════════════════════
   EMBARK BUTTON (Hexagonal Ritual Button)
   ═════════════════════════════════════════════════════════════════════════════ */

.embark-button {
    position: absolute;
    width: 320px;
    height: 72px;
    bottom: 280px;
    left: 50%;
    translate: -50% 0;
    z-index: 25;
    background-color: transparent;
    border-width: 0;
    overflow: visible;
    cursor: pointer;
}

.embark-hex-bg {
    position: absolute;
    width: 100%;
    height: 100%;
    /* Stylized button background */
    background: linear-gradient(180deg,
        rgba(30, 25, 40, 0.95) 0%,
        rgba(15, 12, 20, 0.98) 100%);
    border-color: rgba(255, 255, 255, 0.15);
    border-width: 2px;
    border-radius: 6px;
    transition: all var(--transition-fast) var(--ease-out-expo);
}

.embark-button:hover .embark-hex-bg {
    background: linear-gradient(180deg,
        rgba(40, 35, 55, 0.95) 0%,
        rgba(20, 17, 28, 0.98) 100%);
    border-color: var(--hero-color-secondary);
    border-width: 2px;
    box-shadow: 0 0 25px var(--hero-color-primary),
                inset 0 1px 0 rgba(255, 255, 255, 0.1);
}

.embark-glow {
    position: absolute;
    width: 120%;
    height: 140%;
    top: -20%;
    left: -10%;
    background: none;
    transition: all var(--transition-fast) var(--ease-out-expo);
}

.embark-button:hover .embark-glow {
    background: radial-gradient(ellipse at 50% 50%,
        var(--hero-color-primary) 0%,
        transparent 60%);
    opacity: 0.55;
}

.embark-content {
    position: absolute;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
}

.embark-text {
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--text-primary);
    letter-spacing: 4px;
    margin-bottom: 2px;
    transition: all var(--transition-fast) var(--ease-out-expo);
}

.embark-button:hover .embark-text {
    color: var(--hero-color-secondary);
    text-shadow: 0 0 20px var(--hero-color-primary);
}

.embark-subtext {
    font-size: 10px;
    color: var(--text-secondary);
    letter-spacing: 2px;
}

.embark-particles {
    position: absolute;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity var(--transition-fast) var(--ease-out-expo);
}

.embark-button:hover .embark-particles {
    opacity: 1;
}

/* ═════════════════════════════════════════════════════════════════════════════
   NAVIGATION BUTTONS
   ═════════════════════════════════════════════════════════════════════════════ */

.nav-button {
    position: absolute;
    z-index: 40;
    background-color: rgba(15, 12, 20, 0.8);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    flex-direction: row;
    align-items: center;
    padding: 8px 16px;
    cursor: pointer;
    transition: all var(--transition-fast) var(--ease-out-expo);
}

.nav-button:hover {
    background-color: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.3);
}

.back-button {
    top: var(--panel-margin);
    left: var(--panel-margin);
}

.settings-button {
    top: var(--panel-margin);
    right: 340px;
    padding: 8px;
}

.nav-icon {
    width: 20px;
    height: 20px;
    background-size: contain;
    margin-right: 8px;
}

.nav-icon.settings-icon {
    margin-right: 0;
}

.nav-label {
    font-size: 12px;
    color: var(--text-secondary);
    letter-spacing: 2px;
}

.back-icon {
    /* CSS arrow pointing left */
    width: 10px;
    height: 10px;
    background-color: transparent;
    border-top-width: 2px;
    border-left-width: 2px;
    border-bottom-width: 0;
    border-right-width: 0;
    border-color: rgba(255, 255, 255, 0.6);
    rotate: -45deg;
}

.settings-icon {
    /* CSS gear-like shape using border */
    width: 18px;
    height: 18px;
    background-color: transparent;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.6);
    border-radius: 50%;
}

/* ═════════════════════════════════════════════════════════════════════════════
   VFX OVERLAYS
   ═════════════════════════════════════════════════════════════════════════════ */

.vfx-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    z-index: 50;
    pointer-events: none;
}

.particle-container {
    position: absolute;
    width: 100%;
    height: 100%;
}

.lightning-flash {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(200, 220, 255, 0.3);
    opacity: 0;
    transition: opacity 0.1s linear;
}

.lightning-flash.active {
    opacity: 1;
}

.corruption-fx {
    position: absolute;
    width: 100%;
    height: 100%;
    /* Procedural corruption effect */
    background: linear-gradient(45deg,
        rgba(80, 20, 40, 0.3) 0%,
        transparent 25%,
        rgba(60, 15, 30, 0.4) 50%,
        transparent 75%,
        rgba(100, 25, 50, 0.3) 100%);
    opacity: 0;
}

.corruption-fx.active {
    animation: corruption 0.8s steps(8) forwards;
}

@keyframes corruption {
    0% { opacity: 0; }
    20% { opacity: 0.8; }
    80% { opacity: 0.8; }
    100% { opacity: 0; }
}

/* ═════════════════════════════════════════════════════════════════════════════
   SCREEN FADE
   ═════════════════════════════════════════════════════════════════════════════ */

.screen-fade {
    position: absolute;
    width: 100%;
    height: 100%;
    z-index: 100;
    background-color: rgb(0, 0, 0);
    opacity: 0;
    transition: opacity 1s var(--ease-in-out-quint);
}

.screen-fade.active {
    opacity: 1;
}

/* ═════════════════════════════════════════════════════════════════════════════
   RESPONSIVE ADJUSTMENTS
   ═════════════════════════════════════════════════════════════════════════════ */

/* Ultrawide (21:9) */
@media (min-aspect-ratio: 2.0) {
    .main-stage {
        width: 50%;
        left: 10%;
    }
    
    .right-panel {
        width: 320px;
    }
    
    .carousel-prev {
        left: calc(50% - 380px);
    }
    
    .carousel-next {
        right: calc(50% - 380px);
    }
}

/* 16:10 (Older monitors) */
@media (max-aspect-ratio: 1.7) {
    .main-stage {
        height: 65%;
    }
    
    .hero-name-display {
        font-size: 48px;
    }
    
    .embark-button {
        bottom: 260px;
    }
}

/* ═════════════════════════════════════════════════════════════════════════════
   HERO-SPECIFIC COLOR OVERRIDES
   ═════════════════════════════════════════════════════════════════════════════ */

/* Vex - Iron/Steel (140, 150, 165) */
.hero-card[data-hero="vex"],
.hero-card[data-hero="vex"] .hero-glow.active {
    --hero-color-primary: rgb(140, 150, 165);
    --hero-color-secondary: rgb(180, 190, 205);
}

/* Seraphina - Venom Green (80, 180, 60) */
.hero-card[data-hero="seraphina"],
.hero-card[data-hero="seraphina"] .hero-glow.active {
    --hero-color-primary: rgb(80, 180, 60);
    --hero-color-secondary: rgb(120, 220, 100);
}

/* Orion - Lightning Blue (60, 140, 220) */
.hero-card[data-hero="orion"],
.hero-card[data-hero="orion"] .hero-glow.active {
    --hero-color-primary: rgb(60, 140, 220);
    --hero-color-secondary: rgb(100, 180, 255);
}

/* Nyx - Void Crimson (160, 40, 70) */
.hero-card[data-hero="nyx"],
.hero-card[data-hero="nyx"] .hero-glow.active {
    --hero-color-primary: rgb(160, 40, 70);
    --hero-color-secondary: rgb(200, 70, 100);
}

/* ═════════════════════════════════════════════════════════════════════════════
   REDUCED MOTION (Accessibility)
   ═════════════════════════════════════════════════════════════════════════════ */

@media (prefers-reduced-motion: reduce) {
    .aura-base,
    .aura-particles,
    .monster-container,
    .synergy-tether,
    .fog-particles {
        animation: none;
    }
    
    .stat-fill {
        transition: none;
    }
    
    .hero-card,
    .embark-button,
    .carousel-arrow,
    .nav-button {
        transition: opacity var(--transition-fast);
    }
}

/* ═════════════════════════════════════════════════════════════════════════════
   HIGH CONTRAST MODE (Accessibility)
   ═════════════════════════════════════════════════════════════════════════════ */

@media (prefers-contrast: high) {
    .glass-panel {
        background-color: rgba(0, 0, 0, 0.9);
        border-color: rgba(255, 255, 255, 0.5);
    }
    
    .hero-card {
        border-color: rgba(255, 255, 255, 0.3);
    }
    
    .hero-card.selected {
        border-width: 3px;
    }
    
    .stat-fill {
        background: var(--hero-color-primary);
    }
}
