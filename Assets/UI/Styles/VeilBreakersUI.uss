/* =============================================================================
   VEILBREAKERS AAA UI STYLESHEET
   The Ultimate Dark Fantasy Horror UI System
   ============================================================================= */

/* =============================================================================
   GLOBAL RESET & FONT
   ============================================================================= */

* {
    -unity-font-definition: url('project://database/Assets/UI/Fonts/Arial.ttf?fileID=12800000&guid=a1b82bd02ca673443b4c4c64ac746061&type=3');
    transition-duration: 0.2s;
    transition-timing-function: ease-out;
}

/* =============================================================================
   CSS CUSTOM PROPERTIES - SINGLE SOURCE OF TRUTH
   ============================================================================= */

:root {
    /* =========================================================================
       BRAND COLORS - The 10 Brands of VeilBreakers
       ========================================================================= */
    --brand-iron: rgb(140, 150, 165);
    --brand-iron-glow: rgb(180, 190, 205);
    --brand-savage: rgb(180, 45, 45);
    --brand-savage-glow: rgb(220, 70, 70);
    --brand-surge: rgb(60, 140, 220);
    --brand-surge-glow: rgb(100, 180, 255);
    --brand-venom: rgb(80, 180, 60);
    --brand-venom-glow: rgb(120, 220, 100);
    --brand-dread: rgb(140, 40, 80);
    --brand-dread-glow: rgb(180, 60, 100);
    --brand-leech: rgb(140, 40, 80);
    --brand-leech-glow: rgb(180, 60, 110);
    --brand-grace: rgb(220, 220, 240);
    --brand-grace-glow: rgb(255, 255, 255);
    --brand-mend: rgb(200, 170, 80);
    --brand-mend-glow: rgb(240, 210, 120);
    --brand-ruin: rgb(220, 120, 40);
    --brand-ruin-glow: rgb(255, 160, 80);
    --brand-void: rgb(60, 20, 40);
    --brand-void-glow: rgb(100, 40, 60);

    /* =========================================================================
       PATH COLORS
       ========================================================================= */
    --path-ironbound: rgb(140, 150, 165);
    --path-fangborn: rgb(180, 45, 45);
    --path-voidtouched: rgb(140, 50, 90);
    --path-unchained: rgb(200, 170, 80);

    /* =========================================================================
       SURFACE COLORS - Layered Depth System
       ========================================================================= */
    --surface-void: rgb(3, 2, 5);
    --surface-abyss: rgb(8, 6, 12);
    --surface-deep: rgb(12, 9, 18);
    --surface-dark: rgb(18, 14, 26);
    --surface-base: rgb(25, 18, 22);
    --surface-raised: rgb(38, 25, 32);
    --surface-elevated: rgb(50, 32, 40);
    --surface-floating: rgb(60, 40, 50);

    /* =========================================================================
       TEXT COLORS
       ========================================================================= */
    --text-white: rgb(255, 255, 255);
    --text-bright: rgb(240, 235, 225);
    --text-primary: rgb(215, 205, 195);
    --text-secondary: rgb(145, 135, 125);
    --text-muted: rgb(95, 85, 80);
    --text-disabled: rgb(60, 55, 50);
    --text-glow: rgb(255, 245, 220);
    --text-accent: rgb(220, 100, 120);

    /* =========================================================================
       ACCENT & GLOW COLORS - CRIMSON VEIL THEME
       ========================================================================= */
    --accent-primary: rgb(180, 40, 60);
    --accent-primary-glow: rgb(220, 60, 80);
    --accent-primary-bright: rgb(255, 100, 120);
    --accent-secondary: rgb(140, 30, 50);
    --accent-secondary-glow: rgb(180, 50, 70);
    --accent-gold: rgb(220, 180, 80);
    --accent-gold-glow: rgb(255, 220, 120);
    --accent-teal: rgb(60, 180, 160);
    --accent-teal-glow: rgb(100, 220, 200);

    /* =========================================================================
       STATUS COLORS
       ========================================================================= */
    --status-health: rgb(180, 50, 50);
    --status-health-glow: rgb(220, 80, 80);
    --status-attack: rgb(220, 120, 40);
    --status-attack-glow: rgb(255, 160, 80);
    --status-defense: rgb(100, 140, 180);
    --status-defense-glow: rgb(140, 180, 220);
    --status-speed: rgb(60, 180, 140);
    --status-speed-glow: rgb(100, 220, 180);

    /* =========================================================================
       CORRUPTION STATES
       ========================================================================= */
    --corruption-ascended: rgb(255, 215, 0);
    --corruption-purified: rgb(180, 210, 255);
    --corruption-unstable: rgb(160, 160, 170);
    --corruption-corrupted: rgb(160, 40, 80);
    --corruption-abyssal: rgb(80, 10, 30);

    /* =========================================================================
       BORDER COLORS
       ========================================================================= */
    --border-subtle: rgb(40, 28, 32);
    --border-default: rgb(60, 40, 45);
    --border-strong: rgb(90, 50, 60);
    --border-accent: rgb(180, 40, 60);
    --border-glow: rgb(220, 60, 80);

    /* =========================================================================
       ANIMATION TIMING
       ========================================================================= */
    --anim-instant: 0.1s;
    --anim-fast: 0.2s;
    --anim-normal: 0.3s;
    --anim-slow: 0.5s;
    --anim-slower: 0.8s;
    --anim-breathing: 3s;
}

/* =============================================================================
   ROOT CONTAINER
   ============================================================================= */

.vb-root {
    flex-grow: 1;
    background-color: var(--surface-abyss);
}

/* =============================================================================
   ANIMATED BACKGROUND LAYERS
   ============================================================================= */

.bg-void {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: var(--surface-void);
}

.bg-gradient-veil {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(180, 40, 60, 0.08);
    transition-duration: 2s;
}

.bg-gradient-veil:hover {
    background-color: rgba(180, 40, 60, 0.12);
}

/* Animated vignette */
.bg-vignette {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.bg-vignette-top {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    height: 250px;
    background-color: rgba(0, 0, 0, 0.6);
}

.bg-vignette-bottom {
    position: absolute;
    left: 0;
    bottom: 0;
    right: 0;
    height: 200px;
    background-color: rgba(0, 0, 0, 0.7);
}

.bg-vignette-left {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 150px;
    background-color: rgba(0, 0, 0, 0.5);
}

.bg-vignette-right {
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    width: 150px;
    background-color: rgba(0, 0, 0, 0.5);
}

/* =============================================================================
   PARTICLE CONTAINERS
   ============================================================================= */

.particle-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    overflow: hidden;
}

.particle-ember {
    position: absolute;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background-color: rgba(255, 180, 80, 0.8);
}

.particle-dust {
    position: absolute;
    width: 2px;
    height: 2px;
    border-radius: 50%;
    background-color: rgba(200, 180, 160, 0.4);
}

.particle-veil {
    position: absolute;
    width: 100px;
    height: 100px;
    border-radius: 50%;
    background-color: rgba(180, 40, 60, 0.1);
}

/* =============================================================================
   TYPOGRAPHY - AAA QUALITY
   ============================================================================= */

/* Game Title - Hero Typography */
.title-hero {
    font-size: 72px;
    color: var(--text-bright);
    -unity-font-style: bold;
    letter-spacing: 8px;
    -unity-text-align: middle-center;
    text-shadow: 0 0 30px rgba(180, 40, 60, 0.8), 0 0 60px rgba(180, 40, 60, 0.4), 0 4px 8px rgba(0, 0, 0, 0.9);
    transition-duration: 0.5s;
}

.title-hero:hover {
    color: var(--text-white);
    text-shadow: 0 0 40px rgba(220, 60, 80, 1), 0 0 80px rgba(180, 40, 60, 0.6), 0 4px 8px rgba(0, 0, 0, 0.9);
    scale: 1.02;
}

/* Section Headers */
.title-section {
    font-size: 28px;
    color: var(--text-bright);
    -unity-font-style: bold;
    letter-spacing: 4px;
    text-shadow: 0 0 15px rgba(180, 40, 60, 0.5), 0 2px 4px rgba(0, 0, 0, 0.8);
}

/* Subtitle / Tagline */
.title-tagline {
    font-size: 16px;
    color: var(--text-secondary);
    letter-spacing: 3px;
    -unity-font-style: italic;
}

/* Body Text */
.text-body {
    font-size: 15px;
    color: var(--text-primary);
}

.text-label {
    font-size: 14px;
    color: var(--text-secondary);
}

.text-small {
    font-size: 12px;
    color: var(--text-muted);
}

.text-accent {
    color: var(--accent-primary-glow);
}

.text-glow {
    text-shadow: 0 0 10px rgba(180, 40, 60, 0.6);
}

/* =============================================================================
   BUTTONS - AAA QUALITY WITH GLOW EFFECTS
   ============================================================================= */

/* Primary Action Button (Main CTA) */
.btn-primary {
    min-height: 60px;
    padding: 16px 40px;
    background-color: var(--accent-primary);
    border-width: 2px;
    border-color: var(--accent-primary-glow);
    border-radius: 6px;
    color: var(--text-white);
    font-size: 18px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    transition-duration: 0.25s;
    transition-property: all;
}

.btn-primary:hover {
    background-color: var(--accent-primary-glow);
    border-color: var(--accent-primary-bright);
    scale: 1.03;
    translate: 0 -2px;
}

.btn-primary:active {
    background-color: rgb(120, 30, 50);
    scale: 0.98;
    translate: 0 0;
}

/* Secondary Button (Menu Items) */
.btn-secondary {
    min-height: 54px;
    padding: 14px 32px;
    background-color: rgba(180, 40, 60, 0.3);
    border-width: 2px;
    border-color: var(--border-accent);
    border-radius: 6px;
    color: var(--text-bright);
    font-size: 16px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    transition-duration: 0.2s;
}

.btn-secondary:hover {
    background-color: rgba(180, 40, 60, 0.5);
    border-color: var(--accent-primary-glow);
    color: var(--text-white);
    translate: -4px 0;
}

.btn-secondary:active {
    background-color: rgba(180, 40, 60, 0.7);
    scale: 0.98;
}

/* Tertiary Button (Less Important) */
.btn-tertiary {
    min-height: 44px;
    padding: 10px 24px;
    background-color: rgba(55, 32, 42, 0.8);
    border-width: 1px;
    border-color: var(--border-default);
    border-radius: 4px;
    color: var(--text-secondary);
    font-size: 14px;
    letter-spacing: 1px;
    transition-duration: 0.15s;
}

.btn-tertiary:hover {
    background-color: rgba(65, 40, 50, 0.9);
    border-color: var(--border-strong);
    color: var(--text-primary);
    translate: -2px 0;
}

/* Icon Button (Close, etc.) */
.btn-icon {
    width: 44px;
    height: 44px;
    padding: 0;
    background-color: rgba(55, 32, 42, 0.6);
    border-width: 1px;
    border-color: var(--border-default);
    border-radius: 50%;
    color: var(--text-secondary);
    font-size: 20px;
    -unity-font-style: bold;
    transition-duration: 0.15s;
}

.btn-icon:hover {
    background-color: rgba(180, 50, 70, 0.8);
    border-color: var(--accent-secondary-glow);
    color: var(--text-white);
    scale: 1.1;
}

/* =============================================================================
   PANELS & CARDS - AAA GLASS MORPHISM
   ============================================================================= */

.panel-glass {
    background-color: rgba(12, 9, 18, 0.92);
    border-width: 1px;
    border-color: rgba(180, 40, 60, 0.3);
    border-radius: 12px;
    padding: 24px;
}

.panel-glass-dark {
    background-color: rgba(8, 6, 12, 0.95);
    border-width: 2px;
    border-color: rgba(100, 50, 65, 0.5);
    border-radius: 12px;
    padding: 24px;
}

.panel-floating {
    background-color: rgba(18, 14, 26, 0.9);
    border-width: 1px;
    border-color: var(--border-default);
    border-radius: 8px;
    padding: 16px;
    transition-duration: 0.2s;
}

.panel-floating:hover {
    border-color: var(--border-accent);
    translate: 0 -2px;
}

/* Card Component */
.card {
    background-color: var(--surface-base);
    border-width: 2px;
    border-color: var(--border-default);
    border-radius: 8px;
    padding: 16px;
    transition-duration: 0.2s;
    transition-property: all;
}

.card:hover {
    background-color: var(--surface-raised);
    border-color: var(--accent-primary);
    translate: 0 -2px;
}

.card-selected {
    background-color: var(--surface-raised);
    border-color: var(--accent-primary-glow);
    border-width: 3px;
}

/* =============================================================================
   DROPDOWN - FIXED POSITIONING
   ============================================================================= */

.dropdown {
    min-height: 44px;
    padding: 10px 16px;
    background-color: var(--surface-base);
    border-width: 2px;
    border-color: var(--border-default);
    border-radius: 6px;
    transition-duration: 0.15s;
}

.dropdown:hover {
    background-color: var(--surface-raised);
    border-color: var(--accent-primary);
}

.dropdown:focus {
    border-color: var(--accent-primary-glow);
}

.dropdown .unity-base-popup-field__text {
    color: var(--text-primary);
    font-size: 15px;
}

.dropdown .unity-base-popup-field__arrow {
    -unity-background-image-tint-color: var(--text-secondary);
    width: 14px;
    height: 14px;
}

.dropdown .unity-base-popup-field__input {
    background-color: transparent;
    border-width: 0;
    padding: 0;
}

/* CRITICAL: Dropdown Popup Container Fix */
.unity-base-dropdown__container-outer {
    position: absolute;
    background-color: var(--surface-deep);
    border-width: 2px;
    border-color: var(--accent-primary);
    border-radius: 8px;
    padding: 4px;
    margin-top: 4px;
    overflow: visible;
}

.unity-base-dropdown__container-inner {
    background-color: transparent;
    padding: 4px;
}

.unity-base-dropdown__item {
    background-color: transparent;
    padding: 12px 16px;
    margin: 2px 0;
    border-radius: 4px;
    transition-duration: 0.1s;
}

.unity-base-dropdown__item:hover {
    background-color: rgba(180, 40, 60, 0.4);
}

.unity-base-dropdown__item:checked {
    background-color: var(--accent-primary);
}

.unity-base-dropdown__label {
    color: var(--text-primary);
    font-size: 14px;
}

.unity-base-dropdown__item:hover .unity-base-dropdown__label {
    color: var(--text-white);
}

.unity-base-dropdown__item:checked .unity-base-dropdown__label {
    color: var(--text-white);
    -unity-font-style: bold;
}

.unity-base-dropdown__checkmark {
    -unity-background-image-tint-color: var(--accent-teal-glow);
    width: 16px;
    height: 16px;
}

/* =============================================================================
   SLIDERS - AAA QUALITY
   ============================================================================= */

.slider {
    min-height: 36px;
}

.slider .unity-base-slider__tracker {
    height: 8px;
    background-color: var(--surface-dark);
    border-radius: 4px;
    border-width: 1px;
    border-color: var(--border-subtle);
}

.slider .unity-base-slider__dragger {
    width: 24px;
    height: 24px;
    margin-top: -8px;
    background-color: var(--accent-primary);
    border-width: 3px;
    border-color: var(--accent-primary-glow);
    border-radius: 50%;
    transition-duration: 0.15s;
}

.slider .unity-base-slider__dragger:hover {
    background-color: var(--accent-primary-glow);
    border-color: var(--accent-primary-bright);
    scale: 1.15;
}

.slider .unity-base-slider__drag-container {
    background-color: var(--accent-primary);
    border-radius: 4px;
    height: 8px;
}

/* =============================================================================
   TOGGLES / CHECKBOXES
   ============================================================================= */

.toggle {
    flex-direction: row;
    align-items: center;
}

.toggle .unity-toggle__checkmark {
    width: 28px;
    height: 28px;
    background-color: var(--surface-dark);
    border-width: 2px;
    border-color: var(--border-default);
    border-radius: 6px;
    transition-duration: 0.15s;
}

.toggle:hover .unity-toggle__checkmark {
    border-color: var(--accent-primary);
}

.toggle:checked .unity-toggle__checkmark {
    background-color: var(--accent-primary);
    border-color: var(--accent-primary-glow);
}

.toggle .unity-toggle__text {
    color: var(--text-primary);
    font-size: 15px;
    margin-left: 12px;
}

/* =============================================================================
   TABS
   ============================================================================= */

.tab-button {
    flex-grow: 1;
    min-height: 48px;
    padding: 12px 20px;
    background-color: transparent;
    border-width: 0;
    border-bottom-width: 3px;
    border-color: transparent;
    border-radius: 0;
    color: var(--text-secondary);
    font-size: 14px;
    letter-spacing: 2px;
    -unity-font-style: bold;
    transition-duration: 0.2s;
}

.tab-button:hover {
    background-color: rgba(180, 40, 60, 0.1);
    color: var(--text-primary);
    border-color: var(--border-strong);
}

.tab-button-active {
    background-color: rgba(180, 40, 60, 0.2);
    color: var(--text-white);
    border-color: var(--accent-primary-glow);
}

/* =============================================================================
   SCROLL VIEW
   ============================================================================= */

.scrollview {
    background-color: transparent;
}

.scrollview .unity-scroller--vertical {
    width: 14px;
    margin-left: 6px;
}

.scrollview .unity-scroller--vertical .unity-base-slider__tracker {
    background-color: rgba(40, 32, 50, 0.8);
    border-radius: 7px;
    border-width: 1px;
    border-color: rgba(100, 50, 65, 0.3);
    cursor: link;
}

.scrollview .unity-scroller--vertical .unity-base-slider__dragger {
    background-color: var(--accent-primary);
    border-radius: 6px;
    width: 10px;
    margin-left: 2px;
    min-height: 40px;
    transition-duration: 0.15s;
    cursor: link;
}

.scrollview .unity-scroller--vertical .unity-base-slider__dragger:hover {
    background-color: var(--accent-primary-glow);
    width: 12px;
    margin-left: 1px;
}

/* Hide scroll buttons */
.scrollview .unity-scroller__low-button,
.scrollview .unity-scroller__high-button {
    display: none;
}

/* =============================================================================
   PROGRESS / STAT BARS
   ============================================================================= */

.bar-container {
    height: 12px;
    background-color: var(--surface-dark);
    border-radius: 6px;
    border-width: 1px;
    border-color: var(--border-subtle);
    overflow: hidden;
}

.bar-fill {
    height: 100%;
    border-radius: 5px;
    transition-duration: 0.4s;
    transition-property: width;
}

.bar-health {
    background-color: var(--status-health);
}

.bar-attack {
    background-color: var(--status-attack);
}

.bar-defense {
    background-color: var(--status-defense);
}

.bar-speed {
    background-color: var(--status-speed);
}

.bar-corruption {
    background-color: var(--corruption-corrupted);
}

/* =============================================================================
   HERO / MONSTER CARDS
   ============================================================================= */

.hero-card {
    flex-direction: row;
    align-items: center;
    padding: 16px;
    background-color: var(--surface-base);
    border-width: 2px;
    border-color: var(--border-default);
    border-radius: 8px;
    margin-bottom: 8px;
    transition-duration: 0.2s;
    cursor: link;
}

.hero-card:hover {
    background-color: var(--surface-raised);
    border-color: var(--accent-primary);
    translate: -4px 0;
}

.hero-card-selected {
    background-color: var(--surface-raised);
    border-color: var(--accent-primary-glow);
    border-width: 3px;
}

.hero-portrait {
    width: 64px;
    height: 64px;
    background-color: var(--surface-dark);
    border-width: 2px;
    border-color: var(--border-strong);
    border-radius: 8px;
    margin-right: 16px;
    -unity-background-scale-mode: scale-to-fit;
}

.hero-portrait-large {
    width: 120px;
    height: 120px;
    background-color: var(--surface-dark);
    border-width: 3px;
    border-color: var(--accent-primary);
    border-radius: 12px;
    -unity-background-scale-mode: scale-to-fit;
}

/* Monster Card (for signature monster) */
.monster-card {
    width: 140px;
    padding: 12px;
    background-color: var(--surface-base);
    border-width: 2px;
    border-color: var(--border-default);
    border-radius: 10px;
    align-items: center;
    transition-duration: 0.2s;
}

.monster-card:hover {
    background-color: var(--surface-raised);
    border-color: var(--accent-primary);
    scale: 1.02;
}

.monster-portrait {
    width: 80px;
    height: 80px;
    background-color: var(--surface-dark);
    border-width: 2px;
    border-color: var(--border-strong);
    border-radius: 8px;
    margin-bottom: 8px;
    -unity-background-scale-mode: scale-to-fit;
}

/* =============================================================================
   PATH BADGE
   ============================================================================= */

.path-badge {
    flex-direction: row;
    align-items: center;
    padding: 8px 16px;
    border-radius: 20px;
    border-width: 2px;
}

.path-badge-ironbound {
    background-color: rgba(140, 150, 165, 0.2);
    border-color: var(--path-ironbound);
}

.path-badge-fangborn {
    background-color: rgba(180, 45, 45, 0.2);
    border-color: var(--path-fangborn);
}

.path-badge-voidtouched {
    background-color: rgba(180, 40, 60, 0.2);
    border-color: var(--path-voidtouched);
}

.path-badge-unchained {
    background-color: rgba(200, 170, 80, 0.2);
    border-color: var(--path-unchained);
}

.path-icon {
    width: 20px;
    height: 20px;
    border-radius: 10px;
    margin-right: 10px;
}

.path-name {
    font-size: 13px;
    color: var(--text-bright);
    letter-spacing: 1px;
    -unity-font-style: bold;
}

/* =============================================================================
   BRAND INDICATORS
   ============================================================================= */

.brand-dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    margin-right: 6px;
}

.brand-badge {
    flex-direction: row;
    align-items: center;
    padding: 6px 12px;
    background-color: rgba(55, 32, 42, 0.8);
    border-radius: 16px;
    margin-right: 8px;
}

.brand-name {
    font-size: 12px;
    color: var(--text-primary);
    letter-spacing: 1px;
}

/* =============================================================================
   SYNERGY DISPLAY
   ============================================================================= */

.synergy-indicator {
    flex-direction: row;
    align-items: center;
    padding: 8px 14px;
    background-color: rgba(60, 180, 160, 0.15);
    border-width: 1px;
    border-color: var(--accent-teal);
    border-radius: 6px;
}

.synergy-icon {
    width: 18px;
    height: 18px;
    margin-right: 8px;
    background-color: var(--accent-teal);
    border-radius: 50%;
}

.synergy-text {
    font-size: 13px;
    color: var(--accent-teal-glow);
    -unity-font-style: bold;
}

/* =============================================================================
   CORRUPTION INDICATOR
   ============================================================================= */

.corruption-display {
    padding: 10px 16px;
    background-color: rgba(160, 50, 80, 0.15);
    border-width: 1px;
    border-color: var(--corruption-corrupted);
    border-radius: 8px;
}

.corruption-bar-bg {
    height: 10px;
    background-color: var(--surface-dark);
    border-radius: 5px;
    overflow: hidden;
}

.corruption-bar-fill {
    height: 100%;
    border-radius: 5px;
    transition-duration: 0.4s;
}

/* =============================================================================
   ABILITY CARDS
   ============================================================================= */

.ability-card {
    flex-direction: row;
    align-items: center;
    padding: 14px;
    background-color: var(--surface-base);
    border-width: 1px;
    border-color: var(--border-subtle);
    border-radius: 8px;
    margin-bottom: 10px;
    transition-duration: 0.15s;
}

.ability-card:hover {
    background-color: var(--surface-raised);
    border-color: var(--accent-primary);
}

.ability-icon {
    width: 48px;
    height: 48px;
    background-color: var(--surface-dark);
    border-width: 2px;
    border-color: var(--border-strong);
    border-radius: 8px;
    margin-right: 14px;
    -unity-background-scale-mode: scale-to-fit;
}

.ability-name {
    font-size: 15px;
    color: var(--text-bright);
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.ability-desc {
    font-size: 13px;
    color: var(--text-secondary);
}

/* =============================================================================
   DIVIDERS
   ============================================================================= */

.divider-h {
    height: 2px;
    background-color: var(--border-default);
    margin: 16px 0;
}

.divider-h-accent {
    height: 2px;
    background-color: var(--accent-primary);
    margin: 16px 0;
}

.divider-v {
    width: 2px;
    background-color: var(--border-default);
    margin: 0 16px;
}

/* Decorative line with dot */
.divider-decorated {
    flex-direction: row;
    align-items: center;
    margin: 20px 0;
}

.divider-line {
    flex-grow: 1;
    height: 1px;
    background-color: var(--border-default);
}

.divider-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--accent-primary);
    margin: 0 16px;
}

/* =============================================================================
   LAYOUT UTILITIES
   ============================================================================= */

.row {
    flex-direction: row;
    align-items: center;
}

.column {
    flex-direction: column;
}

.center {
    justify-content: center;
    align-items: center;
}

.space-between {
    justify-content: space-between;
}

.flex-grow {
    flex-grow: 1;
}

.flex-shrink-0 {
    flex-shrink: 0;
}

/* Spacing */
.gap-4 { margin: 4px; }
.gap-8 { margin: 8px; }
.gap-12 { margin: 12px; }
.gap-16 { margin: 16px; }
.gap-24 { margin: 24px; }

.p-8 { padding: 8px; }
.p-12 { padding: 12px; }
.p-16 { padding: 16px; }
.p-24 { padding: 24px; }
.p-32 { padding: 32px; }

/* =============================================================================
   FOOTER
   ============================================================================= */

.footer {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 60px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 0 40px;
    background-color: rgba(0, 0, 0, 0.4);
}

.footer-text {
    font-size: 12px;
    color: var(--text-muted);
    letter-spacing: 1px;
}

/* =============================================================================
   LOADING OVERLAY
   ============================================================================= */

.loading-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: var(--surface-void);
    justify-content: center;
    align-items: center;
}

.loading-spinner {
    width: 60px;
    height: 60px;
    border-width: 4px;
    border-color: var(--accent-primary);
    border-top-color: transparent;
    border-radius: 50%;
}

.loading-text {
    margin-top: 20px;
    font-size: 16px;
    color: var(--text-secondary);
    letter-spacing: 2px;
}

/* =============================================================================
   GLOW EFFECTS (Applied via C#)
   ============================================================================= */

.glow-pulse {
    transition-duration: 1.5s;
    transition-timing-function: ease-in-out;
}

.glow-element {
    position: absolute;
    border-radius: 50%;
    background-color: rgba(180, 40, 60, 0.3);
}

/* =============================================================================
   RESPONSIVE BREAKPOINTS (via C# MediaQuery)
   ============================================================================= */

.hide-mobile {
    display: flex;
}

.show-mobile {
    display: none;
}
