/* =============================================================================
   VEILBREAKERS 3D - AAA DARK FANTASY CHARACTER SELECT STYLESHEET
   Rule-of-thirds composition, tabbed info, hold-to-embark, gamepad focus ring
   v3.0 - Complete AAA Visual Overhaul
   ============================================================================= */

/* =============================================================================
   CORE VARIABLES - Character Select Specific
   ============================================================================= */

:root {
    /* Transition Timing */
    --transition-fast: 0.2s;
    --transition-normal: 0.4s;
    --transition-slow: 0.8s;
    --transition-hero-switch: 1.2s;

    /* Easing Functions */
    --ease-out-expo: ease-out-back;
    --ease-out-back: ease-out-back;
    --ease-in-out-quint: ease-in-out;

    /* Spacing */
    --panel-margin: 40px;
    --card-gap: 20px;

    /* Veil-Torn Panel Material */
    --veil-bg: rgba(12, 10, 18, 0.92);
    --veil-border: rgba(60, 50, 70, 0.8);

    /* AAA Color Palette */
    --surface-dark: rgba(8, 6, 14, 0.95);
    --surface-mid: rgba(18, 14, 28, 0.90);
    --surface-light: rgba(30, 24, 44, 0.85);
    --text-primary: rgba(240, 235, 250, 1);
    --text-secondary: rgba(190, 180, 210, 0.8);
    --text-muted: rgba(140, 130, 160, 0.55);
    --border-subtle: rgba(80, 65, 100, 0.35);
    --border-accent: rgba(120, 100, 150, 0.5);
}

/* =============================================================================
   HERO THEME CLASSES (Set on root)
   ============================================================================= */

.theme-vex {
    --hero-primary: rgb(200, 160, 60);
    --hero-secondary: rgb(180, 140, 40);
    --hero-accent: rgb(255, 210, 110);
    --hero-glow: rgba(200, 160, 60, 0.20);
    --hero-dim: rgba(200, 160, 60, 0.08);
}

.theme-seraphina {
    --hero-primary: rgb(150, 90, 210);
    --hero-secondary: rgb(130, 70, 190);
    --hero-accent: rgb(210, 170, 255);
    --hero-glow: rgba(150, 90, 210, 0.20);
    --hero-dim: rgba(150, 90, 210, 0.08);
}

.theme-orion {
    --hero-primary: rgb(200, 60, 60);
    --hero-secondary: rgb(180, 45, 45);
    --hero-accent: rgb(255, 130, 110);
    --hero-glow: rgba(200, 60, 60, 0.20);
    --hero-dim: rgba(200, 60, 60, 0.08);
}

.theme-nyx {
    --hero-primary: rgb(70, 190, 210);
    --hero-secondary: rgb(50, 170, 190);
    --hero-accent: rgb(130, 230, 250);
    --hero-glow: rgba(70, 190, 210, 0.20);
    --hero-dim: rgba(70, 190, 210, 0.08);
}

/* =============================================================================
   HIDDEN UTILITY
   ============================================================================= */

.hidden {
    display: none;
}

/* =============================================================================
   ROOT / LAYOUT
   ============================================================================= */

TemplateContainer {
    flex-grow: 1;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.character-select-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-direction: column;
    overflow: hidden;
    background-color: rgb(6, 4, 10);
}

/* =============================================================================
   PARALLAX BACKGROUND SYSTEM
   ============================================================================= */

.parallax-bg {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* Layer 1: Deepest Void */
.parallax-deep {
    background-color: rgb(4, 3, 8);
    z-index: 0;
}

.void-stars {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: transparent;
    opacity: 0.5;
}

/* Layer 2: Fog Particles */
.parallax-fog {
    z-index: 1;
}

.fog-particles {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: var(--hero-dim, rgba(40, 20, 60, 0.05));
    opacity: 0.5;
    transition-property: background-color;
    transition-duration: var(--transition-slow);
    transition-timing-function: var(--ease-out-expo);
}

/* Layer 5: Vignette Overlay */
.background-vignette {
    position: absolute;
    width: 100%;
    height: 100%;
    z-index: 4;
    background-color: rgba(0, 0, 0, 0.1);
}

/* =============================================================================
   VEIL-TORN PANEL MATERIAL (.veil-panel)
   Frosted glass with hero accent edge lighting
   ============================================================================= */

.veil-panel {
    background-color: rgba(10, 8, 16, 0.88);
    border-width: 1px;
    border-color: var(--border-subtle);
    border-radius: 8px;
    padding: 20px;
    overflow: hidden;
    transition-property: border-color, background-color;
    transition-duration: 0.6s, 0.6s;
    transition-timing-function: ease-in-out, ease-in-out;
}

/* Per-hero accent glow on veil-panel borders */
.theme-vex .veil-panel {
    border-color: rgba(200, 160, 60, 0.35);
    border-top-color: rgba(200, 160, 60, 0.6);
}

.theme-seraphina .veil-panel {
    border-color: rgba(150, 90, 210, 0.35);
    border-top-color: rgba(150, 90, 210, 0.6);
}

.theme-orion .veil-panel {
    border-color: rgba(200, 60, 60, 0.35);
    border-top-color: rgba(200, 60, 60, 0.6);
}

.theme-nyx .veil-panel {
    border-color: rgba(70, 190, 210, 0.35);
    border-top-color: rgba(70, 190, 210, 0.6);
}

/* =============================================================================
   HERO STAGE (Left 55%, full height, hero centered-right)
   ============================================================================= */

.hero-stage {
    position: absolute;
    left: 0;
    top: 0;
    right: 45%;
    bottom: 0;
    z-index: 10;
    align-items: center;
    justify-content: center;
}

.hero-render-target {
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-to-fit;
}

/* Hero Name Plate - floating title at bottom of stage */
.hero-name-plate {
    position: absolute;
    bottom: 18%;
    left: 0;
    right: 0;
    align-items: center;
    justify-content: center;
    flex-direction: column;
}

.stage-hero-name {
    font-size: 48px;
    -unity-font-style: bold;
    color: var(--text-primary);
    letter-spacing: 12px;
    opacity: 0.15;
    -unity-text-align: middle-center;
}

.stage-hero-title {
    font-size: 13px;
    color: var(--hero-primary);
    letter-spacing: 6px;
    opacity: 0.4;
    -unity-text-align: middle-center;
    margin-top: 4px;
}

.drag-hint {
    position: absolute;
    bottom: 8%;
    font-size: 11px;
    color: rgba(200, 200, 215, 0.18);
    letter-spacing: 6px;
    -unity-text-align: middle-center;
    align-self: center;
    transition-property: opacity;
    transition-duration: 0.6s;
}

.drag-hint:hover {
    opacity: 0;
}

.hero-aura-container {
    position: absolute;
    width: 70%;
    height: 50%;
    bottom: 5%;
    z-index: 1;
    align-items: center;
    justify-content: flex-end;
}

.aura-base {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: var(--hero-dim, rgba(40, 20, 60, 0.04));
    border-radius: 50%;
    opacity: 0.4;
    transition-property: background-color;
    transition-duration: 1.2s;
}

/* Outer ring glow effect */
.aura-ring {
    position: absolute;
    width: 80%;
    height: 80%;
    bottom: 0;
    border-radius: 50%;
    border-width: 1px;
    border-color: var(--hero-glow, rgba(60, 40, 80, 0.1));
    opacity: 0.3;
    transition-property: border-color;
    transition-duration: 1.2s;
}

/* =============================================================================
   INFO PANEL CONTAINER (Right half, tabbed info)
   ============================================================================= */

.info-panel-container {
    position: absolute;
    right: 0;
    top: 40px;
    bottom: 20%;
    width: 42%;
    background-color: rgba(14, 11, 22, 0.97);
    border-top-width: 2px;
    border-top-color: var(--hero-primary, rgba(200, 160, 60, 0.5));
    border-radius: 6px 6px 4px 4px;
    z-index: 20;
    padding: 24px 28px;
    overflow: hidden;
    flex-direction: column;
    opacity: 1;
    translate: 0 0;
    transition-property: opacity, translate, border-color, background-color;
    transition-duration: 0.3s, 0.3s, 0.6s, 0.6s;
    transition-timing-function: ease-out, ease-out, ease-in-out, ease-in-out;
}

/* =============================================================================
   TAB SYSTEM
   ============================================================================= */

.tab-header-strip {
    flex-direction: row;
    justify-content: flex-start;
    padding-bottom: 12px;
    border-bottom-width: 1px;
    border-bottom-color: var(--border-subtle);
    flex-shrink: 0;
    margin-bottom: 4px;
}

.tab-btn {
    background-color: transparent;
    color: var(--text-muted);
    border-width: 0;
    border-bottom-width: 2px;
    border-bottom-color: transparent;
    padding: 10px 20px;
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    transition-property: color, border-bottom-color, background-color;
    transition-duration: 0.25s, 0.25s, 0.25s;
    border-radius: 4px 4px 0 0;
    margin-right: 4px;
}

.tab-btn-active {
    color: var(--text-primary);
    border-bottom-color: var(--hero-primary, rgba(200, 160, 60, 0.9));
    background-color: rgba(255, 255, 255, 0.03);
}

.tab-btn:hover {
    color: var(--text-secondary);
    background-color: rgba(255, 255, 255, 0.02);
}

/* Per-hero active tab underline */
.theme-vex .tab-btn-active { border-bottom-color: rgba(200, 160, 60, 0.9); }
.theme-seraphina .tab-btn-active { border-bottom-color: rgba(150, 90, 210, 0.9); }
.theme-orion .tab-btn-active { border-bottom-color: rgba(200, 60, 60, 0.9); }
.theme-nyx .tab-btn-active { border-bottom-color: rgba(70, 190, 210, 0.9); }

.tab-content {
    flex-grow: 1;
    overflow: hidden;
}

.tab-content-section {
    display: none;
    flex-grow: 1;
    padding: 16px 0;
}

.tab-content-section.tab-active {
    display: flex;
}

/* =============================================================================
   ORNAMENTAL DIVIDERS
   ============================================================================= */

.ornamental-divider {
    height: 16px;
    margin: 6px 0;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.divider-line {
    position: absolute;
    left: 0;
    right: 0;
    height: 1px;
    background-color: rgba(80, 65, 100, 0.3);
}

.divider-diamond {
    font-size: 6px;
    color: var(--hero-primary, rgba(200, 160, 60, 0.35));
    background-color: rgba(14, 11, 22, 0.98);
    padding: 0 8px;
    -unity-text-align: middle-center;
}

/* =============================================================================
   HERO IDENTITY (Inside tab-overview-content)
   ============================================================================= */

.hero-name {
    font-size: 36px;
    -unity-font-style: bold;
    color: var(--text-primary);
    letter-spacing: 4px;
    margin-bottom: 2px;
    transition-property: color;
    transition-duration: var(--transition-slow);
    transition-timing-function: var(--ease-out-expo);
}

.hero-title {
    font-size: 14px;
    color: var(--hero-primary);
    letter-spacing: 3px;
    margin-bottom: 14px;
    opacity: 0.9;
    border-left-width: 3px;
    border-left-color: var(--hero-primary);
    padding-left: 14px;
    transition-property: color, border-left-color;
    transition-duration: var(--transition-slow), var(--transition-slow);
}

.hero-quote {
    font-size: 13px;
    color: rgba(180, 170, 200, 0.5);
    -unity-font-style: italic;
    margin-bottom: 18px;
    white-space: normal;
    padding-bottom: 14px;
    border-bottom-width: 1px;
    border-bottom-color: var(--border-subtle);
}

/* =============================================================================
   INFO ROWS
   ============================================================================= */

.hero-class-info {
    margin-bottom: 10px;
}

.info-row {
    flex-direction: row;
    margin: 4px 0;
    align-items: center;
}

.info-label {
    width: 80px;
    font-size: 11px;
    color: var(--text-muted);
    letter-spacing: 3px;
    -unity-font-style: bold;
}

.info-value {
    flex-grow: 1;
    font-size: 14px;
    color: var(--text-secondary);
    white-space: normal;
    overflow: hidden;
    flex-shrink: 1;
    letter-spacing: 1px;
}

/* =============================================================================
   STARTER STATS GRID
   ============================================================================= */

.starter-stats-grid {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 14px;
    justify-content: space-between;
}

.stat-chip {
    width: 48%;
    background-color: rgba(0, 0, 0, 0.35);
    padding: 8px 12px;
    margin-bottom: 8px;
    border-radius: 6px;
    border-left-width: 3px;
    border-left-color: var(--hero-primary);
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.03);
    transition-property: background-color, border-color;
    transition-duration: var(--transition-fast), var(--transition-fast);
}

.stat-chip:hover {
    background-color: rgba(0, 0, 0, 0.5);
    border-color: var(--border-subtle);
    translate: 0 -1px;
}

.stat-chip-label {
    font-size: 11px;
    color: var(--text-muted);
    letter-spacing: 2px;
    -unity-font-style: bold;
}

.stat-chip-value {
    font-size: 16px;
    color: var(--text-primary);
    -unity-font-style: bold;
}

/* =============================================================================
   PER-STAT COLORS (AAA RPG standard)
   ============================================================================= */

.stat-chip-hp {
    border-left-color: rgb(204, 56, 56);
}
.stat-chip-hp .stat-chip-value {
    color: rgb(255, 85, 85);
}

.stat-chip-stamina {
    border-left-color: rgb(56, 168, 85);
}
.stat-chip-stamina .stat-chip-value {
    color: rgb(85, 221, 112);
}

.stat-chip-atk {
    border-left-color: rgb(204, 136, 32);
}
.stat-chip-atk .stat-chip-value {
    color: rgb(255, 170, 51);
}

.stat-chip-def {
    border-left-color: rgb(56, 120, 204);
}
.stat-chip-def .stat-chip-value {
    color: rgb(85, 170, 255);
}

/* =============================================================================
   CHAMPION MONSTER — 50/50 Split (model left, info right)
   ============================================================================= */

.champion-section-v2 {
    flex: 1;
    min-height: 100px;
    flex-direction: row;
    background-color: rgba(0, 0, 0, 0.25);
    border-width: 1px;
    border-color: var(--hero-primary, rgba(200, 160, 60, 0.15));
    border-radius: 6px;
    padding: 10px;
    margin-top: 8px;
    overflow: hidden;
}

.champion-model-viewer {
    width: 48%;
    background-color: rgba(0, 0, 0, 0.2);
    border-width: 1px;
    border-color: var(--hero-primary, rgba(200, 160, 60, 0.10));
    border-radius: 5px;
    -unity-background-scale-mode: scale-to-fit;
}

.champion-info-panel {
    flex: 1;
    padding-left: 12px;
    justify-content: center;
}

.champion-name-v2 {
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--hero-accent, rgb(255, 210, 112));
    letter-spacing: 1px;
    margin-bottom: 4px;
}

.champion-brand-label {
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    color: var(--hero-primary, rgba(200, 160, 60, 0.8));
    margin-bottom: 6px;
    padding-bottom: 4px;
    border-bottom-width: 1px;
    border-bottom-color: var(--hero-primary, rgba(200, 160, 60, 0.15));
}

.tag-brand {
    border-color: var(--hero-primary, rgba(200, 160, 60, 0.35));
    color: var(--hero-primary, rgba(200, 160, 60, 0.75));
    background-color: rgba(200, 160, 60, 0.06);
}

.champion-desc {
    font-size: 10px;
    color: rgba(180, 170, 200, 0.4);
    white-space: normal;
    margin-top: 8px;
}

.champion-tags {
    flex-direction: row;
}

.tag {
    font-size: 11px;
    color: var(--text-secondary);
    letter-spacing: 3px;
    background-color: rgba(255, 255, 255, 0.04);
    padding: 5px 12px;
    margin-right: 8px;
    border-radius: 4px;
    border-width: 1px;
    border-color: var(--border-subtle);
    -unity-font-style: bold;
    transition-property: background-color, border-color;
    transition-duration: var(--transition-fast), var(--transition-fast);
}

.tag:hover {
    background-color: rgba(255, 255, 255, 0.08);
    border-color: var(--border-accent);
}

/* =============================================================================
   ATTRIBUTE GRID — Numbers only, no bars (D&D style)
   ============================================================================= */

.attribute-section {
    margin-top: 14px;
    padding-top: 12px;
    border-top-width: 1px;
    border-top-color: var(--border-subtle);
}

/* Keep .attribute-bars-section as alias for backward compat */
.attribute-bars-section {
    margin-top: 14px;
    padding-top: 12px;
    border-top-width: 1px;
    border-top-color: var(--border-subtle);
}

.section-header {
    font-size: 11px;
    color: var(--text-muted);
    letter-spacing: 5px;
    margin-bottom: 12px;
    -unity-font-style: bold;
}

.attribute-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
}

.attr-chip {
    width: 15%;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.25);
    border-width: 1px;
    border-color: rgba(80, 65, 100, 0.15);
    border-radius: 4px;
    padding: 6px 2px;
    margin-bottom: 4px;
    transition-property: background-color, border-color;
    transition-duration: 0.2s, 0.2s;
}

.attr-chip:hover {
    background-color: rgba(0, 0, 0, 0.4);
    border-color: rgba(80, 65, 100, 0.3);
}

.attr-chip-label {
    font-size: 8px;
    letter-spacing: 2px;
    -unity-font-style: bold;
    color: rgba(140, 130, 160, 0.5);
    margin-bottom: 2px;
    -unity-text-align: middle-center;
}

.attr-chip-value {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgba(240, 235, 250, 0.85);
    -unity-text-align: middle-center;
}

/* Legacy bar classes — kept so any stale USS references don't hard-error */
.attribute-bars { flex-direction: column; }
.stat-bar-row { flex-direction: row; align-items: center; margin-bottom: 6px; }
.stat-bar-label { width: 40px; font-size: 11px; color: var(--text-muted); letter-spacing: 3px; -unity-font-style: bold; }
.stat-bar-track { flex-grow: 1; height: 10px; background-color: rgba(5, 5, 12, 0.8); border-radius: 5px; margin: 0 10px; overflow: hidden; }
.stat-bar-fill { height: 100%; background-color: var(--hero-primary, rgb(200, 160, 60)); border-radius: 5px; }
.stat-bar-value { width: 28px; font-size: 13px; color: var(--text-primary); -unity-text-align: middle-right; -unity-font-style: bold; }

/* =============================================================================
   ABILITIES (Tab 2)
   ============================================================================= */

.abilities-list {
    flex-direction: column;
}

.ability-slot {
    font-size: 14px;
    color: var(--text-secondary);
    padding: 12px 18px;
    margin-bottom: 6px;
    background-color: rgba(255, 255, 255, 0.03);
    border-radius: 6px;
    border-left-width: 3px;
    border-left-color: var(--hero-primary);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.02);
    translate: 0 0;
    transition-property: translate, background-color, border-left-color, border-color, color;
    transition-duration: var(--transition-fast), var(--transition-fast), var(--transition-fast), var(--transition-fast), var(--transition-fast);
    transition-timing-function: var(--ease-out-expo), var(--ease-out-expo), var(--ease-out-expo), var(--ease-out-expo), var(--ease-out-expo);
    letter-spacing: 1px;
}

.ability-slot:hover {
    background-color: rgba(255, 255, 255, 0.08);
    translate: 8px 0;
    border-left-color: var(--hero-accent);
    border-color: var(--border-subtle);
    color: var(--text-primary);
}

/* =============================================================================
   LORE (Tab 3)
   ============================================================================= */

.hero-lore-section {
    margin-bottom: 14px;
}

.hero-backstory {
    font-size: 13px;
    color: rgba(180, 170, 200, 0.65);
    white-space: normal;
    -unity-font-style: italic;
    line-height: 18px;
}

.synergy-detail-section {
    margin-top: 10px;
    padding-top: 10px;
    border-top-width: 1px;
    border-top-color: var(--border-subtle);
}

.hero-synergy-detail {
    font-size: 13px;
    color: rgba(180, 170, 200, 0.65);
    white-space: normal;
}

.brands-section {
    margin-top: 10px;
    padding-top: 10px;
    border-top-width: 1px;
    border-top-color: var(--border-subtle);
}

.hero-brands-detail {
    font-size: 13px;
    color: rgba(180, 170, 200, 0.65);
    white-space: normal;
}

/* =============================================================================
   FOCUS RING (Gamepad Navigation)
   ============================================================================= */

.focusable-zone {
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 6px;
    transition-property: border-color, scale;
    transition-duration: 0.15s, 0.15s;
    transition-timing-function: ease-out, ease-out;
}

.focusable-zone:focus {
    border-color: rgba(255, 200, 80, 0.9);
    scale: 1.02 1.02;
}

/* C#-driven focus class for zone-level highlighting */
.focus-ring-active {
    border-color: rgba(255, 200, 80, 0.9);
    scale: 1.02 1.02;
}

/* Per-hero focus ring colors */
.theme-vex .focus-ring-active { border-color: rgba(200, 160, 60, 0.9); }
.theme-seraphina .focus-ring-active { border-color: rgba(150, 90, 210, 0.9); }
.theme-orion .focus-ring-active { border-color: rgba(200, 60, 60, 0.9); }
.theme-nyx .focus-ring-active { border-color: rgba(70, 190, 210, 0.9); }

/* =============================================================================
   EMBARK AREA (Inline inside bottom-layer, sits to right of carousel)
   ============================================================================= */

.embark-area {
    align-items: center;
    justify-content: center;
    margin-left: 24px;
    flex-shrink: 0;
}

.btn-embark {
    width: 240px;
    height: 54px;
    background-color: rgb(200, 160, 60);
    border-width: 2px;
    border-color: rgba(255, 215, 90, 0.55);
    border-top-color: rgba(255, 230, 140, 0.35);
    border-radius: 4px;
    overflow: visible;
    align-items: center;
    justify-content: center;
    transition-property: background-color, border-color, scale;
    transition-duration: 0.2s, 0.2s, 0.15s;
}

.btn-embark:hover {
    border-color: rgba(255, 230, 120, 0.70);
    scale: 1.04 1.04;
}

.btn-embark:active {
    background-color: rgb(240, 200, 80);
    border-color: rgba(255, 240, 150, 0.90);
    scale: 0.96 0.96;
}

.embark-text {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgba(15, 10, 5, 0.90);
    letter-spacing: 4px;
}

.embark-subtitle {
    font-size: 9px;
    -unity-font-style: bold;
    color: rgba(15, 10, 5, 0.65);
    letter-spacing: 4px;
    margin-top: 2px;
}

.embark-hex-bg {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: transparent;
    border-width: 0;
    border-radius: 4px;
    transition-property: opacity;
    transition-duration: var(--transition-normal);
}

.embark-glow {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(255, 230, 120, 0.15);
    opacity: 0;
    border-radius: 8px;
    transition-property: opacity;
    transition-duration: var(--transition-slow);
}

.embark-glow.breathing {
    opacity: 0.06;
}

/* Embark Progress Ring (hold-to-confirm visual) */
.embark-progress-ring {
    position: absolute;
    width: 64px;
    height: 64px;
    border-radius: 32px;
    border-width: 3px;
    border-color: rgba(255, 200, 80, 0);
    transition-property: border-color, opacity;
    transition-duration: 0.2s, 0.2s;
}

.embark-progress-ring.hold-active {
    border-color: rgba(255, 200, 80, 0.9);
    opacity: 1;
}

/* =============================================================================
   BOTTOM LAYER: CAROUSEL (AAA Card Design)
   ============================================================================= */

.bottom-layer {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 16%;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding: 10px 4% 8px;
    z-index: 30;
    background-color: rgba(0, 0, 0, 0.5);
}

.nav-arrow {
    width: 48px;
    height: 48px;
    font-size: 20px;
    color: rgba(255, 255, 255, 0.35);
    background-color: rgba(12, 10, 18, 0.85);
    border-radius: 24px;
    border-width: 1px;
    border-color: var(--border-subtle);
    -unity-text-align: middle-center;
    transition-property: color, border-color, scale, background-color;
    transition-duration: var(--transition-fast), var(--transition-fast), var(--transition-fast), var(--transition-fast);
    transition-timing-function: var(--ease-out-expo), var(--ease-out-expo), var(--ease-out-expo), var(--ease-out-expo);
}

.nav-arrow:hover {
    color: var(--text-primary);
    border-color: var(--hero-primary);
    scale: 1.12;
    background-color: rgba(20, 16, 30, 0.95);
}

.carousel-container {
    margin: 0 24px;
}

.carousel-strip {
    flex-direction: row;
    align-items: center;
}

.hero-card {
    width: 80px;
    height: 100px;
    margin: 0 6px;
    background-color: rgba(10, 8, 16, 0.92);
    border-width: 1px;
    border-color: var(--border-subtle);
    border-radius: 10px;
    align-items: center;
    justify-content: center;
    transition-property: scale, opacity, border-color, background-color;
    transition-duration: var(--transition-normal), var(--transition-normal), var(--transition-normal), var(--transition-normal);
    transition-timing-function: var(--ease-out-back), var(--ease-out-back), var(--ease-out-back), var(--ease-out-back);
    opacity: 0.55;
    overflow: hidden;
}

.hero-card:hover {
    scale: 1.1;
    opacity: 0.85;
    border-color: var(--border-accent);
    background-color: rgba(16, 12, 24, 0.95);
}

.hero-card.selected {
    scale: 1.2;
    opacity: 1;
    border-color: var(--hero-primary);
    border-width: 2px;
    background-color: rgba(16, 12, 26, 0.98);
}

.hero-card-initial {
    font-size: 30px;
    -unity-font-style: bold;
    color: var(--hero-primary);
    opacity: 0.3;
    margin-bottom: 4px;
    transition-property: opacity, color;
    transition-duration: var(--transition-normal), var(--transition-normal);
}

.hero-card.selected .hero-card-initial {
    opacity: 0.9;
}

.hero-card-name {
    font-size: 12px;
    color: var(--text-secondary);
    letter-spacing: 3px;
    -unity-font-style: bold;
}

.hero-card-role {
    font-size: 10px;
    color: var(--text-muted);
    letter-spacing: 3px;
    margin-top: 6px;
}

.hero-card.teaser {
    border-color: rgba(60, 50, 70, 0.15);
    opacity: 0.2;
}

.hero-card.teaser:hover {
    opacity: 0.35;
    scale: 1.03;
}

/* =============================================================================
   MISC UI
   ============================================================================= */

.btn-back {
    position: absolute;
    top: 16px;
    left: 16px;
    padding: 10px 24px;
    background-color: rgba(10, 8, 16, 0.75);
    border-width: 1px;
    border-color: var(--border-subtle);
    border-radius: 6px;
    color: var(--text-muted);
    font-size: 12px;
    letter-spacing: 4px;
    z-index: 50;
    transition-property: color, border-color, background-color;
    transition-duration: var(--transition-fast), var(--transition-fast), var(--transition-fast);
}

.btn-back:hover {
    color: var(--text-primary);
    border-color: var(--border-accent);
    background-color: rgba(16, 12, 24, 0.9);
}

.hero-index {
    position: absolute;
    top: 12px;
    left: 50%;
    translate: -50% 0;
    font-size: 10px;
    color: rgba(190, 180, 210, 0.30);
    letter-spacing: 5px;
    z-index: 30;
}

/* =============================================================================
   TOAST NOTIFICATION
   ============================================================================= */

.toast-container {
    position: absolute;
    bottom: -100px;
    left: 50%;
    translate: -50% 0;
    width: 420px;
    z-index: 200;
    transition-property: translate;
    transition-duration: 0.4s;
    transition-timing-function: ease-out;
}

.toast-container.toast-visible {
    translate: -50% -120px;
}

.toast-container.toast-hidden {
    translate: -50% 0;
}

.toast-content {
    flex-direction: row;
    background-color: rgba(40, 12, 12, 0.95);
    border-width: 1px;
    border-color: rgba(200, 60, 60, 0.5);
    border-radius: 8px;
    padding: 14px 18px;
    align-items: center;
}

.toast-icon {
    width: 20px;
    height: 20px;
    margin-right: 12px;
    background-color: rgba(200, 60, 60, 0.7);
    border-radius: 10px;
    flex-shrink: 0;
}

.toast-message {
    color: rgba(240, 200, 200, 0.9);
    font-size: 13px;
    flex-grow: 1;
    white-space: normal;
}

.toast-actions {
    flex-direction: row;
    padding-top: 10px;
    justify-content: flex-end;
}

.toast-btn {
    background-color: rgba(60, 16, 16, 0.85);
    color: rgba(240, 200, 200, 0.9);
    border-width: 1px;
    border-color: rgba(200, 60, 60, 0.35);
    border-radius: 6px;
    padding: 8px 16px;
    margin-left: 8px;
    font-size: 12px;
    letter-spacing: 1px;
    transition-property: background-color, border-color;
    transition-duration: var(--transition-fast), var(--transition-fast);
}

.toast-btn:hover {
    background-color: rgba(80, 24, 24, 0.95);
    border-color: rgba(200, 60, 60, 0.6);
}

/* =============================================================================
   SKELETON SHIMMER (Loading State)
   ============================================================================= */

.skeleton-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(8, 6, 14, 0.85);
    z-index: 150;
}

/* When hidden, ensure it doesn't block input */
.skeleton-overlay.hidden {
    display: none;
}

.skeleton-shimmer {
    background-color: rgba(40, 35, 55, 0.5);
    border-radius: 6px;
    min-height: 16px;
    margin: 4px 0;
    overflow: hidden;
}

.shimmer-bar {
    position: absolute;
    width: 60px;
    height: 100%;
    background-color: rgba(255, 255, 255, 0.04);
    rotate: 15deg;
    translate: -60px 0;
    transition-property: translate;
    transition-duration: 1.2s;
    transition-timing-function: ease-in-out;
}

.shimmer-bar.shimmer-active {
    translate: 400px 0;
}

/* =============================================================================
   PANEL TRANSITION CLASSES
   ============================================================================= */

.panel-hidden {
    opacity: 0;
    translate: -20px 0;
}

/* =============================================================================
   CINEMATIC OVERLAY SYSTEM
   Subtle post-process layers for atmospheric depth
   ============================================================================= */

.cinematic-overlays {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 90;
}

/* Scanline overlay: subtle horizontal stripe pattern */
.overlay-scanlines {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.015);
    opacity: 0.3;
}

/* Vignette: darken edges for cinematic focus */
.overlay-vignette {
    position: absolute;
    width: 100%;
    height: 100%;
    border-width: 100px;
    border-color: rgba(0, 0, 0, 0.3);
}

/* Veil glow: hero-tinted ambient haze */
.overlay-veil-glow {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: var(--hero-dim, rgba(40, 20, 60, 0.02));
    opacity: 0.12;
    transition-property: background-color;
    transition-duration: 1.2s;
    transition-timing-function: ease-in-out;
}

/* =============================================================================
   VISUAL DEPTH HIERARCHY
   Inactive panels are dimmed for visual depth
   ============================================================================= */

.panel-inactive-dim {
    opacity: 0.6;
    transition-property: opacity;
    transition-duration: 0.3s;
    transition-timing-function: ease-in-out;
}

/* =============================================================================
   DYNAMIC RESOURCE STAT CHIP - MANA (VOIDTOUCHED / UNCHAINED paths)
   ============================================================================= */

.stat-chip-mana {
    border-left-color: rgb(130, 80, 200);
}

.stat-chip-mana .stat-chip-value {
    color: rgb(180, 130, 255);
}
