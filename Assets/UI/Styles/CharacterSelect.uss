/* =============================================================================
   VEILBREAKERS 3D - CHARACTER SELECT SCREEN
   BG3-inspired cinematic hero selection
   ============================================================================= */

/* =============================================================================
   HIDDEN STATE
   ============================================================================= */

.hidden {
    display: none;
}

/* =============================================================================
   ENVIRONMENT BACKGROUND
   ============================================================================= */

.environment-container {
    position: absolute;
    width: 100%;
    height: 100%;
}

.env-layer {
    position: absolute;
    width: 100%;
    height: 100%;
}

.env-layer-base {
    background-color: rgb(8, 5, 12);
}

.env-layer-color {
    opacity: 1;
}

.env-vignette {
    background-color: rgba(0, 0, 0, 0.45);
}

/* =============================================================================
   HERO STAGE (3D RenderTexture)
   ============================================================================= */

.hero-stage {
    position: absolute;
    width: 50%;
    height: 70%;
    top: 5%;
    left: 25%;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-radius: 14px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.09);
    background-color: rgba(12, 10, 18, 0.62);
}

.hero-stage-render {
    width: 100%;
    height: 100%;
    background-color: transparent;
}

/* =============================================================================
   VFX OVERLAY
   ============================================================================= */

.vfx-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
}

.model-rotate-btn {
    position: absolute;
    width: 46px;
    height: 46px;
    top: 50%;
    margin-top: -23px;
    background-color: rgba(12, 10, 18, 0.86);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.24);
    border-radius: 23px;
    align-items: center;
    justify-content: center;
}

.model-rotate-btn:hover {
    background-color: rgba(25, 22, 34, 0.94);
    border-color: rgba(255, 255, 255, 0.42);
}

.model-rotate-left {
    left: 14px;
}

.model-rotate-right {
    right: 14px;
}

.model-rotate-arrow {
    color: rgba(244, 236, 224, 1);
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* =============================================================================
   VEIL TEAR TRANSITION
   ============================================================================= */

.veil-tear-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
}

.veil-tear-flash {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgb(0, 0, 0);
    opacity: 0;
}

.veil-tear-flash.active {
    opacity: 0.85;
}

.veil-tear-crack {
    position: absolute;
    width: 4px;
    height: 0%;
    top: 50%;
    left: 50%;
    opacity: 0;
}

.veil-tear-crack.active {
    height: 100%;
    opacity: 1;
}

/* =============================================================================
   LEFT INFO PANEL
   ============================================================================= */

.info-panel {
    position: absolute;
    width: 300px;
    top: 80px;
    left: 40px;
    padding-top: 24px;
    padding-right: 24px;
    padding-bottom: 24px;
    padding-left: 24px;
    opacity: 0;
}

.info-panel.visible {
    opacity: 1;
}

.glass-panel {
    background-color: rgba(10, 10, 14, 0.92);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.2);
    border-radius: 8px;
}

.hero-name {
    font-size: 42px;
    -unity-font-style: bold;
    letter-spacing: 8px;
    margin-bottom: 4px;
    color: rgba(245, 238, 226, 1);
}

.hero-title {
    font-size: 14px;
    color: rgba(228, 216, 198, 0.95);
    letter-spacing: 6px;
    margin-bottom: 16px;
}

.hero-quote {
    font-size: 13px;
    -unity-font-style: italic;
    color: rgba(225, 215, 202, 0.92);
    margin-bottom: 20px;
    opacity: 0;
}

.hero-quote.visible {
    opacity: 1;
}

.hero-details {
    margin-bottom: 14px;
    padding-top: 16px;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.06);
}

.detail-row {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 8px;
}

.detail-label {
    font-size: 10px;
    color: rgba(214, 205, 192, 0.82);
    letter-spacing: 3px;
}

.detail-value {
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: rgba(240, 232, 220, 1);
}

.section-label {
    font-size: 10px;
    color: rgba(214, 205, 192, 0.82);
    letter-spacing: 4px;
    margin-bottom: 10px;
}

.starter-stats {
    margin-bottom: 14px;
}

.starter-stat-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
}

.starter-stat-chip {
    width: 48%;
    margin-bottom: 8px;
    padding-top: 6px;
    padding-right: 8px;
    padding-bottom: 6px;
    padding-left: 8px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    background-color: rgba(255, 255, 255, 0.07);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.16);
    border-radius: 5px;
}

.starter-stat-key {
    font-size: 9px;
    color: rgba(220, 210, 198, 0.85);
    letter-spacing: 2px;
}

.starter-stat-val {
    font-size: 12px;
    -unity-font-style: bold;
    color: rgba(246, 238, 226, 1);
}

/* Monster Info */
.monster-info {
    padding-top: 12px;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.06);
}

.monster-card {
    flex-direction: row;
    align-items: center;
    padding-top: 10px;
    padding-right: 12px;
    padding-bottom: 10px;
    padding-left: 12px;
    background-color: rgba(255, 255, 255, 0.08);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.2);
}

.monster-thumbnail {
    width: 44px;
    height: 44px;
    margin-right: 12px;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    border-radius: 4px;
    background-color: rgba(0, 0, 0, 0.3);
}

.monster-text {
    flex-grow: 1;
}

.monster-name {
    font-size: 13px;
    -unity-font-style: bold;
    margin-bottom: 2px;
    color: rgba(243, 236, 226, 1);
}

.monster-brand {
    font-size: 10px;
    color: rgba(214, 204, 194, 0.85);
    letter-spacing: 2px;
}

/* =============================================================================
   RIGHT STATS PANEL
   ============================================================================= */

.stats-panel {
    position: absolute;
    width: 280px;
    top: 80px;
    right: 40px;
    padding-top: 24px;
    padding-right: 24px;
    padding-bottom: 24px;
    padding-left: 24px;
    opacity: 1;
    display: flex;
}

.stats-panel.visible {
    opacity: 1;
    display: flex;
}

.stats-panel.hidden {
    display: none;
}

.stat-bars {
    margin-bottom: 20px;
}

.stat-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
}

.stat-row-primary .stat-label {
    color: rgba(250, 239, 221, 1);
    -unity-font-style: bold;
}

.stat-row-primary .stat-value {
    color: rgba(255, 245, 230, 1);
}

.stat-label {
    width: 36px;
    font-size: 10px;
    color: rgba(220, 210, 198, 0.9);
    letter-spacing: 2px;
}

.stat-bar-track {
    flex-grow: 1;
    height: 6px;
    background-color: rgba(255, 255, 255, 0.16);
    border-radius: 3px;
    overflow: hidden;
    margin-left: 10px;
    margin-right: 10px;
}

.stat-row-primary .stat-bar-track {
    background-color: rgba(255, 255, 255, 0.24);
}

.stat-bar-fill {
    height: 100%;
    width: 0%;
    border-radius: 3px;
    background-color: rgba(226, 146, 82, 0.92);
}

.stat-value {
    width: 24px;
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
    color: rgba(244, 237, 225, 1);
}

/* Abilities */
.ability-list {
    padding-top: 12px;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.06);
}

.ability-row {
    padding-top: 8px;
    padding-right: 10px;
    padding-bottom: 8px;
    padding-left: 10px;
    margin-bottom: 6px;
    background-color: rgba(255, 255, 255, 0.08);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.22);
}

.ability-row:hover {
    border-color: rgba(255, 255, 255, 0.35);
}

.ability-name {
    font-size: 12px;
    -unity-font-style: bold;
    margin-bottom: 2px;
    color: rgba(244, 236, 224, 1);
}

.ability-desc {
    font-size: 10px;
    color: rgba(221, 212, 200, 0.9);
}

/* =============================================================================
   CAROUSEL STRIP
   ============================================================================= */

.carousel-strip {
    position: absolute;
    width: 100%;
    height: 160px;
    bottom: 30px;
    align-items: center;
    justify-content: center;
}

.carousel-track {
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.carousel-slot {
    width: 120px;
    height: 150px;
    background-color: rgba(15, 12, 20, 0.85);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    overflow: hidden;
    align-items: center;
    justify-content: flex-end;
    padding-bottom: 10px;
    margin-left: 8px;
    margin-right: 8px;
    position: relative;
}

.carousel-slot:hover {
    border-color: rgba(255, 255, 255, 0.25);
}

.carousel-slot.selected {
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.35);
}

.slot-portrait {
    position: absolute;
    width: 100%;
    height: 70%;
    top: 0;
    background-size: cover;
    background-position: center top;
    opacity: 0.6;
}

.carousel-slot.selected .slot-portrait {
    opacity: 1;
}

.slot-glow {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0);
}

.carousel-slot.selected .slot-glow {
    background-color: rgba(200, 200, 220, 0.1);
}

.slot-name {
    font-size: 11px;
    -unity-font-style: bold;
    color: rgba(230, 220, 208, 0.95);
    letter-spacing: 2px;
}

.carousel-slot.selected .slot-name {
    color: rgba(235, 225, 215, 1);
}

/* Teaser slot */
.carousel-slot.teaser {
    background-color: rgba(10, 8, 15, 0.7);
    justify-content: center;
}

.carousel-slot.teaser:hover {
    border-color: rgba(255, 255, 255, 0.12);
}

.slot-teaser-mark {
    font-size: 36px;
    color: rgba(200, 190, 180, 0.2);
    -unity-text-align: middle-center;
}

.teaser-name {
    color: rgba(220, 210, 198, 0.55);
    font-size: 9px;
}

.hero-cycle-hud {
    position: absolute;
    left: 50%;
    margin-left: -210px;
    bottom: 280px;
    width: 420px;
    height: 42px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding-top: 4px;
    padding-bottom: 4px;
    background-color: rgba(8, 7, 12, 0.75);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.14);
    border-radius: 8px;
}

.hero-cycle-btn {
    width: 40px;
    height: 32px;
    margin-left: 12px;
    margin-right: 12px;
    background-color: rgba(15, 12, 20, 0.82);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.2);
    border-radius: 4px;
    align-items: center;
    justify-content: center;
}

.hero-cycle-btn:hover {
    border-color: rgba(255, 255, 255, 0.45);
}

.hero-cycle-arrow {
    color: rgba(244, 236, 224, 1);
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.hero-index-indicator {
    min-width: 250px;
    color: rgba(234, 224, 212, 0.98);
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
}

/* =============================================================================
   EMBARK BUTTON
   ============================================================================= */

.embark-btn {
    position: absolute;
    width: 300px;
    height: 64px;
    bottom: 210px;
    left: 50%;
    margin-left: -150px;
    background-color: transparent;
    border-width: 0;
    overflow: visible;
    align-items: center;
    justify-content: center;
}

.embark-glow {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(18, 14, 26, 0.97);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.12);
    border-radius: 6px;
}

.embark-btn:hover .embark-glow {
    border-color: rgba(255, 255, 255, 0.3);
}

.embark-label {
    font-size: 16px;
    -unity-font-style: bold;
    letter-spacing: 4px;
    color: rgba(245, 238, 227, 1);
}

.embark-sub {
    font-size: 9px;
    color: rgba(225, 214, 201, 0.88);
    letter-spacing: 2px;
}

/* =============================================================================
   NAVIGATION BUTTONS
   ============================================================================= */

.nav-btn {
    position: absolute;
    background-color: rgba(15, 12, 20, 0.75);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 4px;
    flex-direction: row;
    align-items: center;
    padding-top: 8px;
    padding-right: 16px;
    padding-bottom: 8px;
    padding-left: 16px;
}

.nav-btn:hover {
    background-color: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.2);
}

.back-btn {
    top: 36px;
    left: 40px;
}

.neutral-btn {
    top: 36px;
    right: 40px;
}

.back-arrow {
    width: 10px;
    height: 10px;
    margin-right: 8px;
    background-color: transparent;
    border-top-width: 2px;
    border-left-width: 2px;
    border-bottom-width: 0;
    border-right-width: 0;
    border-color: rgba(255, 255, 255, 0.6);
    rotate: -45deg;
}

.nav-label {
    font-size: 11px;
    color: rgba(232, 223, 210, 0.94);
    letter-spacing: 2px;
}

/* =============================================================================
   SCREEN FADE
   ============================================================================= */

.screen-fade {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgb(0, 0, 0);
    opacity: 0;
}

.screen-fade.active {
    opacity: 1;
}
