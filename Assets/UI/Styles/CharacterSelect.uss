/* =============================================================================
   VEILBREAKERS 3D - VEIL-TORN DARK FANTASY CHARACTER SELECT STYLESHEET
   Rule-of-thirds composition, tabbed info, hold-to-embark, gamepad focus ring
   ============================================================================= */

/* =============================================================================
   CORE VARIABLES - Character Select Specific
   ============================================================================= */

:root {
    /* Transition Timing */
    --transition-fast: 0.2s;
    --transition-normal: 0.4s;
    --transition-slow: 0.8s;
    --transition-hero-switch: 1.2s;

    /* Easing Functions */
    --ease-out-expo: ease-out-back;
    --ease-out-back: ease-out-back;
    --ease-in-out-quint: ease-in-out-cubic;

    /* Spacing */
    --panel-margin: 40px;
    --card-gap: 20px;

    /* Veil-Torn Panel Material */
    --veil-bg: rgba(12, 10, 18, 0.92);
    --veil-border: rgba(60, 50, 70, 0.8);
}

/* =============================================================================
   HERO THEME CLASSES (Set on root)
   ============================================================================= */

.theme-vex {
    --hero-primary: rgb(200, 160, 60);
    --hero-secondary: rgb(180, 140, 40);
    --hero-accent: rgb(255, 200, 100);
    --hero-glow: rgba(200, 160, 60, 0.25);
}

.theme-seraphina {
    --hero-primary: rgb(140, 80, 200);
    --hero-secondary: rgb(120, 60, 180);
    --hero-accent: rgb(200, 160, 255);
    --hero-glow: rgba(140, 80, 200, 0.25);
}

.theme-orion {
    --hero-primary: rgb(180, 50, 50);
    --hero-secondary: rgb(160, 40, 40);
    --hero-accent: rgb(255, 120, 100);
    --hero-glow: rgba(180, 50, 50, 0.25);
}

.theme-nyx {
    --hero-primary: rgb(60, 180, 200);
    --hero-secondary: rgb(40, 160, 180);
    --hero-accent: rgb(120, 220, 240);
    --hero-glow: rgba(60, 180, 200, 0.25);
}

/* =============================================================================
   HIDDEN UTILITY
   ============================================================================= */

.hidden {
    display: none;
}

/* =============================================================================
   ROOT / LAYOUT
   ============================================================================= */

TemplateContainer {
    flex-grow: 1;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.character-select-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-direction: column;
    overflow: hidden;
    background-color: rgb(8, 6, 12);
}

/* =============================================================================
   PARALLAX BACKGROUND SYSTEM
   ============================================================================= */

.parallax-bg {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    pointer-events: none;
}

/* Layer 1: Deepest Void */
.parallax-deep {
    background-color: rgb(4, 4, 8);
    z-index: 0;
}

.void-stars {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: transparent;
    opacity: 0.6;
}

/* Layer 2: Fog Particles */
.parallax-fog {
    z-index: 1;
    pointer-events: none;
}

.fog-particles {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: var(--hero-glow, rgba(40, 20, 60, 0.08));
    opacity: 0.4;
    transition-property: background-color;
    transition-duration: var(--transition-slow);
    transition-timing-function: var(--ease-out-expo);
}

/* Layer 5: Vignette Overlay */
.background-vignette {
    position: absolute;
    width: 100%;
    height: 100%;
    z-index: 4;
    pointer-events: none;
    background-color: rgba(0, 0, 0, 0.15);
}

/* =============================================================================
   VEIL-TORN PANEL MATERIAL (.veil-panel)
   Obsidian/iron textured borders with per-hero accent glow
   ============================================================================= */

.veil-panel {
    background-color: rgba(12, 10, 18, 0.92);
    border-width: 2px;
    border-color: rgba(60, 50, 70, 0.8);
    border-radius: 6px;
    padding: 16px;
    overflow: hidden;
    transition-property: border-color;
    transition-duration: 0.4s;
    transition-timing-function: ease-in-out;
}

/* Per-hero accent glow on veil-panel borders */
.theme-vex .veil-panel {
    border-color: rgba(200, 160, 60, 0.6);
}

.theme-seraphina .veil-panel {
    border-color: rgba(140, 80, 200, 0.6);
}

.theme-orion .veil-panel {
    border-color: rgba(180, 50, 50, 0.6);
}

.theme-nyx .veil-panel {
    border-color: rgba(60, 180, 200, 0.6);
}

/* =============================================================================
   HERO STAGE (Left half, 50% width)
   ============================================================================= */

.hero-stage {
    position: absolute;
    left: 0;
    top: 0;
    right: 50%;
    bottom: 0;
    z-index: 10;
    align-items: center;
    justify-content: center;
}

.hero-render-target {
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-to-fit;
}

.drag-hint {
    position: absolute;
    bottom: 12%;
    font-size: 12px;
    color: rgba(200, 200, 215, 0.25);
    letter-spacing: 6px;
    -unity-text-align: middle-center;
    align-self: center;
    transition-property: opacity;
    transition-duration: 0.6s;
}

.drag-hint:hover {
    opacity: 0;
}

.hero-aura-container {
    position: absolute;
    width: 60%;
    height: 60%;
    bottom: 10%;
    z-index: 1;
    pointer-events: none;
}

.aura-base {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: var(--hero-glow, rgba(40, 20, 60, 0.08));
    opacity: 0.3;
}

/* =============================================================================
   INFO PANEL CONTAINER (Right half, tabbed info)
   ============================================================================= */

.info-panel-container {
    position: absolute;
    right: 0;
    top: 60px;
    width: 46%;
    height: 70%;
    z-index: 20;
    padding: 20px;
    overflow: hidden;
    flex-direction: column;
}

/* =============================================================================
   TAB SYSTEM
   ============================================================================= */

.tab-header-strip {
    flex-direction: row;
    justify-content: flex-start;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(60, 50, 70, 0.5);
    flex-shrink: 0;
}

.tab-btn {
    background-color: transparent;
    color: rgba(180, 170, 190, 0.5);
    border-width: 0;
    border-bottom-width: 2px;
    border-bottom-color: transparent;
    padding: 8px 16px;
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    transition-property: color, border-bottom-color, opacity;
    transition-duration: 0.2s, 0.2s, 0.2s;
}

.tab-btn-active {
    color: rgba(240, 230, 250, 1);
    border-bottom-color: rgba(200, 160, 60, 0.9);
}

.tab-btn:hover {
    color: rgba(220, 210, 230, 0.8);
}

.tab-content {
    flex-grow: 1;
    overflow: hidden;
}

.tab-content-section {
    display: none;
    flex-grow: 1;
    padding: 12px 0;
}

.tab-content-section.tab-active {
    display: flex;
}

/* =============================================================================
   HERO IDENTITY (Inside tab-overview-content)
   ============================================================================= */

.hero-name {
    font-size: 32px;
    -unity-font-style: bold;
    color: rgba(240, 230, 250, 1);
    letter-spacing: 3px;
    margin-bottom: 2px;
    transition-property: color;
    transition-duration: var(--transition-slow);
    transition-timing-function: var(--ease-out-expo);
}

.hero-title {
    font-size: 16px;
    color: rgba(180, 170, 190, 0.7);
    letter-spacing: 2px;
    margin-bottom: 12px;
    opacity: 0.8;
    border-left-width: 2px;
    border-left-color: var(--hero-primary);
    padding-left: 12px;
}

.hero-quote {
    font-size: 13px;
    color: rgba(160, 150, 170, 0.6);
    -unity-font-style: italic;
    margin-bottom: 16px;
    white-space: normal;
    padding-bottom: 12px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.1);
}

/* =============================================================================
   INFO ROWS
   ============================================================================= */

.hero-class-info {
    margin-bottom: 8px;
}

.info-row {
    flex-direction: row;
    margin: 2px 0;
    align-items: flex-start;
}

.info-label {
    width: 80px;
    font-size: 13px;
    color: rgba(140, 130, 150, 0.6);
    letter-spacing: 2px;
}

.info-value {
    flex-grow: 1;
    font-size: 13px;
    color: rgba(220, 210, 230, 0.9);
    white-space: normal;
    overflow: hidden;
    flex-shrink: 1;
}

/* =============================================================================
   STARTER STATS GRID
   ============================================================================= */

.starter-stats-grid {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 12px;
    justify-content: space-between;
}

.stat-chip {
    width: 48%;
    background-color: rgba(0, 0, 0, 0.3);
    padding: 6px 10px;
    margin-bottom: 6px;
    border-radius: 4px;
    border-left-width: 2px;
    border-left-color: var(--hero-primary);
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.stat-chip-label {
    font-size: 12px;
    color: rgba(160, 150, 170, 0.6);
}

.stat-chip-value {
    font-size: 14px;
    color: rgba(240, 230, 250, 0.95);
    -unity-font-style: bold;
}

/* =============================================================================
   CHAMPION SECTION
   ============================================================================= */

.champion-section {
    margin-top: 12px;
    padding-top: 10px;
    border-top-width: 1px;
    border-top-color: rgba(60, 50, 70, 0.4);
}

.champion-name {
    font-size: 15px;
    -unity-font-style: bold;
    color: var(--hero-accent);
    margin-bottom: 6px;
}

.champion-tags {
    flex-direction: row;
}

.tag {
    font-size: 12px;
    color: rgba(200, 200, 215, 0.9);
    letter-spacing: 2px;
    background-color: rgba(255, 255, 255, 0.06);
    padding: 4px 10px;
    margin-right: 8px;
    border-radius: 3px;
    border-width: 1px;
    border-color: rgba(60, 50, 70, 0.5);
}

/* =============================================================================
   ATTRIBUTE BARS SECTION
   ============================================================================= */

.attribute-bars-section {
    margin-top: 12px;
    padding-top: 10px;
    border-top-width: 1px;
    border-top-color: rgba(60, 50, 70, 0.4);
}

.section-header {
    font-size: 12px;
    color: rgba(180, 170, 190, 0.7);
    letter-spacing: 5px;
    margin-bottom: 10px;
    -unity-font-style: bold;
}

.attribute-bars {
    flex-direction: column;
}

.stat-bar-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.stat-bar-label {
    width: 40px;
    font-size: 12px;
    color: rgba(140, 130, 150, 0.7);
    letter-spacing: 3px;
}

.stat-bar-track {
    flex-grow: 1;
    height: 12px;
    background-color: rgba(5, 5, 10, 0.7);
    border-radius: 6px;
    margin: 0 10px;
    overflow: hidden;
    border-width: 1px;
    border-color: rgba(60, 50, 70, 0.4);
}

.stat-bar-fill {
    height: 100%;
    background-color: var(--hero-primary, rgb(200, 160, 60));
    border-radius: 6px;
}

.stat-bar-value {
    width: 30px;
    font-size: 13px;
    color: rgba(240, 230, 250, 0.9);
    -unity-text-align: middle-right;
    -unity-font-style: bold;
}

/* =============================================================================
   ABILITIES (Tab 2)
   ============================================================================= */

.abilities-list {
    flex-direction: column;
}

.ability-slot {
    font-size: 13px;
    color: rgba(230, 220, 240, 0.9);
    padding: 10px 16px;
    margin-bottom: 6px;
    background-color: rgba(255, 255, 255, 0.04);
    border-radius: 4px;
    border-left-width: 3px;
    border-left-color: var(--hero-primary);
    transition-property: translate, background-color, border-left-color;
    transition-duration: var(--transition-fast), var(--transition-fast), var(--transition-fast);
    transition-timing-function: var(--ease-out-expo), var(--ease-out-expo), var(--ease-out-expo);
}

.ability-slot:hover {
    background-color: rgba(255, 255, 255, 0.1);
    translate: 6px 0;
    border-left-color: rgba(240, 230, 250, 0.9);
}

/* =============================================================================
   LORE (Tab 3)
   ============================================================================= */

.hero-lore-section {
    margin-bottom: 12px;
}

.hero-backstory {
    font-size: 12px;
    color: rgba(180, 170, 190, 0.7);
    white-space: normal;
    -unity-font-style: italic;
}

.synergy-detail-section {
    margin-top: 8px;
    padding-top: 8px;
    border-top-width: 1px;
    border-top-color: rgba(60, 50, 70, 0.3);
}

.hero-synergy-detail {
    font-size: 12px;
    color: rgba(180, 170, 190, 0.7);
    white-space: normal;
}

.brands-section {
    margin-top: 8px;
    padding-top: 8px;
    border-top-width: 1px;
    border-top-color: rgba(60, 50, 70, 0.3);
}

.hero-brands-detail {
    font-size: 12px;
    color: rgba(180, 170, 190, 0.7);
    white-space: normal;
}

/* =============================================================================
   FOCUS RING (Gamepad Navigation)
   ============================================================================= */

.focusable-zone {
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 4px;
    transition-property: border-color, scale;
    transition-duration: 0.15s, 0.15s;
    transition-timing-function: ease-out, ease-out;
}

.focusable-zone:focus {
    border-color: rgba(255, 180, 60, 0.9);
    scale: 1.02 1.02;
}

/* C#-driven focus class for zone-level highlighting */
.focus-ring-active {
    border-color: rgba(255, 180, 60, 0.9);
    scale: 1.02 1.02;
}

/* Per-hero focus ring colors */
.theme-vex .focus-ring-active {
    border-color: rgba(200, 160, 60, 0.9);
}

.theme-seraphina .focus-ring-active {
    border-color: rgba(140, 80, 200, 0.9);
}

.theme-orion .focus-ring-active {
    border-color: rgba(180, 50, 50, 0.9);
}

.theme-nyx .focus-ring-active {
    border-color: rgba(60, 180, 200, 0.9);
}

/* =============================================================================
   EMBARK AREA (Bottom-right of info area)
   ============================================================================= */

.embark-area {
    position: absolute;
    bottom: 20px;
    right: 2%;
    width: 42%;
    align-items: flex-end;
    z-index: 40;
}

.btn-embark {
    width: 340px;
    height: 72px;
    background-color: transparent;
    border-width: 0;
    overflow: visible;
}

.embark-hex-bg {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(20, 16, 28, 0.98);
    border-width: 2px;
    border-color: var(--hero-primary);
    border-radius: 6px;
    transition-property: border-color, background-color, scale;
    transition-duration: var(--transition-normal), var(--transition-normal), var(--transition-normal);
    transition-timing-function: var(--ease-out-expo), var(--ease-out-expo), var(--ease-out-expo);
}

.btn-embark:hover .embark-hex-bg {
    border-color: rgba(240, 230, 250, 0.9);
    background-color: rgba(35, 30, 45, 0.98);
    scale: 1.05;
}

.embark-text {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgba(240, 230, 250, 1);
    letter-spacing: 8px;
    transition-property: color, scale;
    transition-duration: var(--transition-normal), var(--transition-normal);
}

.btn-embark:hover .embark-text {
    color: rgba(255, 255, 255, 1);
    scale: 1.08;
}

.embark-subtitle {
    font-size: 12px;
    color: rgba(180, 170, 190, 0.5);
    letter-spacing: 4px;
    margin-top: 4px;
}

.embark-glow {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: var(--hero-primary);
    opacity: 0;
    transition-property: opacity;
    transition-duration: var(--transition-slow);
}

.embark-glow.breathing {
    opacity: 0.08;
}

/* Embark Progress Ring (hold-to-confirm visual) */
.embark-progress-ring {
    position: absolute;
    width: 64px;
    height: 64px;
    border-radius: 32px;
    border-width: 3px;
    border-color: rgba(255, 180, 60, 0);
    transition-property: border-color, opacity;
    transition-duration: 0.2s, 0.2s;
}

.embark-progress-ring.hold-active {
    border-color: rgba(255, 180, 60, 0.9);
    opacity: 1;
}

/* =============================================================================
   BOTTOM LAYER: CAROUSEL
   ============================================================================= */

.bottom-layer {
    position: absolute;
    bottom: 20px;
    width: 100%;
    height: 140px;
    z-index: 30;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.nav-arrow {
    width: 50px;
    height: 50px;
    font-size: 24px;
    color: rgba(255, 255, 255, 0.4);
    background-color: rgba(12, 10, 18, 0.8);
    border-radius: 25px;
    border-width: 1px;
    border-color: rgba(60, 50, 70, 0.5);
    -unity-text-align: middle-center;
    transition-property: color, border-color, scale;
    transition-duration: var(--transition-fast), var(--transition-fast), var(--transition-fast);
    transition-timing-function: var(--ease-out-expo), var(--ease-out-expo), var(--ease-out-expo);
}

.nav-arrow:hover {
    color: rgba(240, 230, 250, 1);
    border-color: var(--hero-accent);
    scale: 1.1;
}

.carousel-container {
    margin: 0 40px;
}

.carousel-strip {
    flex-direction: row;
    align-items: center;
}

.hero-card {
    width: 120px;
    height: 150px;
    margin: 0 12px;
    background-color: rgba(12, 10, 18, 0.95);
    border-width: 1px;
    border-color: rgba(60, 50, 70, 0.4);
    border-radius: 8px;
    align-items: center;
    justify-content: center;
    transition-property: scale, opacity, border-color;
    transition-duration: var(--transition-normal), var(--transition-normal), var(--transition-normal);
    transition-timing-function: var(--ease-out-back), var(--ease-out-back), var(--ease-out-back);
    opacity: 0.7;
}

.hero-card:hover {
    scale: 1.15;
    opacity: 1;
    border-color: rgba(180, 170, 190, 0.5);
}

.hero-card.selected {
    scale: 1.25;
    opacity: 1;
    border-color: var(--hero-primary);
}

.hero-card-initial {
    font-size: 42px;
    -unity-font-style: bold;
    color: var(--hero-primary);
    opacity: 0.4;
    margin-bottom: 4px;
    transition-property: opacity;
    transition-duration: var(--transition-normal);
}

.hero-card.selected .hero-card-initial {
    opacity: 1;
}

.hero-card-name {
    font-size: 13px;
    color: rgba(240, 230, 250, 0.8);
    letter-spacing: 2px;
}

.hero-card-role {
    font-size: 12px;
    color: rgba(180, 170, 190, 0.5);
    letter-spacing: 3px;
    margin-top: 4px;
}

.hero-card.teaser {
    border-color: rgba(60, 50, 70, 0.2);
    opacity: 0.3;
}

.hero-card.teaser:hover {
    opacity: 0.5;
    scale: 1.05;
}

/* =============================================================================
   MISC UI
   ============================================================================= */

.btn-back {
    position: absolute;
    top: 12px;
    left: 12px;
    padding: 10px 20px;
    background-color: rgba(12, 10, 18, 0.7);
    border-width: 1px;
    border-color: rgba(60, 50, 70, 0.5);
    border-radius: 4px;
    color: rgba(180, 170, 190, 0.5);
    font-size: 12px;
    letter-spacing: 4px;
    z-index: 50;
    transition-property: color, border-color;
    transition-duration: var(--transition-fast), var(--transition-fast);
}

.btn-back:hover {
    color: rgba(240, 230, 250, 1);
    border-color: rgba(240, 230, 250, 0.6);
}

.hero-index {
    position: absolute;
    bottom: 20px;
    right: 40px;
    font-size: 12px;
    color: rgba(180, 170, 190, 0.2);
    letter-spacing: 4px;
}

/* =============================================================================
   TOAST NOTIFICATION
   ============================================================================= */

.toast-container {
    position: absolute;
    bottom: -100px;
    left: 50%;
    translate: -50% 0;
    width: 400px;
    z-index: 200;
    transition-property: translate;
    transition-duration: 0.4s;
    transition-timing-function: ease-out;
}

.toast-container.toast-visible {
    translate: -50% -120px;
}

.toast-container.toast-hidden {
    translate: -50% 0;
}

.toast-content {
    flex-direction: row;
    background-color: rgba(40, 15, 15, 0.95);
    border-width: 1px;
    border-color: rgba(200, 60, 60, 0.6);
    border-radius: 6px;
    padding: 12px 16px;
    align-items: center;
}

.toast-icon {
    width: 20px;
    height: 20px;
    margin-right: 10px;
    background-color: rgba(200, 60, 60, 0.8);
    border-radius: 10px;
    flex-shrink: 0;
}

.toast-message {
    color: rgba(240, 200, 200, 0.9);
    font-size: 13px;
    flex-grow: 1;
    white-space: normal;
}

.toast-actions {
    flex-direction: row;
    padding-top: 8px;
    justify-content: flex-end;
}

.toast-btn {
    background-color: rgba(60, 20, 20, 0.8);
    color: rgba(240, 200, 200, 0.9);
    border-width: 1px;
    border-color: rgba(200, 60, 60, 0.4);
    border-radius: 4px;
    padding: 6px 14px;
    margin-left: 8px;
    font-size: 12px;
}

.toast-btn:hover {
    background-color: rgba(80, 30, 30, 0.9);
    border-color: rgba(200, 60, 60, 0.7);
}

/* =============================================================================
   SKELETON SHIMMER (Loading State)
   ============================================================================= */

.skeleton-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(12, 10, 18, 0.7);
    z-index: 150;
    pointer-events: none;
}

.skeleton-shimmer {
    background-color: rgba(40, 40, 50, 0.6);
    border-radius: 4px;
    min-height: 16px;
    margin: 4px 0;
    overflow: hidden;
}

.shimmer-bar {
    position: absolute;
    width: 60px;
    height: 100%;
    background-color: rgba(255, 255, 255, 0.06);
    rotate: 15deg;
    translate: -60px 0;
    transition-property: translate;
    transition-duration: 1.2s;
    transition-timing-function: ease-in-out;
}

.shimmer-bar.shimmer-active {
    translate: 400px 0;
}

/* =============================================================================
   PANEL TRANSITION CLASSES
   ============================================================================= */

.panel-hidden {
    opacity: 0;
    translate: -20px 0;
}

/* Default panel state (no .panel-hidden) with transitions */
.info-panel-container {
    opacity: 1;
    translate: 0 0;
    transition-property: opacity, translate, border-color;
    transition-duration: 0.3s, 0.3s, 0.4s;
    transition-timing-function: ease-out, ease-out, ease-in-out;
}

/* =============================================================================
   CINEMATIC OVERLAY SYSTEM
   Subtle post-process layers for atmospheric depth
   ============================================================================= */

.cinematic-overlays {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 90;
    pointer-events: none;
}

/* Scanline overlay: subtle horizontal stripe pattern */
.overlay-scanlines {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.02);
    opacity: 0.3;
}

/* Vignette: darken edges for cinematic focus */
.overlay-vignette {
    position: absolute;
    width: 100%;
    height: 100%;
    border-width: 80px;
    border-color: rgba(0, 0, 0, 0.25);
}

/* Veil glow: hero-tinted ambient haze */
.overlay-veil-glow {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: var(--hero-glow, rgba(40, 20, 60, 0.03));
    opacity: 0.15;
    transition-property: background-color;
    transition-duration: 1.2s;
    transition-timing-function: ease-in-out;
}

/* =============================================================================
   VISUAL DEPTH HIERARCHY (VISUAL-07)
   Inactive panels are dimmed for visual depth, drawing focus to active content
   ============================================================================= */

/* Panel dim/desaturate for inactive state (applied via OverlayController) */
.panel-inactive-dim {
    opacity: 0.6;
    transition-property: opacity;
    transition-duration: 0.3s;
    transition-timing-function: ease-in-out;
}
