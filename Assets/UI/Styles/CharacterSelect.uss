/* =============================================================================
   VEILBREAKERS 3D - AAA DARK FANTASY CHARACTER SELECT STYLESHEET
   Rule-of-thirds composition, tabbed info, hold-to-embark, gamepad focus ring
   v3.0 - Complete AAA Visual Overhaul
   ============================================================================= */

/* =============================================================================
   CORE VARIABLES - Character Select Specific
   ============================================================================= */

:root {
    /* Transition Timing */
    --transition-fast: 0.2s;
    --transition-normal: 0.4s;
    --transition-slow: 0.8s;
    --transition-hero-switch: 1.2s;

    /* Easing Functions */
    --ease-out-expo: ease-out-back;
    --ease-out-back: ease-out-back;
    --ease-in-out-quint: ease-in-out;

    /* Spacing */
    --panel-margin: 40px;
    --card-gap: 20px;

    /* Veil-Torn Panel Material */
    --veil-bg: rgba(12, 10, 18, 0.92);
    --veil-border: rgba(60, 50, 70, 0.8);

    /* AAA Color Palette */
    --surface-dark: rgba(8, 6, 14, 0.95);
    --surface-mid: rgba(18, 14, 28, 0.90);
    --surface-light: rgba(30, 24, 44, 0.85);
    --text-primary: rgba(240, 235, 250, 1);
    --text-secondary: rgba(190, 180, 210, 0.8);
    --text-muted: rgba(160, 150, 180, 0.75);
    --border-subtle: rgba(80, 65, 100, 0.35);
    --border-accent: rgba(120, 100, 150, 0.5);
}

/* =============================================================================
   HERO THEME CLASSES (Set on root)
   ============================================================================= */

.theme-vex {
    --hero-primary: rgb(220, 68, 34);
    --hero-secondary: rgb(190, 55, 25);
    --hero-accent: rgb(255, 120, 60);
    --hero-glow: rgba(220, 68, 34, 0.25);
    --hero-dim: rgba(220, 68, 34, 0.10);
}

.theme-seraphina {
    --hero-primary: rgb(150, 90, 210);
    --hero-secondary: rgb(130, 70, 190);
    --hero-accent: rgb(200, 150, 255);
    --hero-glow: rgba(150, 90, 210, 0.25);
    --hero-dim: rgba(150, 90, 210, 0.10);
}

.theme-orion {
    --hero-primary: rgb(100, 70, 220);
    --hero-secondary: rgb(80, 55, 200);
    --hero-accent: rgb(140, 110, 255);
    --hero-glow: rgba(100, 70, 220, 0.25);
    --hero-dim: rgba(100, 70, 220, 0.10);
}

.theme-nyx {
    --hero-primary: rgb(180, 25, 30);
    --hero-secondary: rgb(150, 18, 22);
    --hero-accent: rgb(240, 50, 55);
    --hero-glow: rgba(180, 25, 30, 0.25);
    --hero-dim: rgba(180, 25, 30, 0.10);
}

/* =============================================================================
   HIDDEN UTILITY
   ============================================================================= */

.hidden {
    display: none;
}

/* =============================================================================
   ROOT / LAYOUT
   ============================================================================= */

TemplateContainer {
    flex-grow: 1;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.character-select-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-direction: column;
    overflow: hidden;
    background-color: rgb(6, 4, 10);
}

/* =============================================================================
   PARALLAX BACKGROUND SYSTEM
   ============================================================================= */

.parallax-bg {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* Layer 1: Deepest Void */
.parallax-deep {
    background-color: rgb(4, 3, 8);
    z-index: 0;
}

.void-stars {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: transparent;
    opacity: 0.5;
}

/* Layer 2: Fog Particles */
.parallax-fog {
    z-index: 1;
}

.fog-particles {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: var(--hero-dim, rgba(40, 20, 60, 0.05));
    opacity: 0.5;
    transition-property: background-color;
    transition-duration: var(--transition-slow);
    transition-timing-function: var(--ease-out-expo);
}

/* Layer 5: Vignette Overlay */
.background-vignette {
    position: absolute;
    width: 100%;
    height: 100%;
    z-index: 4;
    background-color: rgba(0, 0, 0, 0.1);
}

/* =============================================================================
   VEIL-TORN PANEL MATERIAL (.veil-panel)
   Frosted glass with hero accent edge lighting
   ============================================================================= */

.veil-panel {
    background-color: rgba(10, 8, 16, 0.88);
    border-width: 1px;
    border-color: var(--border-subtle);
    border-radius: 8px;
    padding: 20px;
    overflow: hidden;
    transition-property: border-color, background-color;
    transition-duration: 0.6s, 0.6s;
    transition-timing-function: ease-in-out, ease-in-out;
}

/* Per-hero accent glow on veil-panel borders */
.theme-vex .veil-panel {
    border-color: rgba(220, 68, 34, 0.35);
    border-top-color: rgba(220, 68, 34, 0.6);
}

.theme-seraphina .veil-panel {
    border-color: rgba(150, 90, 210, 0.35);
    border-top-color: rgba(150, 90, 210, 0.6);
}

.theme-orion .veil-panel {
    border-color: rgba(100, 70, 220, 0.35);
    border-top-color: rgba(100, 70, 220, 0.6);
}

.theme-nyx .veil-panel {
    border-color: rgba(180, 25, 30, 0.35);
    border-top-color: rgba(180, 25, 30, 0.6);
}

/* =============================================================================
   HERO STAGE (Left 55%, full height, hero centered-right)
   ============================================================================= */

.hero-stage {
    position: absolute;
    left: 0;
    top: 0;
    right: 45%;
    bottom: 0;
    z-index: 10;
    align-items: center;
    justify-content: center;
}

/* Model display area — constrained to 180x320 centered in stage (spec: .cs-model-area) */
.hero-render-target {
    width: 180px;
    height: 320px;
    border-width: 1px;
    border-color: var(--hero-dim, rgba(180, 60, 50, 0.1));
    border-radius: 8px;
    -unity-background-scale-mode: scale-to-fit;
    align-self: center;
}

/* Hero Name Plate - watermark text at bottom of stage (spec: left:25%, translateX(-50%)) */
.hero-name-plate {
    position: absolute;
    bottom: 20%;
    left: 25%;
    translate: -50% 0;
    align-items: center;
    justify-content: center;
    flex-direction: column;
}

.stage-hero-name {
    -unity-font-definition: url('project://database/Assets/UI/Fonts/CinzelDecorative-Bold.ttf?fileID=12800000&guid=a571f12f2cfa23b44875b20ecbd843c4&type=3');
    font-size: 48px;
    -unity-font-style: bold;
    color: var(--text-primary);
    letter-spacing: 12px;
    opacity: 0.06;
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.stage-hero-title {
    font-size: 12px;
    color: var(--hero-primary);
    letter-spacing: 6px;
    opacity: 0.45;
    -unity-text-align: middle-center;
    margin-top: 10px;
    text-shadow: 0 0 8px var(--hero-glow, rgba(180, 60, 50, 0.15));
}

.drag-hint {
    position: absolute;
    bottom: 12%;
    font-size: 10px;
    color: rgba(255, 255, 255, 0.2);
    letter-spacing: 3px;
    -unity-text-align: middle-center;
    align-self: center;
    transition-property: opacity;
    transition-duration: 0.6s;
}

.drag-hint:hover {
    opacity: 0;
}

/* Aura hidden — the circular glow looked bad behind the model.
   The spec uses CSS filter:blur(30px) which UI Toolkit can't replicate cleanly. */
.hero-aura-container {
    display: none;
}

.aura-base {
    display: none;
}

.aura-ring {
    display: none;
}

/* =============================================================================
   INFO PANEL CONTAINER (Right half, tabbed info)
   ============================================================================= */

.info-panel-container {
    position: absolute;
    right: 2%;
    top: 5%;
    bottom: 20%;
    width: 42%;
    /* background-color removed — C# CharSelectVisualEnhancer applies gradient texture */
    border-width: 1px;
    border-color: rgba(80, 65, 100, 0.25);
    border-top-width: 2px;
    border-top-color: var(--hero-primary, rgba(180, 60, 50, 0.5));
    border-radius: 6px 6px 4px 4px;
    z-index: 20;
    padding: 16px 20px;
    overflow: hidden;
    flex-direction: column;
    opacity: 1;
    translate: 0 0;
    transition-property: opacity, border-color;
    transition-duration: 0.3s, 0.6s;
    transition-timing-function: ease-out, ease-in-out;
}

/* =============================================================================
   TAB SYSTEM
   ============================================================================= */

.tab-header-strip {
    flex-direction: row;
    justify-content: flex-start;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(80, 65, 100, 0.2);
    flex-shrink: 0;
    margin-bottom: 10px;
}

.tab-btn {
    background-color: transparent;
    color: rgba(190, 180, 210, 0.80);
    border-width: 0;
    border-bottom-width: 2px;
    border-bottom-color: transparent;
    padding: 5px 12px;
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    transition-property: border-bottom-color, background-color;
    transition-duration: 0.25s, 0.25s;
    border-radius: 3px 3px 0 0;
    margin-right: 2px;
}

.tab-btn-active {
    color: var(--hero-accent, rgba(240, 100, 80, 1.0));
    border-bottom-color: var(--hero-primary, rgba(180, 60, 50, 0.9));
    background-color: rgba(255, 255, 255, 0.04);
    text-shadow: 0 0 10px var(--hero-glow, rgba(180, 60, 50, 0.4));
}

.tab-btn:hover {
    color: var(--text-secondary);
    background-color: rgba(255, 255, 255, 0.02);
}

/* Per-hero active tab underline */
.theme-vex .tab-btn-active { border-bottom-color: rgba(220, 68, 34, 0.9); color: rgb(255, 120, 60); }
.theme-seraphina .tab-btn-active { border-bottom-color: rgba(150, 90, 210, 0.9); color: rgb(200, 150, 255); }
.theme-orion .tab-btn-active { border-bottom-color: rgba(100, 70, 220, 0.9); color: rgb(140, 110, 255); }
.theme-nyx .tab-btn-active { border-bottom-color: rgba(180, 25, 30, 0.9); color: rgb(240, 50, 55); }

.tab-content {
    flex-grow: 1;
    overflow: scroll;
}

.tab-content-section {
    display: none;
    flex-grow: 1;
    padding: 0;
}

.tab-content-section.tab-active {
    display: flex;
}

/* =============================================================================
   ORNAMENTAL DIVIDERS
   ============================================================================= */

.ornamental-divider {
    height: 14px;
    margin: 4px 0;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.divider-line {
    position: absolute;
    left: 0;
    right: 0;
    height: 1px;
    background-color: rgba(80, 65, 100, 0.3);
}

.divider-diamond {
    font-size: 7px;
    color: var(--hero-primary, rgba(180, 60, 50, 0.5));
    background-color: rgba(10, 8, 16, 0.98);
    padding: 0 8px;
    -unity-text-align: middle-center;
}

/* =============================================================================
   HERO IDENTITY (Inside tab-overview-content)
   ============================================================================= */

.hero-name {
    -unity-font-definition: url('project://database/Assets/UI/Fonts/CinzelDecorative-Bold.ttf?fileID=12800000&guid=a571f12f2cfa23b44875b20ecbd843c4&type=3');
    font-size: 26px;
    -unity-font-style: bold;
    color: var(--hero-accent, #f0ebfa);
    letter-spacing: 3px;
    margin-bottom: 2px;
    white-space: nowrap;
    text-shadow: 0 0 20px var(--hero-glow, rgba(180, 60, 50, 0.3));
    transition-property: color, text-shadow;
    transition-duration: var(--transition-slow);
    transition-timing-function: var(--ease-out-expo);
}

.hero-title {
    font-size: 14px;
    color: var(--hero-primary);
    letter-spacing: 3px;
    margin-bottom: 5px;
    opacity: 1.0;
    border-left-width: 3px;
    border-left-color: var(--hero-primary);
    padding-left: 10px;
    white-space: nowrap;
    text-shadow: 0 0 6px var(--hero-glow, rgba(180, 60, 50, 0.2));
    transition-property: color, border-left-color, text-shadow;
    transition-duration: var(--transition-slow), var(--transition-slow), var(--transition-slow);
}

.hero-quote {
    font-size: 15px;
    color: rgba(235, 230, 250, 1.0);
    -unity-font-style: italic;
    margin-bottom: 10px;
    white-space: normal;
    line-height: 20px;
    padding: 6px 0;
}

/* =============================================================================
   INFO ROWS
   ============================================================================= */

.hero-class-info {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 2px;
}

.info-row {
    flex-direction: row;
    margin-right: 12px;
    align-items: baseline;
}

.info-label {
    font-size: 12px;
    color: rgba(170, 160, 190, 0.8);
    letter-spacing: 3px;
    -unity-font-style: bold;
    margin-right: 4px;
}

.info-value {
    font-size: 13px;
    color: rgba(210, 200, 230, 0.9);
    letter-spacing: 1px;
    margin-left: 4px;
}

/* =============================================================================
   STARTER STATS GRID
   ============================================================================= */

.starter-stats-grid {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 5px;
    justify-content: space-between;
}

.stat-chip {
    width: 48%;
    background-color: rgba(0, 0, 0, 0.3);
    padding: 6px 8px;
    margin-bottom: 5px;
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.04);
    flex-direction: column;
    overflow: hidden;
    transition-property: background-color, border-color, translate;
    transition-duration: 0.2s, 0.2s, 0.2s;
}

.stat-chip:hover {
    background-color: rgba(0, 0, 0, 0.45);
    translate: 0 -1px;
}

.stat-chip-hp:hover { border-color: rgba(204, 56, 56, 0.6); }
.stat-chip-hp:hover .stat-chip-label { opacity: 1; }
.stat-chip-stamina:hover { border-color: rgba(56, 168, 85, 0.6); }
.stat-chip-stamina:hover .stat-chip-label { opacity: 1; }
.stat-chip-atk:hover { border-color: rgba(204, 136, 32, 0.6); }
.stat-chip-atk:hover .stat-chip-label { opacity: 1; }
.stat-chip-def:hover { border-color: rgba(56, 120, 204, 0.6); }
.stat-chip-def:hover .stat-chip-label { opacity: 1; }
.stat-chip-mana:hover { border-color: rgba(130, 80, 200, 0.6); }
.stat-chip-mana:hover .stat-chip-label { opacity: 1; }

.stat-chip-label {
    font-size: 11px;
    color: var(--text-muted);
    letter-spacing: 2px;
    -unity-font-style: bold;
    opacity: 1;
}

.stat-chip-value {
    font-size: 14px;
    color: rgba(240, 235, 250, 0.95);
    -unity-font-style: bold;
}

/* =============================================================================
   PER-STAT COLORS (AAA RPG standard)
   ============================================================================= */

/* Stat chip internal layout */
.stat-chip-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 5px;
}

/* Bar track and fill — AAA V5 spec: dark track, gradient fill, bright end-cap */
.stat-bar-track {
    width: 100%;
    height: 5px;
    background-color: rgba(5, 5, 12, 0.7);
    border-radius: 2px;
    overflow: hidden;
    position: relative;
}

.stat-bar-fill {
    height: 100%;
    border-radius: 2px;
    transition-property: width, background-color;
    transition-duration: 0.4s, 0.6s;
    transition-timing-function: ease-out, ease-in-out;
    position: relative;
    overflow: hidden;
}

/* Per-stat colors — top accent, value text, label color, and bar fill */
.stat-chip-hp {
    border-top-width: 1px;
    border-top-color: rgba(204, 56, 56, 0.5);
}
.stat-chip-hp .stat-chip-label {
    color: rgb(204, 56, 56);
}
.stat-chip-hp .stat-chip-value {
    color: rgb(255, 85, 85);
}
.stat-chip-hp .stat-bar-fill {
    background-color: rgb(204, 56, 56);
}

.stat-chip-stamina {
    border-top-width: 1px;
    border-top-color: rgba(56, 168, 85, 0.5);
}
.stat-chip-stamina .stat-chip-label {
    color: rgb(56, 168, 85);
}
.stat-chip-stamina .stat-chip-value {
    color: rgb(85, 221, 112);
}
.stat-chip-stamina .stat-bar-fill {
    background-color: rgb(56, 168, 85);
}

.stat-chip-atk {
    border-top-width: 1px;
    border-top-color: rgba(204, 136, 32, 0.5);
}
.stat-chip-atk .stat-chip-label {
    color: rgb(204, 136, 32);
}
.stat-chip-atk .stat-chip-value {
    color: rgb(255, 170, 51);
}
.stat-chip-atk .stat-bar-fill {
    background-color: rgb(204, 136, 32);
}

.stat-chip-def {
    border-top-width: 1px;
    border-top-color: rgba(56, 120, 204, 0.5);
}
.stat-chip-def .stat-chip-label {
    color: rgb(56, 120, 204);
}
.stat-chip-def .stat-chip-value {
    color: rgb(85, 170, 255);
}
.stat-chip-def .stat-bar-fill {
    background-color: rgb(56, 120, 204);
}

.stat-chip-mana {
    border-top-width: 1px;
    border-top-color: rgba(130, 80, 200, 0.5);
}
.stat-chip-mana .stat-chip-label {
    color: rgb(130, 80, 200);
}
.stat-chip-mana .stat-chip-value {
    color: rgb(180, 130, 255);
}
.stat-chip-mana .stat-bar-fill {
    background-color: rgb(130, 80, 200);
}

/* =============================================================================
   CHAMPION MONSTER — 50/50 Split (model left, info right)
   ============================================================================= */

.champion-section-v2 {
    flex: 1;
    min-height: 100px;
    flex-direction: row;
    background-color: rgba(0, 0, 0, 0.3);
    border-width: 1px;
    border-color: var(--hero-dim, rgba(180, 60, 50, 0.15));
    border-radius: 6px;
    padding: 10px;
    margin-top: 2px;
    overflow: hidden;
}

.champion-model-viewer {
    width: 48%;
    min-height: 80px;
    background-color: rgba(0, 0, 0, 0.2);
    border-width: 1px;
    border-color: var(--hero-dim, rgba(180, 60, 50, 0.1));
    border-radius: 5px;
    -unity-background-scale-mode: scale-to-fit;
}

.champion-info-panel {
    flex: 1;
    padding-left: 12px;
    justify-content: center;
}

.champion-name-v2 {
    -unity-font-definition: url('project://database/Assets/UI/Fonts/CinzelDecorative-Bold.ttf?fileID=12800000&guid=a571f12f2cfa23b44875b20ecbd843c4&type=3');
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--hero-accent, rgb(240, 100, 80));
    letter-spacing: 1px;
    margin-bottom: 4px;
    white-space: nowrap;
    text-shadow: 0 0 8px var(--hero-glow, rgba(180, 60, 50, 0.2));
}

.champion-brand-label {
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    color: var(--hero-primary, rgba(180, 60, 50, 0.8));
    margin-bottom: 6px;
    padding-bottom: 4px;
    border-bottom-width: 1px;
    border-bottom-color: var(--hero-primary, rgba(180, 60, 50, 0.15));
}

.tag-brand {
    border-color: var(--hero-primary, rgba(180, 60, 50, 0.35));
    color: var(--hero-primary, rgba(180, 60, 50, 0.75));
    background-color: var(--hero-dim, rgba(180, 60, 50, 0.06));
}

.champion-desc {
    font-size: 13px;
    color: rgba(210, 200, 230, 0.85);
    white-space: normal;
    margin-top: 8px;
}

.champion-tags {
    flex-direction: row;
}

.tag {
    font-size: 11px;
    color: rgba(220, 215, 240, 0.95);
    letter-spacing: 2px;
    background-color: rgba(0, 0, 0, 0.45);
    padding: 4px 12px;
    margin-right: 5px;
    border-radius: 3px;
    border-width: 1px;
    border-color: rgba(120, 100, 160, 0.4);
    -unity-font-style: bold;
    transition-property: background-color, border-color;
    transition-duration: 0.2s, 0.2s;
}

.tag:hover {
    background-color: rgba(255, 255, 255, 0.08);
    border-color: var(--border-accent);
}

/* Champion starter monster skills */
.champion-skills-container {
    flex-direction: column;
    margin-top: 6px;
    padding-top: 5px;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.04);
}

.champion-skills-header {
    font-size: 10px;
    letter-spacing: 3px;
    -unity-font-style: bold;
    color: var(--hero-primary, rgba(180, 60, 50, 0.7));
    margin-bottom: 4px;
}

.champion-skill-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 2px;
}

.champion-skill-dot {
    width: 5px;
    height: 5px;
    border-radius: 3px;
    margin-right: 6px;
    flex-shrink: 0;
}

.champion-skill-name {
    font-size: 12px;
    color: rgba(230, 225, 245, 0.95);
    letter-spacing: 1px;
}

.champion-skill-power {
    font-size: 10px;
    color: rgba(255, 180, 100, 0.85);
    margin-left: 6px;
    letter-spacing: 1px;
}

/* =============================================================================
   ATTRIBUTE GRID — Numbers only, no bars (D&D style)
   ============================================================================= */

.attribute-section {
    margin-top: 4px;
    padding-top: 4px;
}

/* Keep .attribute-bars-section as alias for backward compat */
.attribute-bars-section {
    margin-top: 4px;
    padding-top: 4px;
}

.section-header {
    font-size: 10px;
    color: rgba(160, 150, 180, 0.7);
    letter-spacing: 3px;
    margin-bottom: 5px;
    -unity-font-style: bold;
}

.attribute-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
}

.attr-chip {
    width: 15%;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.25);
    border-width: 1px;
    border-color: rgba(80, 65, 100, 0.15);
    border-radius: 4px;
    padding: 4px 2px;
    margin-bottom: 4px;
    transition-property: background-color, border-color;
    transition-duration: 0.2s, 0.2s;
}

.attr-chip:hover {
    background-color: rgba(0, 0, 0, 0.4);
    border-color: rgba(80, 65, 100, 0.3);
}

.attr-chip-label {
    font-size: 11px;
    letter-spacing: 2px;
    -unity-font-style: bold;
    color: rgba(170, 160, 190, 0.8);
    margin-bottom: 1px;
    -unity-text-align: middle-center;
}

.attr-chip-value {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgba(240, 235, 250, 0.85);
    -unity-text-align: middle-center;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.4);
}

/* Legacy bar classes — kept so any stale USS references don't hard-error */
.attribute-bars { flex-direction: column; }
.stat-bar-row { flex-direction: row; align-items: center; margin-bottom: 6px; }
.stat-bar-label { width: 40px; font-size: 11px; color: var(--text-muted); letter-spacing: 3px; -unity-font-style: bold; }
.stat-bar-track { flex-grow: 1; height: 10px; background-color: rgba(5, 5, 12, 0.8); border-radius: 5px; margin: 0 10px; overflow: hidden; }
.stat-bar-fill { height: 100%; background-color: var(--hero-primary, rgb(180, 60, 50)); border-radius: 5px; }
.stat-bar-value { width: 28px; font-size: 13px; color: var(--text-primary); -unity-text-align: middle-right; -unity-font-style: bold; }

/* =============================================================================
   ABILITIES (Tab 2) — AAA skill cards with brand dots, damage info, descriptions
   ============================================================================= */

.abilities-list {
    flex-direction: column;
    padding: 2px 0;
}

/* Ability card container — AAA card with layered depth and accent edge */
.ability-card {
    flex-direction: row;
    align-items: flex-start;
    padding: 10px 12px;
    margin-bottom: 6px;
    background-color: rgba(8, 6, 16, 0.65);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(80, 65, 100, 0.12);
    border-left-width: 3px;
    border-left-color: var(--hero-primary, rgba(180, 60, 50, 0.5));
    translate: 0 0;
    transition-property: translate, background-color, border-color, border-left-color;
    transition-duration: 0.2s, 0.2s, 0.2s, 0.2s;
    transition-timing-function: ease-out, ease-out, ease-out, ease-out;
    overflow: hidden;
    position: relative;
}

.ability-card:hover {
    background-color: rgba(12, 10, 24, 0.85);
    translate: 3px 0;
    border-left-color: var(--hero-accent, rgba(240, 100, 80, 0.9));
    border-color: rgba(80, 65, 100, 0.25);
}

/* Brand color dot — glowing orb indicator */
.ability-brand-dot {
    width: 10px;
    height: 10px;
    border-radius: 5px;
    margin-right: 10px;
    margin-top: 3px;
    flex-shrink: 0;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
}

/* Ability info column */
.ability-info {
    flex: 1;
    flex-direction: column;
}

/* Top row: name + cost/type tags */
.ability-header-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 4px;
}

.ability-name {
    font-size: 12px;
    -unity-font-style: bold;
    color: rgba(240, 235, 250, 0.95);
    letter-spacing: 1px;
}

/* Tag row: damage type, cost, cooldown — pill badges */
.ability-tags {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
}

.ability-tag {
    font-size: 10px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    color: rgba(200, 190, 220, 0.9);
    background-color: rgba(80, 65, 100, 0.2);
    border-radius: 8px;
    padding: 3px 8px;
    margin-left: 4px;
    border-width: 1px;
    border-color: rgba(100, 80, 130, 0.2);
}

/* Power/damage display — warm accent pill */
.ability-power-tag {
    font-size: 10px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    color: rgba(255, 190, 110, 1.0);
    background-color: rgba(255, 140, 40, 0.15);
    border-radius: 8px;
    padding: 3px 8px;
    margin-left: 4px;
    border-width: 1px;
    border-color: rgba(255, 140, 40, 0.2);
}

/* Skill description text */
.ability-desc {
    font-size: 12px;
    color: rgba(210, 200, 230, 0.8);
    white-space: normal;
    -unity-font-style: italic;
    margin-top: 2px;
    padding-right: 4px;
}

.ability-card:hover .ability-desc {
    color: rgba(195, 185, 215, 0.8);
}

.ability-card:hover .ability-name {
    color: rgba(255, 250, 240, 1);
}

.ability-card:hover .ability-brand-dot {
    border-color: rgba(255, 255, 255, 0.35);
}

/* =============================================================================
   LORE (Tab 3) — AAA immersive styling with drop-cap, section dividers
   ============================================================================= */

/* Lore section — AAA immersive card with atmospheric depth */
.hero-lore-section {
    margin-bottom: 14px;
    padding: 12px 10px;
    background-color: rgba(8, 6, 16, 0.5);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(80, 65, 100, 0.1);
    border-left-width: 3px;
    border-left-color: var(--hero-primary, rgba(180, 60, 50, 0.3));
}

.hero-backstory {
    font-size: 14px;
    color: rgba(210, 200, 230, 0.9);
    white-space: normal;
    -unity-font-style: italic;
    padding: 0 4px;
    line-height: 20px;
}

/* Drop-cap first letter element (created in C#) */
.lore-drop-cap {
    font-size: 32px;
    -unity-font-style: bold;
    color: var(--hero-accent, rgba(240, 100, 80, 0.9));
    float: left;
    margin-right: 4px;
    margin-top: -2px;
}

/* Section headers in lore tab */
.lore-section-divider {
    height: 1px;
    background-color: var(--hero-dim, rgba(180, 60, 50, 0.12));
    margin-top: 14px;
    margin-bottom: 10px;
}

/* Synergy detail card — deeper layered card with accent header */
.synergy-detail-section {
    margin-top: 8px;
    padding: 10px 12px;
    background-color: rgba(8, 6, 16, 0.5);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(80, 65, 100, 0.1);
    border-left-width: 3px;
    border-left-color: var(--hero-primary, rgba(180, 60, 50, 0.3));
}

.synergy-detail-section .section-header {
    font-size: 12px;
    letter-spacing: 3px;
    -unity-font-style: bold;
    color: var(--hero-primary, rgba(180, 60, 50, 0.9));
    margin-bottom: 8px;
    padding-bottom: 6px;
    border-bottom-width: 1px;
    border-bottom-color: var(--hero-dim, rgba(180, 60, 50, 0.15));
}

.hero-synergy-detail {
    font-size: 14px;
    color: rgba(210, 200, 230, 0.85);
    white-space: normal;
    line-height: 19px;
}

/* Brands detail card */
.brands-section {
    margin-top: 8px;
    padding: 10px 12px;
    background-color: rgba(8, 6, 16, 0.5);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(80, 65, 100, 0.1);
    border-left-width: 3px;
    border-left-color: var(--hero-primary, rgba(180, 60, 50, 0.3));
}

.brands-section .section-header {
    font-size: 12px;
    letter-spacing: 3px;
    -unity-font-style: bold;
    color: var(--hero-primary, rgba(180, 60, 50, 0.9));
    margin-bottom: 8px;
    padding-bottom: 6px;
    border-bottom-width: 1px;
    border-bottom-color: var(--hero-dim, rgba(180, 60, 50, 0.15));
}

.hero-brands-detail {
    font-size: 14px;
    color: rgba(210, 200, 230, 0.85);
    white-space: normal;
    line-height: 19px;
}

/* =============================================================================
   FOCUS RING (Gamepad Navigation)
   ============================================================================= */

.focusable-zone {
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 6px;
    transition-property: border-color, scale;
    transition-duration: 0.15s, 0.15s;
    transition-timing-function: ease-out, ease-out;
}

.focusable-zone:focus {
    border-color: rgba(255, 200, 80, 0.9);
    scale: 1.02 1.02;
}

/* C#-driven focus class for zone-level highlighting */
.focus-ring-active {
    border-color: rgba(255, 200, 80, 0.9);
    scale: 1.02 1.02;
}

/* Per-hero focus ring colors */
.theme-vex .focus-ring-active { border-color: rgba(220, 68, 34, 0.9); }
.theme-seraphina .focus-ring-active { border-color: rgba(150, 90, 210, 0.9); }
.theme-orion .focus-ring-active { border-color: rgba(100, 70, 220, 0.9); }
.theme-nyx .focus-ring-active { border-color: rgba(180, 25, 30, 0.9); }

/* =============================================================================
   EMBARK AREA (Inline inside bottom-layer, sits to right of carousel)
   ============================================================================= */

.embark-area {
    align-items: center;
    justify-content: center;
    margin-left: 24px;
    flex-shrink: 0;
}

.btn-embark {
    width: 240px;
    height: 54px;
    /* background-color removed — C# CharSelectVisualEnhancer applies gold gradient texture */
    border-width: 2px;
    border-color: rgba(255, 215, 90, 0.55);
    border-top-color: rgba(255, 230, 140, 0.35);
    border-radius: 4px;
    overflow: visible;
    align-items: center;
    justify-content: center;
    transition-property: border-color, scale;
    transition-duration: 0.2s, 0.15s;
}

.btn-embark:hover {
    border-color: rgba(255, 230, 120, 0.70);
    scale: 1.04 1.04;
}

.btn-embark:active {
    /* background-color removed — C# handles active gradient */
    border-color: rgba(255, 240, 150, 0.90);
    scale: 0.96 0.96;
}

.embark-text {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgba(15, 10, 5, 0.95);
    letter-spacing: 4px;
}

.embark-subtitle {
    font-size: 10px;
    -unity-font-style: bold;
    color: rgba(15, 10, 5, 0.75);
    letter-spacing: 4px;
    margin-top: 2px;
}

.embark-hex-bg {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: transparent;
    border-width: 0;
    border-radius: 4px;
    transition-property: opacity;
    transition-duration: var(--transition-normal);
}

.embark-glow {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(255, 230, 120, 0.15);
    opacity: 0;
    border-radius: 8px;
    transition-property: opacity;
    transition-duration: var(--transition-slow);
}

.embark-glow.breathing {
    opacity: 0.06;
}

/* Embark Progress Ring (hold-to-confirm visual) */
.embark-progress-ring {
    position: absolute;
    width: 64px;
    height: 64px;
    border-radius: 32px;
    border-width: 3px;
    border-color: rgba(255, 200, 80, 0);
    transition-property: border-color, opacity;
    transition-duration: 0.2s, 0.2s;
}

.embark-progress-ring.hold-active {
    border-color: rgba(255, 200, 80, 0.9);
    opacity: 1;
}

/* =============================================================================
   BOTTOM LAYER: CAROUSEL (AAA Card Design)
   ============================================================================= */

.bottom-layer {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 16%;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding: 10px 4% 8px;
    z-index: 25;
    /* background-color removed — C# CharSelectVisualEnhancer applies gradient (transparent→dark) */
}

.nav-arrow {
    width: 34px;
    height: 34px;
    font-size: 14px;
    color: rgba(190, 180, 210, 0.4);
    /* background-color removed — C# applies gradient */
    border-radius: 17px;
    border-width: 1px;
    border-color: rgba(100, 80, 130, 0.3);
    -unity-text-align: middle-center;
    align-items: center;
    justify-content: center;
    padding: 0;
    transition-property: color, border-color, scale, background-color;
    transition-duration: 0.25s, 0.25s, 0.25s, 0.25s;
    transition-timing-function: ease-out, ease-out, ease-out, ease-out;
}

.nav-arrow:hover {
    color: rgba(230, 220, 250, 0.8);
    border-color: rgba(150, 130, 180, 0.5);
    scale: 1.1;
}

.carousel-container {
    margin: 0 10px;
    flex-grow: 0;
    flex-shrink: 0;
}

.carousel-strip {
    flex-direction: row;
    align-items: center;
}

.hero-card {
    width: 90px;
    height: 105px;
    margin: 0 6px;
    background-color: rgba(22, 18, 34, 0.9);
    border-width: 1.5px;
    border-color: rgba(80, 65, 100, 0.25);
    border-radius: 6px;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    transition-property: scale, opacity, border-color, translate;
    transition-duration: 0.3s, 0.3s, 0.3s, 0.3s;
    transition-timing-function: ease, ease, ease, ease;
    opacity: 0.7;
    overflow: visible;
}

.hero-card:hover {
    scale: 1.05;
    opacity: 0.85;
    border-color: rgba(120, 100, 150, 0.4);
    translate: 0 -3px;
}

.hero-card.selected {
    scale: 1.08;
    translate: 0 -6px;
    opacity: 1;
    border-color: var(--hero-primary);
    border-width: 1px;
    /* background-color cleared -- per-hero gradient applied by CharSelectVisualEnhancer */
    background-color: rgba(0, 0, 0, 0);
}

.hero-card-initial {
    -unity-font-definition: url('project://database/Assets/UI/Fonts/CinzelDecorative-Bold.ttf?fileID=12800000&guid=a571f12f2cfa23b44875b20ecbd843c4&type=3');
    font-size: 30px;
    -unity-font-style: bold;
    color: var(--hero-primary);
    opacity: 0.2;
    margin-bottom: 0;
    -unity-text-align: middle-center;
    transition-property: opacity, color;
    transition-duration: 0.3s, 0.3s;
}

.hero-card.selected .hero-card-initial {
    opacity: 0.75;
}

.hero-card:hover .hero-card-initial {
    opacity: 0.45;
}

.hero-card-name {
    -unity-font-definition: url('project://database/Assets/UI/Fonts/CinzelDecorative-Regular.ttf?fileID=12800000&guid=d13ae79c9243c964db9245ce6c976d4a&type=3');
    font-size: 8px;
    color: var(--text-secondary);
    letter-spacing: 1px;
    -unity-font-style: bold;
    opacity: 0.5;
    margin-top: 4px;
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    transition-property: opacity, color;
    transition-duration: 0.3s, 0.3s;
}

.hero-card.selected .hero-card-name {
    opacity: 0.85;
}

.hero-card-role {
    font-size: 9px;
    color: var(--text-muted);
    letter-spacing: 1px;
    margin-top: 3px;
    white-space: nowrap;
}

/* Selection dot below active card */
.hero-card-dot {
    position: absolute;
    bottom: -4px;
    left: 50%;
    translate: -50% 0;
    width: 6px;
    height: 6px;
    border-radius: 3px;
    background-color: var(--hero-primary);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.3s;
}

.hero-card.selected .hero-card-dot {
    opacity: 1;
}

.hero-card.teaser {
    border-color: rgba(60, 50, 70, 0.15);
    opacity: 0.2;
}

.hero-card.teaser:hover {
    opacity: 0.35;
    scale: 1.03;
}

/* =============================================================================
   MISC UI
   ============================================================================= */

.btn-back {
    position: absolute;
    top: 10px;
    left: 12px;
    padding: 5px 12px;
    background-color: rgba(10, 8, 16, 0.4);
    border-width: 1px;
    border-color: rgba(80, 65, 100, 0.15);
    border-radius: 3px;
    color: rgba(200, 190, 220, 0.55);
    font-size: 12px;
    letter-spacing: 3px;
    z-index: 30;
    transition-property: color, border-color, background-color;
    transition-duration: 0.2s, 0.2s, 0.2s;
}

.btn-back:hover {
    color: var(--text-primary);
    border-color: var(--border-accent);
    background-color: rgba(16, 12, 24, 0.9);
}

.hero-index {
    position: absolute;
    top: 12px;
    left: 50%;
    translate: -50% 0;
    font-size: 11px;
    color: rgba(200, 190, 220, 0.50);
    letter-spacing: 5px;
    z-index: 30;
}

/* =============================================================================
   TOAST NOTIFICATION
   ============================================================================= */

.toast-container {
    position: absolute;
    bottom: -100px;
    left: 50%;
    translate: -50% 0;
    width: 420px;
    z-index: 200;
    transition-property: translate;
    transition-duration: 0.4s;
    transition-timing-function: ease-out;
}

.toast-container.toast-visible {
    translate: -50% -120px;
}

.toast-container.toast-hidden {
    translate: -50% 0;
}

.toast-content {
    flex-direction: row;
    background-color: rgba(40, 12, 12, 0.95);
    border-width: 1px;
    border-color: rgba(200, 60, 60, 0.5);
    border-radius: 8px;
    padding: 14px 18px;
    align-items: center;
}

.toast-icon {
    width: 20px;
    height: 20px;
    margin-right: 12px;
    background-color: rgba(200, 60, 60, 0.7);
    border-radius: 10px;
    flex-shrink: 0;
}

.toast-message {
    color: rgba(240, 200, 200, 0.9);
    font-size: 13px;
    flex-grow: 1;
    white-space: normal;
}

.toast-actions {
    flex-direction: row;
    padding-top: 10px;
    justify-content: flex-end;
}

.toast-btn {
    background-color: rgba(60, 16, 16, 0.85);
    color: rgba(240, 200, 200, 0.9);
    border-width: 1px;
    border-color: rgba(200, 60, 60, 0.35);
    border-radius: 6px;
    padding: 8px 16px;
    margin-left: 8px;
    font-size: 12px;
    letter-spacing: 1px;
    transition-property: background-color, border-color;
    transition-duration: var(--transition-fast), var(--transition-fast);
}

.toast-btn:hover {
    background-color: rgba(80, 24, 24, 0.95);
    border-color: rgba(200, 60, 60, 0.6);
}

/* =============================================================================
   SKELETON SHIMMER (Loading State)
   ============================================================================= */

.skeleton-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(8, 6, 14, 0.85);
    z-index: 150;
}

/* When hidden, ensure it doesn't block input */
.skeleton-overlay.hidden {
    display: none;
}

.skeleton-shimmer {
    background-color: rgba(40, 35, 55, 0.5);
    border-radius: 6px;
    min-height: 16px;
    margin: 4px 0;
    overflow: hidden;
}

.shimmer-bar {
    position: absolute;
    width: 60px;
    height: 100%;
    background-color: rgba(255, 255, 255, 0.04);
    rotate: 15deg;
    translate: -60px 0;
    transition-property: translate;
    transition-duration: 1.2s;
    transition-timing-function: ease-in-out;
}

.shimmer-bar.shimmer-active {
    translate: 400px 0;
}

/* =============================================================================
   PANEL TRANSITION CLASSES
   ============================================================================= */

.panel-hidden {
    opacity: 0;
    translate: -20px 0;
}

/* =============================================================================
   CINEMATIC OVERLAY SYSTEM
   Subtle post-process layers for atmospheric depth
   ============================================================================= */

.cinematic-overlays {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 90;
}

/* Scanline overlay: subtle horizontal stripe pattern */
.overlay-scanlines {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.015);
    opacity: 0.3;
}

/* Vignette: darken edges for cinematic focus */
.overlay-vignette {
    position: absolute;
    width: 100%;
    height: 100%;
    border-width: 100px;
    border-color: rgba(0, 0, 0, 0.3);
}

/* Veil glow: hero-tinted ambient haze */
.overlay-veil-glow {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: var(--hero-dim, rgba(40, 20, 60, 0.02));
    opacity: 0.12;
    transition-property: background-color;
    transition-duration: 1.2s;
    transition-timing-function: ease-in-out;
}

/* =============================================================================
   VISUAL DEPTH HIERARCHY
   Inactive panels are dimmed for visual depth
   ============================================================================= */

.panel-inactive-dim {
    opacity: 0.6;
    transition-property: opacity;
    transition-duration: 0.3s;
    transition-timing-function: ease-in-out;
}

/* (Mana stat chip styles consolidated above with other per-stat colors) */
