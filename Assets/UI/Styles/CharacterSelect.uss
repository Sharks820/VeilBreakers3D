/* =============================================================================
   CHARACTER SELECT - MASTER STYLESHEET
   VeilBreakers 3D - "The Veil Tear Showcase"
   Dark gothic fantasy with luminous accents and glass-panel aesthetic
   ============================================================================= */

/* =============================================================================
   CSS VARIABLES / THEME SYSTEM
   Per-hero theme classes set on root. USS transitions handle crossfade.
   ============================================================================= */

.theme-vex {
    --hero-primary: rgb(200, 60, 60);
    --hero-secondary: rgb(255, 100, 80);
    --hero-accent: rgb(255, 180, 120);
    --hero-glow: rgba(200, 60, 60, 0.25);
    --hero-glow-strong: rgba(255, 100, 80, 0.4);
}

.theme-seraphina {
    --hero-primary: rgb(60, 180, 60);
    --hero-secondary: rgb(120, 80, 200);
    --hero-accent: rgb(220, 200, 60);
    --hero-glow: rgba(60, 180, 60, 0.25);
    --hero-glow-strong: rgba(120, 80, 200, 0.4);
}

.theme-orion {
    --hero-primary: rgb(60, 60, 200);
    --hero-secondary: rgb(80, 120, 255);
    --hero-accent: rgb(60, 220, 255);
    --hero-glow: rgba(60, 60, 200, 0.25);
    --hero-glow-strong: rgba(80, 120, 255, 0.4);
}

.theme-nyx {
    --hero-primary: rgb(200, 50, 80);
    --hero-secondary: rgb(180, 60, 180);
    --hero-accent: rgb(220, 130, 255);
    --hero-glow: rgba(200, 50, 80, 0.25);
    --hero-glow-strong: rgba(180, 60, 180, 0.4);
}

/* =============================================================================
   ROOT / LAYOUT
   UIDocument wraps UXML content in a TemplateContainer — it must grow to
   fill the panel, otherwise percentage-based sizing on children resolves to 0.
   ============================================================================= */

TemplateContainer {
    flex-grow: 1;
}

.character-select-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-direction: column;
    overflow: hidden;
}

/* =============================================================================
   BACKGROUND LAYER - atmospheric depth
   ============================================================================= */

.background-layer {
    position: absolute;
    width: 100%;
    height: 100%;
}

.background-gradient {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgb(4, 4, 8);
}

.background-vignette {
    position: absolute;
    width: 100%;
    height: 100%;
    opacity: 0.5;
    border-width: 0;
    border-color: rgba(0, 0, 0, 0);
    /* Dark vignette edges */
    background-color: rgba(0, 0, 0, 0);
}

.background-particles {
    position: absolute;
    width: 100%;
    height: 100%;
    /* Subtle hero-colored atmospheric tint */
    background-color: var(--hero-glow, rgba(40, 20, 60, 0.08));
    transition-property: background-color;
    transition-duration: 1.2s;
    transition-timing-function: ease-out;
}

/* =============================================================================
   CONTENT LAYER
   ============================================================================= */

.content-layer {
    flex-grow: 1;
    flex-direction: row;
    padding: 12px 24px 4px 24px;
}

/* =============================================================================
   GLASS PANEL BASE - refined glass-morphism with hero-colored glow
   ============================================================================= */

.glass-panel {
    background-color: rgba(8, 8, 14, 0.92);
    border-width: 1px;
    border-color: var(--hero-accent, rgba(120, 120, 140, 0.3));
    border-radius: 6px;
    transition-property: border-color;
    transition-duration: 0.6s;
    transition-timing-function: ease-out;
}

/* =============================================================================
   LEFT PANEL: HERO INFO
   ============================================================================= */

.hero-info-panel {
    width: 17%;
    min-width: 170px;
    max-width: 240px;
    padding: 14px 12px;
    flex-direction: column;
    translate: 0 0;
    opacity: 1;
    transition-property: translate, opacity, border-color;
    transition-duration: 0.4s, 0.3s, 0.6s;
    transition-timing-function: ease-out;
    border-top-width: 2px;
    border-top-color: var(--hero-primary, rgba(120, 120, 140, 0.3));
}

.hero-info-panel.panel-hidden {
    translate: -40px 0;
    opacity: 0;
}

/* --- Hero Identity --- */

.hero-name {
    font-size: 24px;
    color: rgb(240, 240, 245);
    -unity-font-style: bold;
    letter-spacing: 4px;
    margin-bottom: 2px;
    border-bottom-width: 2px;
    border-bottom-color: var(--hero-primary, rgba(120, 120, 140, 0.4));
    padding-bottom: 3px;
    transition-property: border-bottom-color;
    transition-duration: 0.6s;
}

.hero-title {
    font-size: 12px;
    color: var(--hero-accent, rgb(200, 200, 215));
    letter-spacing: 3px;
    margin-bottom: 10px;
    transition-property: color;
    transition-duration: 0.6s;
}

.hero-quote {
    font-size: 10px;
    color: rgba(200, 200, 215, 0.65);
    -unity-font-style: italic;
    margin-bottom: 10px;
    white-space: normal;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(80, 80, 100, 0.2);
}

/* --- Class Info Rows --- */

.hero-class-info {
    margin-bottom: 10px;
}

.info-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
    padding: 3px 0;
}

.info-label {
    font-size: 9px;
    color: rgba(160, 160, 180, 0.75);
    letter-spacing: 3px;
}

.info-value {
    font-size: 12px;
    color: var(--hero-accent, rgb(220, 220, 235));
    -unity-font-style: bold;
    letter-spacing: 1px;
    flex-shrink: 1;
    white-space: normal;
}

/* --- Starter Stats 2x2 Grid --- */

.starter-stats-grid {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 10px;
}

.stat-chip {
    width: 48%;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 5px 8px;
    margin: 1%;
    background-color: rgba(20, 20, 32, 0.7);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(60, 60, 80, 0.25);
    border-left-width: 2px;
    border-left-color: var(--hero-primary, rgba(100, 100, 120, 0.3));
    transition-property: border-left-color;
    transition-duration: 0.6s;
}

.stat-chip-label {
    font-size: 9px;
    color: rgba(170, 170, 190, 0.8);
    letter-spacing: 2px;
}

.stat-chip-value {
    font-size: 14px;
    color: rgb(220, 220, 230);
    -unity-font-style: bold;
}

/* --- Champion Monster --- */

.champion-section {
    padding-top: 10px;
    border-top-width: 1px;
    border-top-color: rgba(80, 80, 100, 0.2);
}

.section-header {
    font-size: 9px;
    color: rgba(170, 170, 190, 0.7);
    letter-spacing: 4px;
    margin-bottom: 8px;
}

.champion-name {
    font-size: 14px;
    color: var(--hero-accent, rgb(230, 230, 240));
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.champion-tags {
    flex-direction: row;
}

.tag {
    font-size: 9px;
    color: var(--hero-accent, rgba(200, 200, 210, 0.8));
    background-color: rgba(30, 30, 48, 0.9);
    padding: 3px 10px;
    margin-right: 6px;
    border-radius: 3px;
    letter-spacing: 1px;
    border-width: 1px;
    border-color: rgba(60, 60, 80, 0.3);
    transition-property: color;
    transition-duration: 0.6s;
}

/* =============================================================================
   CENTER: HERO STAGE
   ============================================================================= */

.hero-stage {
    flex-grow: 1;
    margin: 0 12px;
    align-items: center;
    justify-content: flex-start;
    padding-top: 10px;
    padding-bottom: 0;
}

.hero-render-target {
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-to-fit;
}

.drag-hint {
    position: absolute;
    bottom: 12px;
    left: 0;
    right: 0;
    -unity-text-align: middle-center;
    font-size: 9px;
    color: rgba(140, 140, 155, 0.25);
    letter-spacing: 3px;
}

/* =============================================================================
   RIGHT PANEL: STATS & ABILITIES
   ============================================================================= */

.stats-panel {
    width: 17%;
    min-width: 170px;
    max-width: 230px;
    padding: 14px 12px;
    flex-direction: column;
    translate: 0 0;
    opacity: 1;
    transition-property: translate, opacity, border-color;
    transition-duration: 0.4s, 0.3s, 0.6s;
    transition-timing-function: ease-out;
    border-top-width: 2px;
    border-top-color: var(--hero-primary, rgba(120, 120, 140, 0.3));
}

.stats-panel.panel-hidden {
    translate: 40px 0;
    opacity: 0;
}

/* --- Attribute Bars --- */

.attribute-bars {
    margin-bottom: 14px;
}

.stat-bar-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 7px;
}

.stat-bar-label {
    width: 34px;
    font-size: 9px;
    color: rgba(170, 170, 190, 0.8);
    letter-spacing: 3px;
}

.stat-bar-track {
    flex-grow: 1;
    height: 10px;
    background-color: rgba(20, 20, 32, 0.9);
    border-radius: 5px;
    margin: 0 8px;
    overflow: hidden;
    border-width: 1px;
    border-color: rgba(40, 40, 60, 0.4);
}

.stat-bar-fill {
    height: 100%;
    width: 50%;
    background-color: var(--hero-primary, rgb(100, 100, 120));
    border-radius: 5px;
    scale: 1 1;
    transform-origin: left center;
    transition-property: width, background-color;
    transition-duration: 0.6s;
    transition-timing-function: ease-out-cubic;
}

.stat-bar-value {
    width: 26px;
    font-size: 12px;
    color: rgb(225, 225, 240);
    -unity-text-align: middle-right;
    -unity-font-style: bold;
}

/* --- Abilities --- */

.abilities-header {
    margin-top: 8px;
    padding-top: 14px;
    border-top-width: 1px;
    border-top-color: rgba(80, 80, 100, 0.15);
}

.abilities-list {
    flex-direction: column;
}

.ability-slot {
    font-size: 11px;
    color: rgba(200, 200, 215, 0.85);
    padding: 5px 8px;
    margin-bottom: 3px;
    background-color: rgba(20, 20, 32, 0.5);
    border-radius: 3px;
    border-left-width: 3px;
    border-left-color: var(--hero-primary, rgba(100, 100, 120, 0.5));
    transition-property: border-left-color, background-color;
    transition-duration: 0.6s;
}

.ability-slot:hover {
    background-color: rgba(30, 30, 48, 0.7);
}

/* =============================================================================
   BOTTOM LAYER: CAROUSEL + NAVIGATION
   ============================================================================= */

.bottom-layer {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding: 4px 24px;
    height: 100px;
    margin-bottom: 8px;
}

.nav-arrow {
    width: 44px;
    height: 44px;
    font-size: 22px;
    color: rgba(180, 180, 200, 0.5);
    background-color: rgba(14, 14, 22, 0.7);
    border-width: 1px;
    border-color: rgba(60, 60, 80, 0.3);
    border-radius: 22px;
    -unity-text-align: middle-center;
    transition-property: color, border-color, background-color;
    transition-duration: 0.2s;
}

.nav-arrow:hover {
    color: rgb(255, 255, 255);
    border-color: var(--hero-accent, rgba(160, 160, 180, 0.6));
    background-color: rgba(30, 30, 48, 0.9);
}

.carousel-container {
    margin: 0 16px;
}

.carousel-strip {
    flex-direction: row;
    align-items: center;
}

/* --- Hero Cards --- */

.hero-card {
    width: 76px;
    height: 88px;
    margin: 0 5px;
    padding: 4px 0 5px 0;
    flex-direction: column;
    background-color: rgba(14, 14, 22, 0.8);
    border-width: 2px;
    border-color: rgba(50, 50, 70, 0.35);
    border-radius: 5px;
    align-items: center;
    justify-content: center;
    scale: 1;
    opacity: 0.6;
    cursor: initial;
    transition-property: scale, opacity, border-color, background-color;
    transition-duration: 0.3s;
    transition-timing-function: ease-out;
}

.hero-card:hover {
    opacity: 0.85;
    border-color: rgba(120, 120, 145, 0.5);
    background-color: rgba(20, 20, 32, 0.9);
}

.hero-card:active {
    scale: 0.95 0.95;
    opacity: 1;
    background-color: rgba(30, 30, 48, 0.95);
}

.hero-card.selected {
    scale: 1.15 1.15;
    opacity: 1;
    border-color: var(--hero-primary, rgb(200, 200, 220));
    background-color: rgba(20, 20, 35, 0.95);
    border-width: 2px;
}

.hero-card-name {
    font-size: 10px;
    color: rgba(200, 200, 215, 0.8);
    -unity-font-style: normal;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
}

.hero-card.selected .hero-card-name {
    color: var(--hero-accent, rgb(220, 220, 230));
}

.hero-card.teaser {
    opacity: 0.25;
    border-color: rgba(40, 40, 55, 0.3);
}

.hero-card.teaser .hero-card-name {
    font-size: 8px;
    color: rgba(140, 140, 155, 0.4);
}

/* --- Hero Card Initial Letter --- */

.hero-card-initial {
    font-size: 24px;
    -unity-font-style: bold;
    color: rgba(180, 180, 200, 0.35);
    margin-bottom: -2px;
    transition-property: color;
    transition-duration: 0.3s;
}

.hero-card.selected .hero-card-initial {
    color: var(--hero-primary, rgb(200, 200, 220));
}

/* --- Hero Card Role Tag --- */

.hero-card-role {
    font-size: 7px;
    color: rgba(140, 140, 160, 0.5);
    letter-spacing: 1px;
    margin-top: 2px;
}

.hero-card.selected .hero-card-role {
    color: rgba(200, 200, 220, 0.7);
}

/* --- Per-Hero Card Colors (border accent on selected) --- */

.hero-card-vex.selected {
    border-color: rgb(200, 60, 60);
}

.hero-card-seraphina.selected {
    border-color: rgb(60, 180, 60);
}

.hero-card-orion.selected {
    border-color: rgb(60, 60, 200);
}

.hero-card-nyx.selected {
    border-color: rgb(200, 50, 80);
}

.hero-index {
    position: absolute;
    right: 80px;
    font-size: 10px;
    color: rgba(140, 140, 155, 0.4);
    letter-spacing: 3px;
}

/* =============================================================================
   EMBARK LAYER - dramatic CTA
   ============================================================================= */

.embark-layer {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding: 4px 24px 12px 24px;
    height: 64px;
}

.btn-back {
    position: absolute;
    left: 28px;
    font-size: 12px;
    color: rgba(160, 160, 175, 0.5);
    background-color: transparent;
    border-width: 0;
    letter-spacing: 2px;
    transition-property: color;
    transition-duration: 0.2s;
}

.btn-back:hover {
    color: rgb(255, 255, 255);
}

.btn-embark {
    width: 300px;
    height: 50px;
    background-color: rgba(14, 14, 22, 0.9);
    border-width: 2px;
    border-color: var(--hero-primary, rgba(120, 120, 140, 0.4));
    border-radius: 5px;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    transition-property: border-color, background-color;
    transition-duration: 0.3s;
}

.btn-embark:hover {
    border-color: var(--hero-accent, rgba(200, 200, 220, 0.8));
    background-color: rgba(20, 20, 32, 0.95);
}

.embark-glow {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: var(--hero-primary, rgba(255, 200, 100, 0.05));
    opacity: 0;
    transition-property: opacity, background-color;
    transition-duration: 0.6s;
}

.embark-glow.breathing {
    opacity: 0.12;
}

.embark-text {
    font-size: 16px;
    color: var(--hero-accent, rgb(220, 220, 230));
    -unity-font-style: bold;
    letter-spacing: 4px;
    transition-property: color;
    transition-duration: 0.6s;
}

.embark-subtitle {
    font-size: 9px;
    color: rgba(160, 160, 175, 0.4);
    letter-spacing: 2px;
    margin-top: 2px;
}

/* =============================================================================
   CONFIRM POPUP
   ============================================================================= */

.confirm-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
}

.confirm-overlay.hidden {
    display: none;
}

.confirm-dim {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.55);
}

.confirm-popup {
    width: 440px;
    padding: 36px;
    align-items: center;
    background-color: rgba(8, 8, 14, 0.96);
    border-color: var(--hero-accent, rgba(160, 160, 180, 0.4));
    border-width: 1px;
    border-radius: 8px;
    border-top-width: 2px;
    border-top-color: var(--hero-primary, rgba(120, 120, 140, 0.4));
}

.confirm-title {
    font-size: 16px;
    color: rgb(220, 220, 230);
    -unity-font-style: bold;
    letter-spacing: 4px;
    margin-bottom: 16px;
}

.confirm-description {
    font-size: 13px;
    color: rgba(200, 200, 215, 0.75);
    -unity-text-align: middle-center;
    margin-bottom: 28px;
    white-space: normal;
}

.confirm-buttons {
    flex-direction: row;
    justify-content: center;
    width: 100%;
}

.btn-confirm {
    width: 150px;
    height: 42px;
    font-size: 14px;
    color: rgb(220, 220, 230);
    background-color: var(--hero-primary, rgba(60, 120, 200, 0.6));
    border-width: 1px;
    border-color: var(--hero-accent, rgba(100, 160, 255, 0.4));
    border-radius: 5px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    margin-right: 7px;
    margin-left: 7px;
    transition-property: background-color;
    transition-duration: 0.2s;
}

.btn-confirm:hover {
    background-color: var(--hero-primary, rgba(80, 140, 220, 0.8));
}

.btn-cancel {
    width: 150px;
    height: 42px;
    font-size: 14px;
    color: rgba(180, 180, 195, 0.7);
    background-color: rgba(30, 30, 42, 0.6);
    border-width: 1px;
    border-color: rgba(60, 60, 80, 0.3);
    border-radius: 5px;
    letter-spacing: 2px;
    margin-left: 7px;
    margin-right: 7px;
    transition-property: color, background-color;
    transition-duration: 0.2s;
}

.btn-cancel:hover {
    color: rgb(220, 220, 230);
    background-color: rgba(50, 50, 65, 0.8);
}

/* =============================================================================
   UTILITY CLASSES
   ============================================================================= */

.hidden {
    display: none;
}

.panel-entering-left {
    translate: -40px 0;
    opacity: 0;
}

.panel-entering-right {
    translate: 40px 0;
    opacity: 0;
}
