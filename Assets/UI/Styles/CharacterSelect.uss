/* =============================================================================
   VEILBREAKERS 3D - CHARACTER SELECT SCREEN
   BG3-inspired cinematic hero selection
   ============================================================================= */

@import url("VeilBreakersTheme.uss");

/* =============================================================================
   VARIABLES
   ============================================================================= */

:root {
    --cs-transition-fast: 0.2s;
    --cs-transition-normal: 0.4s;
    --cs-transition-slow: 0.8s;
    --cs-ease-out-expo: cubic-bezier(0.16, 1, 0.3, 1);
    --cs-ease-out-back: cubic-bezier(0.34, 1.56, 0.64, 1);
    --cs-ease-in-out: cubic-bezier(0.86, 0, 0.07, 1);
    --cs-glass-bg: rgba(12, 10, 18, 0.78);
    --cs-glass-border: rgba(255, 255, 255, 0.08);
}

/* =============================================================================
   HIDDEN STATE
   ============================================================================= */

.hidden {
    opacity: 0;
    display: none;
}

/* =============================================================================
   ENVIRONMENT BACKGROUND
   ============================================================================= */

.environment-container {
    position: absolute;
    width: 100%;
    height: 100%;
}

.env-layer {
    position: absolute;
    width: 100%;
    height: 100%;
}

.env-layer-base {
    background-color: rgb(8, 5, 12);
}

.env-layer-color {
    opacity: 1;
    transition: background-color var(--cs-transition-slow) var(--cs-ease-out-expo);
}

.env-vignette {
    background: radial-gradient(ellipse at 50% 50%,
        transparent 0%,
        transparent 45%,
        rgba(0, 0, 0, 0.5) 80%,
        rgba(0, 0, 0, 0.8) 100%);
    pointer-events: none;
}

/* =============================================================================
   HERO STAGE (3D RenderTexture)
   ============================================================================= */

.hero-stage {
    position: absolute;
    width: 50%;
    height: 70%;
    top: 5%;
    left: 25%;
    z-index: 10;
    align-items: center;
    justify-content: center;
}

.hero-stage-render {
    width: 100%;
    height: 100%;
    background-color: transparent;
}

/* =============================================================================
   VFX OVERLAY
   ============================================================================= */

.vfx-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    z-index: 15;
    pointer-events: none;
}

/* =============================================================================
   VEIL TEAR TRANSITION
   ============================================================================= */

.veil-tear-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    z-index: 90;
    pointer-events: none;
}

.veil-tear-flash {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgb(0, 0, 0);
    opacity: 0;
    transition: opacity 0.15s linear;
}

.veil-tear-flash.active {
    opacity: 0.85;
}

.veil-tear-crack {
    position: absolute;
    width: 4px;
    height: 0%;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    opacity: 0;
    transition: height 0.3s var(--cs-ease-out-expo),
                opacity 0.15s linear;
}

.veil-tear-crack.active {
    height: 100%;
    opacity: 1;
}

/* =============================================================================
   LEFT INFO PANEL
   ============================================================================= */

.info-panel {
    position: absolute;
    width: 300px;
    top: 80px;
    left: 40px;
    padding: 24px;
    z-index: 20;
    opacity: 0;
    translate: -20px 0;
    transition: opacity var(--cs-transition-normal) var(--cs-ease-out-expo),
                translate var(--cs-transition-normal) var(--cs-ease-out-expo);
}

.info-panel.visible {
    opacity: 1;
    translate: 0 0;
}

.glass-panel {
    background-color: var(--cs-glass-bg);
    border-width: 1px;
    border-color: var(--cs-glass-border);
    border-radius: 8px;
}

.hero-name {
    font-size: 42px;
    -unity-font-style: bold;
    letter-spacing: 8px;
    margin-bottom: 4px;
    transition: color var(--cs-transition-normal) var(--cs-ease-out-expo);
}

.hero-title {
    font-size: 14px;
    color: rgba(200, 190, 180, 0.7);
    letter-spacing: 6px;
    margin-bottom: 16px;
}

.hero-quote {
    font-size: 13px;
    font-style: italic;
    color: rgba(200, 190, 180, 0.6);
    margin-bottom: 20px;
    opacity: 0;
    transition: opacity var(--cs-transition-slow) var(--cs-ease-out-expo);
}

.hero-quote.visible {
    opacity: 1;
}

.hero-details {
    margin-bottom: 20px;
    padding-top: 16px;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.06);
}

.detail-row {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 8px;
}

.detail-label {
    font-size: 10px;
    color: rgba(180, 170, 160, 0.5);
    letter-spacing: 3px;
}

.detail-value {
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.section-label {
    font-size: 10px;
    color: rgba(180, 170, 160, 0.5);
    letter-spacing: 4px;
    margin-bottom: 10px;
}

/* Monster Info */
.monster-info {
    padding-top: 16px;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.06);
}

.monster-card {
    flex-direction: row;
    align-items: center;
    padding: 10px 12px;
    background-color: rgba(255, 255, 255, 0.03);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.04);
}

.monster-thumbnail {
    width: 44px;
    height: 44px;
    margin-right: 12px;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    border-radius: 4px;
    background-color: rgba(0, 0, 0, 0.3);
}

.monster-text {
    flex-grow: 1;
}

.monster-name {
    font-size: 13px;
    -unity-font-style: bold;
    margin-bottom: 2px;
}

.monster-brand {
    font-size: 10px;
    color: rgba(180, 170, 160, 0.5);
    letter-spacing: 2px;
}

/* =============================================================================
   RIGHT STATS PANEL
   ============================================================================= */

.stats-panel {
    position: absolute;
    width: 280px;
    top: 80px;
    right: 40px;
    padding: 24px;
    z-index: 20;
    opacity: 0;
    translate: 20px 0;
    transition: opacity var(--cs-transition-normal) var(--cs-ease-out-expo),
                translate var(--cs-transition-normal) var(--cs-ease-out-expo);
    display: none;
}

.stats-panel.visible {
    opacity: 1;
    translate: 0 0;
    display: flex;
}

.stats-panel.hidden {
    opacity: 0;
    translate: 20px 0;
    display: none;
}

.stat-bars {
    margin-bottom: 20px;
}

.stat-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
}

.stat-label {
    width: 36px;
    font-size: 10px;
    color: rgba(180, 170, 160, 0.6);
    letter-spacing: 2px;
}

.stat-bar-track {
    flex-grow: 1;
    height: 6px;
    background-color: rgba(255, 255, 255, 0.05);
    border-radius: 3px;
    overflow: hidden;
    margin: 0 10px;
}

.stat-bar-fill {
    height: 100%;
    width: 0%;
    border-radius: 3px;
    transition: width 0.8s var(--cs-ease-out-back);
}

.stat-value {
    width: 24px;
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
}

/* Abilities */
.ability-list {
    padding-top: 12px;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.06);
}

.ability-row {
    padding: 8px 10px;
    margin-bottom: 6px;
    background-color: rgba(255, 255, 255, 0.02);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.04);
    transition: border-color var(--cs-transition-fast) var(--cs-ease-out-expo);
}

.ability-row:hover {
    border-color: rgba(255, 255, 255, 0.15);
}

.ability-name {
    font-size: 12px;
    -unity-font-style: bold;
    margin-bottom: 2px;
}

.ability-desc {
    font-size: 10px;
    color: rgba(180, 170, 160, 0.5);
}

/* =============================================================================
   CAROUSEL STRIP
   ============================================================================= */

.carousel-strip {
    position: absolute;
    width: 100%;
    height: 160px;
    bottom: 30px;
    z-index: 30;
    align-items: center;
    justify-content: center;
}

.carousel-track {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    gap: 16px;
}

.carousel-slot {
    width: 120px;
    height: 150px;
    background-color: rgba(15, 12, 20, 0.85);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    overflow: hidden;
    align-items: center;
    justify-content: flex-end;
    padding-bottom: 10px;
    cursor: pointer;
    transition: all var(--cs-transition-normal) var(--cs-ease-out-back);
    position: relative;
}

.carousel-slot:hover {
    border-color: rgba(255, 255, 255, 0.25);
    scale: 1.06;
}

.carousel-slot.selected {
    scale: 1.12;
    border-width: 2px;
}

.slot-portrait {
    position: absolute;
    width: 100%;
    height: 70%;
    top: 0;
    background-size: cover;
    background-position: center top;
    opacity: 0.6;
    transition: opacity var(--cs-transition-normal) var(--cs-ease-out-expo);
}

.carousel-slot.selected .slot-portrait {
    opacity: 1;
}

.slot-glow {
    position: absolute;
    width: 100%;
    height: 100%;
    background: none;
    transition: all var(--cs-transition-normal) var(--cs-ease-out-expo);
}

.carousel-slot.selected .slot-glow {
    background: radial-gradient(ellipse at 50% 30%,
        rgba(200, 200, 220, 0.15) 0%,
        transparent 70%);
}

.slot-name {
    font-size: 11px;
    -unity-font-style: bold;
    color: rgba(200, 190, 180, 0.5);
    letter-spacing: 2px;
    z-index: 1;
    transition: color var(--cs-transition-normal) var(--cs-ease-out-expo);
}

.carousel-slot.selected .slot-name {
    color: rgba(235, 225, 215, 1);
}

/* Teaser slot */
.carousel-slot.teaser {
    background-color: rgba(10, 8, 15, 0.7);
    border-style: dashed;
    cursor: default;
    justify-content: center;
}

.carousel-slot.teaser:hover {
    scale: 1;
    border-color: rgba(255, 255, 255, 0.12);
}

.slot-teaser-mark {
    font-size: 36px;
    color: rgba(200, 190, 180, 0.2);
    -unity-text-align: middle-center;
}

.teaser-name {
    color: rgba(200, 190, 180, 0.25);
    font-size: 9px;
}

/* =============================================================================
   EMBARK BUTTON
   ============================================================================= */

.embark-btn {
    position: absolute;
    width: 300px;
    height: 64px;
    bottom: 210px;
    left: 50%;
    translate: -50% 0;
    z-index: 25;
    background-color: transparent;
    border-width: 0;
    overflow: visible;
    cursor: pointer;
    align-items: center;
    justify-content: center;
}

.embark-glow {
    position: absolute;
    width: 100%;
    height: 100%;
    background: linear-gradient(180deg,
        rgba(25, 22, 35, 0.95) 0%,
        rgba(12, 10, 18, 0.98) 100%);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.12);
    border-radius: 6px;
    transition: all var(--cs-transition-fast) var(--cs-ease-out-expo);
}

.embark-btn:hover .embark-glow {
    border-color: rgba(255, 255, 255, 0.3);
}

.embark-label {
    font-size: 16px;
    -unity-font-style: bold;
    letter-spacing: 4px;
    z-index: 1;
    transition: color var(--cs-transition-fast) var(--cs-ease-out-expo);
}

.embark-sub {
    font-size: 9px;
    color: rgba(200, 190, 180, 0.4);
    letter-spacing: 2px;
    z-index: 1;
}

/* =============================================================================
   NAVIGATION BUTTONS
   ============================================================================= */

.nav-btn {
    position: absolute;
    z-index: 40;
    background-color: rgba(15, 12, 20, 0.75);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 4px;
    flex-direction: row;
    align-items: center;
    padding: 8px 16px;
    cursor: pointer;
    transition: all var(--cs-transition-fast) var(--cs-ease-out-expo);
}

.nav-btn:hover {
    background-color: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.2);
}

.back-btn {
    top: 36px;
    left: 40px;
}

.neutral-btn {
    top: 36px;
    right: 40px;
}

.back-arrow {
    width: 10px;
    height: 10px;
    margin-right: 8px;
    background-color: transparent;
    border-top-width: 2px;
    border-left-width: 2px;
    border-bottom-width: 0;
    border-right-width: 0;
    border-color: rgba(255, 255, 255, 0.6);
    rotate: -45deg;
}

.nav-label {
    font-size: 11px;
    color: rgba(200, 190, 180, 0.6);
    letter-spacing: 2px;
}

/* =============================================================================
   SCREEN FADE
   ============================================================================= */

.screen-fade {
    position: absolute;
    width: 100%;
    height: 100%;
    z-index: 100;
    background-color: rgb(0, 0, 0);
    opacity: 0;
    transition: opacity 0.8s var(--cs-ease-in-out);
    pointer-events: none;
}

.screen-fade.active {
    opacity: 1;
}

/* =============================================================================
   RESPONSIVE
   ============================================================================= */

@media (min-aspect-ratio: 2.0) {
    .hero-stage {
        width: 45%;
        left: 27.5%;
    }

    .info-panel {
        width: 320px;
    }

    .stats-panel {
        width: 300px;
    }
}

@media (max-aspect-ratio: 1.7) {
    .hero-stage {
        height: 60%;
    }

    .hero-name {
        font-size: 36px;
    }

    .embark-btn {
        bottom: 190px;
    }
}

/* =============================================================================
   REDUCED MOTION (Accessibility)
   ============================================================================= */

@media (prefers-reduced-motion: reduce) {
    .stat-bar-fill {
        transition: none;
    }

    .carousel-slot,
    .embark-btn,
    .nav-btn,
    .info-panel,
    .stats-panel {
        transition: opacity var(--cs-transition-fast);
    }
}

/* =============================================================================
   HIGH CONTRAST (Accessibility)
   ============================================================================= */

@media (prefers-contrast: high) {
    .glass-panel {
        background-color: rgba(0, 0, 0, 0.92);
        border-color: rgba(255, 255, 255, 0.4);
    }

    .carousel-slot {
        border-color: rgba(255, 255, 255, 0.3);
    }

    .carousel-slot.selected {
        border-width: 3px;
    }
}
