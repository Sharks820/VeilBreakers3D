/* =============================================================================
   VEILBREAKERS 3D - AAA MASTER CHARACTER SELECT STYLESHEET
   Cinematic, atmospheric, immersive hero selection experience
   ============================================================================= */

/* Import theme variables */
@import url("VeilBreakersTheme.uss");

/* =============================================================================
   CORE VARIABLES - Character Select Specific
   ============================================================================= */

:root {
    /* Transition Timing */
    --transition-fast: 0.2s;
    --transition-normal: 0.4s;
    --transition-slow: 0.8s;
    --transition-hero-switch: 1.2s;
    
    /* Easing Functions */
    --ease-out-expo: cubic-bezier(0.16, 1, 0.3, 1);
    --ease-out-back: cubic-bezier(0.34, 1.56, 0.64, 1);
    --ease-in-out-quint: cubic-bezier(0.86, 0, 0.07, 1);
    
    /* Spacing */
    --panel-margin: 40px;
    --card-gap: 20px;
    
    /* Glass Effect */
    --glass-bg: rgba(8, 8, 14, 0.92);
    --glass-border: rgba(255, 255, 255, 0.1);
    --glass-blur: 12px;
    
    /* Glow Effects */
    --glow-primary: 0 0 20px var(--hero-primary);
    --glow-secondary: 0 0 40px var(--hero-secondary);
    --glow-text: 0 0 20px rgba(235, 225, 215, 0.8);
}

/* =============================================================================
   HERO THEME CLASSES (Set on root)
   ============================================================================= */

.theme-vex {
    --hero-primary: rgb(200, 60, 60);
    --hero-secondary: rgb(255, 100, 80);
    --hero-accent: rgb(255, 180, 120);
    --hero-glow: rgba(200, 60, 60, 0.25);
}

.theme-seraphina {
    --hero-primary: rgb(60, 180, 60);
    --hero-secondary: rgb(120, 80, 200);
    --hero-accent: rgb(220, 200, 60);
    --hero-glow: rgba(60, 180, 60, 0.25);
}

.theme-orion {
    --hero-primary: rgb(60, 60, 200);
    --hero-secondary: rgb(80, 120, 255);
    --hero-accent: rgb(60, 220, 255);
    --hero-glow: rgba(60, 60, 200, 0.25);
}

.theme-nyx {
    --hero-primary: rgb(200, 50, 80);
    --hero-secondary: rgb(180, 60, 180);
    --hero-accent: rgb(220, 130, 255);
    --hero-glow: rgba(200, 50, 80, 0.25);
}

/* =============================================================================
   HIDDEN STATE
   ============================================================================= */

.hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    display: none;
}

/* =============================================================================
   ROOT / LAYOUT
   ============================================================================= */

TemplateContainer {
    flex-grow: 1;
}

.character-select-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-direction: column;
    overflow: hidden;
}

/* =============================================================================
   PARALLAX BACKGROUND SYSTEM
   ============================================================================= */

.parallax-bg {
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
}

/* Layer 1: Deepest Void */
.parallax-deep {
    background-color: rgb(4, 4, 8);
    z-index: 0;
}

.void-stars {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: transparent;
    opacity: 0.6;
}

/* Layer 2: Fog Particles */
.parallax-fog {
    z-index: 1;
    pointer-events: none;
}

.fog-particles {
    position: absolute;
    width: 100%;
    height: 100%;
    /* Procedural fog tint based on hero glow */
    background-color: var(--hero-glow, rgba(40, 20, 60, 0.08));
    opacity: 0.4;
    transition: background-color var(--transition-slow) var(--ease-out-expo);
}

/* Layer 5: Vignette Overlay */
.background-vignette {
    position: absolute;
    width: 100%;
    height: 100%;
    z-index: 4;
    pointer-events: none;
    background: radial-gradient(ellipse at 50% 50%,
        transparent 0%,
        transparent 50%,
        rgba(0, 0, 0, 0.5) 85%,
        rgba(0, 0, 0, 0.85) 100%);
}

/* =============================================================================
   GLASS PANEL BASE
   ============================================================================= */

.glass-panel {
    background-color: var(--glass-bg);
    backdrop-filter: blur(var(--glass-blur));
    -unity-backdrop-filter: blur(var(--glass-blur));
    border-width: 1px;
    border-color: var(--hero-accent, rgba(120, 120, 140, 0.2));
    border-radius: 12px;
    /* Rim lighting: subtle bright edge on top and left */
    border-top-color: rgba(255, 255, 255, 0.15);
    border-left-color: rgba(255, 255, 255, 0.1);
    transition: all var(--transition-normal) var(--ease-out-expo);
    /* High-end depth shadow */
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.6),
                inset 0 0 12px rgba(255, 255, 255, 0.05);
}

.glass-panel:hover {
    border-color: var(--hero-accent, rgba(180, 180, 200, 0.4));
    box-shadow: 0 12px 48px rgba(0, 0, 0, 0.8),
                inset 0 0 16px rgba(255, 255, 255, 0.08);
}

/* =============================================================================
   LEFT PANEL: HERO INFO (FLOATING)
   ============================================================================= */

.hero-info-panel {
    position: absolute;
    width: 280px;
    top: var(--panel-margin);
    left: var(--panel-margin);
    padding: 24px;
    z-index: 20;
    opacity: 1;
    translate: 0 0;
    transition: translate var(--transition-normal) var(--ease-out-expo),
                opacity var(--transition-normal) var(--ease-out-expo);
    border-top-width: 3px;
    border-top-color: var(--hero-primary);
}

.hero-info-panel.panel-hidden {
    translate: -60px 0;
    opacity: 0;
}

.hero-name {
    font-size: 38px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    letter-spacing: 8px;
    margin-bottom: 2px;
    /* Hero-themed text glow */
    text-shadow: 0 0 12px var(--hero-glow),
                 0 0 24px rgba(255, 255, 255, 0.15);
    transition: all var(--transition-slow) var(--ease-out-expo);
}

.hero-title {
    font-size: 15px;
    color: var(--hero-accent);
    letter-spacing: 5px;
    margin-bottom: 16px;
    text-transform: uppercase;
    opacity: 0.8;
    /* Rim-lit text effect */
    border-left-width: 2px;
    border-left-color: var(--hero-primary);
    padding-left: 12px;
}

.hero-quote {
    font-size: 11px;
    color: rgba(200, 200, 215, 0.7);
    -unity-font-style: italic;
    margin-bottom: 20px;
    white-space: normal;
    padding-bottom: 12px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.1);
}

/* Info Rows */
.info-row {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 8px;
}

.info-label {
    font-size: 10px;
    color: rgba(170, 170, 190, 0.7);
    letter-spacing: 3px;
}

.info-value {
    font-size: 13px;
    color: var(--hero-accent);
    -unity-font-style: bold;
}

/* Starter Stats 2x2 Grid */
.starter-stats-grid {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 16px;
    justify-content: space-between;
}

.stat-chip {
    width: 48%;
    background-color: rgba(0, 0, 0, 0.2);
    padding: 8px 12px;
    margin-bottom: 8px;
    border-radius: 4px;
    border-left-width: 2px;
    border-left-color: var(--hero-primary);
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.stat-chip-label {
    font-size: 10px;
    color: rgba(200, 200, 215, 0.6);
}

.stat-chip-value {
    font-size: 16px;
    color: #FFF;
    -unity-font-style: bold;
}

/* =============================================================================
   CENTER: HERO STAGE
   ============================================================================= */

.hero-stage {
    position: absolute;
    width: 100%;
    height: 100%;
    z-index: 10;
    align-items: center;
    justify-content: center;
}

.hero-render-target {
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-to-fit;
}

.hero-aura-container {
    position: absolute;
    width: 60%;
    height: 60%;
    bottom: 10%;
    z-index: 1;
    pointer-events: none;
}

.aura-base {
    position: absolute;
    width: 100%;
    height: 100%;
    background: radial-gradient(ellipse at 50% 100%,
        var(--hero-glow) 0%,
        transparent 70%);
    opacity: 0.6;
}

/* =============================================================================
   RIGHT PANEL: STATS & ABILITIES (FLOATING)
   ============================================================================= */

.stats-panel {
    position: absolute;
    width: 280px;
    top: var(--panel-margin);
    right: var(--panel-margin);
    padding: 24px;
    z-index: 20;
    opacity: 1;
    translate: 0 0;
    transition: translate var(--transition-normal) var(--ease-out-expo),
                opacity var(--transition-normal) var(--ease-out-expo);
    border-top-width: 3px;
    border-top-color: var(--hero-primary);
}

.stats-panel.panel-hidden {
    translate: 60px 0;
    opacity: 0;
}

.section-header {
    font-size: 12px;
    color: rgba(200, 200, 215, 0.7);
    letter-spacing: 5px;
    margin-bottom: 16px;
    -unity-font-style: bold;
}

/* Attribute Bars */
.stat-bar-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
}

.stat-bar-label {
    width: 40px;
    font-size: 10px;
    color: rgba(170, 170, 190, 0.7);
    letter-spacing: 3px;
}

.stat-bar-track {
    flex-grow: 1;
    height: 14px;
    background-color: rgba(5, 5, 10, 0.7);
    border-radius: 7px;
    margin: 0 12px;
    overflow: hidden;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
}

.stat-bar-fill {
    height: 100%;
    background: linear-gradient(90deg, 
        var(--hero-primary) 0%, 
        var(--hero-secondary) 100%);
    border-radius: 7px;
    /* Glowing fill effect */
    box-shadow: 0 0 16px var(--hero-glow);
    transition: width var(--transition-slow) var(--ease-out-expo);
}

.stat-bar-value {
    width: 30px;
    font-size: 14px;
    color: #FFF;
    -unity-text-align: middle-right;
    -unity-font-style: bold;
}

/* Abilities */
.abilities-header {
    margin-top: 16px;
    padding-top: 16px;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.1);
}

.ability-slot {
    font-size: 14px;
    color: rgb(230, 230, 240);
    padding: 12px 20px;
    margin-bottom: 10px;
    background-color: rgba(255, 255, 255, 0.04);
    border-radius: 6px;
    border-left-width: 4px;
    border-left-color: var(--hero-primary);
    /* High-end hover shadow transition */
    transition: all var(--transition-fast) var(--ease-out-expo);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
}

.ability-slot:hover {
    background-color: rgba(255, 255, 255, 0.1);
    translate: 8px 0;
    border-left-color: #FFF;
    border-left-width: 6px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.5),
                inset 0 0 8px rgba(255, 255, 255, 0.1);
}

/* =============================================================================
   BOTTOM LAYER: CAROUSEL
   ============================================================================= */

.bottom-layer {
    position: absolute;
    bottom: 20px;
    width: 100%;
    height: 140px;
    z-index: 30;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.nav-arrow {
    width: 50px;
    height: 50px;
    font-size: 24px;
    color: rgba(255, 255, 255, 0.4);
    background-color: rgba(15, 12, 20, 0.8);
    border-radius: 25px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
    -unity-text-align: middle-center;
    transition: all var(--transition-fast) var(--ease-out-expo);
}

.nav-arrow:hover {
    color: #FFF;
    border-color: var(--hero-accent);
    scale: 1.1;
}

.carousel-container {
    margin: 0 40px;
}

.carousel-strip {
    flex-direction: row;
    align-items: center;
}

.hero-card {
    width: 120px;
    height: 150px;
    margin: 0 12px;
    background-color: rgba(8, 8, 14, 0.95);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    align-items: center;
    justify-content: center;
    transition: all var(--transition-normal) var(--ease-out-back);
    opacity: 0.7;
    /* Layered glass depth shadow */
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.5),
                inset 0 0 8px rgba(255, 255, 255, 0.03);
}

.hero-card:hover {
    scale: 1.15;
    opacity: 1;
    border-color: rgba(255, 255, 255, 0.4);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.7),
                inset 0 0 12px rgba(255, 255, 255, 0.05);
}

.hero-card.selected {
    scale: 1.25;
    opacity: 1;
    border-width: 2px;
    border-color: var(--hero-primary);
    box-shadow: 0 0 32px var(--hero-glow),
                0 0 64px var(--hero-glow),
                inset 0 0 16px rgba(255, 255, 255, 0.08);
}

.hero-card-initial {
    font-size: 42px;
    -unity-font-style: bold;
    color: var(--hero-primary);
    opacity: 0.4;
    margin-bottom: 4px;
    /* Text glow for selected card */
    transition: all var(--transition-normal);
}

.hero-card.selected .hero-card-initial {
    opacity: 1;
    text-shadow: 0 0 16px var(--hero-glow);
}

.hero-card-name {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.8);
    letter-spacing: 2px;
    text-transform: uppercase;
}

/* =============================================================================
   EMBARK BUTTON (AAA VERSION)
   ============================================================================= */

.embark-layer {
    position: absolute;
    bottom: 180px;
    width: 100%;
    align-items: center;
    z-index: 40;
}

.btn-embark {
    width: 400px;
    height: 80px;
    background-color: transparent;
    border-width: 0;
    overflow: visible;
}

.embark-hex-bg {
    position: absolute;
    width: 100%;
    height: 100%;
    background: linear-gradient(180deg, rgba(35, 30, 45, 0.98) 0%, rgba(10, 8, 15, 0.98) 100%);
    border-width: 2px;
    border-color: var(--hero-primary);
    border-radius: 6px;
    /* Hero-themed shadow */
    box-shadow: 0 0 24px var(--hero-glow),
                inset 0 0 16px rgba(255, 255, 255, 0.05);
    transition: all var(--transition-normal) var(--ease-out-expo);
}

.btn-embark:hover .embark-hex-bg {
    border-color: #FFF;
    border-width: 3px;
    background: linear-gradient(180deg, rgba(50, 45, 65, 0.98) 0%, rgba(20, 15, 25, 0.98) 100%);
    box-shadow: 0 0 48px var(--hero-glow),
                0 0 96px var(--hero-glow),
                inset 0 0 24px rgba(255, 255, 255, 0.1);
    scale: 1.05;
}

.embark-text {
    font-size: 24px;
    -unity-font-style: bold;
    color: #FFF;
    letter-spacing: 12px;
    text-shadow: 0 0 16px rgba(255, 255, 255, 0.3);
    transition: all var(--transition-normal);
}

.btn-embark:hover .embark-text {
    color: #FFF;
    scale: 1.1;
    text-shadow: 0 0 24px #FFF;
}

.embark-subtitle {
    font-size: 10px;
    color: rgba(200, 200, 215, 0.5);
    letter-spacing: 4px;
    text-transform: uppercase;
    margin-top: 4px;
}

.embark-glow {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: var(--hero-primary);
    opacity: 0;
    transition: opacity var(--transition-slow);
}

.embark-glow.breathing {
    opacity: 0.1;
    animation: breathing 4s ease-in-out infinite;
}

@keyframes breathing {
    0%, 100% { opacity: 0.05; scale: 1; }
    50% { opacity: 0.15; scale: 1.02; }
}

/* =============================================================================
   MISC UI
   ============================================================================= */

.btn-back {
    position: absolute;
    top: var(--panel-margin);
    left: var(--panel-margin);
    padding: 12px 24px;
    background-color: rgba(0, 0, 0, 0.4);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    color: rgba(255, 255, 255, 0.5);
    font-size: 12px;
    letter-spacing: 4px;
    transition: all var(--transition-fast);
}

.btn-back:hover {
    color: #FFF;
    border-color: #FFF;
}

.hero-index {
    position: absolute;
    bottom: 20px;
    right: 40px;
    font-size: 12px;
    color: rgba(255, 255, 255, 0.2);
    letter-spacing: 4px;
}

/* =============================================================================
   CONFIRM OVERLAY
   ============================================================================= */

.confirm-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    z-index: 100;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.8);
    transition: opacity var(--transition-normal);
}

.confirm-popup {
    width: 500px;
    padding: 40px;
    background-color: rgb(15, 12, 20);
    border-width: 1px;
    border-color: var(--hero-accent);
    border-top-width: 4px;
    border-top-color: var(--hero-primary);
}

.confirm-title {
    font-size: 24px;
    -unity-font-style: bold;
    color: #FFF;
    letter-spacing: 6px;
    margin-bottom: 20px;
    -unity-text-align: middle-center;
}

.confirm-description {
    font-size: 14px;
    color: rgba(200, 200, 215, 0.8);
    -unity-text-align: middle-center;
    margin-bottom: 40px;
    white-space: normal;
}

.confirm-buttons {
    flex-direction: row;
    justify-content: space-between;
}

.btn-confirm, .btn-cancel {
    width: 48%;
    height: 50px;
    -unity-font-style: bold;
    letter-spacing: 4px;
}

.btn-confirm {
    background-color: var(--hero-primary);
    color: #FFF;
}

.btn-cancel {
    background-color: rgba(255, 255, 255, 0.05);
    color: rgba(255, 255, 255, 0.5);
}
