<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Styles/VeilBreakers.uss?fileID=7433441132597879392&amp;guid=f14e48b4bc52a9f4586f9c621c434598&amp;type=3" />
    <Style src="project://database/Assets/UI/Styles/VeilBreakersTheme.uss?fileID=7433441132597879392&amp;guid=0c75776285827f74db8942ace412c502&amp;type=3" />

    <ui:VisualElement name="charset-root" class="vb-root" style="flex-grow: 1;">

        <!-- Background -->
        <ui:VisualElement name="bg" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgb(8, 6, 12);" />

        <!-- Header Bar -->
        <ui:VisualElement name="header" style="position: absolute; left: 0; top: 0; right: 0; height: 80px; flex-direction: row; justify-content: space-between; align-items: center; padding: 0 40px; background-color: rgba(8, 6, 12, 0.95); border-bottom-width: 2px; border-bottom-color: rgba(255, 140, 60, 0.5);">
            <ui:Button text="‹ BACK" name="btn-back" class="btn-secondary" style="width: 120px; height: 40px; font-size: 13px; letter-spacing: 2px;" />
            <ui:VisualElement style="flex-direction: column; align-items: center;">
                <ui:Label text="CHOOSE YOUR" style="font-size: 11px; letter-spacing: 6px; color: rgb(255, 140, 60); margin-bottom: 2px;" />
                <ui:Label text="VEILBREAKER" style="font-size: 28px; letter-spacing: 8px; color: rgb(240, 230, 220); -unity-font-style: bold;" />
            </ui:VisualElement>
            <ui:VisualElement style="width: 120px;" />
        </ui:VisualElement>

        <!-- Main Content -->
        <ui:VisualElement name="content" style="flex-grow: 1; flex-direction: row; margin-top: 80px; margin-bottom: 100px; padding: 20px;">

            <!-- Left Panel - Hero List -->
            <ui:VisualElement name="hero-list-panel" style="width: 260px; padding: 20px; background-color: rgba(15, 12, 20, 0.95); border-width: 2px; border-color: rgba(255, 140, 60, 0.3); border-radius: 12px; margin-right: 20px;">
                <ui:Label text="VEILBREAKERS" style="font-size: 11px; letter-spacing: 3px; color: rgb(255, 140, 60); margin-bottom: 16px; -unity-font-style: bold;" />
                <ui:ScrollView name="hero-scroll" style="flex-grow: 1;">
                    <ui:VisualElement name="hero-list" />
                </ui:ScrollView>
            </ui:VisualElement>

            <!-- Center - Hero Preview -->
            <ui:VisualElement name="center-panel" style="flex-grow: 1; align-items: center; justify-content: center;">
                <ui:VisualElement name="model-viewport" style="width: 400px; height: 480px; background-color: rgba(15, 12, 20, 0.9); border-width: 2px; border-color: rgba(255, 140, 60, 0.35); border-radius: 14px; align-items: center; justify-content: center;">
                    <ui:VisualElement name="preview-ring" style="width: 80px; height: 80px; border-radius: 40px; border-width: 2px; border-color: rgba(255, 140, 60, 0.25); align-items: center; justify-content: center; margin-bottom: 14px;">
                        <ui:Label text="?" name="preview-icon" style="font-size: 36px; color: rgba(255, 140, 60, 0.4);" />
                    </ui:VisualElement>
                    <ui:Label text="Select a Veilbreaker" style="font-size: 15px; color: rgb(100, 90, 80); letter-spacing: 3px;" />
                </ui:VisualElement>
                <ui:Label text="◄ DRAG TO ROTATE ►" style="margin-top: 12px; font-size: 10px; color: rgb(80, 70, 60); letter-spacing: 2px;" />
            </ui:VisualElement>

            <!-- Right Panel - Hero Details -->
            <ui:VisualElement name="details-panel" style="width: 340px; padding: 20px; background-color: rgba(15, 12, 20, 0.95); border-width: 2px; border-color: rgba(255, 140, 60, 0.3); border-radius: 12px; margin-left: 20px; overflow: hidden;">
                <ui:ScrollView class="scrollview" style="flex-grow: 1;" mode="Vertical" vertical-scroller-visibility="Auto" mouse-wheel-scroll-size="120" scroll-deceleration-rate="0.135" elasticity="0.1">
                    <ui:VisualElement name="details-content" style="flex-direction: column; width: 100%; padding-right: 8px;">

                    <!-- Hero Name -->
                    <ui:Label name="hero-name" text="Select a Hero" style="font-size: 26px; color: rgb(245, 235, 220); -unity-font-style: bold; margin-bottom: 4px; flex-shrink: 0; letter-spacing: 1px;" />
                    <ui:Label name="hero-title" text="" style="font-size: 13px; color: rgb(255, 140, 60); letter-spacing: 2px; margin-bottom: 16px; flex-shrink: 0; -unity-font-style: italic;" />

                    <ui:VisualElement style="height: 2px; background: linear-gradient(90deg, rgba(255, 140, 60, 0.5) 0%, rgba(255, 140, 60, 0) 100%); margin-bottom: 16px;" />

                    <!-- Path & Resource Row -->
                    <ui:VisualElement style="flex-direction: row; justify-content: space-between; margin-bottom: 16px; flex-shrink: 0;">
                        <!-- Path Section -->
                        <ui:VisualElement style="flex-direction: column;">
                            <ui:Label text="PATH" style="font-size: 10px; letter-spacing: 3px; color: rgb(160, 150, 140); margin-bottom: 8px;" />
                            <ui:VisualElement name="path-badge" style="flex-direction: row; align-items: center; padding: 8px 14px; background-color: rgba(255, 140, 60, 0.12); border-width: 1px; border-color: rgba(255, 140, 60, 0.4); border-radius: 6px;">
                                <ui:VisualElement name="path-orb" style="width: 10px; height: 10px; border-radius: 5px; background-color: rgb(255, 140, 60); margin-right: 10px;" />
                                <ui:Label name="path-name" text="--" style="font-size: 12px; letter-spacing: 2px; color: rgb(255, 217, 128); -unity-font-style: bold;" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <!-- Resource Type Section -->
                        <ui:VisualElement style="flex-direction: column; align-items: flex-end;">
                            <ui:Label text="RESOURCE" style="font-size: 10px; letter-spacing: 3px; color: rgb(160, 150, 140); margin-bottom: 8px;" />
                            <ui:VisualElement name="resource-badge" style="flex-direction: row; align-items: center; padding: 8px 14px; background-color: rgba(100, 180, 220, 0.12); border-width: 1px; border-color: rgba(100, 180, 220, 0.4); border-radius: 6px;">
                                <ui:VisualElement name="resource-icon" style="width: 10px; height: 10px; border-radius: 5px; background-color: rgb(100, 180, 220); margin-right: 10px;" />
                                <ui:Label name="resource-name" text="--" style="font-size: 12px; letter-spacing: 2px; color: rgb(180, 220, 255); -unity-font-style: bold;" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- Brand Affinity -->
                    <ui:Label text="BRAND AFFINITY" style="font-size: 10px; letter-spacing: 2px; color: rgb(160, 150, 140); margin-bottom: 8px; flex-shrink: 0;" />
                    <ui:VisualElement name="brand-display" style="flex-direction: row; margin-bottom: 16px; flex-shrink: 0;">
                        <ui:VisualElement style="flex-direction: row; align-items: center; padding: 4px 10px; background-color: rgba(45, 30, 38, 0.6); border-radius: 4px; margin-right: 8px;">
                            <ui:VisualElement name="hero-brand-orb" style="width: 10px; height: 10px; border-radius: 5px; background-color: rgb(180, 40, 60); margin-right: 6px;" />
                            <ui:Label name="brand-name-1" text="--" style="font-size: 11px; color: rgb(210, 200, 190);" />
                        </ui:VisualElement>
                        <ui:VisualElement style="flex-direction: row; align-items: center; padding: 4px 10px; background-color: rgba(45, 30, 38, 0.6); border-radius: 4px;">
                            <ui:VisualElement name="hero-path-orb" style="width: 10px; height: 10px; border-radius: 5px; background-color: rgb(100, 80, 70); margin-right: 6px;" />
                            <ui:Label name="brand-name-2" text="--" style="font-size: 11px; color: rgb(210, 200, 190);" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- Stats -->
                    <ui:Label text="ATTRIBUTES" style="font-size: 10px; letter-spacing: 3px; color: rgb(160, 150, 140); margin-bottom: 10px; flex-shrink: 0;" />
                    <ui:VisualElement name="stats-container" style="margin-bottom: 16px; flex-shrink: 0;">
                        <!-- Strength (ORANGE) - Physical Power -->
                        <ui:VisualElement style="flex-direction: row; align-items: center; margin-bottom: 6px;">
                            <ui:Label text="STR" style="width: 40px; font-size: 11px; color: rgb(230, 160, 100); letter-spacing: 1px;" />
                            <ui:VisualElement style="flex-grow: 1; height: 5px; background-color: rgba(30, 22, 28, 0.8); border-radius: 2px; margin: 0 8px; overflow: hidden;">
                                <ui:VisualElement name="stat-strength-fill" style="width: 50%; height: 100%; background-color: rgb(230, 160, 100); border-radius: 2px;" />
                            </ui:VisualElement>
                            <ui:Label name="stat-strength-value" text="10" style="width: 24px; font-size: 11px; color: rgb(230, 160, 100); -unity-text-align: middle-right;" />
                        </ui:VisualElement>
                        <!-- Dexterity (GREEN) - Speed/Agility -->
                        <ui:VisualElement style="flex-direction: row; align-items: center; margin-bottom: 6px;">
                            <ui:Label text="DEX" style="width: 40px; font-size: 11px; color: rgb(120, 200, 140); letter-spacing: 1px;" />
                            <ui:VisualElement style="flex-grow: 1; height: 5px; background-color: rgba(30, 22, 28, 0.8); border-radius: 2px; margin: 0 8px; overflow: hidden;">
                                <ui:VisualElement name="stat-dexterity-fill" style="width: 50%; height: 100%; background-color: rgb(120, 200, 140); border-radius: 2px;" />
                            </ui:VisualElement>
                            <ui:Label name="stat-dexterity-value" text="10" style="width: 24px; font-size: 11px; color: rgb(120, 200, 140); -unity-text-align: middle-right;" />
                        </ui:VisualElement>
                        <!-- Constitution (RED) - Health/Endurance -->
                        <ui:VisualElement style="flex-direction: row; align-items: center; margin-bottom: 6px;">
                            <ui:Label text="CON" style="width: 40px; font-size: 11px; color: rgb(220, 100, 100); letter-spacing: 1px;" />
                            <ui:VisualElement style="flex-grow: 1; height: 5px; background-color: rgba(30, 22, 28, 0.8); border-radius: 2px; margin: 0 8px; overflow: hidden;">
                                <ui:VisualElement name="stat-constitution-fill" style="width: 50%; height: 100%; background-color: rgb(220, 100, 100); border-radius: 2px;" />
                            </ui:VisualElement>
                            <ui:Label name="stat-constitution-value" text="10" style="width: 24px; font-size: 11px; color: rgb(220, 100, 100); -unity-text-align: middle-right;" />
                        </ui:VisualElement>
                        <!-- Intelligence (CYAN) - Magic Power -->
                        <ui:VisualElement style="flex-direction: row; align-items: center; margin-bottom: 6px;">
                            <ui:Label text="INT" style="width: 40px; font-size: 11px; color: rgb(100, 180, 220); letter-spacing: 1px;" />
                            <ui:VisualElement style="flex-grow: 1; height: 5px; background-color: rgba(30, 22, 28, 0.8); border-radius: 2px; margin: 0 8px; overflow: hidden;">
                                <ui:VisualElement name="stat-intelligence-fill" style="width: 50%; height: 100%; background-color: rgb(100, 180, 220); border-radius: 2px;" />
                            </ui:VisualElement>
                            <ui:Label name="stat-intelligence-value" text="10" style="width: 24px; font-size: 11px; color: rgb(100, 180, 220); -unity-text-align: middle-right;" />
                        </ui:VisualElement>
                        <!-- Wisdom (STEEL BLUE) - Resistance/Perception -->
                        <ui:VisualElement style="flex-direction: row; align-items: center; margin-bottom: 6px;">
                            <ui:Label text="WIS" style="width: 40px; font-size: 11px; color: rgb(130, 170, 200); letter-spacing: 1px;" />
                            <ui:VisualElement style="flex-grow: 1; height: 5px; background-color: rgba(30, 22, 28, 0.8); border-radius: 2px; margin: 0 8px; overflow: hidden;">
                                <ui:VisualElement name="stat-wisdom-fill" style="width: 50%; height: 100%; background-color: rgb(130, 170, 200); border-radius: 2px;" />
                            </ui:VisualElement>
                            <ui:Label name="stat-wisdom-value" text="10" style="width: 24px; font-size: 11px; color: rgb(130, 170, 200); -unity-text-align: middle-right;" />
                        </ui:VisualElement>
                        <!-- Charisma (PURPLE) - Social/Luck -->
                        <ui:VisualElement style="flex-direction: row; align-items: center;">
                            <ui:Label text="CHA" style="width: 40px; font-size: 11px; color: rgb(180, 130, 220); letter-spacing: 1px;" />
                            <ui:VisualElement style="flex-grow: 1; height: 5px; background-color: rgba(30, 22, 28, 0.8); border-radius: 2px; margin: 0 8px; overflow: hidden;">
                                <ui:VisualElement name="stat-charisma-fill" style="width: 50%; height: 100%; background-color: rgb(180, 130, 220); border-radius: 2px;" />
                            </ui:VisualElement>
                            <ui:Label name="stat-charisma-value" text="10" style="width: 24px; font-size: 11px; color: rgb(180, 130, 220); -unity-text-align: middle-right;" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement style="height: 1px; background-color: rgba(255, 140, 60, 0.25); margin-bottom: 16px;" />

                    <!-- Starter Monster Section -->
                    <ui:VisualElement name="monster-section" style="flex-direction: row; align-items: center; margin-bottom: 12px;">
                    <ui:VisualElement name="monster-section-bar" style="width: 4px; height: 16px; background-color: rgb(255, 140, 60); border-radius: 2px; margin-right: 10px;" />
                    <ui:Label name="monster-section-label" text="STARTER MONSTER" style="font-size: 10px; letter-spacing: 3px; color: rgb(255, 140, 60); -unity-font-style: bold;" />
                    </ui:VisualElement>

                    <ui:VisualElement name="signature-monster-card" style="flex-direction: row; padding: 14px; background-color: rgba(20, 15, 25, 0.9); border-width: 2px; border-color: rgba(255, 140, 60, 0.25); border-radius: 10px; margin-bottom: 14px; flex-shrink: 0;">
                        <!-- Monster Portrait -->
                        <ui:VisualElement name="monster-icon-frame" style="width: 64px; height: 64px; background-color: rgba(30, 22, 35, 0.9); border-radius: 8px; border-width: 2px; border-color: rgba(255, 140, 60, 0.35); margin-right: 14px; align-items: center; justify-content: center; flex-shrink: 0;">
                            <ui:Label text="◆" style="font-size: 28px; color: rgba(255, 140, 60, 0.4);" />
                        </ui:VisualElement>
                        <!-- Monster Info -->
                        <ui:VisualElement style="flex-grow: 1;">
                            <ui:Label name="monster-name" text="Shadow Hound" style="font-size: 14px; color: rgb(230, 220, 210); -unity-font-style: bold; margin-bottom: 2px;" />
                            <ui:Label name="monster-type" text="Beast - Stalker" style="font-size: 11px; color: rgb(130, 120, 110); margin-bottom: 6px;" />
                            <ui:VisualElement style="flex-direction: row; margin-bottom: 8px;">
                                <ui:VisualElement name="monster-brand-orb-1" style="width: 12px; height: 12px; border-radius: 6px; background-color: rgb(255, 140, 60); margin-right: 6px;" />
                                <ui:VisualElement name="monster-brand-orb-2" style="width: 12px; height: 12px; border-radius: 6px; background-color: rgb(120, 100, 80);" />
                            </ui:VisualElement>
                            <ui:VisualElement style="flex-direction: row; align-items: center; padding: 4px 10px; background-color: rgba(255, 140, 60, 0.15); border-radius: 4px; align-self: flex-start; border-width: 1px; border-color: rgba(255, 140, 60, 0.3);">
                                <ui:Label text="✦ PATH SYNERGY" style="font-size: 9px; letter-spacing: 1px; color: rgb(255, 180, 130);" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- Monster Ability -->
                    <ui:VisualElement name="monster-ability" style="padding: 10px; background-color: rgba(30, 22, 28, 0.7); border-radius: 6px; margin-bottom: 16px; flex-shrink: 0;">
                        <ui:Label text="SIGNATURE ABILITY" style="font-size: 9px; letter-spacing: 1px; color: rgb(90, 80, 75); margin-bottom: 4px;" />
                        <ui:Label name="monster-ability-name" text="Shadow Stalk" style="font-size: 13px; color: rgb(200, 190, 180); -unity-font-style: bold; margin-bottom: 3px;" />
                        <ui:Label name="monster-ability-desc" text="Vanish into shadows, then strike from behind dealing bonus damage." style="font-size: 11px; color: rgb(130, 120, 110); white-space: normal;" />
                    </ui:VisualElement>

                    <ui:VisualElement style="height: 1px; background-color: rgba(255, 140, 60, 0.25); margin-bottom: 16px;" />

                    <!-- Hero Innate Ability -->
                    <ui:Label text="HERO INNATE ABILITY" style="font-size: 10px; letter-spacing: 2px; color: rgb(90, 80, 75); margin-bottom: 10px;" />
                    <ui:VisualElement name="innate-ability" style="flex-direction: row; padding: 10px; background-color: rgba(30, 22, 28, 0.7); border-radius: 6px; flex-shrink: 0;">
                        <ui:VisualElement style="width: 36px; height: 36px; background-color: rgba(55, 32, 42, 0.8); border-radius: 6px; margin-right: 10px; flex-shrink: 0;" />
                        <ui:VisualElement style="flex-grow: 1;">
                            <ui:Label name="innate-ability-name" text="Void Sight" style="font-size: 13px; color: rgb(200, 190, 180); -unity-font-style: bold; margin-bottom: 2px;" />
                            <ui:Label name="innate-ability-desc" text="See hidden enemies and weak points." style="font-size: 11px; color: rgb(130, 120, 110); white-space: normal;" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    </ui:VisualElement>
                </ui:ScrollView>
            </ui:VisualElement>

        </ui:VisualElement>

        <!-- Footer - Centered Button (spans between hero list and details panel) -->
        <ui:VisualElement name="footer" style="position: absolute; left: 280px; right: 360px; bottom: 0; height: 100px; flex-direction: row; justify-content: center; align-items: center; background-color: rgba(8, 6, 12, 0.95); border-top-width: 2px; border-top-color: rgba(255, 140, 60, 0.5);">
            <ui:Button text="► EMBARK" name="btn-select" class="btn-primary" style="width: 240px; height: 50px; font-size: 18px; letter-spacing: 4px;" />
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
