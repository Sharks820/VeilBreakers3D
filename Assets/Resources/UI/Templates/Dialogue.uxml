<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Styles/VeilBreakers.uss?fileID=7433441132597879392&amp;guid=f14e48b4bc52a9f4586f9c621c434598&amp;type=3" />
    <Style src="project://database/Assets/UI/Styles/VeilBreakersTheme.uss?fileID=7433441132597879392&amp;guid=f14e48b4bc52a9f4586f9c621c434598&amp;type=3" />

    <ui:VisualElement name="dialogue-root" class="vb-root" style="flex-grow: 1; justify-content: flex-end; padding: 40px;">

        <!-- ====================================================================
             VERA DIALOGUE BOX
             ==================================================================== -->

        <ui:VisualElement name="dialogue-container" class="dialogue-box" style="max-width: 900px; margin: 0 auto; width: 100%;">

            <!-- Glitch overlay (hidden by default) -->
            <ui:VisualElement name="glitch-overlay" class="dialogue-glitch-overlay" style="display: none;" />

            <!-- Main dialogue content -->
            <ui:VisualElement name="dialogue-content" style="flex-direction: row; padding: 20px;">

                <!-- ============================================================
                     VERA Portrait
                     ============================================================ -->

                <ui:VisualElement name="portrait-section" style="margin-right: 20px;">

                    <!-- Portrait frame with glow -->
                    <ui:VisualElement name="portrait-frame" class="vera-portrait-frame">

                        <!-- Corruption glow ring -->
                        <ui:VisualElement name="portrait-glow" class="vera-portrait-glow" />

                        <!-- Portrait image -->
                        <ui:VisualElement name="vera-portrait" class="vera-portrait" />

                        <!-- Glitch scanlines -->
                        <ui:VisualElement name="portrait-scanlines" class="vera-scanlines" style="display: none;" />

                    </ui:VisualElement>

                    <!-- VERA name with integrity indicator -->
                    <ui:VisualElement class="vb-row" style="justify-content: center; margin-top: 8px;">
                        <ui:Label name="speaker-name" text="V.E.R.A." class="vera-name" />
                        <ui:VisualElement name="integrity-indicator" class="integrity-pip" style="margin-left: 8px;" />
                    </ui:VisualElement>

                </ui:VisualElement>

                <!-- ============================================================
                     Text Content
                     ============================================================ -->

                <ui:VisualElement name="text-section" style="flex-grow: 1; flex-direction: column;">

                    <!-- Dialogue text area -->
                    <ui:ScrollView name="text-scroll" style="flex-grow: 1; min-height: 100px; max-height: 180px;">
                        <ui:Label name="dialogue-text" class="dialogue-text" text="" />
                    </ui:ScrollView>

                    <!-- Continue indicator -->
                    <ui:VisualElement name="continue-indicator" class="vb-row" style="justify-content: flex-end; margin-top: 8px;">
                        <ui:Label text="[CLICK TO CONTINUE]" class="continue-hint" />
                        <ui:VisualElement name="continue-arrow" class="continue-arrow" />
                    </ui:VisualElement>

                </ui:VisualElement>

            </ui:VisualElement>

            <!-- ================================================================
                 Choice Buttons (hidden when no choices)
                 ================================================================ -->

            <ui:VisualElement name="choices-container" class="dialogue-choices" style="display: none;">

                <ui:VisualElement class="vb-divider-horizontal" style="margin: 0 20px 16px 20px;" />

                <ui:VisualElement name="choices-list" class="vb-column" style="padding: 0 20px 20px 20px;">
                    <!-- Choices populated dynamically -->
                </ui:VisualElement>

            </ui:VisualElement>

        </ui:VisualElement>

        <!-- ====================================================================
             VEIL INTEGRITY BAR (Top of screen)
             ==================================================================== -->

        <ui:VisualElement name="integrity-bar-container" style="position: absolute; top: 20px; left: 50%; translate: -50% 0; width: 300px;">

            <ui:Label text="VEIL INTEGRITY" style="color: rgb(165, 155, 145); font-size: 10px; letter-spacing: 2px; -unity-text-align: middle-center; margin-bottom: 4px;" />

            <ui:VisualElement class="integrity-bar-bg" style="height: 8px;">
                <ui:VisualElement name="integrity-bar-fill" class="integrity-bar-fill" style="width: 100%;" />
            </ui:VisualElement>

            <ui:Label name="integrity-percent" text="100%" style="color: rgb(120, 200, 150); font-size: 12px; -unity-text-align: middle-center; margin-top: 4px;" />

        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
