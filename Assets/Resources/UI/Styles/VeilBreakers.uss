/* =============================================================================
   VEILBREAKERS - MAIN STYLESHEET
   Dark Fantasy Horror Theme
   ============================================================================= */

/* =============================================================================
   CSS VARIABLES (Custom Properties)
   ============================================================================= */

:root {
    /* Primary Colors - Dark Fantasy Palette */
    --color-background-dark: rgb(15, 12, 20);
    --color-background-medium: rgb(28, 20, 25);
    --color-background-light: rgb(45, 30, 38);

    /* Accent Colors - VeilBreakers Crimson Theme */
    --color-accent-red: rgb(180, 40, 60);
    --color-accent-red-glow: rgb(220, 60, 80);
    --color-accent-crimson: rgb(180, 40, 60);
    --color-accent-crimson-glow: rgb(220, 60, 80);
    --color-accent-gold: rgb(200, 160, 80);
    --color-accent-cyan: rgb(60, 180, 200);

    /* Text Colors */
    --color-text-primary: rgb(230, 220, 210);
    --color-text-secondary: rgb(160, 150, 140);
    --color-text-disabled: rgb(100, 90, 80);
    --color-text-highlight: rgb(255, 240, 200);

    /* UI Element Colors */
    --color-border: rgb(70, 45, 55);
    --color-border-highlight: rgb(140, 60, 80);
    --color-panel: rgba(20, 15, 30, 0.9);
    --color-panel-hover: rgba(35, 28, 45, 0.95);

    /* Health/Resource Colors */
    --color-health: rgb(180, 50, 50);
    --color-health-low: rgb(220, 40, 40);
    --color-mana: rgb(60, 100, 180);
    --color-stamina: rgb(60, 160, 80);

    /* Corruption State Colors */
    --color-corruption-ascended: rgb(255, 215, 0);
    --color-corruption-purified: rgb(180, 220, 255);
    --color-corruption-unstable: rgb(180, 180, 180);
    --color-corruption-corrupted: rgb(160, 40, 70);
    --color-corruption-abyssal: rgb(70, 5, 20);

    /* Spacing */
    --spacing-xs: 4px;
    --spacing-sm: 8px;
    --spacing-md: 16px;
    --spacing-lg: 24px;
    --spacing-xl: 32px;

    /* Border Radius */
    --radius-sm: 4px;
    --radius-md: 8px;
    --radius-lg: 12px;

    /* Font Sizes */
    --font-size-xs: 12px;
    --font-size-sm: 14px;
    --font-size-md: 16px;
    --font-size-lg: 20px;
    --font-size-xl: 24px;
    --font-size-title: 32px;
    --font-size-header: 48px;
}

/* =============================================================================
   BASE ELEMENTS
   ============================================================================= */

.vb-root {
    flex-grow: 1;
    background-color: var(--color-background-dark);
}

/* =============================================================================
   TYPOGRAPHY
   ============================================================================= */

.vb-text {
    color: var(--color-text-primary);
    font-size: var(--font-size-md);
    -unity-font-style: normal;
}

.vb-text-secondary {
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
}

.vb-text-highlight {
    color: var(--color-text-highlight);
    -unity-font-style: bold;
}

.vb-title {
    color: var(--color-text-primary);
    font-size: var(--font-size-title);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 2px;
}

.vb-header {
    color: var(--color-accent-gold);
    font-size: var(--font-size-header);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 4px;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.8);
}

/* =============================================================================
   PANELS & CONTAINERS
   ============================================================================= */

.vb-panel {
    background-color: var(--color-panel);
    border-color: var(--color-border);
    border-width: 2px;
    border-radius: var(--radius-md);
    padding: var(--spacing-md);
}

.vb-panel-dark {
    background-color: rgba(10, 8, 15, 0.95);
    border-color: var(--color-border);
    border-width: 2px;
    border-radius: var(--radius-md);
    padding: var(--spacing-md);
}

.vb-panel-glow {
    background-color: var(--color-panel);
    border-color: var(--color-accent-crimson);
    border-width: 2px;
    border-radius: var(--radius-md);
    padding: var(--spacing-md);
}

.vb-card {
    background-color: var(--color-background-medium);
    border-color: var(--color-border);
    border-width: 1px;
    border-radius: var(--radius-sm);
    padding: var(--spacing-sm);
    margin: var(--spacing-xs);
}

.vb-card:hover {
    background-color: var(--color-panel-hover);
    border-color: var(--color-border-highlight);
}

/* =============================================================================
   BUTTONS
   ============================================================================= */

.vb-button {
    background-color: var(--color-background-light);
    border-color: var(--color-border);
    border-width: 2px;
    border-radius: var(--radius-sm);
    padding: var(--spacing-sm) var(--spacing-md);
    color: var(--color-text-primary);
    font-size: var(--font-size-md);
    -unity-font-style: bold;
    transition-duration: 0.15s;
    cursor: link;
}

.vb-button:hover {
    background-color: var(--color-background-medium);
    border-color: var(--color-accent-crimson);
    color: var(--color-text-highlight);
    scale: 1.02;
}

.vb-button:active {
    background-color: var(--color-accent-crimson);
    scale: 0.98;
}

.vb-button:disabled {
    background-color: var(--color-background-dark);
    border-color: var(--color-border);
    color: var(--color-text-disabled);
    cursor: arrow;
}

.vb-button-primary {
    background-color: var(--color-accent-red);
    border-color: var(--color-accent-red-glow);
    color: white;
}

.vb-button-primary:hover {
    background-color: var(--color-accent-red-glow);
    border-color: rgb(255, 100, 120);
}

.vb-button-secondary {
    background-color: var(--color-accent-crimson);
    border-color: var(--color-accent-crimson-glow);
    color: white;
}

.vb-button-large {
    font-size: var(--font-size-lg);
    padding: var(--spacing-md) var(--spacing-xl);
    min-width: 200px;
    min-height: 50px;
}

/* Button hover glow effect - applied dynamically on mouse enter */
.vb-button-hover-glow {
    border-color: var(--color-accent-crimson-glow);
    transition-duration: 0.2s;
    transition-property: border-color, scale;
    scale: 1.05 1.05;
}

/* =============================================================================
   INPUT FIELDS
   ============================================================================= */

.vb-textfield {
    background-color: var(--color-background-dark);
    border-color: var(--color-border);
    border-width: 2px;
    border-radius: var(--radius-sm);
    padding: var(--spacing-sm);
    color: var(--color-text-primary);
    font-size: var(--font-size-md);
}

.vb-textfield:focus {
    border-color: var(--color-accent-crimson);
}

.vb-textfield > .unity-text-field__input {
    background-color: transparent;
    border-width: 0;
    color: var(--color-text-primary);
}

/* =============================================================================
   SLIDERS
   ============================================================================= */

.vb-slider {
    min-height: 30px;
}

.vb-slider .unity-base-slider__dragger {
    background-color: var(--color-accent-crimson);
    border-radius: 50%;
    width: 20px;
    height: 20px;
    margin-top: -8px;
}

.vb-slider .unity-base-slider__tracker {
    background-color: var(--color-background-light);
    border-radius: var(--radius-sm);
    height: 6px;
}

.vb-slider .unity-base-slider__drag-container {
    background-color: var(--color-accent-crimson-glow);
    border-radius: var(--radius-sm);
}

/* =============================================================================
   TOGGLE / CHECKBOX
   ============================================================================= */

.vb-toggle {
    flex-direction: row;
    align-items: center;
}

.vb-toggle .unity-toggle__checkmark {
    background-color: var(--color-background-dark);
    border-color: var(--color-border);
    border-width: 2px;
    border-radius: var(--radius-sm);
    width: 24px;
    height: 24px;
}

.vb-toggle:checked .unity-toggle__checkmark {
    background-color: var(--color-accent-crimson);
    border-color: var(--color-accent-crimson-glow);
}

.vb-toggle .unity-toggle__text {
    color: var(--color-text-primary);
    font-size: var(--font-size-md);
    margin-left: var(--spacing-sm);
}

/* =============================================================================
   DROPDOWN
   ============================================================================= */

.vb-dropdown {
    background-color: var(--color-background-light);
    border-color: var(--color-border);
    border-width: 2px;
    border-radius: var(--radius-sm);
    padding: var(--spacing-sm);
}

.vb-dropdown .unity-base-popup-field__text {
    color: var(--color-text-primary);
    font-size: var(--font-size-md);
}

.vb-dropdown .unity-base-popup-field__arrow {
    -unity-background-image-tint-color: var(--color-text-primary);
}

/* =============================================================================
   SCROLLVIEW
   ============================================================================= */

.vb-scrollview {
    background-color: transparent;
}

.vb-scrollview .unity-scroller--vertical {
    width: 12px;
}

.vb-scrollview .unity-scroller--vertical .unity-base-slider__dragger {
    background-color: var(--color-accent-crimson);
    border-radius: var(--radius-sm);
    width: 8px;
    margin-left: 2px;
}

.vb-scrollview .unity-scroller--vertical .unity-base-slider__tracker {
    background-color: var(--color-background-dark);
    border-radius: var(--radius-sm);
}

/* =============================================================================
   PROGRESS BARS
   ============================================================================= */

.vb-progressbar {
    height: 20px;
    background-color: var(--color-background-dark);
    border-color: var(--color-border);
    border-width: 1px;
    border-radius: var(--radius-sm);
    overflow: hidden;
}

.vb-progressbar-fill {
    background-color: var(--color-accent-crimson);
    height: 100%;
    transition-duration: 0.3s;
}

.vb-healthbar-fill {
    background-color: var(--color-health);
}

.vb-healthbar-low .vb-healthbar-fill {
    background-color: var(--color-health-low);
}

.vb-manabar-fill {
    background-color: var(--color-mana);
}

/* =============================================================================
   LISTS & GRIDS
   ============================================================================= */

.vb-list-item {
    background-color: transparent;
    border-color: transparent;
    border-width: 1px;
    border-radius: var(--radius-sm);
    padding: var(--spacing-sm);
    margin: var(--spacing-xs) 0;
}

.vb-list-item:hover {
    background-color: var(--color-panel-hover);
    border-color: var(--color-border-highlight);
}

.vb-list-item:selected {
    background-color: var(--color-accent-crimson);
    border-color: var(--color-accent-crimson-glow);
}

.vb-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-start;
    align-items: flex-start;
}

.vb-grid-item {
    width: 100px;
    height: 100px;
    margin: var(--spacing-xs);
    background-color: var(--color-background-medium);
    border-color: var(--color-border);
    border-width: 1px;
    border-radius: var(--radius-sm);
}

/* =============================================================================
   TOOLTIPS
   ============================================================================= */

.vb-tooltip {
    background-color: rgba(10, 8, 15, 0.98);
    border-color: var(--color-accent-crimson);
    border-width: 1px;
    border-radius: var(--radius-sm);
    padding: var(--spacing-sm) var(--spacing-md);
    max-width: 300px;
}

.vb-tooltip-title {
    color: var(--color-text-highlight);
    font-size: var(--font-size-md);
    -unity-font-style: bold;
    margin-bottom: var(--spacing-xs);
}

.vb-tooltip-text {
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
}

/* =============================================================================
   ICONS & IMAGES
   ============================================================================= */

.vb-icon {
    width: 32px;
    height: 32px;
    -unity-background-scale-mode: scale-to-fit;
}

.vb-icon-small {
    width: 24px;
    height: 24px;
}

.vb-icon-large {
    width: 48px;
    height: 48px;
}

.vb-portrait {
    width: 64px;
    height: 64px;
    border-color: var(--color-border);
    border-width: 2px;
    border-radius: var(--radius-sm);
    -unity-background-scale-mode: scale-to-fit;
}

/* =============================================================================
   DIVIDERS & SEPARATORS
   ============================================================================= */

.vb-divider-horizontal {
    height: 2px;
    background-color: var(--color-border);
    margin: var(--spacing-md) 0;
}

.vb-divider-vertical {
    width: 2px;
    background-color: var(--color-border);
    margin: 0 var(--spacing-md);
}

/* =============================================================================
   LAYOUT UTILITIES
   ============================================================================= */

.vb-row {
    flex-direction: row;
    align-items: center;
}

.vb-column {
    flex-direction: column;
}

.vb-center {
    justify-content: center;
    align-items: center;
}

.vb-space-between {
    justify-content: space-between;
}

.vb-flex-grow {
    flex-grow: 1;
}

.vb-margin-sm { margin: var(--spacing-sm); }
.vb-margin-md { margin: var(--spacing-md); }
.vb-margin-lg { margin: var(--spacing-lg); }

.vb-padding-sm { padding: var(--spacing-sm); }
.vb-padding-md { padding: var(--spacing-md); }
.vb-padding-lg { padding: var(--spacing-lg); }

/* =============================================================================
   ANIMATIONS
   ============================================================================= */

.vb-fade-in {
    opacity: 1;
    transition-property: opacity;
    transition-duration: 0.3s;
}

.vb-fade-out {
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.3s;
}

.vb-pulse {
    transition-property: scale;
    transition-duration: 0.5s;
}

.vb-pulse:hover {
    scale: 1.05;
}

/* =============================================================================
   MAIN MENU SPECIFIC STYLES
   ============================================================================= */

/* Main menu buttons - larger, more prominent */
.menu-button-main {
    min-width: 100%;
    min-height: 54px;
    font-size: 18px;
    letter-spacing: 2px;
    background-color: rgb(180, 40, 60);
    border-color: rgb(220, 60, 80);
    border-width: 2px;
    border-radius: 4px;
    color: rgb(235, 225, 215);
    -unity-font-style: bold;
    transition-duration: 0.2s;
    transition-property: background-color, border-color, scale, translate;
}

.menu-button-main:hover {
    background-color: rgb(200, 60, 80);
    border-color: rgb(220, 60, 80);
    scale: 1.02;
    translate: -2px 0;
}

.menu-button-main:active {
    background-color: rgb(140, 30, 50);
    scale: 0.98;
}

/* Secondary menu buttons - smaller, less prominent */
.menu-button-secondary {
    min-width: 100%;
    min-height: 44px;
    font-size: 14px;
    letter-spacing: 1px;
    background-color: rgba(40, 32, 50, 0.8);
    border-color: rgb(70, 45, 55);
    border-width: 1px;
    border-radius: 4px;
    color: rgb(165, 155, 145);
    -unity-font-style: normal;
    transition-duration: 0.15s;
    transition-property: background-color, border-color, color, translate;
}

.menu-button-secondary:hover {
    background-color: rgba(80, 40, 50, 0.9);
    border-color: rgb(180, 50, 70);
    color: rgb(235, 225, 215);
    translate: -2px 0;
}

.menu-button-secondary:active {
    background-color: rgb(55, 35, 45);
}

/* Button glow effect element (inner child for animation) */
.button-glow {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    border-radius: 4px;
    opacity: 0;
    transition-duration: 0.3s;
}

.menu-button-main:hover .button-glow {
    opacity: 1;
}

/* Menu background layer styles */
.menu-bg-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* =============================================================================
   CHARACTER SELECT SPECIFIC STYLES
   ============================================================================= */

/* Hero card in the list */
.hero-card {
    flex-direction: row;
    align-items: center;
    padding: 12px;
    margin-bottom: 8px;
    background-color: rgb(28, 20, 25);
    border-color: rgb(70, 45, 55);
    border-width: 1px;
    border-radius: 4px;
    transition-duration: 0.15s;
    transition-property: background-color, border-color, scale;
    cursor: link;
}

.hero-card:hover {
    background-color: rgb(35, 28, 45);
    border-color: rgb(80, 65, 100);
}

.hero-card.selected {
    background-color: rgb(45, 30, 40);
    border-color: rgb(180, 40, 60);
}

/* Hero-specific color theming */
.hero-mirage {
    border-color: var(--hero-mirage);
}

.hero-mirage:hover {
    border-color: var(--hero-mirage-glow);
    background-color: rgba(40, 200, 80, 0.1);
}

.hero-mirage.selected {
    border-color: var(--hero-mirage-glow);
    background-color: rgba(40, 200, 80, 0.15);
}

.hero-bastion {
    border-color: var(--hero-bastion);
}

.hero-bastion:hover {
    border-color: var(--hero-bastion-glow);
    background-color: rgba(60, 140, 220, 0.1);
}

.hero-bastion.selected {
    border-color: var(--hero-bastion-glow);
    background-color: rgba(60, 140, 220, 0.15);
}

.hero-marrow {
    border-color: var(--hero-marrow);
}

.hero-marrow:hover {
    border-color: var(--hero-marrow-glow);
    background-color: rgba(160, 80, 200, 0.1);
}

.hero-marrow.selected {
    border-color: var(--hero-marrow-glow);
    background-color: rgba(160, 80, 200, 0.15);
}

.hero-rend {
    border-color: var(--hero-rend);
}

.hero-rend:hover {
    border-color: var(--hero-rend-glow);
    background-color: rgba(140, 30, 30, 0.1);
}

.hero-rend.selected {
    border-color: var(--hero-rend-glow);
    background-color: rgba(140, 30, 30, 0.15);
}

.hero-card-portrait {
    width: 50px;
    height: 50px;
    background-color: rgb(28, 20, 25);
    border-radius: 4px;
    margin-right: 12px;
    -unity-background-scale-mode: scale-to-fit;
}

.hero-card-name {
    color: rgb(235, 225, 215);
    font-size: 16px;
    -unity-font-style: bold;
}

/* Brand badge display */
.brand-badge {
    flex-direction: row;
    align-items: center;
    background-color: rgba(40, 32, 50, 0.8);
    border-radius: 4px;
    padding: 6px 10px;
}

.brand-icon {
    width: 20px;
    height: 20px;
    border-radius: 4px;
    margin-right: 8px;
}

.brand-name {
    color: rgb(235, 225, 215);
    font-size: 14px;
}

/* Stat bars */
.stat-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.stat-bar-bg {
    flex-grow: 1;
    height: 8px;
    background-color: rgb(28, 20, 25);
    border-radius: 4px;
    overflow: hidden;
}

.stat-bar-fill {
    height: 100%;
    border-radius: 4px;
    transition-duration: 0.3s;
    transition-property: width;
}

/* Ability cards */
.ability-card {
    flex-direction: row;
    align-items: center;
    padding: 10px;
    background-color: rgb(28, 20, 25);
    border-color: rgb(50, 35, 42);
    border-width: 1px;
    border-radius: 4px;
}

.ability-card:hover {
    background-color: rgb(35, 28, 45);
    border-color: rgb(70, 45, 55);
}

.ability-icon {
    width: 40px;
    height: 40px;
    background-color: rgb(45, 30, 38);
    border-radius: 4px;
    margin-right: 12px;
    -unity-background-scale-mode: scale-to-fit;
}

.ability-name {
    color: rgb(235, 225, 215);
    font-size: 14px;
    -unity-font-style: bold;
    margin-bottom: 2px;
}

.ability-desc {
    color: rgb(165, 155, 145);
    font-size: 12px;
}

/* =============================================================================
   INVENTORY UI
   ============================================================================= */

/* Category Tabs */
.inventory-tab {
    flex-grow: 1;
    height: 36px;
    background-color: transparent;
    border-width: 0;
    border-radius: 6px;
    color: rgb(165, 155, 145);
    font-size: 12px;
    letter-spacing: 1px;
    margin: 2px;
    transition-duration: 0.15s;
}

.inventory-tab:hover {
    background-color: rgba(180, 40, 60, 0.2);
    color: rgb(200, 190, 180);
}

.inventory-tab-active {
    background-color: rgb(180, 40, 60);
    color: rgb(235, 225, 215);
}

.inventory-tab-active:hover {
    background-color: rgb(200, 60, 80);
}

/* Item Grid Slots */
.item-slot {
    width: 72px;
    height: 72px;
    margin: 4px;
    background-color: rgb(28, 20, 25);
    border-width: 2px;
    border-color: rgb(50, 35, 42);
    border-radius: 6px;
    justify-content: center;
    align-items: center;
    transition-duration: 0.15s;
}

.item-slot:hover {
    border-color: rgb(180, 40, 60);
    background-color: rgb(35, 28, 45);
}

.item-slot-selected {
    border-color: rgb(220, 60, 80);
    background-color: rgb(50, 32, 42);
}

.item-slot-empty {
    background-color: rgb(18, 14, 25);
    border-style: dashed;
    border-color: rgb(35, 30, 45);
}

/* Item icon within slot */
.item-slot-icon {
    width: 48px;
    height: 48px;
    -unity-background-scale-mode: scale-to-fit;
}

/* Item quantity badge */
.item-quantity-badge {
    position: absolute;
    right: 2px;
    bottom: 2px;
    background-color: rgba(0, 0, 0, 0.8);
    padding: 2px 6px;
    border-radius: 4px;
}

.item-quantity-text {
    color: rgb(235, 225, 215);
    font-size: 11px;
    -unity-font-style: bold;
}

/* Rarity borders */
.rarity-common {
    border-color: rgb(120, 120, 120);
}

.rarity-uncommon {
    border-color: rgb(60, 180, 80);
}

.rarity-rare {
    border-color: rgb(60, 120, 220);
}

.rarity-epic {
    border-color: rgb(160, 80, 200);
}

.rarity-legendary {
    border-color: rgb(220, 160, 40);
}

.rarity-mythic {
    border-color: rgb(255, 80, 80);
    border-width: 3px;
}

/* Item icon frame (for detail panel) */
.item-icon-frame {
    background-color: rgb(28, 20, 25);
    border-width: 3px;
    border-radius: 8px;
    padding: 8px;
}

/* Stat display rows */
.item-stat-row {
    flex-direction: row;
    justify-content: space-between;
    padding: 6px 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(60, 50, 75, 0.3);
}

.item-stat-name {
    color: rgb(165, 155, 145);
    font-size: 13px;
}

.item-stat-value {
    font-size: 13px;
    -unity-font-style: bold;
}

.item-stat-positive {
    color: rgb(80, 200, 120);
}

.item-stat-negative {
    color: rgb(220, 80, 80);
}

/* Effect display */
.item-effect {
    padding: 8px;
    margin-bottom: 6px;
    background-color: rgba(180, 40, 60, 0.1);
    border-radius: 4px;
    border-left-width: 3px;
    border-left-color: rgb(180, 40, 60);
}

.item-effect-text {
    color: rgb(200, 190, 180);
    font-size: 13px;
}

/* Dropdown styling */
.vb-dropdown {
    background-color: rgb(28, 20, 25);
    border-color: rgb(70, 45, 55);
    border-width: 1px;
    border-radius: 4px;
    padding: 6px 12px;
    color: rgb(200, 190, 180);
    font-size: 13px;
}

.vb-dropdown:hover {
    border-color: rgb(180, 40, 60);
}

.vb-dropdown:focus {
    border-color: rgb(220, 60, 80);
}

/* Danger button for drop/discard */
.vb-button-danger {
    background-color: rgb(120, 40, 40);
    border-color: rgb(160, 60, 60);
}

.vb-button-danger:hover {
    background-color: rgb(150, 50, 50);
    border-color: rgb(180, 80, 80);
}

.vb-button-danger:active {
    background-color: rgb(100, 30, 30);
}

/* =============================================================================
   MONSTER COLLECTION UI
   ============================================================================= */

/* Monster card in grid */
.monster-card {
    width: 100px;
    height: 120px;
    margin: 6px;
    background-color: rgb(28, 20, 25);
    border-width: 2px;
    border-color: rgb(50, 35, 42);
    border-radius: 8px;
    padding: 8px;
    flex-direction: column;
    align-items: center;
    transition-duration: 0.15s;
}

.monster-card:hover {
    border-color: rgb(180, 40, 60);
    background-color: rgb(35, 28, 45);
    scale: 1.02;
}

.monster-card-selected {
    border-color: rgb(220, 60, 80);
    background-color: rgb(50, 32, 42);
}

/* Monster portrait in card */
.monster-card-portrait {
    width: 64px;
    height: 64px;
    background-color: rgb(35, 28, 45);
    border-radius: 4px;
    margin-bottom: 6px;
    -unity-background-scale-mode: scale-to-fit;
}

.monster-card-name {
    color: rgb(200, 190, 180);
    font-size: 11px;
    -unity-text-align: middle-center;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 84px;
}

.monster-card-level {
    color: rgb(165, 155, 145);
    font-size: 10px;
}

/* Corruption glow effects */
.corruption-low {
    border-color: rgb(60, 120, 80);
}

.corruption-medium {
    border-color: rgb(180, 150, 60);
}

.corruption-high {
    border-color: rgb(180, 80, 80);
}

.corruption-critical {
    border-color: rgb(180, 40, 60);
    border-width: 3px;
}

/* Corruption bar */
.corruption-bar-bg {
    height: 12px;
    background-color: rgb(28, 20, 25);
    border-radius: 6px;
    overflow: hidden;
}

/* Monster stat item */
.monster-stat-item {
    flex-direction: column;
    align-items: flex-start;
    padding: 4px;
}

/* Skill display in list */
.monster-skill {
    flex-direction: row;
    align-items: center;
    padding: 8px;
    margin-bottom: 4px;
    background-color: rgb(30, 24, 40);
    border-radius: 4px;
    border-left-width: 3px;
    border-left-color: rgb(180, 40, 60);
}

.monster-skill:hover {
    background-color: rgb(45, 30, 38);
}

.monster-skill-icon {
    width: 24px;
    height: 24px;
    background-color: rgb(50, 35, 42);
    border-radius: 4px;
    margin-right: 10px;
}

.monster-skill-name {
    color: rgb(200, 190, 180);
    font-size: 13px;
    flex-grow: 1;
}

.monster-skill-brand {
    width: 16px;
    height: 16px;
    border-radius: 8px;
}

/* Text field styling */
.vb-text-field {
    background-color: rgb(28, 20, 25);
    border-color: rgb(70, 45, 55);
    border-width: 1px;
    border-radius: 4px;
    padding: 6px 12px;
    color: rgb(200, 190, 180);
    font-size: 13px;
}

.vb-text-field:hover {
    border-color: rgb(80, 60, 100);
}

.vb-text-field:focus {
    border-color: rgb(180, 40, 60);
}

.vb-text-field > .unity-text-field__input {
    background-color: transparent;
    border-width: 0;
    color: rgb(200, 190, 180);
}

/* =============================================================================
   VERA DIALOGUE UI
   ============================================================================= */

/* Main dialogue box */
.dialogue-box {
    background-color: rgba(12, 10, 18, 0.95);
    border-width: 2px;
    border-color: rgb(70, 45, 55);
    border-radius: 12px;
    overflow: hidden;
}

.dialogue-box-glitched {
    border-color: rgb(180, 40, 60);
}

/* Glitch overlay effect */
.dialogue-glitch-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(180, 40, 60, 0.1);
    border-radius: 12px;
}

/* VERA Portrait */
.vera-portrait-frame {
    width: 100px;
    height: 100px;
    background-color: rgb(20, 16, 28);
    border-radius: 50px;
    border-width: 3px;
    border-color: rgb(180, 40, 60);
    justify-content: center;
    align-items: center;
    overflow: hidden;
}

.vera-portrait-frame-glitched {
    border-color: rgb(180, 40, 60);
}

.vera-portrait-glow {
    position: absolute;
    left: -4px;
    top: -4px;
    right: -4px;
    bottom: -4px;
    border-radius: 54px;
    border-width: 2px;
    border-color: rgba(120, 200, 150, 0.5);
}

.vera-portrait-glow-corrupted {
    border-color: rgba(180, 40, 60, 0.7);
}

.vera-portrait {
    width: 80px;
    height: 80px;
    border-radius: 40px;
    background-color: rgb(70, 45, 55);
    -unity-background-scale-mode: scale-to-fit;
}

.vera-scanlines {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(180, 40, 60, 0.3);
    border-radius: 50px;
}

.vera-name {
    color: rgb(120, 200, 150);
    font-size: 14px;
    letter-spacing: 3px;
    -unity-font-style: bold;
}

.vera-name-glitched {
    color: rgb(180, 40, 60);
}

/* Integrity pip indicator */
.integrity-pip {
    width: 12px;
    height: 12px;
    border-radius: 6px;
    background-color: rgb(120, 200, 150);
}

.integrity-pip-warning {
    background-color: rgb(220, 180, 60);
}

.integrity-pip-critical {
    background-color: rgb(200, 60, 80);
}

.integrity-pip-corrupted {
    background-color: rgb(180, 40, 60);
}

/* Dialogue text */
.dialogue-text {
    color: rgb(220, 215, 210);
    font-size: 16px;
    white-space: normal;
    line-height: 1.5;
}

.dialogue-text-glitched {
    color: rgb(200, 120, 130);
}

/* Continue indicator */
.continue-hint {
    color: rgb(100, 90, 85);
    font-size: 11px;
    letter-spacing: 1px;
}

.continue-arrow {
    width: 0;
    height: 0;
    margin-left: 8px;
    border-left-width: 6px;
    border-right-width: 6px;
    border-top-width: 8px;
    border-left-color: transparent;
    border-right-color: transparent;
    border-top-color: rgb(100, 90, 85);
}

/* Choices container */
.dialogue-choices {
    background-color: rgba(8, 6, 12, 0.5);
}

/* Choice button */
.dialogue-choice {
    padding: 12px 20px;
    margin-bottom: 8px;
    background-color: rgb(28, 20, 25);
    border-width: 1px;
    border-color: rgb(70, 45, 55);
    border-radius: 6px;
    transition-duration: 0.15s;
}

.dialogue-choice:hover {
    background-color: rgb(45, 30, 38);
    border-color: rgb(180, 40, 60);
}

.dialogue-choice:active {
    background-color: rgb(55, 35, 45);
}

.dialogue-choice-text {
    color: rgb(200, 190, 180);
    font-size: 14px;
}

.dialogue-choice:hover .dialogue-choice-text {
    color: rgb(235, 225, 215);
}

/* Choice with consequence indicator */
.dialogue-choice-consequence {
    border-left-width: 3px;
    border-left-color: rgb(220, 180, 60);
}

.dialogue-choice-dangerous {
    border-left-color: rgb(200, 60, 80);
}

/* Veil Integrity bar */
.integrity-bar-bg {
    background-color: rgb(28, 20, 25);
    border-radius: 4px;
    overflow: hidden;
}

.integrity-bar-fill {
    height: 100%;
    background-color: rgb(120, 200, 150);
    border-radius: 4px;
    transition-duration: 0.3s;
    transition-property: width, background-color;
}

.integrity-bar-fill-warning {
    background-color: rgb(220, 180, 60);
}

.integrity-bar-fill-critical {
    background-color: rgb(200, 60, 80);
}

.integrity-bar-fill-corrupted {
    background-color: rgb(180, 40, 60);
}

/* =============================================================================
   SETTINGS PANEL - Dropdown Visibility Fix
   ============================================================================= */

/* CRITICAL: Force all parent containers to allow overflow for dropdown menus */
.settings-panel-container {
    overflow: visible !important;
    background-color: rgba(18, 12, 22, 0.95);
    border-radius: 12px;
    border-width: 2px;
    border-color: rgba(180, 40, 60, 0.4);
}

.settings-scroll {
    overflow: visible !important;
}

.settings-scroll > .unity-scroll-view__content-viewport {
    overflow: visible !important;
}

.settings-scroll > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container {
    overflow: visible !important;
}

/* Ensure dropdown popup is not clipped */
.unity-base-popup-field__input {
    overflow: visible !important;
}

.unity-base-dropdown {
    overflow: visible !important;
}

.unity-base-dropdown__container-outer {
    overflow: visible !important;
}

.unity-base-dropdown__container-inner {
    overflow: visible !important;
}

/* Settings tabs */
.settings-tab {
    background-color: transparent;
    border-width: 0;
    color: rgb(165, 155, 145);
    transition-duration: 0.2s;
    transition-property: background-color, color;
}

.settings-tab-active {
    background-color: rgba(180, 40, 60, 0.2);
    color: rgb(235, 225, 215);
    border-radius: 4px;
}

.settings-tab-inactive:hover {
    background-color: rgba(180, 40, 60, 0.1);
    color: rgb(200, 190, 180);
}
