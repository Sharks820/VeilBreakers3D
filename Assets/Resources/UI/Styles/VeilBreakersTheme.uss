/* =============================================================================
   VEILBREAKERS THEME TOKENS
   Design System Variables - The Foundation of AAA UI
   ============================================================================= */

:root {
    /* =========================================================================
       BRAND COLORS - The 10 Brands of VeilBreakers
       Each brand has primary, glow, and dark variants
       ========================================================================= */

    /* IRON - Steel and strength */
    --brand-iron: rgb(140, 150, 165);
    --brand-iron-glow: rgb(180, 190, 205);
    --brand-iron-dark: rgb(80, 90, 100);

    /* SAVAGE - Blood and fury */
    --brand-savage: rgb(180, 45, 45);
    --brand-savage-glow: rgb(220, 70, 70);
    --brand-savage-dark: rgb(120, 25, 25);

    /* SURGE - Lightning and speed */
    --brand-surge: rgb(60, 140, 220);
    --brand-surge-glow: rgb(100, 180, 255);
    --brand-surge-dark: rgb(30, 80, 140);

    /* VENOM - Poison and decay */
    --brand-venom: rgb(80, 180, 60);
    --brand-venom-glow: rgb(120, 220, 100);
    --brand-venom-dark: rgb(40, 100, 30);

    /* DREAD - Fear and shadow */
    --brand-dread: rgb(140, 40, 80);
    --brand-dread-glow: rgb(180, 60, 100);
    --brand-dread-dark: rgb(80, 20, 50);

    /* LEECH - Life drain */
    --brand-leech: rgb(140, 40, 80);
    --brand-leech-glow: rgb(180, 60, 110);
    --brand-leech-dark: rgb(90, 20, 50);

    /* GRACE - Divine protection */
    --brand-grace: rgb(220, 220, 240);
    --brand-grace-glow: rgb(255, 255, 255);
    --brand-grace-dark: rgb(160, 160, 180);

    /* MEND - Healing and restoration */
    --brand-mend: rgb(200, 170, 80);
    --brand-mend-glow: rgb(240, 210, 120);
    --brand-mend-dark: rgb(140, 110, 40);

    /* RUIN - Destruction and fire */
    --brand-ruin: rgb(220, 120, 40);
    --brand-ruin-glow: rgb(255, 160, 80);
    --brand-ruin-dark: rgb(160, 70, 20);

    /* VOID - Nothingness and entropy */
    --brand-void: rgb(40, 20, 60);
    --brand-void-glow: rgb(100, 60, 140);
    --brand-void-dark: rgb(15, 5, 25);

    /* =========================================================================
       HERO COLORS - Character-specific theming
       ========================================================================= */

    /* MIRAGE - Stealth and illusions (GREEN) */
    --hero-mirage: rgb(40, 200, 80);
    --hero-mirage-glow: rgb(80, 240, 120);
    --hero-mirage-dark: rgb(20, 120, 40);

    /* BASTION - Defense and protection (BLUE) */
    --hero-bastion: rgb(60, 140, 220);
    --hero-bastion-glow: rgb(100, 180, 255);
    --hero-bastion-dark: rgb(30, 80, 140);

    /* MARROW - Death and necromancy (PURPLE) */
    --hero-marrow: rgb(160, 80, 200);
    --hero-marrow-glow: rgb(200, 120, 240);
    --hero-marrow-dark: rgb(100, 40, 120);

    /* REND - Berserker fury (DARK RED) */
    --hero-rend: rgb(140, 30, 30);
    --hero-rend-glow: rgb(200, 60, 60);
    --hero-rend-dark: rgb(80, 15, 15);

    /* NEW HEROES v2.0 */
    /* VEX - Steel warden (IRONBOUND) */
    --hero-vex: rgb(140, 128, 115);
    --hero-vex-glow: rgb(180, 165, 145);
    --hero-vex-dark: rgb(90, 82, 72);

    /* SERAPHINA - Poison rose (FANGBORN) */
    --hero-seraphina: rgb(165, 50, 90);
    --hero-seraphina-glow: rgb(210, 80, 130);
    --hero-seraphina-dark: rgb(100, 30, 55);

    /* ORION - Lightning blue (VOIDTOUCHED) */
    --hero-orion: rgb(40, 165, 240);
    --hero-orion-glow: rgb(80, 200, 255);
    --hero-orion-dark: rgb(25, 100, 150);

    /* NYX - Void purple (UNCHAINED) */
    --hero-nyx: rgb(100, 40, 120);
    --hero-nyx-glow: rgb(140, 70, 170);
    --hero-nyx-dark: rgb(60, 20, 75);

    /* =========================================================================
       CORRUPTION STATE COLORS
       ========================================================================= */

    /* ASCENDED (0-10%) - Golden divine power */
    --corruption-ascended: rgb(255, 215, 0);
    --corruption-ascended-glow: rgb(255, 240, 100);
    --corruption-ascended-bg: rgba(255, 215, 0, 0.15);

    /* PURIFIED (11-25%) - Clean blue-white */
    --corruption-purified: rgb(180, 210, 255);
    --corruption-purified-glow: rgb(220, 240, 255);
    --corruption-purified-bg: rgba(180, 210, 255, 0.15);

    /* UNSTABLE (26-50%) - Neutral gray */
    --corruption-unstable: rgb(160, 160, 170);
    --corruption-unstable-glow: rgb(200, 200, 210);
    --corruption-unstable-bg: rgba(160, 160, 170, 0.15);

    /* CORRUPTED (51-75%) - Crimson infection */
    --corruption-corrupted: rgb(160, 40, 80);
    --corruption-corrupted-glow: rgb(200, 60, 100);
    --corruption-corrupted-bg: rgba(160, 40, 80, 0.2);

    /* ABYSSAL (76-100%) - Deep void crimson */
    --corruption-abyssal: rgb(80, 10, 30);
    --corruption-abyssal-glow: rgb(120, 30, 50);
    --corruption-abyssal-bg: rgba(80, 10, 30, 0.3);

    /* =========================================================================
       RARITY COLORS (For items/monsters)
       ========================================================================= */

    --rarity-common: rgb(180, 180, 180);
    --rarity-uncommon: rgb(80, 180, 80);
    --rarity-rare: rgb(80, 140, 220);
    --rarity-epic: rgb(160, 80, 200);
    --rarity-legendary: rgb(255, 180, 0);
    --rarity-mythic: rgb(255, 100, 100);

    /* =========================================================================
       UI SURFACE COLORS
       ========================================================================= */

    /* Backgrounds - Layered depth system */
    --surface-0: rgb(8, 6, 12);        /* Deepest background */
    --surface-1: rgb(18, 12, 15);      /* Main background */
    --surface-2: rgb(28, 18, 22);      /* Elevated panels */
    --surface-3: rgb(42, 28, 35);      /* Cards, containers */
    --surface-4: rgb(55, 35, 45);      /* Hover states */
    --surface-5: rgb(70, 45, 55);      /* Active states */

    /* Transparency variants for overlays */
    --surface-overlay-light: rgba(255, 255, 255, 0.05);
    --surface-overlay-medium: rgba(255, 255, 255, 0.1);
    --surface-overlay-dark: rgba(0, 0, 0, 0.5);
    --surface-overlay-heavy: rgba(0, 0, 0, 0.8);

    /* =========================================================================
       TEXT COLORS
       ========================================================================= */

    --text-primary: rgb(235, 225, 215);
    --text-secondary: rgb(165, 155, 145);
    --text-tertiary: rgb(110, 100, 95);
    --text-disabled: rgb(75, 68, 65);
    --text-inverse: rgb(15, 12, 20);
    --text-highlight: rgb(255, 245, 220);
    --text-link: rgb(140, 180, 255);
    --text-error: rgb(255, 100, 100);
    --text-success: rgb(100, 200, 100);
    --text-warning: rgb(255, 200, 80);

    /* =========================================================================
       BORDER COLORS
       ========================================================================= */

    --border-subtle: rgb(50, 35, 42);
    --border-default: rgb(70, 45, 55);
    --border-strong: rgb(100, 50, 65);
    --border-highlight: rgb(120, 100, 150);
    --border-focus: var(--brand-dread-glow);

    /* =========================================================================
       SEMANTIC COLORS
       ========================================================================= */

    /* Health/Damage */
    --health-full: rgb(60, 180, 80);
    --health-high: rgb(140, 200, 60);
    --health-medium: rgb(220, 180, 40);
    --health-low: rgb(220, 100, 40);
    --health-critical: rgb(200, 40, 40);

    /* Resources */
    --resource-mana: rgb(60, 120, 200);
    --resource-stamina: rgb(200, 180, 60);
    --resource-special: rgb(200, 100, 200);

    /* =========================================================================
       SHADOWS & GLOWS
       ========================================================================= */

    --shadow-sm: 0 2px 4px rgba(0, 0, 0, 0.3);
    --shadow-md: 0 4px 8px rgba(0, 0, 0, 0.4);
    --shadow-lg: 0 8px 16px rgba(0, 0, 0, 0.5);
    --shadow-xl: 0 12px 24px rgba(0, 0, 0, 0.6);

    --glow-subtle: 0 0 8px rgba(180, 40, 60, 0.3);
    --glow-medium: 0 0 16px rgba(180, 40, 60, 0.5);
    --glow-strong: 0 0 24px rgba(180, 40, 60, 0.7);
    --glow-intense: 0 0 32px rgba(220, 60, 80, 0.8);

    /* =========================================================================
       SPACING SCALE (8px base)
       ========================================================================= */

    --space-0: 0;
    --space-1: 4px;
    --space-2: 8px;
    --space-3: 12px;
    --space-4: 16px;
    --space-5: 24px;
    --space-6: 32px;
    --space-7: 48px;
    --space-8: 64px;
    --space-9: 96px;
    --space-10: 128px;

    /* =========================================================================
       TYPOGRAPHY SCALE
       ========================================================================= */

    --font-size-2xs: 10px;
    --font-size-xs: 12px;
    --font-size-sm: 14px;
    --font-size-md: 16px;
    --font-size-lg: 18px;
    --font-size-xl: 20px;
    --font-size-2xl: 24px;
    --font-size-3xl: 30px;
    --font-size-4xl: 36px;
    --font-size-5xl: 48px;
    --font-size-6xl: 64px;

    --line-height-tight: 1.2;
    --line-height-normal: 1.5;
    --line-height-relaxed: 1.75;

    --letter-spacing-tight: -0.5px;
    --letter-spacing-normal: 0;
    --letter-spacing-wide: 1px;
    --letter-spacing-wider: 2px;
    --letter-spacing-widest: 4px;

    /* =========================================================================
       BORDER RADIUS
       ========================================================================= */

    --radius-none: 0;
    --radius-sm: 4px;
    --radius-md: 8px;
    --radius-lg: 12px;
    --radius-xl: 16px;
    --radius-2xl: 24px;
    --radius-full: 9999px;

    /* =========================================================================
       ANIMATION TIMING
       ========================================================================= */

    --duration-instant: 0.05s;
    --duration-fast: 0.15s;
    --duration-normal: 0.3s;
    --duration-slow: 0.5s;
    --duration-slower: 0.8s;

    --ease-default: ease;
    --ease-in: ease-in;
    --ease-out: ease-out;
    --ease-in-out: ease-in-out;

    /* =========================================================================
       Z-INDEX LAYERS
       ========================================================================= */

    --z-base: 0;
    --z-dropdown: 100;
    --z-sticky: 200;
    --z-fixed: 300;
    --z-modal-backdrop: 400;
    --z-modal: 500;
    --z-popover: 600;
    --z-tooltip: 700;
    --z-toast: 800;
}
