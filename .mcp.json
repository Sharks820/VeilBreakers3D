{
  "mcpServers": {
    "sequential-thinking": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"],
      "description": "Complex problem breakdown, multi-step reasoning, game balance calculations"
    },
    "serena": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server"
      ],
      "description": "Symbol-aware code navigation and scoped edits"
    },
    "gemini-cli": {
      "type": "stdio",
      "command": "node",
      "args": ["--require", "./Tools/mcp/spawn-patch.cjs", "C:/nvm4w/nodejs/node_modules/mcp-gemini-cli/dist/index.js", "--allow-npx"],
      "env": {
        "PATH": "C:\\nvm4w\\nodejs;${PATH}"
      },
      "description": "Gemini CLI - search, chat, analyze files. Use for second opinions and web research."
    },
    "codex-cli": {
      "type": "stdio",
      "command": "node",
      "args": ["--require", "./Tools/mcp/spawn-patch.cjs", "C:/nvm4w/nodejs/node_modules/mcp-codex-cli/dist/index.js", "--allow-npx"],
      "env": {
        "PATH": "C:\\nvm4w\\nodejs;${PATH}"
      },
      "description": "Codex CLI - OpenAI code review, analysis. Use as senior reviewer alongside Gemini."
    },
    "github": {
      "type": "stdio",
      "command": "node",
      "args": ["Tools/mcp/github-mcp-launcher.js"],
      "description": "GitHub operations - PRs, issues, commits, CI status. Token auto-sourced from gh CLI."
    },
    "vb-blender": {
      "type": "stdio",
      "command": "uv",
      "args": ["--directory", "C:/Users/Conner/OneDrive/Documents/veilbreakers-gamedev-toolkit/Tools/mcp-toolkit", "run", "vb-blender-mcp"],
      "env": {
        "BLENDER_PORT": "9876",
        "BLENDER_HOST": "localhost",
        "ELEVENLABS_API_KEY": "${ELEVENLABS_API_KEY}",
        "GEMINI_API_KEY": "${GEMINI_API_KEY}",
        "TRIPO_API_KEY": "${TRIPO_API_KEY}",
        "FAL_KEY": "${FAL_KEY}"
      },
      "description": "VeilBreakers Blender toolkit - 15 compound tools"
    },
    "vb-unity": {
      "type": "stdio",
      "command": "uv",
      "args": ["--directory", "C:/Users/Conner/OneDrive/Documents/veilbreakers-gamedev-toolkit/Tools/mcp-toolkit", "run", "vb-unity-mcp"],
      "env": {
        "UNITY_PROJECT_PATH": "C:/Users/Conner/OneDrive/Documents/VeilBreakers3DCurrent",
        "ELEVENLABS_API_KEY": "${ELEVENLABS_API_KEY}",
        "GEMINI_API_KEY": "${GEMINI_API_KEY}"
      },
      "description": "VeilBreakers Unity toolkit - VFX, audio, UI, scene, gameplay, performance tools"
    },
    "unity-mcp": {
      "type": "stdio",
      "command": "unity-mcp-server",
      "args": ["--client-transport=stdio", "--port=8080", "--plugin-timeout=10000"],
      "description": "IvanMurzak Unity-MCP - runtime debugging, Roslyn execute, reflection, package manager, editor selection"
    }
  },
  "_profile": {
    "name": "core",
    "purpose": "Lean daily-driver profile. For memory-graph, image-process, notion: use .mcp.full.json"
  }
}
