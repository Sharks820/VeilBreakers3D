{
  "mcpServers": {
    "sequential-thinking": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "image-process": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "image-process-mcp-server"
      ]
    },
    "mcp-unity": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@akiojin/unity-mcp-server@latest"
      ]
    },
    "mcp-hfspace": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@llmindset/mcp-hfspace"
      ],
      "env": {
        "HF_TOKEN": "${HF_TOKEN}"
      }
    },
    "github": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "github-mcp"
      ],
      "env": {
        "GITHUB_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      }
    }
  }
}
